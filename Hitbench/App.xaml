<Application
    x:Class="Hitbench.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Family roles share a composite; consumers select the real weight/style. Display uses Bold. -->
            <FontFamily x:Key="Display">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="Regular">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="Italic">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="Bold">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="BoldItalic">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="Light">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <FontFamily x:Key="LightItalic">pack://application:,,,/Hitbench;component/Resources/Fonts/#Hitbench Noto Sans</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="Resources/Themes/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Converters/Converters.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/ColumnDefinition.xaml" />
                <ResourceDictionary Source="Resources/Styles/Grid.xaml" />
                <ResourceDictionary Source="Resources/Styles/StackPanel.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="Resources/Styles/ItemsControl.xaml" />
                <ResourceDictionary Source="Resources/Styles/Image.xaml" />
                <ResourceDictionary Source="Resources/Styles/Border.xaml" />
                <ResourceDictionary Source="Resources/Styles/ContentPresenter.xaml" />
                <ResourceDictionary Source="Resources/Styles/Button.xaml" />
                <ResourceDictionary Source="Resources/Styles/MenuItem.xaml" />
                <ResourceDictionary Source="Resources/Styles/ContextMenu.xaml" />
                <ResourceDictionary Source="Resources/Styles/BalloonComboBox.xaml" />
                <ResourceDictionary Source="Resources/Styles/SegmentedToggleGroup.xaml" />
                <ResourceDictionary Source="Resources/Styles/SegmentedToggleOption.xaml" />
                <ResourceDictionary Source="Resources/Styles/PianoRollView.xaml" />
                <ResourceDictionary Source="Resources/Styles/BeatGridView.xaml" />
                <ResourceDictionary Source="Resources/Styles/ToolTip.xaml" />
                <ResourceDictionary Source="Resources/Styles/Window.xaml" />
                <ResourceDictionary Source="Resources/Styles/ListBox.xaml" />
                <ResourceDictionary Source="Resources/Styles/ListView.xaml" />
                <ResourceDictionary Source="Resources/Styles/TreeView.xaml" />
                <ResourceDictionary Source="Resources/Styles/ComboBox.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBox.xaml" />
                <ResourceDictionary Source="Resources/Styles/ProgressBar.xaml" />
                <ResourceDictionary Source="Resources/Styles/ScrollViewer.xaml" />
                <ResourceDictionary Source="Resources/Styles/Slider.xaml" />
                <ResourceDictionary Source="Resources/Styles/StepNavigator.xaml" />
                <ResourceDictionary Source="Resources/Styles/Popup.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
