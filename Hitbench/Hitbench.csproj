<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OHsReleaseVersion" Value="$(OHsReleaseVersion)" />
    <AssemblyMetadata Include="OHsSourceCommit" Value="$(SourceRevisionId)" />
    <EmbeddedResource Include="Resources\Update-Hitbench.ps1" LogicalName="Hitbench.UpdateHelper" />
    <Resource Include="Resources\logo.ico;Resources\logo.png;Resources\logo-light.ico;Resources\logo-light.png" />
    <Resource Include="Resources\LoadingSpinnerD.json;Resources\LoadingSpinnerL.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LottieSharp" Version="2.4.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <Resource Include="Resources\Fonts\*.ttf;Resources\Fonts\*.ttc;Resources\Fonts\*.CompositeFont" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Fonts\*-OFL.txt;Resources\Fonts\*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hitbench.Core\Hitbench.Core.csproj" />
  </ItemGroup>

  <Target Name="SeedAppSettingsForBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/appsettings.json" DestinationFiles="$(TargetDir)appsettings.json" Condition="!Exists('$(TargetDir)appsettings.json')" />
  </Target>
  <Target Name="SeedAppSettingsForPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/appsettings.json" DestinationFiles="$(PublishDir)appsettings.json" Condition="!Exists('$(PublishDir)appsettings.json')" />
  </Target>
</Project>
