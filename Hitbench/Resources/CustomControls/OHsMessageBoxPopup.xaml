<customControls:BasePopup
    x:Class="Hitbench.Resources.CustomControls.OHsMessageBoxPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    Width="420"
    MinWidth="420"
    MaxWidth="420"
    ShowCloseButton="False"
    ShowInTaskbar="False">
    <customControls:BasePopup.Resources>

        <Style x:Key="OHsMessageBoxBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </customControls:BasePopup.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MessageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="Message" Focusable="True"
            h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True"
            FocusVisualStyle="{StaticResource DefaultFocusVisualStyle}" Style="{StaticResource {x:Type ScrollViewer}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="IconBadge"
                Width="48"
                Height="48"
                VerticalAlignment="Top"
                CornerRadius="24">
                <customControls:Icon x:Name="MessageIcon" Margin="12" />
            </Border>

            <TextBlock x:Name="MessageTextBlock" Grid.Column="2"
                Style="{StaticResource OHsMessageBoxBodyTextStyle}" />
        </Grid>
        </ScrollViewer>

        <WrapPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <customControls:BalloonButton
                x:Name="TertiaryButton"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True"
                Margin="0,0,8,0"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Click="OnTertiaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                Visibility="Collapsed" />
            <customControls:BalloonButton
                x:Name="SecondaryButton"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True"
                Margin="0,0,8,0"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Click="OnSecondaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                Visibility="Collapsed" />
            <customControls:BalloonButton
                x:Name="PrimaryButton"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True"
                AutomationProperties.Name="OK"
                ButtonIcon="{StaticResource Check}"
                ButtonText="OK"
                Click="OnPrimaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonConfirmActionStyle}" />
        </WrapPanel>
    </Grid>
</customControls:BasePopup>

