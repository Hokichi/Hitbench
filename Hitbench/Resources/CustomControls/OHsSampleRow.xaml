<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Hitbench.Resources.CustomControls" x:Class="Hitbench.Resources.CustomControls.OHsSampleRow" Style="{StaticResource BaseControlStyle}">
    <UserControl.Resources>
        <Style x:Key="OHsSampleRowBorderStyle" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsSampleRowNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsSampleRowEditorStyle" TargetType="ContentPresenter" BasedOn="{StaticResource BaseContentPresenterStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsSampleRowWaveformBacking" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Waveform.Unplayed}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsSampleRowPlayStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}"/>
            <Setter Property="ButtonText" Value="Play"/>
            <Setter Property="ShouldShowText" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}"/>
                    <Setter Property="ButtonText" Value="Pause"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource OHsSampleRowBorderStyle}">
        <Grid Style="{StaticResource BaseGridStyle}" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="3" Style="{StaticResource OHsSampleRowNameStyle}" Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" ToolTip="{Binding FileToolTip, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}"/>
            <ContentPresenter Grid.ColumnSpan="3" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" ContentTemplate="{Binding NameEditorTemplate, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" Style="{StaticResource OHsSampleRowEditorStyle}"/>
            <Border Grid.Row="1" Margin="8,4" Style="{StaticResource OHsSampleRowWaveformBacking}">
                <c:WaveformView Height="32" Data="{Binding Waveform, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" ShowPlaybackMarker="False" CenterWaveform="True" WaveformBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}, Mode=OneWay}" IsHitTestVisible="False"/>
            </Border>
            <c:BalloonButton x:Name="PlayAction" Grid.Row="1" Grid.Column="1" Style="{StaticResource OHsSampleRowPlayStyle}" Command="{Binding PlayCommand, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" CommandParameter="{Binding PlayCommandParameter, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" AutomationProperties.Name="{Binding FileName, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay, StringFormat=Play or pause {0}}" ToolTip="{Binding FileName, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay, StringFormat=Play or pause {0}}"/>
            <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" ContentTemplate="{Binding ActionsTemplate, RelativeSource={RelativeSource AncestorType=c:OHsSampleRow}, Mode=OneWay}" Style="{StaticResource BaseContentPresenterStyle}"/>
        </Grid>
    </Border>
</UserControl>
