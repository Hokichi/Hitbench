<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseItemsControlStyle"
        TargetType="ItemsControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <ItemsPanelTemplate x:Key="OHsVirtualizedDrawerItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
    <ControlTemplate x:Key="OHsVirtualizedDrawerItemsTemplate" TargetType="ItemsControl">
        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource {x:Type ScrollViewer}}"><ItemsPresenter /></ScrollViewer>
    </ControlTemplate>
    <Style x:Key="OHsVirtualizedDrawerItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource BaseItemsControlStyle}">
        <Setter Property="Template" Value="{StaticResource OHsVirtualizedDrawerItemsTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource OHsVirtualizedDrawerItemsPanel}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <ItemsPanelTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="HorizontalStackItemsPanelTemplate">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style x:Key="BalloonMenuItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource BaseItemsControlStyle}">
        <!-- Keep the action hit targets inside the popup's outer stroke. -->
        <Setter Property="Margin" Value="-1" />
        <Setter Property="ItemsPanel" Value="{StaticResource HorizontalStackItemsPanelTemplate}" />
        <Setter Property="ItemTemplate" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
