<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseItemsControlStyle"
        TargetType="ItemsControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <ItemsPanelTemplate x:Key="OHsVirtualizedDrawerItemsPanel">
        <VirtualizingStackPanel />
    </ItemsPanelTemplate>
    <ControlTemplate x:Key="OHsVirtualizedDrawerItemsTemplate" TargetType="ItemsControl">
        <ScrollViewer
            CanContentScroll="True"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource {x:Type ScrollViewer}}"
            VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
        </ScrollViewer>
    </ControlTemplate>
    <Style
        x:Key="OHsVirtualizedDrawerItemsStyle"
        BasedOn="{StaticResource BaseItemsControlStyle}"
        TargetType="ItemsControl">
        <Setter Property="Template" Value="{StaticResource OHsVirtualizedDrawerItemsTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource OHsVirtualizedDrawerItemsPanel}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <ItemsPanelTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="HorizontalStackItemsPanelTemplate">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="VerticalStackItemsPanelTemplate">
        <StackPanel Orientation="Vertical" />
    </ItemsPanelTemplate>

    <Style
        x:Key="BalloonMenuItemsStyle"
        BasedOn="{StaticResource BaseItemsControlStyle}"
        TargetType="ItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource VerticalStackItemsPanelTemplate}" />
        <Setter Property="ItemTemplate" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
