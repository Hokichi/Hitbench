<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseProgressBarStyle"
        TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>

    <ControlTemplate x:Key="OHsDeterminateProgressTemplate" TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Style="{StaticResource BaseBorderStyle}">
            <Grid x:Name="PART_Track" Style="{StaticResource BaseGridStyle}">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                        Style="{StaticResource BaseBorderStyle}" />
            </Grid>
        </Border>
    </ControlTemplate>
    <Style x:Key="OHsDeterminateProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
        <Setter Property="Template" Value="{StaticResource OHsDeterminateProgressTemplate}" />
        <Setter Property="Height" Value="{StaticResource Space.2}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
