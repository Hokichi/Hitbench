<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseSegmentedToggleOptionStyle"
        TargetType="{x:Type c:SegmentedToggleOption}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        <Setter Property="Padding" Value="14,6" />
    </Style>
    <DataTemplate x:Key="SegmentedToggleOptionContentTemplate">
        <TextBlock
            Style="{StaticResource BaseTextBlockStyle}"
            Text="{Binding Mode=OneWay}"
            TextWrapping="Wrap" />
    </DataTemplate>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SegmentedToggleOptionTemplate"
        TargetType="{x:Type c:SegmentedToggleOption}">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Style="{StaticResource BaseBorderStyle}">
                <StackPanel
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Orientation="Horizontal"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <c:Icon
                        x:Name="OptionIcon"
                        Width="{TemplateBinding IconSize}"
                        Height="{TemplateBinding IconSize}"
                        VerticalAlignment="Center"
                        Path="{TemplateBinding Icon}"
                        Color="{TemplateBinding Foreground}" />
                    <Border
                        x:Name="IconSpacing"
                        Width="8"
                        Style="{StaticResource BaseBorderStyle}" />
                    <ContentPresenter
                        x:Name="OptionContent"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                        Style="{StaticResource BaseContentPresenterStyle}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="SelectedMarker"
                Height="3"
                Margin="8,0,8,0"
                VerticalAlignment="Bottom"
                Background="{TemplateBinding Foreground}"
                IsHitTestVisible="False"
                Style="{StaticResource BaseBorderStyle}"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="OptionIcon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="OptionContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseSegmentedToggleOptionStyle}"
        TargetType="{x:Type c:SegmentedToggleOption}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="IconSize" Value="{StaticResource Size.Icon.Default}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate" Value="{StaticResource SegmentedToggleOptionContentTemplate}" />
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        <Setter Property="Template" Value="{StaticResource SegmentedToggleOptionTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Navy.Text}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Navy.Text}" />
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
