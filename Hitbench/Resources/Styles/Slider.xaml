<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls">
    <Style x:Key="BaseSliderStyle" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="OHsValueSliderTrackButtonTemplate" TargetType="RepeatButton">
        <Border
            Height="6"
            VerticalAlignment="Center"
            Background="{TemplateBinding Background}"
            CornerRadius="3" />
    </ControlTemplate>

    <ControlTemplate x:Key="OHsValueSliderThumbTemplate" TargetType="Thumb">
        <Ellipse
            Fill="{TemplateBinding Background}"
            Stroke="{TemplateBinding BorderBrush}"
            StrokeThickness="{TemplateBinding BorderThickness}" />
    </ControlTemplate>
    <Style
        x:Key="OHsValueSliderDecreaseStyle"
        BasedOn="{StaticResource BaseRepeatButtonStyle}"
        TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />

        <Setter Property="Template" Value="{StaticResource OHsValueSliderTrackButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsValueSliderIncreaseStyle"
        BasedOn="{StaticResource BaseRepeatButtonStyle}"
        TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />

        <Setter Property="Template" Value="{StaticResource OHsValueSliderTrackButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsValueSliderThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource OHsValueSliderThumbTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Hover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Pressed}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="OHsValueSliderTemplate" TargetType="customControls:ValueSlider">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="FocusBorder"
                Margin="1"
                Padding="3"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="10">
                <Track
                    x:Name="PART_Track"
                    IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                    Maximum="{TemplateBinding Maximum}"
                    Minimum="{TemplateBinding Minimum}"
                    Orientation="Horizontal"
                    Value="{TemplateBinding Value}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource OHsValueSliderDecreaseStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource OHsValueSliderIncreaseStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource OHsValueSliderThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Border>
            <TextBlock
                x:Name="DisplayText"
                Grid.Column="1"
                MinWidth="24"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Focusable="False"
                Foreground="{DynamicResource Brush.Text.Primary}"
                Style="{StaticResource BaseTextBlockStyle}"
                Text="{TemplateBinding DisplayText}"
                TextAlignment="Right" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ShowValueTag" Value="True">
                <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="DisplayText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        x:Key="BaseValueSliderStyle"
        BasedOn="{StaticResource BaseSliderStyle}"
        TargetType="customControls:ValueSlider">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Dense}" />
        <Setter Property="Template" Value="{StaticResource OHsValueSliderTemplate}" />
    </Style>

    <EllipseGeometry x:Key="OHsVolumeWheelFaceGeometry" Center="68,68" RadiusX="66" RadiusY="66" />
    <EllipseGeometry x:Key="OHsVolumeWheelTrackGeometry" Center="68,68" RadiusX="52" RadiusY="52" />
    <ControlTemplate x:Key="OHsVolumeWheelTemplate" TargetType="customControls:VolumeWheel">
        <ControlTemplate.Resources>
            <Style x:Key="OHsVolumeWheelLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
                <Setter Property="FontStyle" Value="Normal" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ControlTemplate.Resources>
        <Grid MinWidth="240" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" MinWidth="80" />
            </Grid.ColumnDefinitions>
            <Grid Width="136" Height="136" FlowDirection="LeftToRight" IsHitTestVisible="False">
                <Path x:Name="WheelBackground"
                      Data="{StaticResource OHsVolumeWheelFaceGeometry}" Stretch="None"
                      Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                <Path x:Name="WheelTrack"
                      Data="{StaticResource OHsVolumeWheelTrackGeometry}" Stretch="None"
                      Stroke="{DynamicResource Brush.Background.Deepened}" StrokeThickness="5" />
                <Path x:Name="WheelFill"
                      Data="{Binding FilledGeometry, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Stretch="None"
                      Stroke="{DynamicResource Brush.Navy}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="WheelIndicator"
                      Data="{Binding IndicatorGeometry, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Stretch="None"
                      Fill="{DynamicResource Brush.Text.Primary}" Stroke="{DynamicResource Brush.Background.Surface}" StrokeThickness="1"
                      Visibility="Hidden" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                           FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"
                           FontStyle="{TemplateBinding FontStyle}" FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding Foreground}" Style="{StaticResource BaseTextBlockStyle}"
                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={}{0:0}%}" />
            </Grid>
            <StackPanel x:Name="LabelHost" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Background.Surface}" IsHitTestVisible="False"
                        Style="{StaticResource BaseStackPanelStyle}">
                <TextBlock Style="{StaticResource OHsVolumeWheelLabelTextStyle}"
                           Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Label}" />
                <Border x:Name="ActiveUnderline" Height="3" Margin="0,6,0,0" Visibility="Hidden"
                        Background="{DynamicResource Brush.Navy}" Style="{StaticResource BaseBorderStyle}" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="WheelFill" Property="Stroke" Value="{DynamicResource Brush.Navy.Hover}" />
                <Setter TargetName="WheelIndicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="ActiveUnderline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="WheelBackground" Property="Fill" Value="{DynamicResource Brush.Background.Hover}" />
                <Setter TargetName="WheelBackground" Property="Stroke" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter TargetName="WheelFill" Property="Stroke" Value="{DynamicResource Brush.Navy.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="WheelBackground" Property="Fill" Value="{DynamicResource Brush.Background.Pressed}" />
                <Setter TargetName="WheelBackground" Property="Stroke" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter TargetName="WheelFill" Property="Stroke" Value="{DynamicResource Brush.Navy.Text}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="WheelBackground" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="WheelBackground" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="WheelTrack" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="WheelFill" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="WheelIndicator" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="WheelIndicator" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="LabelHost" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="ActiveUnderline" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        x:Key="BaseVolumeWheelStyle"
        BasedOn="{StaticResource BaseSliderStyle}"
        TargetType="customControls:VolumeWheel">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="Template" Value="{StaticResource OHsVolumeWheelTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
