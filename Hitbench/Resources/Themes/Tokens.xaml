<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Hitbench · theme-independent layout tokens ("Ink" v2)
        Merge once in App.xaml, before or after the theme dictionary. Values are DIPs.
        Use DynamicResource only where a value can change at runtime; StaticResource is fine here.
    -->

    <!-- Spacing scale -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>

    <Thickness x:Key="Inset.Card">16</Thickness>
    <Thickness x:Key="Inset.Field">12,0</Thickness>
    <Thickness x:Key="Inset.Button">16,0</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">16</CornerRadius>
    <CornerRadius x:Key="Radius.Node">4</CornerRadius>

    <!-- Height tiers -->
    <sys:Double x:Key="Size.Control.Primary">40</sys:Double>
    <sys:Double x:Key="Size.Control.Compact">32</sys:Double>
    <sys:Double x:Key="Size.Control.Dense">28</sys:Double>
    <sys:Double x:Key="Size.Control.Min">24</sys:Double>
    <sys:Double x:Key="Size.Icon.Default">16</sys:Double>
    <sys:Double x:Key="Size.Icon.Tool">18</sys:Double>
    <sys:Double x:Key="Size.MenuRow">36</sys:Double>
    <sys:Double x:Key="Size.Slider.Track">4</sys:Double>
    <sys:Double x:Key="Size.Slider.Thumb">16</sys:Double>

    <!-- Focus ring: 2 px ring, 2 px gap, drawn with Brush.Border.Focus -->
    <sys:Double x:Key="Focus.Thickness">2</sys:Double>
    <sys:Double x:Key="Focus.Gap">2</sys:Double>

    <!-- Type scale (Noto Sans) -->
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Title">14</sys:Double>
    <sys:Double x:Key="FontSize.Heading">18</sys:Double>
    <sys:Double x:Key="FontSize.Display">24</sys:Double>

    <!-- Disabled -->
    <sys:Double x:Key="Opacity.Disabled">0.4</sys:Double>
</ResourceDictionary>
