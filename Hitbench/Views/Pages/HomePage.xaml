<UserControl
    x:Class="Hitbench.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hitbench.Resources.Converters"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Hitbench.Views.Pages"
    MinWidth="638" MinHeight="260"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    PreviewKeyDown="OnHomePageKeyDown"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="R"
            Command="{Binding ReloadSongsCommand, Mode=OneWay}"
            Modifiers="Control" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <converters:OHsSameFolderConverter x:Key="OHsHomePageSameFolderConverter" />
        <ObjectDataProvider x:Key="OHsHomePageSource" />
        <Style
            x:Key="HomePageSearchInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="Padding" Value="32,0,24,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePageSongCaptionStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePageSearchPlaceholderStyle"
            BasedOn="{StaticResource CardLabelTextStyle}"
            TargetType="TextBlock">
            <!-- Search padding plus the input border and native TextBox text inset. -->
            <Setter Property="Margin" Value="35,0,27,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePageMapsetPlaceholderStyle"
            BasedOn="{StaticResource OHsHomePageSearchPlaceholderStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="Search mapsets" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SongSearchText, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageBodyStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BlurEffect x:Key="OHsHomeLoadingBlur" Radius="8"/>
        <Style
            x:Key="HomePagePanelStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:HomePage}, Mode=OneWay}" Value="True">
                    <Setter Property="Padding" Value="8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True"><Setter Property="Effect" Value="{StaticResource OHsHomeLoadingBlur}"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Effect" Value="{x:Null}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="HomePageProjectNameStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="HomePageSongArtworkStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{x:Null}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source, ElementName=SongArtwork, Mode=OneWay}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongBackgroundStyle"
            BasedOn="{StaticResource BaseImageStyle}"
            TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongArtistStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Artist, Mode=OneWay}" />

            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect
            x:Key="OHsHomePageSongCardGlowEffect"
            BlurRadius="16"
            Opacity="0.5"
            ShadowDepth="0"
            Color="{DynamicResource Color.Navy.Text}" />
        <Style
            x:Key="HomePageSongCardButtonStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Effect" Value="{StaticResource OHsHomePageSongCardGlowEffect}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Effect" Value="{StaticResource OHsHomePageSongCardGlowEffect}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                </MultiDataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource OHsHomePageSameFolderConverter}" Mode="OneWay">
                            <Binding Mode="OneWay" />
                            <Binding
                                Mode="OneWay"
                                Path="DataContext.SelectedMapset"
                                RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageSongTemplate">
            <Button
                AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
                Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource HomePageSongCardButtonStyle}">
                <Grid
                    x:Name="SongArtworkViewport"
                    SizeChanged="OnSongCardSizeChanged"
                    Style="{StaticResource HomePageSongArtworkStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image
                        x:Name="SongArtwork"
                        DataContextChanged="OnSongImageDataContextChanged"
                        Loaded="OnSongImageLoaded"
                        Style="{StaticResource HomePageSongBackgroundStyle}"
                        Unloaded="OnSongImageUnloaded" />
                    <Border Grid.Row="1" Style="{StaticResource OHsHomePageSongCaptionStyle}">
                        <StackPanel HorizontalAlignment="Stretch" IsHitTestVisible="False">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="Bold" FontFamily="{DynamicResource Bold}"
                                FontSize="{StaticResource FontSize.Title}"
                                Style="{StaticResource HomePageSongArtistStyle}"
                                Text="{Binding Title, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource HomePageSongArtistStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <Style
            x:Key="OHsHomePageMetadataStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="OHsHomePageChangedTimeStyle"
            BasedOn="{StaticResource OHsHomePageMetadataStyle}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastChangedLocalDateTime, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePageSelectedMapsetStyle"
            BasedOn="{StaticResource BaseStackPanelStyle}"
            TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMapset, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePageMenuTriggerStyle"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}"
            TargetType="customControls:BalloonComboBox">
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
        </Style>
        <Style
            x:Key="OHsHomePageProjectContentButtonStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="helpers:OHsFolderActionPresentation.IsPressOffsetEnabled" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Mode=OneWay}" />
                </MultiDataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Mode=OneWay}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsHomePagePinMenuItemStyle"
            BasedOn="{StaticResource OHsActionMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="Pin" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned, Mode=OneWay}" Value="True">
                    <Setter Property="Header" Value="Unpin" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu
            x:Key="OHsHomePageProjectMenu"
            x:Shared="False"
            Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem
                Command="{Binding DataContext.ToggleProjectPinCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource OHsHomePagePinMenuItemStyle}" />
            <MenuItem
                Command="{Binding DataContext.DeleteProjectCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Delete"
                Style="{StaticResource OHsDestructiveActionMenuItemStyle}" />
        </ContextMenu>
        <DataTemplate x:Key="OHsHomePageProjectHeadingTemplate">
            <TextBlock
                Margin="0,12,0,8"
                FontWeight="Bold" FontFamily="{DynamicResource Bold}"
                Style="{StaticResource OHsHomePageMetadataStyle}"
                Text="{Binding Mode=OneWay}" />
        </DataTemplate>
        <Style x:Key="OHsHomePageProjectCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.CanInteract, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Effect" Value="{StaticResource OHsHomePageSongCardGlowEffect}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.CanInteract, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Effect" Value="{StaticResource OHsHomePageSongCardGlowEffect}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsHomePageProjectRowTemplate">
            <Border
                Margin="0,0,0,8"
                Padding="8"
                Style="{StaticResource OHsHomePageProjectCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                        AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                        Command="{Binding DataContext.OpenProjectCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}"
                        CommandParameter="{Binding Mode=OneWay}"
                        Style="{StaticResource OHsHomePageProjectContentButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Margin="0,0,8,0">
                                <Image
                                    DataContextChanged="OnProjectImageDataContextChanged"
                                    Loaded="OnProjectImageLoaded"
                                    Style="{StaticResource HomePageSongBackgroundStyle}"
                                    Unloaded="OnProjectImageUnloaded" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BaseStackPanelStyle}">
                                <TextBlock Style="{StaticResource HomePageProjectNameStyle}" Text="{Binding Name, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource OHsHomePageMetadataStyle}" Text="{Binding MapsetName, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource OHsHomePageChangedTimeStyle}" Text="{Binding LastChangedLocalDateTime, Converter={StaticResource DateTimeToRelativeDateConverter}, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <customControls:BalloonComboBox
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Project actions"
                        ButtonIcon="{StaticResource BarsSolid}"
                        ContextMenu="{StaticResource OHsHomePageProjectMenu}"
                        IsEnabled="{Binding DataContext.CanInteract, Source={StaticResource OHsHomePageSource}, Mode=OneWay}"
                        Style="{StaticResource OHsHomePageMenuTriggerStyle}"
                        ToolTip="Project actions" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style
            x:Key="OHsHomePageProjectContentStyle"
            BasedOn="{StaticResource BaseContentControlStyle}"
            TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding Project, Mode=OneWay}" />
            <Setter Property="ContentTemplate" Value="{StaticResource OHsHomePageProjectRowTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeading, Mode=OneWay}" Value="True">
                    <Setter Property="Content" Value="{Binding Heading, Mode=OneWay}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource OHsHomePageProjectHeadingTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsHomePageProjectItemTemplate">
            <ContentControl Style="{StaticResource OHsHomePageProjectContentStyle}" />
        </DataTemplate>
        <Style
            x:Key="OHsHomePageProjectPlaceholderStyle"
            BasedOn="{StaticResource OHsHomePageSearchPlaceholderStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="Search all projects" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectSearchText, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="HomePageItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="HomePageSongsItemsPanel">
            <customControls:SpacedUniformGrid
                Columns="4"
                HorizontalGap="12"
                ItemHeight="108"
                ItemWidth="336"
                VerticalGap="12" />
        </ItemsPanelTemplate>

        <Style
            x:Key="HomePageRetryButtonStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="HomePageProjectsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetryProjects, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetrySongs, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomeInitialLoadingStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsLoadingStatusTextStyle}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsInitialLoading, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="OHsHomePageLayoutStyle" TargetType="Grid" BasedOn="{StaticResource BaseGridStyle}">
            <Setter Property="Margin" Value="12,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:HomePage}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="12,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomeProjectsPanelStyle" TargetType="Border" BasedOn="{StaticResource HomePagePanelStyle}">
            <Setter Property="Grid.Column" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:HomePage}, Mode=OneWay}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Margin" Value="4,8,4,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomeHeaderGroupStyle" TargetType="Grid" BasedOn="{StaticResource BaseGridStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:HomePage}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageLayout" Style="{StaticResource OHsHomePageLayoutStyle}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="SongsPanel"
            Grid.Column="0"
            Style="{StaticResource HomePagePanelStyle}">
            <Grid x:Name="SongsContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource OHsHomeHeaderGroupStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontWeight="Bold" FontFamily="{DynamicResource Bold}"
                        FontSize="{StaticResource FontSize.Title}"
                        Style="{StaticResource HomePageBodyStyle}"
                        Text="Mapsets" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource OHsHomePageMetadataStyle}"
                        Text="{Binding MapsetInventoryText, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="1" Style="{StaticResource OHsHomeHeaderGroupStyle}">
                    <TextBox
                        x:Name="SongSearchTextBox"
                        AutomationProperties.Name="Search mapsets"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        PreviewKeyDown="OnSongSearchKeyDown"
                        Style="{StaticResource HomePageSearchInputStyle}"
                        Text="{Binding SongSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <customControls:Icon
                        Width="16"
                        Height="16"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Path="{StaticResource MagnifyingGlass}"
                        Color="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Style="{StaticResource OHsHomePageMapsetPlaceholderStyle}" />
                    <TextBlock
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource OHsHomePageMetadataStyle}"
                        Text="/" />
                </Grid>
                <customControls:BalloonButton
                    x:Name="SongsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Refresh Songs"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Refresh Songs"
                    Command="{Binding RetrySongsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageSongsRetryStyle}" />
                <ItemsControl
                    x:Name="SongsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Songs"
                    ItemContainerStyle="{StaticResource BaseContentPresenterStyle}"
                    ItemTemplate="{StaticResource HomePageSongTemplate}"
                    ItemsPanel="{StaticResource HomePageSongsItemsPanel}"
                    ItemsSource="{Binding Songs, Mode=OneWay}"
                    Opacity="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    Style="{StaticResource BaseItemsControlStyle}"
                    Template="{StaticResource HomePageItemsTemplate}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
            </Grid>
        </Border>
        <Border Style="{StaticResource OHsHomeProjectsPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Style="{StaticResource OHsHomePageSelectedMapsetStyle}">
                    <TextBlock Style="{StaticResource OHsHomePageMetadataStyle}" Text="Selected mapset" />
                    <TextBlock
                        FontWeight="Bold" FontFamily="{DynamicResource Bold}"
                        Style="{StaticResource HomePageBodyStyle}"
                        Text="{Binding SelectedMapset.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <TextBox
                        x:Name="ProjectSearchTextBox"
                        AutomationProperties.Name="Search all projects"
                        IsEnabled="{Binding CanInteract, Mode=OneWay}"
                        Style="{StaticResource HomePageSearchInputStyle}"
                        Text="{Binding ProjectSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <customControls:Icon
                        Width="16"
                        Height="16"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Path="{StaticResource MagnifyingGlass}"
                        Color="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Style="{StaticResource OHsHomePageProjectPlaceholderStyle}" />
                </Grid>
                <customControls:BalloonButton
                    x:Name="ProjectsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Retry Projects"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Retry Projects"
                    Command="{Binding RetryProjectsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageProjectsRetryStyle}" />
                <ItemsControl
                    x:Name="ProjectsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Projects"
                    ItemContainerStyle="{StaticResource BaseContentPresenterStyle}"
                    ItemTemplate="{StaticResource OHsHomePageProjectItemTemplate}"
                    ItemsSource="{Binding ProjectItems, Mode=OneWay}"
                    Style="{StaticResource OHsVirtualizedDrawerItemsStyle}" />
            </Grid>
        </Border>
        <TextBlock x:Name="InitialLoadingText" Grid.ColumnSpan="2" Grid.RowSpan="2" Text="Loading projects..." Style="{StaticResource OHsHomeInitialLoadingStyle}"/>
    </Grid>
</UserControl>
