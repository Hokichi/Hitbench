<UserControl
    x:Class="Hitbench.Views.Pages.OHsWorkstationTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hitbench.Resources.Converters"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:Hitbench.Core.Entities;assembly=Hitbench.Core"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Hitbench.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>        <ControlTemplate x:Key="OHsWorkstationWaveformScrollTemplate" TargetType="ScrollViewer">
            <Border
                x:Name="WaveformBoundary"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
            </Border>
            <ControlTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="WaveformBoundary" Property="BorderBrush" Value="{DynamicResource Brush.Text.Secondary}" />
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationWaveformScrollStyle"
            BasedOn="{StaticResource BaseScrollViewerStyle}"
            TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationWaveformScrollTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

</UserControl.Resources>
 <Grid Style="{StaticResource BaseGridStyle}" FlowDirection="LeftToRight">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ScrollViewer
                                x:Name="WaveformScrollViewer" Height="{Binding WaveformHeight, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"

                                AutomationProperties.HelpText="Click to seek. In static marker mode, drag to move the tracks and seek. Left and Right move between subdivision lines. Control plus Left or Right moves between whole beats. Use wheel to scroll horizontally, Control plus wheel to zoom, or Control plus Alt plus wheel anywhere in the active Workstation to change subdivision."
                                AutomationProperties.Name="Audio waveform"
                                FlowDirection="LeftToRight"
                                Focusable="True"
                                IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                ScrollChanged="OnWaveformScrollChanged"
                                SizeChanged="OnWaveformViewportSizeChanged"
                                Style="{StaticResource OHsWorkstationWaveformScrollStyle}">
                                <Border x:Name="WaveformExtent" Style="{StaticResource BaseBorderStyle}" Background="Transparent" MouseLeftButtonDown="OnWaveformMouseLeftButtonDown">
                                <customControls:WaveformView
                                    x:Name="WaveformDisplay"
                                    Bpms="{Binding Project.BPMs, Mode=OneWay}"
                                    ControlPointTimestamps="{Binding ControlPointTimestamps, Mode=OneWay}"
                                    ControlPointBrush="{DynamicResource Brush.Success}"
                                    Data="{Binding Waveform, Mode=OneWay}"
                                    FontFamily="{DynamicResource Regular}"
                                    HorizontalOffset="{Binding TimelineHorizontalOffset, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
                                    IsPlaybackMarkerStatic="{Binding IsStaticMarker, Mode=OneWay}"
                                    MarkerBrush="{DynamicResource Brush.Playhead}"
                                    Offsets="{Binding Project.Offsets, Mode=OneWay}"
                                    Position="{Binding DisplayPosition, Mode=OneWay}"
                                    SeekCommand="{Binding SeekCommand, Mode=OneWay}"
                                    SizeChanged="OnWaveformDisplaySizeChanged"
                                    Subdivision="{Binding Subdivision, Mode=OneWay}"
                                    TextBrush="{DynamicResource Brush.Text.Secondary}"
                                    ViewportWidth="{Binding ElementName=WaveformScrollViewer, Path=ViewportWidth, Mode=OneWay}"
                                    WaveformBrush="{DynamicResource Brush.Waveform.Unplayed}"
                                    PlayedWaveformBrush="{DynamicResource Brush.Waveform.Played}"
                                    ZoomFactor="{Binding ZoomFactor, Mode=OneWay}" />
                                </Border>
                            </ScrollViewer>
  <pages:OHsControlPointLane x:Name="ControlPointLane" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left"
   FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
   Width="{Binding TimelineViewportWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
   State="{Binding ControlPointsState, Mode=OneWay}" PendingAdd="{Binding PendingControlPointAdd, Mode=OneWay}"
   Position="{Binding Position, Mode=OneWay}" IsPlaybackMarkerStatic="{Binding IsStaticMarker, Mode=OneWay}"
   HorizontalScrollPadding="{Binding TimelineEdgePadding, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
   PlaybackMarkerBrush="{DynamicResource Brush.Playhead}" PlaybackMarkerOutlineBrush="{DynamicResource Brush.Background.Deepened}"
   AddCommand="{Binding AddControlPointCommand, Mode=OneWay}" CommitAddCommand="{Binding CommitControlPointAddCommand, Mode=OneWay}"
   MovePointCommand="{Binding MoveControlPointCommand, Mode=OneWay}" SetPointCommand="{Binding SetControlPointCommand, Mode=OneWay}"
   SetPointDisabledCommand="{Binding SetControlPointDisabledCommand, Mode=OneWay}" SplitPointCommand="{Binding SplitControlPointCommand, Mode=OneWay}"
   DeletePointCommand="{Binding DeleteControlPointCommand, Mode=OneWay}" RetrySaveCommand="{Binding RetryControlPointsSaveCommand, Mode=OneWay}"
   OwnerError="{Binding ControlPointError, Mode=OneWay}" DurationMilliseconds="{Binding Waveform.Duration.TotalMilliseconds, Mode=OneWay, FallbackValue=0}"
   Offsets="{Binding Project.Offsets, Mode=OneWay}"
   Bpms="{Binding Project.BPMs, Mode=OneWay}" Subdivision="{Binding Subdivision, Mode=OneWay}"
   ContentWidth="{Binding TimelineContentWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
   ViewportWidth="{Binding TimelineViewportWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}"
   HorizontalOffset="{Binding TimelineHorizontalOffset, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTimeline}, Mode=OneWay}" />
 </Grid>
</UserControl>

