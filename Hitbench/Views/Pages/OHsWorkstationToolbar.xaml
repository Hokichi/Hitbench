<UserControl
    x:Class="Hitbench.Views.Pages.OHsWorkstationToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hitbench.Resources.Converters"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:Hitbench.Core.Entities;assembly=Hitbench.Core"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Hitbench.Views.Pages"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="OHsWorkstationHeaderCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShortLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True">
                    <Setter Property="Padding" Value="16,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTransportButtonStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationScrollWithMarkerStyle"
            BasedOn="{StaticResource {x:Type customControls:BalloonCheckBox}}"
            TargetType="customControls:BalloonCheckBox">
            <Setter Property="ButtonSize" Value="{StaticResource Size.Control.Primary}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="DefaultBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="CheckedBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="HoveredBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="StrokeThickness" Value="1" />
                </DataTrigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="StrokeThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationPlayPauseStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="AutomationProperties.Name" Value="Play audio" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Setter Property="ButtonText" Value="Play" />
            <Setter Property="ToolTip" Value="Play audio (Space)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Pause audio" />
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}" />
                    <Setter Property="ButtonText" Value="Pause" />
                    <Setter Property="ToolTip" Value="Pause audio (Space)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationSamplesActionStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ButtonIcon" Value="{StaticResource MusicNote}" />
            <Setter Property="ButtonText" Value="Samples" />
            <Setter Property="ToolTip" Value="Manage samples" />
            <Setter Property="AutomationProperties.ItemStatus" Value="Closed" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSamplesOpen, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource Close}" />
                    <Setter Property="ButtonText" Value="Close samples" />
                    <Setter Property="ToolTip" Value="Close samples" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Open" />
                    <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive}" />
                    <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive.Hovered}" />
                    <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive.Pressed}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Destructive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationAddActionStyle" BasedOn="{StaticResource BaseBalloonMenuStyle}" TargetType="customControls:BalloonMenu" />
        <Style x:Key="OHsWorkstationProjectActionsStyle" BasedOn="{StaticResource BaseBalloonMenuStyle}" TargetType="customControls:BalloonMenu">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationCollapseOptionStyle" BasedOn="{StaticResource BaseBalloonMenuOptionStyle}" TargetType="customControls:BalloonMenuOption">
            <Setter Property="ButtonText" Value="Collapse all tracks" />
            <Setter Property="ButtonIcon" Value="{StaticResource CompressAlt}" />
            <Setter Property="ToolTip" Value="Collapse all tracks (F4)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreTracksCollapsed, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonText" Value="Expand all tracks" />
                    <Setter Property="ButtonIcon" Value="{StaticResource ExpandAlt}" />
                    <Setter Property="ToolTip" Value="Expand all tracks (F4)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OHsWorkstationCompactSeparatorStyle" TargetType="Border" BasedOn="{StaticResource OHsWorkstationToolbarSeparatorStyle}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Compact}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationStopStyle" TargetType="customControls:BalloonButton" BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="OHsWorkstationFolderActionStyle" TargetType="customControls:BalloonMenu" BasedOn="{StaticResource OHsWorkstationProjectActionsStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="OHsWorkstationEditingModeStyle" TargetType="customControls:SegmentedToggleGroup" BasedOn="{StaticResource {x:Type customControls:SegmentedToggleGroup}}">
            <Setter Property="Width" Value="160" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True"><Setter Property="Width" Value="128" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationEditingOptionStyle" TargetType="customControls:SegmentedToggleOption" BasedOn="{StaticResource {x:Type customControls:SegmentedToggleOption}}">
            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" Value="True"><Setter Property="Padding" Value="8,6" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationMarkerModeStyle" TargetType="customControls:SegmentedToggleGroup" BasedOn="{StaticResource {x:Type customControls:SegmentedToggleGroup}}">
            <Setter Property="Width" Value="240" />
        </Style>
        <Style x:Key="OHsWorkstationMarkerOptionStyle" TargetType="customControls:SegmentedToggleOption" BasedOn="{StaticResource OHsWorkstationEditingOptionStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>
    </UserControl.Resources>
        <Border Style="{StaticResource OHsWorkstationHeaderCardStyle}">
            <Grid x:Name="ToolbarLayoutRoot">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel x:Name="TransportGroup" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="{Binding ActualWidth, ElementName=ToolbarLayoutRoot, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <customControls:BalloonButton
                            x:Name="PlayPauseButton"
                            Margin="0"
                            Command="{Binding PlayPauseCommand, Mode=OneWay}"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            Style="{StaticResource OHsWorkstationPlayPauseStyle}" />
                        <customControls:BalloonButton
                            AutomationProperties.Name="Stop audio"
                            ButtonIcon="{StaticResource MediaStop}"
                            ButtonText="Stop"
                            Command="{Binding StopCommand, Mode=OneWay}"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            Style="{StaticResource OHsWorkstationStopStyle}"
                            ToolTip="Stop audio and return to the beginning" />
                    </StackPanel>
                    <Border Style="{StaticResource OHsWorkstationCompactSeparatorStyle}" />
                    <customControls:BalloonCheckBox
                        x:Name="ScrollWithMarkerCheckBox"
                        AutomationProperties.HelpText="Follow the current playback marker. Selecting a node turns this off."
                        AutomationProperties.Name="Scroll with marker"
                        ButtonIcon="{StaticResource AlignArrowRightFill}"
                        ButtonText="Scroll with marker"
                        CheckedIcon="{StaticResource AlignArrowRightFill}"
                        IsChecked="{Binding ScrollWithMarker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanToggleScrollWithMarker, Mode=OneWay}"
                        Style="{StaticResource OHsWorkstationScrollWithMarkerStyle}"
                        ToolTip="Follow the current playback marker (F). Selecting a node turns this off." />
                    <Border Style="{StaticResource OHsWorkstationCompactSeparatorStyle}" />
                    <customControls:SegmentedToggleGroup
                        x:Name="EditingModeGroup"
                        Style="{StaticResource OHsWorkstationEditingModeStyle}"
                        Margin="0"
                        AutomationProperties.Name="Workstation editing mode"
                        IsEnabled="{Binding CanPlaceSamples, Mode=OneWay}"
                        SelectedValue="{Binding IsAdditionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <customControls:SegmentedToggleOption
                            x:Name="SelectionModeButton" Style="{StaticResource OHsWorkstationEditingOptionStyle}"
                            AutomationProperties.Name="Selection Mode"
                            Content="Select"
                            ToolTip="Select and move nodes (1)">
                            <customControls:SegmentedToggleOption.Value>
                                <sys:Boolean>False</sys:Boolean>
                            </customControls:SegmentedToggleOption.Value>
                        </customControls:SegmentedToggleOption>
                        <customControls:SegmentedToggleOption
                            x:Name="AdditionModeButton" Style="{StaticResource OHsWorkstationEditingOptionStyle}"
                            AutomationProperties.Name="Addition Mode"
                            Content="Draw"
                            ToolTip="Create nodes (2)">
                            <customControls:SegmentedToggleOption.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </customControls:SegmentedToggleOption.Value>
                        </customControls:SegmentedToggleOption>
                    </customControls:SegmentedToggleGroup>
                    <Border Style="{StaticResource OHsWorkstationCompactSeparatorStyle}" />
                    <customControls:SegmentedToggleGroup x:Name="MarkerModeGroup"
                        Style="{StaticResource OHsWorkstationMarkerModeStyle}"
                        AutomationProperties.Name="Playback marker mode" IsEnabled="{Binding CanPlay, Mode=OneWay}"
                        SelectedValue="{Binding IsStaticMarker, Mode=OneWay}" OptionSelected="OnMarkerModeSelected">
                        <customControls:SegmentedToggleOption Content="MarkerStatic" AutomationProperties.Name="Static playback marker"
                            Style="{StaticResource OHsWorkstationMarkerOptionStyle}" ToolTip="Keep playback marker centered and move tracks (F8)">
                            <customControls:SegmentedToggleOption.Value><sys:Boolean>True</sys:Boolean></customControls:SegmentedToggleOption.Value>
                        </customControls:SegmentedToggleOption>
                        <customControls:SegmentedToggleOption Content="MarkerDynamic" AutomationProperties.Name="Dynamic playback marker"
                            Style="{StaticResource OHsWorkstationMarkerOptionStyle}" ToolTip="Move playback marker across tracks (F8)">
                            <customControls:SegmentedToggleOption.Value><sys:Boolean>False</sys:Boolean></customControls:SegmentedToggleOption.Value>
                        </customControls:SegmentedToggleOption>
                    </customControls:SegmentedToggleGroup>
                </WrapPanel>
                <WrapPanel x:Name="ActionGroup" Orientation="Horizontal" MaxWidth="{Binding ActualWidth, ElementName=ToolbarLayoutRoot, Mode=OneWay}"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                    <customControls:BalloonMenu
                        x:Name="ProjectActionsButton"
                        AutomationProperties.Name="Project actions"
                        ButtonIcon="{StaticResource BarsSolid}"
                        ButtonText="Actions"
                        Style="{StaticResource OHsWorkstationProjectActionsStyle}"
                        ToolTip="Project actions">
                        <customControls:BalloonMenuOption ButtonText="Resnap" ButtonIcon="{StaticResource ResnapGrid}"
                            Command="{Binding ResnapAllSamplesCommand, Mode=OneWay}"
                            AutomationProperties.Name="Resnap all samples and control points"
                            AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            ToolTip="Resnap all samples and control points to the current beat subdivision, including instrumental notes" />
                        <customControls:BalloonMenuOption ButtonText="Import from mapset" ButtonIcon="{StaticResource Download}"
                            Command="{Binding ImportFromMapsetCommand, Mode=OneWay}" Style="{StaticResource BaseBalloonMenuOptionStyle}"
                            AutomationProperties.Name="Import from mapset" ToolTip="Import from mapset" />
                        <customControls:BalloonMenuOption ButtonText="Refresh samples" ButtonIcon="{StaticResource ArrowsRotateSolid}"
                            Command="{Binding ReloadSamplesCommand, Mode=OneWay}" ToolTip="Refresh project samples (F5)" />
                        <customControls:BalloonMenuOption Command="{Binding ToggleTracksCollapsedCommand, Mode=OneWay}"
                            Style="{StaticResource OHsWorkstationCollapseOptionStyle}" />
                        <customControls:BalloonMenuOption ButtonText="Config Hitnormal" ButtonIcon="{StaticResource MusicNote}"
                            Command="{Binding ConfigHitNormalCommand, Mode=OneWay}" Style="{StaticResource BaseBalloonMenuOptionStyle}"
                            AutomationProperties.Name="Config Hitnormal" ToolTip="Config Hitnormal" />
                        <customControls:BalloonMenuOption ButtonText="Export" ButtonIcon="{StaticResource Export}"
                            Command="{Binding ExportCommand, Mode=OneWay}" ToolTip="Export" />
                    </customControls:BalloonMenu>
                    <customControls:BalloonMenu
                        x:Name="OpenFoldersButton"
                        AutomationProperties.Name="Open folder"
                        ButtonIcon="{StaticResource Folder}"
                        ButtonText="Open"
                        Style="{StaticResource OHsWorkstationFolderActionStyle}"
                        ToolTip="Open folder">
                        <customControls:BalloonMenuOption ButtonText="Open beatmap folder" ButtonIcon="{StaticResource Folder}"
                            Command="{Binding OpenBeatmapFolderCommand, Mode=OneWay}" />
                        <customControls:BalloonMenuOption ButtonText="Open project folder" ButtonIcon="{StaticResource Folder}"
                            Command="{Binding OpenProjectFolderCommand, Mode=OneWay}" />
                    </customControls:BalloonMenu>
                    <Border Style="{StaticResource OHsWorkstationCompactSeparatorStyle}" />
                    <Grid Style="{StaticResource BaseGridStyle}" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <customControls:BalloonMenu
                            x:Name="AddMenuButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Add"
                            ButtonIcon="{StaticResource PlusSolid}"
                            ButtonText="Add"
                            Style="{StaticResource OHsWorkstationAddActionStyle}"
                            ToolTip="Add track">
                            <customControls:BalloonMenuOption ButtonText="Sample Track" ButtonIcon="{StaticResource MusicNotesPlusFill}"
                                AutomationProperties.Name="Add sample track" Command="{Binding AddSampleTrackCommand, Mode=OneWay}"
                                ToolTip="Add sample track (Ctrl+N)" />
                            <customControls:BalloonMenuOption ButtonText="Instrumental Track" ButtonIcon="{StaticResource KeyboardBoxFill}"
                                AutomationProperties.Name="Add instrumental track" Command="{Binding AddPianoTrackCommand, Mode=OneWay}"
                                ToolTip="Add instrumental track (Ctrl+Shift+N)" />
                        </customControls:BalloonMenu>
                        <customControls:BalloonButton
                            x:Name="ManageSamplesButton"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Samples"
                            Command="{Binding ManageSamplesCommand, Mode=OneWay}"
                            Style="{StaticResource OHsWorkstationSamplesActionStyle}" />
                    </Grid>
                    <Border Style="{StaticResource OHsWorkstationCompactSeparatorStyle}" />
                    <pages:OHsWorkstationFooter IsCompactLayout="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationToolbar}, Mode=OneWay}" x:Name="FooterControls" VerticalAlignment="Top" />
                </WrapPanel>
            </Grid>
        </Border>
</UserControl>
