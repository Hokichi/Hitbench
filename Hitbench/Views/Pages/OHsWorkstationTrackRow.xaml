<UserControl
    x:Class="Hitbench.Views.Pages.OHsWorkstationTrackRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hitbench.Resources.Converters"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:Hitbench.Core.Entities;assembly=Hitbench.Core"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Hitbench.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="OHsWorkstationTrackRowSource" />
        <Style x:Key="OHsDefaultTrackRowStyle" TargetType="pages:OHsWorkstationTrackRow" BasedOn="{StaticResource BaseControlStyle}"><Style.Triggers><Trigger Property="IsDefaultUnavailable" Value="True"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}"/></Trigger></Style.Triggers></Style>
        <Style x:Key="OHsWorkstationSampleChoiceStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource OHsComboBoxItemStyle}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsDefault, Mode=OneWay}" Value="True"/><Condition Binding="{Binding IsDefaultSampleAvailable, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="OHsWorkstationConfigSamplesMenuStyle" TargetType="MenuItem" BasedOn="{StaticResource OHsIconActionMenuItemStyle}"><Setter Property="Header" Value="Config Samples"/><Setter Property="Icon" Value="{StaticResource Cog}"/><Style.Triggers><DataTrigger Binding="{Binding IsInstrumentalTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>

        <Style
            x:Key="OHsWorkstationTrackVolumeTagBorderStyle"
            BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}"
            TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackVolumeTagTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsWorkstationTrackVolumeTagTemplate">
            <Border Style="{StaticResource OHsWorkstationTrackVolumeTagBorderStyle}">
                <TextBlock Style="{StaticResource OHsWorkstationTrackVolumeTagTextStyle}" Text="{Binding DisplayText, Mode=OneWay}" />
            </Border>
        </DataTemplate>


        <Style
            x:Key="OHsWorkstationInstrumentActionStyle"
            BasedOn="{StaticResource OHsBalloonSurfaceActionStyle}"
            TargetType="customControls:BalloonButton" />
        <Style
            x:Key="OHsWorkstationSampleTrackNameStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsEnabled" Value="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=customControls:OHsTrackIdentityButton}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackIdentityActionStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="customControls:OHsTrackIdentityButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackTagOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OHsInteractionHighlightBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Node}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=customControls:OHsTrackIdentityButton}, Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackColorSwatchStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Node}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationTrackIdentityContainerStyle" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackActionsStyle"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}"
            TargetType="customControls:BalloonComboBox">
            <Setter Property="ButtonIcon" Value="{StaticResource DotsThreeOutlineVerticalFill}" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <DataTemplate x:Key="OHsWorkstationSampleTrackNameTemplate">
            <Border Style="{StaticResource OHsWorkstationTrackIdentityContainerStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <customControls:OHsTrackIdentityButton
                        AutomationProperties.HelpText="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        AutomationProperties.Name="Change track name and color"
                        Click="OnTrackIdentityClick"
                        IsEnabled="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        PreviewMouseLeftButtonDown="OnTrackIdentityPointerDown"
                        Style="{StaticResource OHsWorkstationTrackIdentityActionStyle}"
                        ToolTip="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}">
                        <Grid Style="{StaticResource BaseGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="10"
                                Height="24"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Style="{StaticResource BaseGridStyle}">
                                <Border Background="{Binding TrackBrush, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Style="{StaticResource OHsWorkstationTrackColorSwatchStyle}" />
                                <Border Style="{StaticResource OHsWorkstationTrackTagOverlayStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="SampleTrackName"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource OHsWorkstationSampleTrackNameStyle}"
                                Text="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
                        </Grid>
                    </customControls:OHsTrackIdentityButton>
                    <customControls:BalloonComboBox Grid.Column="1"
                        AutomationProperties.Name="Track actions"
                        Loaded="OnActionMenuLoaded"
                        Style="{StaticResource OHsWorkstationTrackActionsStyle}"
                        ToolTip="Track actions" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style
            x:Key="OHsWorkstationNameHostStyle"
            BasedOn="{StaticResource BaseContentPresenterStyle}"
            TargetType="ContentPresenter">
            <Setter Property="ContentTemplate" Value="{StaticResource OHsWorkstationSampleTrackNameTemplate}" />
            <Setter Property="Grid.ColumnSpan" Value="7" />
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMetadataComboBoxStyle"
            BasedOn="{StaticResource OHsComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationInstrumentMutedActionStyle"
            BasedOn="{StaticResource OHsWorkstationInstrumentActionStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackMuted, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMenuItemStyle"
            BasedOn="{StaticResource OHsIconActionMenuItemStyle}"
            TargetType="MenuItem" />
        <Style
            x:Key="OHsWorkstationTrackDeleteMenuItemStyle"
            BasedOn="{StaticResource OHsDestructiveIconActionMenuItemStyle}"
            TargetType="MenuItem" />
        <Style
            x:Key="OHsWorkstationTrackCollapseMenuStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="Collapse track" />
            <Setter Property="Icon" Value="{StaticResource CompressAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Header" Value="Expand track" />
                    <Setter Property="Icon" Value="{StaticResource ExpandAlt}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsWorkstationSampleConfigurationFileTemplate">
            <TextBlock
                Style="{StaticResource BaseTextBlockStyle}"
                Text="{Binding DisplayName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DataTemplate>
        <Style
            x:Key="OHsWorkstationSampleConfigurationSurfaceStyle"
            BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}"
            TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationKeysMappingMenuItemStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstrumentalTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Command" Value="{Binding ViewModel.KeysMappingCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu
            x:Key="OHsWorkstationTrackActionMenu"
            x:Shared="False"
            Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem Style="{StaticResource OHsWorkstationConfigSamplesMenuStyle}" Click="OnConfigSampleClick" AutomationProperties.Name="Config Samples"/>
            <MenuItem
                Command="{Binding ViewModel.MoveTrackUpCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Move Up"
                Icon="{StaticResource AngleUp}"
                Style="{StaticResource OHsWorkstationTrackMenuItemStyle}" />
            <MenuItem
                Command="{Binding ViewModel.MoveTrackDownCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Move Down"
                Icon="{StaticResource AngleDown}"
                Style="{StaticResource OHsWorkstationTrackMenuItemStyle}" />
            <MenuItem
                Command="{Binding ViewModel.ToggleTrackCollapsedCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource OHsWorkstationTrackCollapseMenuStyle}" />
            <MenuItem
                Command="{Binding ViewModel.RemoveTrackCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Delete Track"
                Icon="{StaticResource Delete}"
                IsEnabled="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                Style="{StaticResource OHsWorkstationTrackDeleteMenuItemStyle}" />
            <MenuItem
                AutomationProperties.Name="Keys Mapping"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Keys Mapping"
                Icon="{StaticResource KeyboardBoxFill}"
                Style="{StaticResource OHsWorkstationKeysMappingMenuItemStyle}" />
        </ContextMenu>
        <BlurEffect x:Key="OHsWorkstationMissingBlur" Radius="4" />
        <Style
            x:Key="OHsWorkstationGridContentStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Effect" Value="{StaticResource OHsWorkstationMissingBlur}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMutedContentStyle"
            BasedOn="{StaticResource OHsWorkstationGridContentStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackMuted, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationCompactVolumeStyle"
            BasedOn="{StaticResource BaseValueSliderStyle}"
            TargetType="customControls:ValueSlider">
            <Setter Property="Height" Value="{StaticResource Size.Control.Primary}" />
        </Style>
        <Style
            x:Key="OHsWorkstationExpandedVolumeStyle"
            BasedOn="{StaticResource OHsWorkstationCompactVolumeStyle}"
            TargetType="customControls:ValueSlider">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationExpandedToggleStyle"
            BasedOn="{StaticResource OHsWorkstationTrackToggleStyle}"
            TargetType="ToggleButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationConfigSampleActionStyle"
            BasedOn="{StaticResource OHsBalloonSurfaceActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="IsEnabled" Value="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInstrumentalTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsWorkstationTrackLeftTemplate">
            <StackPanel
                x:Name="TrackLeftControls"
                Margin="0,8"
                VerticalAlignment="Center"
                Loaded="OnTrackControlStackLoaded"
                SizeChanged="OnTrackControlStackSizeChanged"
                Style="{StaticResource BaseStackPanelStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="40" SharedSizeGroup="OHsAuditionMute" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="40" SharedSizeGroup="OHsAuditionSolo" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Mode=OneWay}" Style="{StaticResource OHsWorkstationNameHostStyle}" />
                    <customControls:ValueSlider
                        x:Name="VolumeSlider"
                        Grid.Row="1"
                        Grid.ColumnSpan="7"
                        helpers:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="Track volume percent"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        DisplayText="{Binding ElementName=VolumeSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}%}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsEnabled="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        IsMoveToPointEnabled="True"
                        IsSnapToTickEnabled="True"
                        IsTabStop="True"
                        LargeChange="5"
                        Loaded="OnVolumeSliderLoaded"
                        Maximum="200"
                        Minimum="5"
                        ShowValueTag="True"
                        SmallChange="1"
                        Style="{StaticResource OHsWorkstationExpandedVolumeStyle}"
                        TickFrequency="1"
                        ToolTip="Track volume percent"
                        ValueChanged="OnVolumeValueChanged"
                        ValueTagTemplate="{StaticResource OHsWorkstationTrackVolumeTagTemplate}" />
                    <ToggleButton
                        x:Name="TrackMuteToggle"
                        Grid.Row="2"
                        Grid.Column="4"
                        AutomationProperties.Name="Mute track"
                        Checked="OnTrackAuditionChanged"
                        Content="M"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        Loaded="OnTrackAuditionLoaded"
                        Style="{StaticResource OHsWorkstationExpandedToggleStyle}"
                        ToolTip="Mute track"
                        Unchecked="OnTrackAuditionChanged" />
                    <ToggleButton
                        x:Name="TrackSoloToggle"
                        Grid.Row="2"
                        Grid.Column="6"
                        AutomationProperties.Name="Solo track"
                        Checked="OnTrackAuditionChanged"
                        Content="S"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding CanOperateTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        Loaded="OnTrackAuditionLoaded"
                        Style="{StaticResource OHsWorkstationExpandedToggleStyle}"
                        ToolTip="Solo track"
                        Unchecked="OnTrackAuditionChanged" />
                    <customControls:BalloonButton
                        x:Name="ConfigSampleAction"
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Config Sample"
                        ButtonIcon="{StaticResource Cog}"
                        ButtonText="Config Samples"
                        Click="OnConfigSampleClick"
                        Style="{StaticResource OHsWorkstationConfigSampleActionStyle}"
                        ToolTip="Config Sample" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OHsWorkstationSampleTrackTemplate">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackRow}, Mode=OneWay}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Content="{Binding Mode=OneWay}"
                    ContentTemplate="{StaticResource OHsWorkstationTrackLeftTemplate}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource Brush.Background.Deepened}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1,0"
                    Style="{StaticResource BaseBorderStyle}">
                    <Grid
                        x:Name="TrackGridHost"
                        DataContextChanged="OnTrackGridHostDataContextChanged"
                        Loaded="OnTrackGridHostLoaded"
                        Style="{StaticResource BaseGridStyle}">
                        <Grid x:Name="TrackGridContent" Style="{StaticResource OHsWorkstationTrackMutedContentStyle}">
                            <customControls:BeatGridView
                                IsPlaybackMarkerStatic="{Binding ViewModel.IsStaticMarker, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                Height="{Binding CurrentTrackExtent, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                AllowNodeCreation="{Binding ViewModel.CanCreateSampleNodes, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                AutomationProperties.HelpText="Use Left and Right to move playback. Enter places or selects a node. In Draw mode, a visible placement preview takes priority over selecting overlapping nodes, including Control+click. In Selection Mode, drag empty timeline space to select nodes across tracks. Control+click toggles selection when no placement preview applies. Control+Enter toggles selection. Drag nodes to move them; hold Control to duplicate, keeping originals visible. Press or release Control during a drag to switch between duplication and movement. Escape cancels an active drag and keeps selection; press Escape again to clear selection. Selecting nodes disables Scroll with marker. Delete removes selected nodes; Control+C copies and Control+V pastes on the selected track at the marker, preserving spacing and discarding nodes beyond the audio end. Pasting requires a selected sample track. Nodes use their destination track's sample. Alt+Left or Right moves selected nodes; Alt+Up or Down changes tracks."
                                AutomationProperties.Name="Track sample placement timeline"
                                Bpms="{Binding ViewModel.Project.BPMs, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                CanPlaceSamples="{Binding ViewModel.CanPlaceSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ContentWidth="{Binding TimelineContentWidth, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                FocusBrush="{DynamicResource Brush.Text.Primary}"
                                HorizontalOffset="{Binding TimelineHorizontalOffset, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                HoverBrush="{DynamicResource Brush.Background.Hover}"
                                IsNodeDragActive="{Binding ViewModel.IsNodeDragActive, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                IsNodeDragCopy="{Binding ViewModel.IsNodeDragCopy, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                KeyboardNavigation.IsTabStop="True"
                                MarkerBrush="{Binding TrackBrush, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                Offsets="{Binding ViewModel.Project.Offsets, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                PlaybackMarkerBrush="{DynamicResource Brush.Playhead}"
                                PlaybackMarkerOutlineBrush="{DynamicResource Brush.Background.Deepened}"
                                Position="{Binding ViewModel.Position, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                PressedBrush="{DynamicResource Brush.Navy}"
                                SamplePlacementRequested="OnSamplePlacementRequested"
                                SampleRemovalRequested="OnSampleRemovalRequested"
                                SampleSelectionRequested="OnSampleSelectionRequested"
                                Samples="{Binding Samples, Mode=OneWay}"
                                SamplesRevision="{Binding ViewModel.SamplesRevision, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                SelectedSamples="{Binding ViewModel.SelectedSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                SelectionBrush="{DynamicResource Brush.Navy}"
                                SelectionCueBrush="{DynamicResource Brush.Node.SelectedOutline}"
                                Subdivision="{Binding ViewModel.Subdivision, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ViewportWidth="{Binding TimelineViewportWidth, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ZoomFactor="{Binding ViewModel.ZoomFactor, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                Duration="{Binding ViewModel.Waveform.Duration, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OHsWorkstationInstrumentalTrackTemplate">
            <Grid Height="{Binding CurrentTrackExtent, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackRow}, Mode=OneWay}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Content="{Binding Mode=OneWay}"
                    ContentTemplate="{StaticResource OHsWorkstationTrackLeftTemplate}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <customControls:BalloonButton
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    helpers:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.HelpText="Map at least one key before opening the arrangement."
                    AutomationProperties.Name="View Arrangement"
                    ButtonIcon="{StaticResource Eye}"
                    ButtonText="View Arrangement"
                    Command="{Binding ViewModel.ViewArrangementCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    HasIcon="False"
                    IsTabStop="True"
                    ShouldShowText="True"
                    Style="{StaticResource OHsWorkstationInstrumentMutedActionStyle}"
                    ToolTip="Edit instrumental notes (map at least one key first)"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />

            </Grid>
        </DataTemplate>
        <helpers:WorkstationTrackTemplateSelector
            x:Key="OHsWorkstationTrackTemplateSelector"
            InstrumentalTrackTemplate="{StaticResource OHsWorkstationInstrumentalTrackTemplate}"
            SampleTrackTemplate="{StaticResource OHsWorkstationSampleTrackTemplate}" />
    </UserControl.Resources>
    <UserControl.Style><StaticResource ResourceKey="OHsDefaultTrackRowStyle"/></UserControl.Style>
    <Grid Style="{StaticResource BaseGridStyle}">
        <ContentPresenter
            x:Name="RowContent"
            Content="{Binding Track, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackRow}, Mode=OneWay}"
            ContentTemplateSelector="{StaticResource OHsWorkstationTrackTemplateSelector}" />
        <Popup
            x:Name="SampleConfigurationPopup"
            AllowsTransparency="True"
            Closed="OnSampleConfigurationClosed"
            Opened="OnSampleConfigurationOpened"
            Placement="Right"
            PopupAnimation="None"
            StaysOpen="False">
            <Border
                x:Name="SampleConfigurationContent"
                DataContext="{Binding Track, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                FlowDirection="{Binding FlowDirection, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                KeyboardNavigation.TabNavigation="Cycle"
                PreviewKeyDown="OnSampleConfigurationKeyDown"
                Style="{StaticResource OHsWorkstationSampleConfigurationSurfaceStyle}">
                <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                    <ComboBox
                        x:Name="TrackSampleFileSelector"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Track sample"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding ViewModel.CanSelectTrackSample, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        ItemTemplate="{StaticResource OHsWorkstationSampleConfigurationFileTemplate}"
                        ItemContainerStyle="{StaticResource OHsWorkstationSampleChoiceStyle}"
                        ItemsSource="{Binding ViewModel.TrackSampleChoices, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        Loaded="OnSampleSelectorLoaded"
                        SelectionChanged="OnSampleSelectionChanged"
                        Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                        ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                    <ComboBox
                        x:Name="TrackAdditionSelector"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Sampleset"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        ItemsSource="{x:Static entities:Track.AdditionOptions}"
                        Loaded="OnTrackMetadataSelectorLoaded"
                        SelectionChanged="OnTrackMetadataSelectionChanged"
                        Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                        ToolTip="Sampleset" />
                    <ComboBox
                        x:Name="TrackSampleTypeSelector"
                        AutomationProperties.Name="Track sample type"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        ItemsSource="{x:Static entities:Track.SampleTypeOptions}"
                        Loaded="OnTrackMetadataSelectorLoaded"
                        SelectionChanged="OnTrackMetadataSelectionChanged"
                        Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                        ToolTip="Track sample type" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
