<UserControl
    x:Class="Hitbench.Views.Pages.WorkstationPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hitbench.Resources.Converters"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:Hitbench.Core.Entities;assembly=Hitbench.Core"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Hitbench.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>










        <BlurEffect x:Key="OHsWorkstationLoadingBlurEffect" Radius="8" />
        <BlurEffect x:Key="OHsWorkstationVolumeBlurEffect" Radius="0" />
        <Style
            x:Key="OHsWorkstationContentStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVolumeOverlayOpen, ElementName=Page, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>








        <Style
            x:Key="OHsWorkstationWaveformScrollThumbStyle"
            BasedOn="{StaticResource RoundedHorizontalScrollThumbStyle}"
            TargetType="Thumb">
            <Setter Property="Height" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationWaveformScrollBarTemplate" TargetType="ScrollBar">
            <Grid x:Name="Root" Background="Transparent">
                <Border
                    x:Name="TrackBackground"
                    Height="16"
                    Margin="0,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Opacity="1" />
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageLeftCommand"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                            Style="{StaticResource BaseRepeatButtonStyle}"  Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource OHsWorkstationWaveformScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageRightCommand"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                            Style="{StaticResource BaseRepeatButtonStyle}"  Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationWaveformScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="ScrollBar">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationWaveformScrollBarTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanPlay, Mode=OneWay}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style
            x:Key="OHsWorkstationVolumeOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Style.Triggers>
                <Trigger Property="FlowDirection" Value="RightToLeft">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Trigger>
            </Style.Triggers>
        </Style>






        <Style
            x:Key="OHsWorkstationRetrySaveStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>












        <Style
            x:Key="OHsWorkstationLoadingOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LoadingStatusText, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>




</UserControl.Resources>
    <Grid Background="Transparent" Style="{StaticResource BaseGridStyle}">
        <Grid
            x:Name="WorkstationRoot"
            Margin="16,16,16,0"
            IsEnabled="{Binding IsWorkstationContentEnabled, Mode=OneWay}"
            SizeChanged="OnVolumeOverlayHostSizeChanged">
            <Grid x:Name="WorkstationContent" Style="{StaticResource OHsWorkstationContentStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <pages:OHsWorkstationAudioCard x:Name="AudioCard"
                    IsCompactLayout="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                    IsShortLayout="{Binding IsShortLayout, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                    TrackSideColumnWidth="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" TrackScrollBarGutter="{Binding TrackScrollBarGutter, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <customControls:BalloonButton
                        AutomationProperties.Name="Retry project save"
                        ButtonIcon="{StaticResource RegularRepeat}"
                        ButtonText="Retry save"
                        Command="{Binding RetrySaveCommand, Mode=OneWay}"
                        ShouldShowText="True"
                        Style="{StaticResource OHsWorkstationRetrySaveStyle}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    Margin="17,0,17,8"
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                        <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                        <ColumnDefinition Width="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                        <ColumnDefinition Width="{Binding TrackScrollBarGutter, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <ScrollBar
                        x:Name="WaveformScrollBar"
                        Grid.Column="2"
                        Margin="0"
                        AutomationProperties.HelpText="Use arrow keys, Page Up, Page Down, Home, or End to move through the waveform."
                        AutomationProperties.Name="Waveform horizontal position"
                        FlowDirection="LeftToRight"
                        Orientation="Horizontal"
                        SmallChange="16"
                        Style="{StaticResource OHsWorkstationWaveformScrollBarStyle}" />
                </Grid>
                <Border
                    x:Name="TracksCard"
                    Grid.Row="3"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <pages:OHsWorkstationTrackList TrackSideColumnWidth="{Binding TrackSideColumnWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" x:Name="TrackListComponent" Grid.Row="0"
 Timeline="{Binding Timeline, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
 TimelineContentWidth="{Binding TimelineContentWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
 TimelineViewportWidth="{Binding TimelineViewportWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
 TimelineHorizontalOffset="{Binding TimelineHorizontalOffset, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                    </Grid>
                </Border>

            </Grid>
            <Border
                x:Name="VolumeOverlay"
                Width="320"
                VerticalAlignment="Center"
                Panel.ZIndex="10"
                PreviewMouseMove="OnVolumeOverlayMouseMove"
                Style="{StaticResource OHsWorkstationVolumeOverlayStyle}"
                Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="VolumeWheelPanel"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BaseStackPanelStyle}">
                        <customControls:VolumeWheel
                            x:Name="SongVolumeWheel"
                            Label="Audio"
                            Margin="0,0,0,16"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            AutomationProperties.Name="Song volume"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource BaseVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding SongVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <customControls:VolumeWheel
                            x:Name="ApplicationVolumeWheel"
                            Label="Master"
                            Margin="0,0,0,16"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            AutomationProperties.Name="Application volume"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource BaseVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding ApplicationVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <customControls:VolumeWheel
                            x:Name="SamplesVolumeWheel"
                            Label="Samples"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            AutomationProperties.Name="Samples volume"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource BaseVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding SamplesVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border x:Name="LoadingOverlay" Style="{StaticResource OHsWorkstationLoadingOverlayStyle}"><TextBlock x:Name="LoadingStatus" Text="{Binding LoadingStatusText, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Style="{StaticResource OHsLoadingStatusTextStyle}"/></Border>
    </Grid>
</UserControl>

