<UserControl
    x:Class="Hitbench.Views.Popups.ManageSamplesDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    Style="{StaticResource BaseControlStyle}">
    <UserControl.Resources>
        <Style x:Key="OHsManageSamplesDragSourceStyle" TargetType="c:OHsSampleRow" BasedOn="{StaticResource BaseControlStyle}"><Style.Triggers><Trigger Property="IsDragSource" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger></Style.Triggers></Style>
        <Style x:Key="OHsManageSamplesDragTagSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
            <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsManageSamplesDragTagNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <DataTemplate x:Key="OHsManageSamplesDragTagTemplate"><Border Style="{StaticResource OHsManageSamplesDragTagSurfaceStyle}"><TextBlock Style="{StaticResource OHsManageSamplesDragTagNameStyle}" Text="{Binding SampleName,Mode=OneWay}"/></Border></DataTemplate>
        <DataTemplate x:Key="OHsManageSamplesSkinRowTemplate"><c:OHsSampleRow Style="{StaticResource BaseControlStyle}" FileName="{Binding FileName, Mode=OneWay}" FileToolTip="{Binding FileName, Mode=OneWay}" Waveform="{Binding Waveform, Mode=OneWay}" IsPlaying="{Binding IsPlaying, Mode=OneWay}" IsEnabled="{Binding IsInteractionEnabled, Mode=OneWay}" PlayCommand="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" PlayCommandParameter="{Binding Mode=OneWay}" WaveformRequested="OnSharedWaveformRequested"/></DataTemplate>
        <ObjectDataProvider x:Key="OHsManageSamplesOwner" />
        <Style x:Key="OHsManageSamplesPrimaryActionStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonDefaultActionStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorHostStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesActionStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>

        <Style x:Key="OHsManageSamplesMenuStyle" TargetType="c:BalloonComboBox" BasedOn="{StaticResource BaseBalloonComboBoxStyle}">
            <Setter Property="ButtonIcon" Value="{StaticResource BarsSolid}" />
            <Setter Property="ButtonText" Value="Actions" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
            <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Actions for {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Actions for {0}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsManageSamplesConfirmRenameStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsManageSamplesActionStyle}">
            <Setter Property="ButtonIcon" Value="{StaticResource Check}" />
            <Setter Property="ButtonText" Value="Confirm" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Confirm rename {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Confirm rename {0}}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsManageSamplesCreateTrackHeader"><StackPanel Orientation="Horizontal" Style="{StaticResource BaseStackPanelStyle}"><c:Icon Path="{StaticResource PlusSolid}" Color="{Binding Foreground,RelativeSource={RelativeSource AncestorType=MenuItem},Mode=OneWay}" Width="16" Height="16"/><TextBlock Text="{Binding Mode=OneWay}" Margin="8,0,0,0" Style="{StaticResource BodyTextStyle}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=MenuItem},Mode=OneWay}"/></StackPanel></DataTemplate>
        <ContextMenu x:Key="OHsManageSamplesRowMenu" x:Shared="False" Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem Header="Edit" Style="{StaticResource OHsActionMenuItemStyle}" Click="OnEditActionClick"
                Command="{Binding DataContext.EditCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}" AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Edit {0}}" />
            <MenuItem Header="Delete" Style="{StaticResource OHsDestructiveActionMenuItemStyle}"
                Command="{Binding DataContext.DeleteCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}" AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Delete {0}}" />
            <MenuItem Header="Save" Style="{StaticResource OHsActionMenuItemStyle}"
                Command="{Binding DataContext.SaveCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}" AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Save {0}}" />
            <MenuItem Header="Create track" HeaderTemplate="{StaticResource OHsManageSamplesCreateTrackHeader}" Style="{StaticResource OHsActionMenuItemStyle}" Command="{Binding DataContext.CreateTrackCommand,Source={StaticResource OHsManageSamplesOwner},Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" AutomationProperties.Name="{Binding FileName,Mode=OneWay,StringFormat=Create track with {0}}"></MenuItem>
        </ContextMenu>
<DataTemplate x:Key="OHsManageSamplesEditorTemplate"><Grid Grid.ColumnSpan="3" Margin="0,0,8,0" Style="{StaticResource OHsManageSamplesEditorHostStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox AutomationProperties.Name="Sample filename stem"
                            IsEnabled="{Binding DataContext.CanEditDraft, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                            IsVisibleChanged="OnEditorVisibilityChanged" PreviewKeyDown="OnEditorKeyDown"
                            Style="{StaticResource OHsManageSamplesEditorStyle}"
                            Text="{Binding DataContext.DraftStem, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{Binding Extension, Mode=OneWay}" />
                    </Grid></DataTemplate>
<DataTemplate x:Key="OHsManageSamplesActionsTemplate"><Grid Grid.Row="1" Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource BaseGridStyle}">
                        <c:BalloonComboBox ContextMenu="{StaticResource OHsManageSamplesRowMenu}" Style="{StaticResource OHsManageSamplesMenuStyle}" />
                        <c:BalloonButton Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                            Style="{StaticResource OHsManageSamplesConfirmRenameStyle}" />
                    </Grid></DataTemplate>
<DataTemplate x:Key="OHsManageSamplesRowTemplate"><c:OHsSampleRow Loaded="OnSampleDragRowLoaded" Unloaded="OnSampleDragRowUnloaded" DataContextChanged="OnSampleDragRowChanged" Style="{StaticResource OHsManageSamplesDragSourceStyle}" FileName="{Binding FileName, Mode=OneWay}" FileToolTip="{Binding FileName, Mode=OneWay}" Waveform="{Binding Waveform, Mode=OneWay}" IsPlaying="{Binding IsPlaying, Mode=OneWay}" IsEditing="{Binding IsEditing, Mode=OneWay}" IsEnabled="{Binding IsInteractionEnabled, Mode=OneWay}" PlayCommand="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" PlayCommandParameter="{Binding Mode=OneWay}" NameEditorTemplate="{StaticResource OHsManageSamplesEditorTemplate}" ActionsTemplate="{StaticResource OHsManageSamplesActionsTemplate}" WaveformRequested="OnSharedWaveformRequested"/></DataTemplate>

        <Style x:Key="OHsManageSamplesSurfaceStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}" />
    </UserControl.Resources>
    <Border Style="{StaticResource OHsManageSamplesSurfaceStyle}">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource OHsPopupTitleTextStyle}"
                    Text="Manage Samples" TextWrapping="Wrap" />
                <c:BalloonButton
                    x:Name="CloseDrawerButton"
                    Grid.Column="1"
                    h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.Name="Close Manage Samples"
                    ButtonIcon="{StaticResource Close}"
                    ButtonText="Close" ShouldShowText="False"
                    Click="OnCloseClick"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    IsEnabled="{Binding CanClose, Mode=OneWay}"
                    IsTabStop="True"
                    Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                    ToolTip="Close Manage Samples"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
            </Grid>
            <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="SkinSectionRow" Height="*"/><RowDefinition x:Name="ProjectSectionRow" Height="*"/></Grid.RowDefinitions>
                <CheckBox x:Name="AllowDefaultsCheckBox" Content="Allow skin's defaults" AutomationProperties.Name="Allow skin's defaults"
                          Style="{StaticResource RegularCheckBoxStyle}" Margin="0,0,0,8" MinHeight="40"
                          IsEnabled="{Binding CanChangeAllowDefaults, Mode=OneWay}" IsChecked="{Binding AllowDefaults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Expander x:Name="SkinDefaultsExpander" Grid.Row="1" Header="Skin Defaults" IsExpanded="True" Style="{StaticResource {x:Type Expander}}"
                          Expanded="OnSampleSectionChanged" Collapsed="OnSampleSectionChanged" AutomationProperties.Name="Skin Defaults">
                    <ItemsControl x:Name="SkinDefaultRows" ItemsSource="{Binding SkinDefaultEntries, Mode=OneWay}" ItemTemplate="{StaticResource OHsManageSamplesSkinRowTemplate}" Style="{StaticResource OHsVirtualizedDrawerItemsStyle}"/>
                </Expander>
                <Expander x:Name="ProjectSamplesExpander" Grid.Row="2" Header="Project Samples" IsExpanded="True" Style="{StaticResource {x:Type Expander}}"
                          Expanded="OnSampleSectionChanged" Collapsed="OnSampleSectionChanged" AutomationProperties.Name="Project Samples">
                    <ItemsControl x:Name="SampleRows" ItemsSource="{Binding Entries, Mode=OneWay}" ItemTemplate="{StaticResource OHsManageSamplesRowTemplate}" Style="{StaticResource OHsVirtualizedDrawerItemsStyle}"/>
                </Expander>
            </Grid>
            <Grid
                Grid.Row="3"
                Margin="0,16,0,0"
                Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:BalloonButton
                    x:Name="AddNewSampleButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Add new sample"
                    ButtonIcon="{StaticResource PlusSolid}"
                    ButtonSize="40"
                    ButtonText="Add sample"
                    Command="{Binding AddNewSampleCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource OHsManageSamplesPrimaryActionStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

