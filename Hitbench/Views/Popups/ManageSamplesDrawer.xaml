<UserControl
    x:Class="Hitbench.Views.Popups.ManageSamplesDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    Style="{StaticResource BaseControlStyle}">
    <UserControl.Resources>
        <Style
            x:Key="OHsManageSamplesEmptyTextStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, Mode=OneWay}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesItemsStyle"
            BasedOn="{StaticResource OHsVirtualizedDrawerItemsStyle}"
            TargetType="ItemsControl">
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesSkinExpanderStyle"
            BasedOn="{StaticResource {x:Type Expander}}"
            TargetType="Expander">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AllowDefaults, Mode=OneWay}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesDragSourceStyle"
            BasedOn="{StaticResource BaseControlStyle}"
            TargetType="c:OHsSampleRow">
            <Style.Triggers>
                <Trigger Property="IsDragSource" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesDragTagSurfaceStyle"
            BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}"
            TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesDragTagNameStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="OHsManageSamplesDragTagTemplate">
            <Border Style="{StaticResource OHsManageSamplesDragTagSurfaceStyle}">
                <TextBlock Style="{StaticResource OHsManageSamplesDragTagNameStyle}" Text="{Binding SampleName, Mode=OneWay}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OHsManageSamplesSkinRowTemplate">
            <c:OHsSampleRow
                FileName="{Binding DisplayFileName, Mode=OneWay}"
                FileToolTip="{Binding DisplayFileName, Mode=OneWay}"
                IsEnabled="{Binding IsInteractionEnabled, Mode=OneWay}"
                IsPlaying="{Binding IsPlaying, Mode=OneWay}"
                PlayCommand="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                PlayCommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource BaseControlStyle}"
                Waveform="{Binding Waveform, Mode=OneWay}"
                WaveformRequested="OnSharedWaveformRequested" />
        </DataTemplate>
        <ObjectDataProvider x:Key="OHsManageSamplesOwner" />
        <Style
            x:Key="OHsManageSamplesPrimaryActionStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorHostStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesActionStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>

        <Style
            x:Key="OHsManageSamplesMenuStyle"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}"
            TargetType="c:BalloonComboBox">
            <Setter Property="ButtonIcon" Value="{StaticResource BarsSolid}" />
            <Setter Property="ButtonText" Value="Actions" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
            <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Actions for {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Actions for {0}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesConfirmRenameStyle"
            BasedOn="{StaticResource OHsManageSamplesActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="ButtonIcon" Value="{StaticResource Check}" />
            <Setter Property="ButtonText" Value="Confirm" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Confirm rename {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Confirm rename {0}}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsManageSamplesCreateTrackHeader">
            <StackPanel Orientation="Horizontal" Style="{StaticResource BaseStackPanelStyle}">
                <c:Icon
                    Width="16"
                    Height="16"
                    Path="{StaticResource PlusSolid}"
                    Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}, Mode=OneWay}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}, Mode=OneWay}"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <ContextMenu
            x:Key="OHsManageSamplesRowMenu"
            x:Shared="False"
            Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem
                AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Edit {0}}"
                Click="OnEditActionClick"
                Command="{Binding DataContext.EditCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Edit"
                Style="{StaticResource OHsActionMenuItemStyle}" />
            <MenuItem
                AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Delete {0}}"
                Command="{Binding DataContext.DeleteCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Delete"
                Style="{StaticResource OHsDestructiveActionMenuItemStyle}" />
            <MenuItem
                AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Save {0}}"
                Command="{Binding DataContext.SaveCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Save"
                Style="{StaticResource OHsActionMenuItemStyle}" />
            <MenuItem
                AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Create track with {0}}"
                Command="{Binding DataContext.CreateTrackCommand, Source={StaticResource OHsManageSamplesOwner}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Create track"
                HeaderTemplate="{StaticResource OHsManageSamplesCreateTrackHeader}"
                Style="{StaticResource OHsActionMenuItemStyle}" />
        </ContextMenu>
        <DataTemplate x:Key="OHsManageSamplesEditorTemplate">
            <Grid
                Grid.ColumnSpan="3"
                Margin="0,0,8,0"
                Style="{StaticResource OHsManageSamplesEditorHostStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="Sample filename stem"
                    IsEnabled="{Binding DataContext.CanEditDraft, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                    IsVisibleChanged="OnEditorVisibilityChanged"
                    PreviewKeyDown="OnEditorKeyDown"
                    Style="{StaticResource OHsManageSamplesEditorStyle}"
                    Text="{Binding DataContext.DraftStem, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding Extension, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OHsManageSamplesActionsTemplate">
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Margin="4,0,0,0"
                Style="{StaticResource BaseGridStyle}">
                <c:BalloonComboBox ContextMenu="{StaticResource OHsManageSamplesRowMenu}" Style="{StaticResource OHsManageSamplesMenuStyle}" />
                <c:BalloonButton Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" Style="{StaticResource OHsManageSamplesConfirmRenameStyle}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OHsManageSamplesRowTemplate">
            <c:OHsSampleRow
                ActionsTemplate="{StaticResource OHsManageSamplesActionsTemplate}"
                DataContextChanged="OnSampleDragRowChanged"
                FileName="{Binding DisplayFileName, Mode=OneWay}"
                FileToolTip="{Binding DisplayFileName, Mode=OneWay}"
                IsEditing="{Binding IsEditing, Mode=OneWay}"
                IsEnabled="{Binding IsInteractionEnabled, Mode=OneWay}"
                IsPlaying="{Binding IsPlaying, Mode=OneWay}"
                Loaded="OnSampleDragRowLoaded"
                NameEditorTemplate="{StaticResource OHsManageSamplesEditorTemplate}"
                PlayCommand="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                PlayCommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource OHsManageSamplesDragSourceStyle}"
                Unloaded="OnSampleDragRowUnloaded"
                Waveform="{Binding Waveform, Mode=OneWay}"
                WaveformRequested="OnSharedWaveformRequested" />
        </DataTemplate>

        <Style
            x:Key="OHsManageSamplesSurfaceStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border" />
    </UserControl.Resources>
    <Border Style="{StaticResource OHsManageSamplesSurfaceStyle}">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource OHsPopupTitleTextStyle}"
                    Text="Manage Samples"
                    TextWrapping="Wrap" />
                <c:BalloonButton
                    x:Name="CloseDrawerButton"
                    Grid.Column="1"
                    h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.Name="Close Manage Samples"
                    ButtonIcon="{StaticResource Close}"
                    ButtonText="Close"
                    Click="OnCloseClick"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    IsEnabled="{Binding CanClose, Mode=OneWay}"
                    IsTabStop="True"
                    ShouldShowText="False"
                    Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                    ToolTip="Close Manage Samples"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
            </Grid>
            <StackPanel Grid.Row="1" Style="{StaticResource BaseStackPanelStyle}">
                <Expander
                    x:Name="SkinDefaultsExpander"
                    Grid.Row="0"
                    AutomationProperties.Name="Skin Defaults"
                    Header="Skin Defaults"
                    IsExpanded="True"
                    Style="{StaticResource OHsManageSamplesSkinExpanderStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <ItemsControl
                            x:Name="SkinDefaultRows"
                            ItemTemplate="{StaticResource OHsManageSamplesSkinRowTemplate}"
                            ItemsSource="{Binding SkinDefaultEntries, Mode=OneWay}"
                            Style="{StaticResource OHsManageSamplesItemsStyle}" />
                        <TextBlock
                            Margin="0,4"
                            DataContext="{Binding ElementName=SkinDefaultRows, Mode=OneWay}"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            Style="{StaticResource OHsManageSamplesEmptyTextStyle}"
                            Text="No samples found"
                            TextAlignment="Center" />
                    </Grid>
                </Expander>
                <Expander
                    x:Name="MapsetSamplesExpander"
                    Grid.Row="1"
                    AutomationProperties.Name="Mapset Samples"
                    Header="Mapset Samples"
                    IsExpanded="True"
                    Style="{StaticResource {x:Type Expander}}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <ItemsControl
                            x:Name="MapsetSampleRows"
                            ItemTemplate="{StaticResource OHsManageSamplesRowTemplate}"
                            ItemsSource="{Binding MapsetEntries, Mode=OneWay}"
                            Style="{StaticResource OHsManageSamplesItemsStyle}" />
                        <TextBlock
                            Margin="0,4"
                            DataContext="{Binding ElementName=MapsetSampleRows, Mode=OneWay}"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            Style="{StaticResource OHsManageSamplesEmptyTextStyle}"
                            Text="No samples found"
                            TextAlignment="Center" />
                    </Grid>
                </Expander>
                <Expander
                    x:Name="ProjectSamplesExpander"
                    Grid.Row="2"
                    AutomationProperties.Name="Project Samples"
                    Header="Project Samples"
                    IsExpanded="True"
                    Style="{StaticResource {x:Type Expander}}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <ItemsControl
                            x:Name="SampleRows"
                            ItemTemplate="{StaticResource OHsManageSamplesRowTemplate}"
                            ItemsSource="{Binding Entries, Mode=OneWay}"
                            Style="{StaticResource OHsManageSamplesItemsStyle}" />
                        <TextBlock
                            Margin="0,4"
                            DataContext="{Binding ElementName=SampleRows, Mode=OneWay}"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            Style="{StaticResource OHsManageSamplesEmptyTextStyle}"
                            Text="No samples found"
                            TextAlignment="Center" />
                    </Grid>
                </Expander>
            </StackPanel>
            <Grid
                Grid.Row="3"
                Margin="0,16,0,0"
                Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="AllowDefaultsCheckBox"
                    MinHeight="40"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Allow skin's defaults"
                    Content="Allow skin's defaults"
                    IsChecked="{Binding AllowDefaults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanChangeAllowDefaults, Mode=OneWay}"
                    Style="{StaticResource RegularCheckBoxStyle}" />
                <c:BalloonButton
                    x:Name="AddNewSampleButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Add new sample"
                    ButtonIcon="{StaticResource PlusSolid}"
                    ButtonSize="40"
                    ButtonText="Add sample"
                    Command="{Binding AddNewSampleCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource OHsManageSamplesPrimaryActionStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

