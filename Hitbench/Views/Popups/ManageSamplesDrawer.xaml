<UserControl
    x:Class="Hitbench.Views.Popups.ManageSamplesDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    Style="{StaticResource BaseControlStyle}">
    <UserControl.Resources>

        <Style
            x:Key="OHsManageSamplesNameStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorHostStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesEditorStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesActionStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>

        <Style
            x:Key="OHsManageSamplesPlayStyle"
            BasedOn="{StaticResource OHsManageSamplesActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Setter Property="ButtonText" Value="Play" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Play {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Play {0}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}" />
                    <Setter Property="ButtonText" Value="Pause" />
                    <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Pause {0}}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Pause {0}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsManageSamplesRowStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OHsManageSamplesSaveStyle"
            BasedOn="{StaticResource OHsBalloonConfirmActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="ButtonText" Value="Save" />
            <Setter Property="ButtonIcon" Value="{StaticResource Check}" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Save {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Save {0}}" />
        </Style>
        <Style
            x:Key="OHsManageSamplesEditStyle"
            BasedOn="{StaticResource OHsManageSamplesActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="ButtonText" Value="Edit" />
            <Setter Property="ButtonIcon" Value="{StaticResource Pen}" />
            <Setter Property="ToolTip" Value="{Binding FileName, Mode=OneWay, StringFormat=Edit {0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName, Mode=OneWay, StringFormat=Edit {0}}" />
        </Style>
        <DataTemplate x:Key="OHsManageSamplesRowTemplate">
            <Border IsEnabled="{Binding IsInteractionEnabled, Mode=OneWay}" Style="{StaticResource OHsManageSamplesRowStyle}">
                <Grid MinHeight="48" Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource OHsManageSamplesNameStyle}"
                        Text="{Binding FileName, Mode=OneWay}"
                        ToolTip="{Binding FileName, Mode=OneWay}" />
                    <Grid Margin="0,0,8,0" Style="{StaticResource OHsManageSamplesEditorHostStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="1"
                            AutomationProperties.Name="Sample filename stem"
                            IsEnabled="{Binding DataContext.CanEditDraft, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                            IsVisibleChanged="OnEditorVisibilityChanged"
                            PreviewKeyDown="OnEditorKeyDown"
                            Style="{StaticResource OHsManageSamplesEditorStyle}"
                            Text="{Binding DataContext.DraftStem, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding Extension, Mode=OneWay}" />
                    </Grid>
                    <c:WaveformView Grid.Column="1" Margin="8,4" Height="32" VerticalAlignment="Center" Data="{Binding Waveform, Mode=OneWay}" ShowPlaybackMarker="False" CenterWaveform="True" WaveformBrush="{DynamicResource Brush.Waveform.Unplayed}" Loaded="OnWaveformRowLoaded" DataContextChanged="OnWaveformRowChanged" IsHitTestVisible="False"/>
                    <c:BalloonButton
                        Grid.Column="2"
                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                        CommandParameter="{Binding Mode=OneWay}"
                        Style="{StaticResource OHsManageSamplesPlayStyle}" />
                    <c:BalloonButton
                        x:Name="EditAction"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Click="OnEditActionClick"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                        CommandParameter="{Binding Mode=OneWay}"
                        Style="{StaticResource OHsManageSamplesEditStyle}" />
                    <c:BalloonButton
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="{Binding FileName, Mode=OneWay, StringFormat=Delete {0}}"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonText="Delete"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                        CommandParameter="{Binding Mode=OneWay}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsTabStop="True"
                        Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                        ToolTip="{Binding FileName, Mode=OneWay, StringFormat=Delete {0}}"
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing, Mode=OneWay}" Value="True">
                    <Setter TargetName="EditAction" Property="Style" Value="{StaticResource OHsManageSamplesSaveStyle}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <Style x:Key="OHsManageSamplesSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}">
            <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource OHsManageSamplesSurfaceStyle}">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource OHsPopupTitleTextStyle}"
                    Text="Manage Samples" />
                <c:BalloonButton
                    x:Name="CloseDrawerButton"
                    Grid.Column="1"
                    h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.Name="Close Manage Samples"
                    ButtonIcon="{StaticResource Close}"
                    ButtonText="Close"
                    Click="OnCloseClick"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    IsEnabled="{Binding CanClose, Mode=OneWay}"
                    IsTabStop="True"
                    Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                    ToolTip="Close Manage Samples"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
            </Grid>
            <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                <ItemsControl
                    x:Name="SampleRows"
                    ItemTemplate="{StaticResource OHsManageSamplesRowTemplate}"
                    ItemsPanel="{StaticResource OHsVirtualizedDrawerItemsPanel}"
                    ItemsSource="{Binding Entries, Mode=OneWay}"
                    Style="{StaticResource BaseItemsControlStyle}"
                    Template="{StaticResource OHsVirtualizedDrawerItemsTemplate}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
            </Grid>
            <Grid
                Grid.Row="3"
                Margin="0,16,0,0"
                Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:BalloonButton
                    x:Name="AddNewSampleButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Add new sample"
                    ButtonIcon="{StaticResource PlusSolid}"
                    ButtonSize="40"
                    ButtonText="Add New Sample"
                    Command="{Binding AddNewSampleCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource OHsManageSamplesActionStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

