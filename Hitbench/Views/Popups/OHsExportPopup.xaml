<c:BasePopup
    x:Class="Hitbench.Views.Popups.OHsExportPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:d="clr-namespace:Hitbench.Resources.DataModels"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    PopupTitle="Export"
    ShowInTaskbar="False">
    <c:BasePopup.Resources>
        <Style
            x:Key="OHsExportDestinationGroupStyle"
            BasedOn="{StaticResource {x:Type c:SegmentedToggleGroup}}"
            TargetType="c:SegmentedToggleGroup">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        </Style>
        <Style
            x:Key="OHsExportDestinationOptionStyle"
            BasedOn="{StaticResource {x:Type c:SegmentedToggleOption}}"
            TargetType="c:SegmentedToggleOption">
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy.Text}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsExportNameInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNameError, Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding HasNameError, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsExportIndexInputStyle"
            BasedOn="{StaticResource {x:Type c:NumericUpDown}}"
            TargetType="c:NumericUpDown">
            <Setter Property="IsIntegerOnly" Value="True" />
            <Setter Property="LowerLimit" Value="1" />
            <Setter Property="UpperLimit" Value="999" />
            <Setter Property="Step" Value="1" />
        </Style>
        <Style
            x:Key="OHsExportFormatInputStyle"
            BasedOn="{StaticResource OHsComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style
            x:Key="OHsExportLabelStyle"
            BasedOn="{StaticResource FieldLabelTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsExportCheckTextStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsExportCheckContentTemplate">
            <TextBlock Style="{StaticResource OHsExportCheckTextStyle}" Text="{Binding Mode=OneWay}" />
        </DataTemplate>

        <Style
            x:Key="OHsExportShowFilesStyle"
            BasedOn="{StaticResource RegularCheckBoxStyle}"
            TargetType="CheckBox">

            <Setter Property="ContentTemplate" Value="{StaticResource OHsExportCheckContentTemplate}" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsExportProgressTemplate" TargetType="ProgressBar">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Style="{StaticResource BaseBorderStyle}">
                <Grid x:Name="PART_Track" Style="{StaticResource BaseGridStyle}">
                    <Border
                        x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        Style="{StaticResource BaseBorderStyle}" />
                </Grid>
            </Border>
        </ControlTemplate>
        <Style
            x:Key="OHsExportProgressStyle"
            BasedOn="{StaticResource BaseProgressBarStyle}"
            TargetType="ProgressBar">
            <Setter Property="Template" Value="{StaticResource OHsExportProgressTemplate}" />
            <Setter Property="Height" Value="{StaticResource Space.2}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </c:BasePopup.Resources>
    <Grid
        Width="600"
        Margin="24,8,24,24"
        Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource {x:Type ScrollViewer}}"
            VerticalScrollBarVisibility="Auto">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                    <TextBlock Style="{StaticResource OHsExportLabelStyle}" Text="Diff Name" />
                    <TextBox
                        x:Name="DiffNameInput"
                        AutomationProperties.Name="Diff Name"
                        Style="{StaticResource OHsExportNameInputStyle}"
                        Text="{Binding DiffName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                    <TextBlock Style="{StaticResource OHsExportLabelStyle}" Text="Starting sample count" />
                    <c:NumericUpDown
                        x:Name="StartingIndexInput"
                        AutomationProperties.Name="Starting custom sample index"
                        Style="{StaticResource OHsExportIndexInputStyle}"
                        Value="{Binding StartingIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Grid
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                        <TextBlock Style="{StaticResource OHsExportLabelStyle}" Text="Single sample format" />
                        <ComboBox
                            x:Name="SingleFormatInput"
                            AutomationProperties.Name="Single sample format"
                            ItemsSource="{Binding Formats, Mode=OneWay}"
                            SelectedItem="{Binding SingleFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource OHsExportFormatInputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                        <TextBlock Style="{StaticResource OHsExportLabelStyle}" Text="Mixed sample format" />
                        <ComboBox
                            x:Name="MixedFormatInput"
                            AutomationProperties.Name="Mixed sample format"
                            ItemsSource="{Binding Formats, Mode=OneWay}"
                            SelectedItem="{Binding MixedFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource OHsExportFormatInputStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <c:SegmentedToggleGroup
                        x:Name="DestinationInput"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Export destination"
                        IsEnabled="{Binding CanEditOptions, Mode=OneWay}"
                        SelectedValue="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource OHsExportDestinationGroupStyle}">
                        <c:SegmentedToggleOption
                            x:Name="ProjectDestinationInput"
                            AutomationProperties.Name="Project"
                            Content="Project"
                            Style="{StaticResource OHsExportDestinationOptionStyle}"
                            Value="{x:Static d:OHsExportDestination.Project}" />
                        <c:SegmentedToggleOption
                            x:Name="BeatmapDestinationInput"
                            AutomationProperties.Name="Beatmap"
                            Content="Beatmap"
                            Style="{StaticResource OHsExportDestinationOptionStyle}"
                            Value="{x:Static d:OHsExportDestination.Beatmap}" />
                    </c:SegmentedToggleGroup>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Style="{StaticResource BaseStackPanelStyle}">
                        <CheckBox
                            x:Name="OverwriteEverythingInput"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Overwrite everything"
                            Content="Overwrite everything"
                            IsChecked="{Binding OverwriteEverything, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanOverwriteEverything, Mode=OneWay}"
                            Style="{StaticResource OHsExportShowFilesStyle}" />
                        <CheckBox
                            x:Name="ShowFilesAfterExportInput"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Show files after export"
                            Content="Show files after export"
                            IsChecked="{Binding ShowFilesAfterExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEditOptions, Mode=OneWay}"
                            Style="{StaticResource OHsExportShowFilesStyle}" />
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
        <ProgressBar
            x:Name="ExportProgressBar"
            Grid.Row="1"
            Margin="0,16,0,0"
            AutomationProperties.HelpText="{Binding ProgressPhase, Mode=OneWay}"
            AutomationProperties.Name="Export progress"
            Maximum="100"
            Minimum="0"
            Style="{StaticResource OHsExportProgressStyle}"
            ToolTip="{Binding ProgressPhase, Mode=OneWay}"
            Value="{Binding ExportProgress, Mode=OneWay}" />
        <WrapPanel
            Grid.Row="2"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <c:BalloonButton
                x:Name="CancelButton"
                Margin="0,0,8,0"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Command="{Binding CancelCommand, Mode=OneWay}"
                IsTabStop="True"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}" />
            <c:BalloonButton
                x:Name="ExportButton"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                AutomationProperties.HelpText="{Binding ExportToolTip, Mode=OneWay}"
                AutomationProperties.Name="Export"
                ButtonIcon="{StaticResource Export}"
                ButtonText="Export"
                Command="{Binding ExportCommand, Mode=OneWay}"
                IsTabStop="True"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonConfirmActionStyle}"
                ToolTip="{Binding ExportToolTip, Mode=OneWay}"
                ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
        </WrapPanel>
    </Grid>
</c:BasePopup>
