<c:BasePopup x:Class="Hitbench.Views.Popups.OHsHitNormalPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    PopupTitle="Config Hitnormal" ShowInTaskbar="False" h:KeyboardNavigationPolicy.SuppressTabNavigation="True">
    <c:BasePopup.Resources>
        <DataTemplate x:Key="OHsHitNormalChoiceTemplate">
            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource BaseTextBlockStyle}"
                TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName, Mode=OneWay}"
                ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
        </DataTemplate>
        <Style x:Key="OHsHitNormalComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OHsComboBoxStyle}">
            <Setter Property="ItemsPanel" Value="{StaticResource OHsVirtualizedDrawerItemsPanel}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate" Value="{StaticResource OHsHitNormalChoiceTemplate}" />
            <Setter Property="SelectedValuePath" Value="Path" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style x:Key="OHsHitNormalLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="OHsHitNormalScrollStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </c:BasePopup.Resources>
    <ScrollViewer x:Name="ContentScroll" Style="{StaticResource OHsHitNormalScrollStyle}" h:KeyboardNavigationPolicy.SuppressTabNavigation="True">
        <Grid Margin="24,8,24,24" Style="{StaticResource BaseGridStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                <RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Normal" Style="{StaticResource OHsHitNormalLabelStyle}" />
            <ComboBox x:Name="NormalInput" Grid.Column="1" Style="{StaticResource OHsHitNormalComboBoxStyle}"
                AutomationProperties.Name="Normal" ItemsSource="{Binding Choices, Mode=OneWay}"
                SelectedValue="{Binding NormalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Normal (Alt+N)" />
            <TextBlock Grid.Row="2" Text="Soft" Style="{StaticResource OHsHitNormalLabelStyle}" />
            <ComboBox x:Name="SoftInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource OHsHitNormalComboBoxStyle}"
                AutomationProperties.Name="Soft" ItemsSource="{Binding Choices, Mode=OneWay}"
                SelectedValue="{Binding SoftPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Soft (Alt+S)" />
            <TextBlock Grid.Row="4" Text="Drum" Style="{StaticResource OHsHitNormalLabelStyle}" />
            <ComboBox x:Name="DrumInput" Grid.Row="4" Grid.Column="1" Style="{StaticResource OHsHitNormalComboBoxStyle}"
                AutomationProperties.Name="Drum" ItemsSource="{Binding Choices, Mode=OneWay}"
                SelectedValue="{Binding DrumPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Drum (Alt+D)" />
            <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                <c:BalloonButton x:Name="CancelAction" ButtonText="Cancel" ButtonIcon="{StaticResource Ban}" ShouldShowText="True"
                    Style="{StaticResource OHsBalloonDestructiveActionStyle}" AutomationProperties.Name="Cancel" ToolTip="Cancel (Esc, Alt+C)" Click="OnCancel" Margin="0,0,8,0" />
                <c:BalloonButton x:Name="SaveAction" ButtonText="Save" ButtonIcon="{StaticResource Check}" ShouldShowText="True"
                    Style="{StaticResource OHsBalloonConfirmActionStyle}" AutomationProperties.Name="Save" ToolTip="Save (Enter, Alt+V)"
                    IsEnabled="{Binding CanSave, Mode=OneWay}" Click="OnSave" />
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</c:BasePopup>
