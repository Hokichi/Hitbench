<UserControl x:Class="Hitbench.Views.Popups.OHsInstrumentalArrangementDrawer" x:Name="Drawer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Hitbench.Resources.CustomControls" xmlns:h="clr-namespace:Hitbench.Resources.Helpers">
    <UserControl.Resources>
        <Style x:Key="OHsArrangementCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <!-- The pitch scrollbar occupies the card's right inset, keeping the time viewport aligned with the waveform. -->
            <Setter Property="Padding" Value="16,16,0,16" />
        </Style>
        <Style x:Key="OHsArrangementMappingActionStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style x:Key="OHsArrangementExpansionStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
            <Setter Property="ButtonIcon" Value="{StaticResource AngleUp}" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ToolTip" Value="Expand piano roll (Ctrl+Shift+Enter)" />
            <Setter Property="AutomationProperties.Name" Value="Expand piano roll" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, ElementName=Drawer, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource AngleDown}" />
                    <Setter Property="ToolTip" Value="Restore tracks (Ctrl+Shift+Enter)" />
                    <Setter Property="AutomationProperties.Name" Value="Restore tracks" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource OHsArrangementCardStyle}">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,16,12" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PopupTitle,Mode=OneWay}" Style="{StaticResource OHsPopupTitleTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PopupTitle, Mode=OneWay}" />
                <c:BalloonButton x:Name="ExpansionButton" Grid.Column="1" Click="OnExpansionClick" Style="{StaticResource OHsArrangementExpansionStyle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource BaseStackPanelStyle}">
                    <c:BalloonButton x:Name="KeysMappingButton" ButtonText="Keys Mapping" ButtonIcon="{StaticResource KeyboardBoxFill}"
     Command="{Binding RequestKeysMappingCommand, Mode=OneWay}" Style="{StaticResource OHsArrangementMappingActionStyle}"
     AutomationProperties.Name="Keys Mapping" ToolTip="Map samples to instrument keys" />
                    <c:BalloonButton ButtonText="Close" ButtonIcon="{StaticResource Close}" Style="{StaticResource OHsBalloonDestructiveActionStyle}"
     Click="OnCloseClick" AutomationProperties.Name="Close arrangement" ToolTip="Close (Esc)" ShouldShowText="False" IsTabStop="True"
     h:KeyboardNavigationPolicy.AllowTabNavigation="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PianoArea" Grid.Row="1" Style="{StaticResource BaseGridStyle}" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:PianoRollView x:Name="PianoRoll" Style="{StaticResource BasePianoRollViewStyle}" Notes="{Binding Notes,Mode=OneWay}"
    HorizontalAlignment="Left" Width="{Binding PianoRollWidth,ElementName=Drawer,Mode=OneWay}"
    KeyColumnWidth="{Binding PianoKeyColumnWidth,ElementName=Drawer,Mode=OneWay}"
    SelectedNoteId="{Binding SelectedNoteId,Mode=OneWay}" SelectedNoteIds="{Binding SelectedNoteIds,Mode=OneWay}" IsAdditionMode="{Binding IsAdditionMode,Mode=OneWay}" LaneHeight="{Binding LaneHeight,Mode=OneWay}" NoteSelectionRequested="OnNoteSelection" Offsets="{Binding Offsets,Mode=OneWay}" Bpms="{Binding Bpms,Mode=OneWay}"
    Subdivision="{Binding Subdivision,Mode=OneWay}" Duration="{Binding Duration,Mode=OneWay}" Position="{Binding Position,Mode=OneWay}" ZoomFactor="{Binding ZoomFactor,Mode=OneWay}"
    ContentWidth="{Binding TimelineContentWidth,ElementName=Drawer,Mode=OneWay}" ViewportWidth="{Binding TimelineViewportWidth,ElementName=Drawer,Mode=OneWay}"
    HorizontalOffset="{Binding TimelineHorizontalOffset,ElementName=Drawer,Mode=OneWay}"
    CanEdit="{Binding CanEdit,Mode=OneWay}" IsEnabled="{Binding CanEdit,Mode=OneWay}" NoteEditRequested="OnNoteEdit"
    AutomationProperties.Name="Instrumental piano roll" AutomationProperties.HelpText="Arrows navigate keys and beats. Enter places or selects a note. Delete removes the selected note. Alt+arrows move notes. Right click removes a note. Escape cancels drag, clears selection, then closes. Space plays or pauses; Shift+Space stops." Background="{DynamicResource Brush.Background.Deepened}" Foreground="{DynamicResource Brush.Text.Primary}" TrackColor="{Binding TrackColor, Mode=OneWay}" TrackColorIndex="{Binding TrackColorIndex, Mode=OneWay}" SelectionBrush="{DynamicResource Brush.Navy}" SelectionCueBrush="{DynamicResource Brush.Node.SelectedOutline}" PressedBrush="{DynamicResource Brush.Navy}" HoverBrush="{DynamicResource Brush.Background.Hover}" NodeBorderBrush="{DynamicResource Brush.Border.Default}" PlaybackMarkerBrush="{DynamicResource Brush.Playhead}" />
                <ScrollBar x:Name="PitchScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{Binding MaximumVerticalOffset,ElementName=PianoRoll,Mode=OneWay}" ViewportSize="{Binding ActualHeight,ElementName=PianoRoll,Mode=OneWay}"
    Value="{Binding VerticalOffset,ElementName=PianoRoll,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SmallChange="36" LargeChange="180" AutomationProperties.Name="Piano pitch position" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
