<UserControl
    x:Class="Hitbench.Views.Popups.OHsKeysMappingDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:popups="clr-namespace:Hitbench.Views.Popups">
    <UserControl.Resources>
        <SolidColorBrush
            x:Key="OHsKeysUnmappedOverlayBrush"
            Opacity="0.35"
            Color="{DynamicResource Color.Shadow}" />
        <Style
            x:Key="OHsKeysSelectedOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OHsInteractionHighlightBrush}" />
            <Setter Property="Opacity" Value="0.25" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ThemeService.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, FallbackValue=False}" Value="True">
                    <Setter Property="Opacity" Value="0.1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsKeysSelectedKeyTextStyle"
            BasedOn="{StaticResource OHsPopupTitleTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        </Style>

        <Style
            x:Key="OHsKeysInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="OHsKeysKeyboardItemsPanel">
            <popups:OHsKeysMappingPianoPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="OHsKeysKeyboardTemplate" TargetType="ListBox">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Style="{StaticResource BaseBorderStyle}">
                <ScrollViewer
                    x:Name="PianoScrollViewer"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    ScrollChanged="OnPianoScrollChanged"
                    Style="{StaticResource {x:Type ScrollViewer}}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                </ScrollViewer>
            </Border>
        </ControlTemplate>
        <Style
            x:Key="OHsKeysKeyboardStyle"
            BasedOn="{StaticResource BaseListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource OHsKeysKeyboardTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource OHsKeysKeyboardItemsPanel}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        </Style>
        <ControlTemplate x:Key="OHsKeysKeyboardItemTemplate" TargetType="ListBoxItem">
            <Border
                x:Name="KeySurface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="0,0,4,4"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Border
                        x:Name="UnmappedOverlay"
                        Background="{StaticResource OHsKeysUnmappedOverlayBrush}"
                        CornerRadius="0,0,4,4"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Style="{StaticResource BaseBorderStyle}"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="SelectedOverlay"
                        CornerRadius="0,0,4,4"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Style="{StaticResource OHsKeysSelectedOverlayStyle}"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMapped, Mode=OneWay}" Value="False">
                    <Setter TargetName="UnmappedOverlay" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="SelectedOverlay" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter TargetName="UnmappedOverlay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SelectedOverlay" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter TargetName="SelectedOverlay" Property="Opacity" Value="1" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsKeysKeyboardItemStyle"
            BasedOn="{StaticResource BaseListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Template" Value="{StaticResource OHsKeysKeyboardItemTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,20,4,8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Key, Mode=OneWay}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding MappingStatus, Mode=OneWay}" />
            <Setter Property="ToolTip" Value="{Binding MappingStatus, Mode=OneWay}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSharp, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
                    <Setter Property="Padding" Value="0,20,0,8" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseCaptureWithin" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}" />
                </MultiTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsKeysKeyboardContentTemplate">
            <TextBlock
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                Style="{StaticResource BodyTextStyle}"
                Text="{Binding KeyboardLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorderStyle}">
        <ScrollViewer
            AutomationProperties.Name="Key mapping controls"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource {x:Type ScrollViewer}}"
            VerticalScrollBarVisibility="Auto">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4" Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="0,0,24,8"
                        VerticalAlignment="Center"
                        Style="{StaticResource BaseStackPanelStyle}">
                        <TextBlock Style="{StaticResource OHsPopupTitleTextStyle}" Text="Keys Mapping" />
                        <TextBlock
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding TrackName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <c:BalloonButton
                            x:Name="LoadAction"
                            Margin="0,0,8,8"
                            h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                            AutomationProperties.HelpText="Choose a folder of note-named audio files. Conflicts can be reviewed before importing."
                            AutomationProperties.Name="Import key mappings from folder"
                            ButtonIcon="{StaticResource PlusSolid}"
                            ButtonText="Load Samples Folder"
                            Command="{Binding OpenFolderCommand, Mode=OneWay}"
                            FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                            IsTabStop="True"
                            ShouldShowText="True"
                            Style="{StaticResource OHsBalloonNeutralActionStyle}"
                            ToolTip="Import key mappings from folder"
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                        <c:BalloonButton
                            x:Name="ClearAllMappingsAction"
                            Margin="0,0,8,8"
                            h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                            AutomationProperties.Name="Clear all key mappings"
                            ButtonIcon="{StaticResource Delete}"
                            ButtonText="Clear All Mappings"
                            Command="{Binding ClearAllMappingsCommand, Mode=OneWay}"
                            FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                            IsTabStop="True"
                            ShouldShowText="True"
                            Style="{StaticResource OHsBalloonDestructiveActionStyle}" />
                        <c:BalloonButton
                            Margin="0,0,0,8"
                            h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                            AutomationProperties.Name="Close Keys Mapping"
                            ButtonIcon="{StaticResource Close}"
                            ButtonText="Close"
                            Click="OnCloseClick"
                            FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                            IsEnabled="{Binding CanClose, Mode=OneWay}"
                            IsTabStop="True"
                            ShouldShowText="True"
                            Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                            ToolTip="Close (Esc)"
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                    </WrapPanel>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Width="60"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource OHsKeysSelectedKeyTextStyle}"
                        Text="{Binding SelectedEntry.Key, Mode=OneWay}" />
                    <TextBox
                        Grid.Column="1"
                        AutomationProperties.Name="Selected key sample path"
                        DataContext="{Binding SelectedEntry, Mode=OneWay}"
                        IsEnabled="{Binding DataContext.CanEditSelectedMapping, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                        LostKeyboardFocus="OnMappingLostFocus"
                        PreviewKeyDown="OnMappingKeyDown"
                        Style="{StaticResource OHsKeysInputStyle}"
                        Text="{Binding DraftFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <c:BalloonButton
                        x:Name="LoadSelectedSampleAction"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="Load sample for selected key"
                        ButtonIcon="{StaticResource DotsThreeOutlineFill}"
                        ButtonText="Load Sample"
                        Command="{Binding LoadSelectedCommand, Mode=OneWay}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsTabStop="True"
                        ShouldShowText="False"
                        Style="{StaticResource OHsBalloonNeutralActionStyle}"
                        ToolTip="Load sample for selected key"
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                    <c:BalloonButton
                        x:Name="DeleteSelectedMappingAction"
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="Unmap selected key"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonText="Delete"
                        Command="{Binding DeleteSelectedCommand, Mode=OneWay}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsTabStop="True"
                        ShouldShowText="false"
                        Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                        ToolTip="Unmap selected key"
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                </Grid>
                <ListBox
                    x:Name="KeySelector"
                    Grid.Row="2"
                    AutomationProperties.Name="Piano key mapping selector"
                    IsEnabled="{Binding CanEditMapping, Mode=OneWay}"
                    IsSynchronizedWithCurrentItem="False"
                    ItemContainerStyle="{StaticResource OHsKeysKeyboardItemStyle}"
                    ItemTemplate="{StaticResource OHsKeysKeyboardContentTemplate}"
                    ItemsSource="{Binding Rows, Mode=OneWay}"
                    PreviewKeyDown="OnPianoKeyDown"
                    PreviewMouseLeftButtonDown="OnPianoKeyMouseDown"
                    PreviewMouseLeftButtonUp="OnPianoKeyMouseUp"
                    SelectedValue="{Binding SelectedEntry.Key, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Key"
                    SelectionChanged="OnKeySelectionChanged"
                    Style="{StaticResource OHsKeysKeyboardStyle}" />
                <ScrollBar
                    x:Name="PianoScrollBar"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Piano key position"
                    IsEnabled="{Binding CanEditMapping, Mode=OneWay}"
                    Orientation="Horizontal"
                    Scroll="OnPianoScroll" />
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>