<c:BasePopup x:Class="Hitbench.Views.Popups.OHsMappingConflictsPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Hitbench.Resources.CustomControls" xmlns:h="clr-namespace:Hitbench.Resources.Helpers" PopupTitle="Mapping conflicts found" SizeToContent="Manual" ShowInTaskbar="False" ShowCloseButton="False">
    <c:BasePopup.Resources>

        <DataTemplate x:Key="OHsMappingConflictChoiceContent">
            <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                <TextBlock Text="{Binding FileName,Mode=OneWay}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=CheckBox},Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontFamily="{DynamicResource Bold}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="OHsMappingConflictChoiceStyle" TargetType="CheckBox" BasedOn="{StaticResource RegularCheckBoxStyle}">

            <Setter Property="ContentTemplate" Value="{StaticResource OHsMappingConflictChoiceContent}" />
            <Setter Property="Content" Value="{Binding Mode=OneWay}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName,Mode=OneWay}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Style.Triggers>

                <DataTrigger Binding="{Binding IsMissing,Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsMappingConflictChoiceItem">
            <CheckBox Style="{StaticResource OHsMappingConflictChoiceStyle}" />
        </DataTemplate>
        <DataTemplate x:Key="OHsMappingConflictRowTemplate">
            <Grid Margin="0,0,0,16" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key,Mode=OneWay}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Top" Margin="0,8,8,0" FontWeight="Bold" FontFamily="{DynamicResource Bold}" />
                <StackPanel Grid.Column="1" Style="{StaticResource BaseStackPanelStyle}">
                    <ItemsControl ItemsSource="{Binding ExistingChoices,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictChoiceItem}" Style="{StaticResource BaseItemsControlStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource BaseStackPanelStyle}">
                    <ItemsControl ItemsSource="{Binding IncomingChoices,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictChoiceItem}" Style="{StaticResource BaseItemsControlStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </c:BasePopup.Resources>
    <Grid Margin="24,0,24,8" Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl x:Name="ConflictRows" Grid.Row="1" ItemsSource="{Binding Rows,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictRowTemplate}" Style="{StaticResource BaseItemsControlStyle}" Template="{StaticResource OHsVirtualizedDrawerItemsTemplate}" ItemsPanel="{StaticResource OHsVirtualizedDrawerItemsPanel}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
        <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <c:BalloonButton ButtonText="Cancel" AutomationProperties.Name="Cancel folder import" ToolTip="Cancel folder import (Esc)" Click="OnCancel" Style="{StaticResource OHsBalloonDestructiveActionStyle}" Margin="0,0,8,0" ButtonIcon="{StaticResource Close}" ShouldShowText="True" h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <c:BalloonButton x:Name="ConfirmButton" ButtonText="Apply mappings" AutomationProperties.Name="Accept mapping choices" ToolTip="Accept mapping choices (Enter)" Click="OnConfirm" IsEnabled="{Binding CanConfirm,Mode=OneWay}" Style="{StaticResource OHsBalloonConfirmActionStyle}" ButtonIcon="{StaticResource Check}" ShouldShowText="True" h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        </WrapPanel>
    </Grid>
</c:BasePopup>
