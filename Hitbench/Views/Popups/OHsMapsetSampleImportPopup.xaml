<c:BasePopup
    x:Class="Hitbench.Views.Popups.OHsMapsetSampleImportPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    PopupTitle="Import from mapset"
    ShowCloseButton="False"
    SizeToContent="Manual">
    <c:BasePopup.Resources>
        <Style
            x:Key="OHsMapsetImportCheckStyle"
            BasedOn="{StaticResource RegularCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicate, Mode=OneWay}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Duplicated" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMapsetImportDuplicateTextStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicate, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsMapsetImportFilenameTemplate">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding FileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource OHsMapsetImportDuplicateTextStyle}"
                    Text="Duplicated" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OHsMapsetImportEntryTemplate">
            <CheckBox
                AutomationProperties.Name="{Binding FileName, Mode=OneWay}"
                Content="{Binding Mode=OneWay}"
                ContentTemplate="{StaticResource OHsMapsetImportFilenameTemplate}"
                IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource OHsMapsetImportCheckStyle}"
                ToolTip="{Binding SourcePath, Mode=OneWay}"
                ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
        </DataTemplate>
    </c:BasePopup.Resources>
    <Grid Margin="16,0" Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding PromptText, Mode=OneWay}" />
        <Expander
            x:Name="SamplesExpander"
            Grid.Row="1"
            Margin="0,8"
            AutomationProperties.Name="Mapset Samples"
            Header="Mapset Samples"
            Style="{StaticResource {x:Type Expander}}">
            <ItemsControl
                x:Name="FileList"
                AutomationProperties.Name="Mapset samples to import"
                ItemTemplate="{StaticResource OHsMapsetImportEntryTemplate}"
                ItemsSource="{Binding Entries, Mode=OneWay}"
                Style="{StaticResource OHsVirtualizedDrawerItemsStyle}" />
        </Expander>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <c:BalloonButton
                x:Name="NoAction"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                AutomationProperties.Name="Do not import mapset samples"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="No"
                Click="OnNo"
                IsTabStop="True"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonNavInfoActionStyle}" />
            <c:BalloonButton
                x:Name="YesAction"
                Margin="8,0,0,0"
                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                AutomationProperties.Name="Import checked mapset samples"
                ButtonIcon="{StaticResource Check}"
                ButtonText="Yes"
                Click="OnYes"
                IsEnabled="{Binding CanConfirm, Mode=OneWay}"
                IsTabStop="True"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonConfirmActionStyle}" />
        </WrapPanel>
    </Grid>
</c:BasePopup>