<c:BasePopup
    x:Class="Hitbench.Views.Popups.OHsMidiImportPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:m="clr-namespace:Hitbench.Resources.DataModels"
    Width="640"
    h:KeyboardNavigationPolicy.SuppressTabNavigation="True"
    PopupTitle="Import MIDI"
    ShowCloseButton="False"
    SizeToContent="Height">
    <c:BasePopup.Resources>
        <Style
            x:Key="OHsMidiModesStyle"
            BasedOn="{StaticResource {x:Type c:SegmentedToggleGroup}}"
            TargetType="c:SegmentedToggleGroup">
            <Setter Property="ItemsPanel" Value="{StaticResource VerticalStackItemsPanelTemplate}" />
        </Style>
        <Style
            x:Key="OHsMidiModeStyle"
            BasedOn="{StaticResource {x:Type c:SegmentedToggleOption}}"
            TargetType="c:SegmentedToggleOption">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="OHsMidiProjectBpmTemplate">
            <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                <TextBlock
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="Import and resnap to the current BPM"
                    TextWrapping="Wrap" />
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="MidiBpmValue"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{Binding MidiBpmText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <c:Icon
                        Grid.Column="1"
                        Width="12"
                        Height="12"
                        Margin="8,0"
                        Path="{StaticResource AngleRight}"
                        Color="{Binding Foreground, ElementName=MidiBpmValue, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{Binding ProjectBpmText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </c:BasePopup.Resources>
    <ScrollViewer
        h:KeyboardNavigationPolicy.SuppressTabNavigation="True"
        HorizontalScrollBarVisibility="Disabled"
        Style="{StaticResource BaseScrollViewerStyle}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24" Style="{StaticResource BaseStackPanelStyle}">
            <c:SegmentedToggleGroup
                x:Name="TimingModes"
                AutomationProperties.HelpText="{Binding FullTimingText, Mode=OneWay}"
                AutomationProperties.Name="MIDI import timing"
                SelectedValue="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource OHsMidiModesStyle}">
                <c:SegmentedToggleOption
                    AutomationProperties.Name="Import as-is"
                    Content="Import as-is"
                    Style="{StaticResource OHsMidiModeStyle}"
                    Value="{x:Static m:OHsMidiImportMode.AsIs}" />
                <c:SegmentedToggleOption
                    AutomationProperties.Name="Import and resnap to closest beat"
                    Content="Import and resnap to closest beat"
                    Style="{StaticResource OHsMidiModeStyle}"
                    Value="{x:Static m:OHsMidiImportMode.ClosestBeat}" />
                <c:SegmentedToggleOption
                    AutomationProperties.HelpText="{Binding FullTimingText, Mode=OneWay}"
                    AutomationProperties.Name="Import and resnap to the current BPM"
                    Content="{Binding Mode=OneWay}"
                    ContentTemplate="{StaticResource OHsMidiProjectBpmTemplate}"
                    Style="{StaticResource OHsMidiModeStyle}"
                    Value="{x:Static m:OHsMidiImportMode.ProjectBpm}" />
            </c:SegmentedToggleGroup>
            <Grid Margin="0,16,0,0" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:BalloonButton
                    x:Name="CloseAction"
                    Grid.Column="1"
                    AutomationProperties.Name="Cancel MIDI import"
                    ButtonIcon="{StaticResource Close}"
                    Click="OnCancel"
                    Style="{StaticResource OHsPopupCloseActionStyle}"
                    ToolTip="Cancel MIDI import (Esc)" />
                <c:BalloonButton
                    x:Name="ImportAction"
                    Grid.Column="3"
                    AutomationProperties.Name="Import MIDI"
                    ButtonIcon="{StaticResource Download}"
                    ButtonText="Import"
                    Click="OnImport"
                    IsEnabled="{Binding CanImport, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource OHsBalloonConfirmActionStyle}"
                    ToolTip="Import MIDI (Enter)" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</c:BasePopup>