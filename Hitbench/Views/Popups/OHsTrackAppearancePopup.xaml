<c:BasePopup x:Class="Hitbench.Views.Popups.OHsTrackAppearancePopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Hitbench.Resources.CustomControls" xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
 PopupTitle="Change Name and Color" ShowCloseButton="False" Width="420" MinWidth="320">
 <c:BasePopup.Resources>
  <Style x:Key="OHsTrackAppearanceColorPickerStyle" TargetType="c:OHsColorPicker" BasedOn="{StaticResource BaseControlStyle}">
   <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
    <Trigger Property="IsMouseCaptured" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy.Pressed}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.4"/></Trigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <LinearGradientBrush x:Key="OHsTrackAppearanceHueRamp" StartPoint="0,0.5" EndPoint="1,0.5">
   <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.1666667"/><GradientStop Color="#00FF00" Offset="0.3333333"/>
   <GradientStop Color="#00FFFF" Offset="0.5"/><GradientStop Color="#0000FF" Offset="0.6666667"/><GradientStop Color="#FF00FF" Offset="0.8333333"/><GradientStop Color="#FF0000" Offset="1"/>
  </LinearGradientBrush>
  <ControlTemplate x:Key="OHsTrackAppearanceHueTrackButtonTemplate" TargetType="RepeatButton">
   <Border Background="{TemplateBinding Background}" Style="{StaticResource BaseBorderStyle}"/>
  </ControlTemplate>
  <Style x:Key="OHsTrackAppearanceHueTrackButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource BaseRepeatButtonStyle}">
   <Setter Property="Template" Value="{StaticResource OHsTrackAppearanceHueTrackButtonTemplate}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="IsTabStop" Value="False"/>
  </Style>
  <ControlTemplate x:Key="OHsTrackAppearanceHueMarkerTemplate" TargetType="Thumb">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" Style="{StaticResource BaseBorderStyle}">
    <Border x:Name="MarkerInset" Margin="2" BorderBrush="{DynamicResource Brush.Background.Popup}" BorderThickness="2" CornerRadius="{StaticResource Radius.Node}" Style="{StaticResource BaseBorderStyle}"/>
   </Border>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
     <Setter TargetName="MarkerInset" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </DataTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="OHsTrackAppearanceHueMarkerStyle" TargetType="Thumb" BasedOn="{StaticResource OHsValueSliderThumbStyle}">
   <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="BorderThickness" Value="2"/>
   <Setter Property="Template" Value="{StaticResource OHsTrackAppearanceHueMarkerTemplate}"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="OHsTrackAppearanceHueTemplate" TargetType="c:ValueSlider">
   <Grid Background="Transparent" Style="{StaticResource BaseGridStyle}">
    <Border Height="16" Margin="8,0" VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource OHsTrackAppearanceHueRamp}" IsHitTestVisible="False" Style="{StaticResource BaseBorderStyle}"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource OHsTrackAppearanceHueTrackButtonStyle}"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource OHsTrackAppearanceHueTrackButtonStyle}"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Style="{StaticResource OHsTrackAppearanceHueMarkerStyle}"/></Track.Thumb>
    </Track>
   </Grid>
  </ControlTemplate>
  <Style x:Key="OHsTrackAppearanceHueStyle" TargetType="c:ValueSlider" BasedOn="{StaticResource BaseValueSliderStyle}">
   <Setter Property="Template" Value="{StaticResource OHsTrackAppearanceHueTemplate}"/>
   <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}"/>
   <Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="IsTabStop" Value="True"/><Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
  </Style>
 </c:BasePopup.Resources>
 <Grid Margin="24" Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="180"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBox x:Name="NameInput" Style="{StaticResource RoundedTextInputStyle}" AutomationProperties.Name="Track name"
   h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  <c:OHsColorPicker x:Name="ColorInput" Grid.Row="2" Style="{StaticResource OHsTrackAppearanceColorPickerStyle}" AutomationProperties.Name="Track color"
   SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  <StackPanel Grid.Row="4" Style="{StaticResource BaseStackPanelStyle}">
   <c:ValueSlider x:Name="HueInput" AutomationProperties.Name="Hue" Style="{StaticResource OHsTrackAppearanceHueStyle}" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
    Value="{Binding Hue, ElementName=ColorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
   <Border Height="24" Background="{Binding Color, Mode=OneWay}" BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="1" Style="{StaticResource BaseBorderStyle}" IsHitTestVisible="False"/>
  </StackPanel>
  <WrapPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
   <c:BalloonButton ButtonText="Cancel" ButtonIcon="{StaticResource Ban}" AutomationProperties.Name="Cancel" ShouldShowText="True" Style="{StaticResource OHsBalloonDestructiveActionStyle}" Click="OnCancel" Margin="0,0,8,0"/>
   <c:BalloonButton ButtonText="Save" ButtonIcon="{StaticResource Check}" AutomationProperties.Name="Save" ShouldShowText="True" Style="{StaticResource OHsBalloonConfirmActionStyle}" Click="OnSave" IsEnabled="{Binding CanSave, Mode=OneWay}"/>
  </WrapPanel>
 </Grid>
</c:BasePopup>
