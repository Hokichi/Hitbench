<c:BasePopup x:Class="Hitbench.Views.Popups.OHsUpdatePopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    PopupTitle="Update Hitbench">
    <c:BasePopup.Resources>
        <Style x:Key="OHsUpdatePopupTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </c:BasePopup.Resources>
    <StackPanel MinWidth="280" MaxWidth="480" Margin="24,8,24,24" Style="{StaticResource BaseStackPanelStyle}">
        <TextBlock x:Name="DownloadText" Text="{Binding DownloadingText, Mode=OneWay}" Style="{StaticResource OHsUpdatePopupTextStyle}" />
        <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
            AutomationProperties.Name="Download progress" Style="{StaticResource OHsDeterminateProgressStyle}" />
    </StackPanel>
</c:BasePopup>
