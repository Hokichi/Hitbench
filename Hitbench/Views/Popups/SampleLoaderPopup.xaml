                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Navy.Tint}"
                            BorderBrush="{DynamicResource Brush.Navy}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                x:Name="SelectedCount"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{Binding SelectionAnnouncement, Mode=OneWay}"
                                FontSize="{StaticResource FontSize.Caption}"
                                FontWeight="Bold"
                                Style="{StaticResource BodyTextStyle}"
                                Text="{Binding CheckedCount, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <c:BalloonButton
                        x:Name="ClearSelectedButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Clear all selected samples"
                        ButtonIcon="{StaticResource Minus}"
                        ButtonText="Clear all"
                        Command="{Binding ClearSelectedCommand, Mode=OneWay}"
                        FontSize="{StaticResource FontSize.Label}"
                        HasIcon="False"
                        ShouldShowText="True"
                        Style="{StaticResource OHsSampleLoaderSecondaryActionStyle}" />
                </Grid>
                <ListBox
                    x:Name="SelectedSamplesList"
                    Grid.Row="1"
                    Margin="0,8,0,8"
                    AutomationProperties.Name="Selected samples"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource OHsSampleLoaderBasketItemStyle}"
                    ItemTemplate="{StaticResource OHsSampleLoaderBasketTemplate}"
                    ItemsSource="{Binding SelectedSamples, Mode=OneWay}"
                    PreviewKeyDown="OnBasketKeyDown"
                    ScrollViewer.CanContentScroll="True"
                    SelectionChanged="OnBasketSelectionChanged"
                    Style="{StaticResource BaseListBoxStyle}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource OHsSampleLoaderImportLayoutStyle}">
            <Border
                Padding="16,0,16,16"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1,1,0,0">
                <StackPanel Grid.Row="2" Margin="0">
                    <Grid Style="{StaticResource OHsSampleLoaderAudioRegionStyle}">
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="{StaticResource FontSize.Label}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="{Binding SelectionSummary, Mode=OneWay}" />
                    </Grid>
                    <c:BalloonButton
                        x:Name="ImportButton"
                        Height="40"
                        Margin="0,12,0,0"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="False"
                        AutomationProperties.Name="{Binding ConfirmAutomationName, Mode=OneWay}"
                        ButtonIcon="{StaticResource PlusSolid}"
                        ButtonText="{Binding ConfirmActionText, Mode=OneWay}"
                        Click="OnImportClick"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        FontSize="{StaticResource FontSize.Body}"
                        FontWeight="Bold"
                        IconSize="14"
                        IsEnabled="{Binding CanConfirm, Mode=OneWay}"
                        IsTabStop="False"
                        ShouldShowText="True"
                        Style="{StaticResource OHsBalloonConfirmActionStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</c:BasePopup>
