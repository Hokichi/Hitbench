<c:BasePopup
    x:Class="Hitbench.Views.Popups.SampleLoaderPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:h="clr-namespace:Hitbench.Resources.Helpers"
    x:Name="PopupRoot"
    Width="1200"
    Height="640"
    PopupTitle="{Binding PopupTitle, Mode=OneWay}"
    SizeToContent="Manual"
    Style="{DynamicResource OHsSampleLoaderPopupStyle}">
    <c:BasePopup.Resources>
        <ControlTemplate x:Key="OHsSampleLoaderPopupTemplate" TargetType="c:BasePopup">
            <Border
                Background="{DynamicResource Brush.Background.Popup}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Clip>
                    <MultiBinding Converter="{StaticResource BorderCornerClipConverter}">
                        <Binding
                            Mode="OneWay"
                            Path="CornerRadius"
                            RelativeSource="{RelativeSource Self}" />
                        <Binding
                            Mode="OneWay"
                            Path="ActualWidth"
                            RelativeSource="{RelativeSource Self}" />
                        <Binding
                            Mode="OneWay"
                            Path="ActualHeight"
                            RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Border.Clip>
                <Grid x:Name="PART_ContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PopupHeaderRow" Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="PopupHeader"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PopupTitleText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Bold}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{TemplateBinding PopupTitle}"
                                Visibility="Collapsed" />
                            <c:BalloonButton
                                x:Name="PART_CloseButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Close (Esc)"
                                ButtonIcon="{StaticResource Close}"
                                ShouldShowText="False"
                                Style="{StaticResource OHsBalloonNeutralActionStyle}"
                                Visibility="{TemplateBinding ShowCloseButton,
                                                             Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ContentPresenter
                                x:Name="PopupTitleContentPresenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PopupTitleContent}" />
                        </Grid>
                    </Border>
                    <ContentPresenter Grid.Row="1" />
                    <Rectangle
                        x:Name="PART_PopupOverlay"
                        Grid.RowSpan="2"
                        Fill="{DynamicResource Brush.Overlay}"
                        Opacity="0"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="PopupTitleContent" Value="{x:Null}">
                    <Setter TargetName="PopupTitleText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PopupTitleContentPresenter" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="ShowHeader" Value="False">
                    <Setter TargetName="PopupHeader" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PopupHeaderRow" Property="Height" Value="0" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsSampleLoaderPopupStyle"
            BasedOn="{StaticResource BaseBasePopupStyle}"
            TargetType="c:BasePopup">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="Template" Value="{StaticResource OHsSampleLoaderPopupTemplate}" />
        </Style>
        <Style
            x:Key="SampleLoaderSelectedFileDetailsStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedFile, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OHsSampleLoaderCheckboxStyle"
            BasedOn="{StaticResource RegularCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style
            x:Key="SampleLoaderCheckStyle"
            BasedOn="{StaticResource OHsSampleLoaderCheckboxStyle}"
            TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Width" Value="16" />
            <Style.Triggers>


                <DataTrigger Binding="{Binding IsDirectory, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderBreadcrumbButtonStyle"
            BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="DefaultBackground" Value="Transparent" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ButtonIcon" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ShouldShowText" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBreadcrumbSeparatorStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="&gt;" />
            <Setter Property="Width" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWay}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SampleLoaderBreadcrumbTemplate">
            <DockPanel LastChildFill="True">
                <c:Icon
                    Width="6"
                    Margin="8,0"
                    Path="{StaticResource AngleRight}"
                    Color="{StaticResource Brush.Text.Primary}" />
                <c:BalloonButton
                    MaxWidth="200"
                    AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                    ButtonText="{Binding Name, Mode=OneWay}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                    CommandParameter="{Binding FullPath, Mode=OneWay}"
                    HasIcon="False"
                    Style="{StaticResource SampleLoaderBreadcrumbButtonStyle}"
                    ToolTip="{Binding FullPath, Mode=OneWay}" />
            </DockPanel>
        </DataTemplate>
        <ControlTemplate x:Key="SampleLoaderContentItemTemplate" TargetType="ListBoxItem">
            <Border
                Margin="8,2"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Icon
                        x:Name="ActiveFileCheck"
                        Width="10"
                        Height="10"
                        IsHitTestVisible="False"
                        Path="{StaticResource Check}"
                        Visibility="Collapsed"
                        Color="{TemplateBinding Foreground}" />
                    <ContentPresenter
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ActiveFileCheck" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderContentItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderContentItemTemplate}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="ToolTip" Value="{Binding FullPath, Mode=OneWay}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnEntryRowMouseDown" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy.Text}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChecked, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight" Value="Bold" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPreviewing, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderRowMetadataStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderFileColumnsStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsFolderSelection, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBadgeStyle"
            BasedOn="{StaticResource BodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,8,0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderPreviewBadgeStyle"
            BasedOn="{StaticResource OHsSampleLoaderBadgeStyle}"
            TargetType="TextBlock">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Popup}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderImportedBadgeStyle"
            BasedOn="{StaticResource OHsSampleLoaderBadgeStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Popup}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlreadyInProject, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SampleLoaderEntryTemplate">
            <Grid MinHeight="40" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                    Click="OnFileCheckClick"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SampleLoaderCheckStyle}" />
                <DockPanel Grid.Column="1" LastChildFill="True">
                    <Border
                        Height="16"
                        Margin="4,0"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="4"
                        DockPanel.Dock="Right"
                        Visibility="{Binding IsAlreadyInProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            Height="14"
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OHsSampleLoaderImportedBadgeStyle}"
                            Text="Already in project" />
                    </Border>
                    <Border
                        Height="16"
                        Margin="4,0"
                        BorderBrush="{DynamicResource Brush.Border.Control}"
                        BorderThickness="1"
                        CornerRadius="4"
                        DockPanel.Dock="Right"
                        Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock
                            Height="14"
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OHsSampleLoaderPreviewBadgeStyle}"
                            Text="Previewing" />
                    </Border>
                    <c:Icon
                        Width="8"
                        Height="8"
                        Margin="2,0"
                        DockPanel.Dock="Right"
                        Path="{StaticResource MediaPlay}"
                        Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Color="{DynamicResource Brush.Text.Secondary}" />
                    <Border Margin="0,4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                            FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                            FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding FullPath, Mode=OneWay}" />
                    </Border>
                </DockPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource OHsSampleLoaderRowMetadataStyle}"
                    Text="{Binding SizeText, Mode=OneWay}"
                    TextAlignment="Right" />
                <c:Icon
                    x:Name="FolderRowIcon"
                    Width="14"
                    Height="14"
                    Path="{StaticResource Folder}"
                    Visibility="Collapsed"
                    Color="{DynamicResource Brush.Text.Secondary}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory, Mode=OneWay}" Value="True">
                    <Setter TargetName="FolderRowIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style
            x:Key="OHsSampleLoaderSecondaryActionStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="DefaultBackground" Value="Transparent" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderEarlierFoldersStyle"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}"
            TargetType="c:BalloonComboBox">
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="ButtonIcon" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderCloseStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Padding" Value="12,2" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderIconActionStyle"
            BasedOn="{StaticResource OHsSampleLoaderSecondaryActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style
            x:Key="SampleLoaderPreviewStyle"
            BasedOn="{StaticResource OHsSampleLoaderSecondaryActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="PressedBackground" Value="{DynamicResource Brush.Navy.Tint}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.Background.Hover}" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
        </Style>
        <Style
            x:Key="SampleLoaderAutoPlayStyle"
            BasedOn="{StaticResource OHsSampleLoaderCheckboxStyle}"
            TargetType="CheckBox">
            <Setter Property="IsTabStop" Value="True"/><Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderSelection, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>

            </Style.Triggers>
        </Style>
        <CollectionViewSource x:Key="OHsSampleLoaderLocationsView" Source="{Binding Locations, Mode=OneWay}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <DataTemplate x:Key="OHsSampleLoaderLocationGroupHeaderTemplate">
            <TextBlock
                Margin="8,12,8,4"
                FontSize="10"
                FontWeight="Bold"
                Style="{StaticResource CardLabelTextStyle}"
                Text="{Binding Name, Mode=OneWay}" />
        </DataTemplate>
        <GroupStyle x:Key="OHsSampleLoaderLocationGroupStyle" HeaderTemplate="{StaticResource OHsSampleLoaderLocationGroupHeaderTemplate}" />
        <ControlTemplate x:Key="OHsSampleLoaderLocationContainerTemplate" TargetType="ListBoxItem">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>
        <Style
            x:Key="OHsSampleLoaderLocationItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="IsEnabled" Value="{Binding IsAvailable, Mode=OneWay}" />
            <Setter Property="Template" Value="{StaticResource OHsSampleLoaderLocationContainerTemplate}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="ToolTip" Value="{Binding FullPath, Mode=OneWay}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsSampleLoaderLocationTemplate">
            <DockPanel LastChildFill="True">
                <c:Icon
                    x:Name="LocationIcon"
                    Width="14"
                    Height="14"
                    Margin="0,0,8,0"
                    Path="{StaticResource Folder}"
                    Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
