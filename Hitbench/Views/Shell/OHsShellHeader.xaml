<UserControl
    x:Class="Hitbench.Views.Shell.OHsShellHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Hitbench.Resources.CustomControls"
    xmlns:helpers="clr-namespace:Hitbench.Resources.Helpers"
    xmlns:shell="clr-namespace:Hitbench.Views.Shell">
    <UserControl.Resources>
        <Style
            x:Key="OHsShellHeaderLogoStyle"
            BasedOn="{StaticResource BaseImageStyle}"
            TargetType="Image">
            <Setter Property="Width" Value="{StaticResource Size.Control.Min}" />
            <Setter Property="Height" Value="{StaticResource Size.Control.Min}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="Source" Value="/Hitbench;component/Resources/logo.png" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}" Value="True">
                    <Setter Property="Source" Value="/Hitbench;component/Resources/logo-light.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsShellHeaderAudioActionsStyle"
            BasedOn="{StaticResource BaseStackPanelStyle}"
            TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OHsMainWindowGoBackStyle"
            BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style
            x:Key="OHsShellHeaderUpdateActionStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style
            x:Key="OHsShellHeaderHomeSeparatorStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowTitleStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsShellThemeToggleTemplate" TargetType="ToggleButton">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}">
                <customControls:Icon
                    x:Name="ThemeIcon"
                    Width="16"
                    Height="16"
                    Path="{StaticResource Moon}"
                    Color="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ThemeIcon" Property="Path" Value="{StaticResource Sun}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsShellProjectNameStyle"
            BasedOn="{StaticResource MainWindowTitleStyle}"
            TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Margin" Value="12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectName, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OHsShellThemeToggleStyle"
            BasedOn="{StaticResource BaseToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource OHsShellThemeToggleTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Pressed}" />
                </MultiTrigger>
                <DataTrigger Binding="{Binding ThemeService.IsChangingTheme, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,8" Style="{StaticResource BaseGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center" Style="{StaticResource BaseGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Style="{StaticResource OHsShellHeaderLogoStyle}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Style="{StaticResource MainWindowTitleStyle}"
                    Text="Hit" />
                <TextBlock
                    Margin="0,0,12,0"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Style="{StaticResource MainWindowTitleStyle}"
                    Text="bench" />
            </StackPanel>
            <Grid Grid.Column="1" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="ThemeSwitch"
                    Grid.Column="1"
                    AutomationProperties.Name="Light theme"
                    Click="OnThemeToggleClick"
                    IsChecked="{Binding IsLightTheme, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}"
                    Style="{StaticResource OHsShellThemeToggleStyle}"
                    ToolTip="Toggle Dark / Light theme" />
            </Grid>
        </Grid>
        <StackPanel
            Grid.Column="1"
            Margin="16,0,0,0"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <StackPanel
                x:Name="WorkstationActions"
                Orientation="Horizontal"
                Style="{StaticResource OHsShellHeaderAudioActionsStyle}">
                <customControls:BalloonButton
                    x:Name="GoBackButton"
                    AutomationProperties.Name="Return to projects"
                    ButtonIcon="{StaticResource Home}"
                    ButtonText="Return to projects"
                    Click="OnGoBackClick"
                    IsEnabled="{Binding CanGoBack, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}"
                    Style="{StaticResource OHsMainWindowGoBackStyle}"
                    ToolTip="Save project and return to projects" />
                <Border Style="{StaticResource OHsShellHeaderHomeSeparatorStyle}" />
            </StackPanel>
            <StackPanel
                x:Name="UpdateActions"
                Orientation="Horizontal"
                Style="{StaticResource BaseStackPanelStyle}">
                <customControls:BalloonButton
                    x:Name="DownloadUpdateButton"
                    AutomationProperties.Name="Download update"
                    ButtonIcon="{StaticResource Download}"
                    Click="OnDownloadUpdateClick"
                    IsEnabled="{Binding CanDownloadUpdate, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}"
                    Style="{StaticResource OHsShellHeaderUpdateActionStyle}"
                    ToolTip="{Binding DownloadUpdateToolTip, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}" />
                <Border Style="{StaticResource OHsShellHeaderHomeSeparatorStyle}" />
            </StackPanel>
            <customControls:BalloonButton
                x:Name="MinimizeButton"
                AutomationProperties.Name="Minimize"
                ButtonIcon="{StaticResource Minus}"
                ButtonText="Minimize"
                Click="OnMinimizeClick"
                Style="{StaticResource OHsBalloonNeutralActionStyle}"
                ToolTip="Minimize" />
            <customControls:BalloonButton
                x:Name="MaximizeRestoreButton"
                AutomationProperties.Name="Maximize"
                ButtonIcon="{StaticResource ExpandAlt}"
                ButtonText="Maximize"
                Click="OnMaximizeRestoreClick"
                Style="{StaticResource OHsBalloonNeutralActionStyle}"
                ToolTip="Maximize" />
            <customControls:BalloonButton
                x:Name="CloseButton"
                AutomationProperties.Name="Close"
                ButtonIcon="{StaticResource Close}"
                ButtonText="Close"
                Click="OnCloseClick"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                ToolTip="Close" />
        </StackPanel>
    </Grid>
</UserControl>
