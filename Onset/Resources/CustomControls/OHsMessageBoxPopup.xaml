<customControls:BasePopup
    x:Class="Onset.Resources.CustomControls.OHsMessageBoxPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Onset.Resources.CustomControls"
    Width="420"
    MinWidth="420"
    MaxWidth="420"
    ShowCloseButton="False"
    ShowInTaskbar="False">
    <customControls:BasePopup.Resources>

        <Style x:Key="OHsMessageBoxBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </customControls:BasePopup.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="IconBadge"
                Width="48"
                Height="48"
                VerticalAlignment="Top"
                CornerRadius="24">
                <customControls:Icon x:Name="MessageIcon" Margin="12" />
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock
                    Style="{StaticResource OHsPopupTitleTextStyle}"
                    Text="{Binding PopupTitle, RelativeSource={RelativeSource AncestorType=customControls:BasePopup}, Mode=OneWay}"  FontSize="{StaticResource FontSize.Title}" TextWrapping="Wrap" TextTrimming="None"/>
                <TextBlock
                    x:Name="MessageTextBlock"
                    Margin="0,10,0,0"
                    Style="{StaticResource OHsMessageBoxBodyTextStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <customControls:BalloonButton
                x:Name="TertiaryButton"
                Margin="0,0,8,0"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Click="OnTertiaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                Visibility="Collapsed" />
            <customControls:BalloonButton
                x:Name="SecondaryButton"
                Margin="0,0,8,0"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Click="OnSecondaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                Visibility="Collapsed" />
            <customControls:BalloonButton
                x:Name="PrimaryButton"
                AutomationProperties.Name="OK"
                ButtonIcon="{StaticResource Check}"
                ButtonText="OK"
                Click="OnPrimaryButtonClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonConfirmActionStyle}" />
        </StackPanel>
    </Grid>
</customControls:BasePopup>

