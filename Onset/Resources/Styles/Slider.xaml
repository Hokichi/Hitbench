<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Onset.Resources.CustomControls">
    <Style x:Key="BaseSliderStyle" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="OHsValueSliderTrackButtonTemplate" TargetType="RepeatButton">
        <Border
            Height="6"
            VerticalAlignment="Center"
            Background="{TemplateBinding Background}"
            CornerRadius="3" />
    </ControlTemplate>

    <ControlTemplate x:Key="OHsValueSliderThumbTemplate" TargetType="Thumb">
        <Ellipse
            Fill="{TemplateBinding Background}"
            Stroke="{TemplateBinding BorderBrush}"
            StrokeThickness="{TemplateBinding BorderThickness}" />
    </ControlTemplate>
    <Style
        x:Key="OHsValueSliderDecreaseStyle"
        BasedOn="{StaticResource BaseRepeatButtonStyle}"
        TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />

        <Setter Property="Template" Value="{StaticResource OHsValueSliderTrackButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsValueSliderIncreaseStyle"
        BasedOn="{StaticResource BaseRepeatButtonStyle}"
        TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />

        <Setter Property="Template" Value="{StaticResource OHsValueSliderTrackButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsValueSliderThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource OHsValueSliderThumbTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Hover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Pressed}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="OHsValueSliderTemplate" TargetType="customControls:ValueSlider">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="FocusBorder"
                Margin="1"
                Padding="3"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="10">
                <Track
                    x:Name="PART_Track"
                    IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                    Maximum="{TemplateBinding Maximum}"
                    Minimum="{TemplateBinding Minimum}"
                    Orientation="Horizontal"
                    Value="{TemplateBinding Value}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource OHsValueSliderDecreaseStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource OHsValueSliderIncreaseStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource OHsValueSliderThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Border>
            <TextBlock
                x:Name="DisplayText"
                Grid.Column="1"
                MinWidth="24"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Focusable="False"
                Foreground="{DynamicResource Brush.Text.Primary}"
                Style="{StaticResource BaseTextBlockStyle}"
                Text="{TemplateBinding DisplayText}"
                TextAlignment="Right" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ShowValueTag" Value="True">
                <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="DisplayText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        x:Key="BaseValueSliderStyle"
        BasedOn="{StaticResource BaseSliderStyle}"
        TargetType="customControls:ValueSlider">
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Dense}" />
        <Setter Property="Template" Value="{StaticResource OHsValueSliderTemplate}" />
    </Style>

    <GeometryGroup x:Key="OHsVolumeWheelRampGeometry" FillRule="EvenOdd">
        <EllipseGeometry
            Center="80,80"
            RadiusX="80"
            RadiusY="80" />
        <EllipseGeometry
            Center="80,80"
            RadiusX="30"
            RadiusY="30" />
    </GeometryGroup>
    <ControlTemplate x:Key="OHsVolumeWheelTemplate" TargetType="customControls:VolumeWheel">
        <Grid
            MinWidth="168"
            MinHeight="168"
            FlowDirection="LeftToRight">
            <Border
                x:Name="ActiveBorder"
                Width="168"
                Height="168"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="84">
                <Grid>
                    <Grid
                        x:Name="PieGraphic"
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="{TemplateBinding PieOpacity}">
                        <Path
                            x:Name="WheelBackground"
                            Data="{StaticResource OHsVolumeWheelRampGeometry}"
                            Fill="{DynamicResource Brush.Background.Deepened}"
                            Stretch="None"
                            Stroke="{DynamicResource Brush.Border.Control}"
                            StrokeThickness="1" />
                        <Path
                            x:Name="WheelFill"
                            Data="{TemplateBinding FilledGeometry}"
                            Fill="{DynamicResource Brush.Navy}"
                            Stretch="None" />
                    </Grid>
                    <TextBlock
                        x:Name="WheelValue"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                        FontFamily="{DynamicResource Bold}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={}{0:0}%}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="WheelBackground" Property="Fill" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>

            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="PieGraphic" Property="Opacity" Value="1" />
                <Setter TargetName="WheelBackground" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter TargetName="WheelBackground" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="WheelFill" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="WheelValue" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        x:Key="BaseVolumeWheelStyle"
        BasedOn="{StaticResource BaseSliderStyle}"
        TargetType="customControls:VolumeWheel">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template" Value="{StaticResource OHsVolumeWheelTemplate}" />
    </Style>
</ResourceDictionary>
