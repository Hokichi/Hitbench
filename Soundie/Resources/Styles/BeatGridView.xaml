<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Soundie.Resources.CustomControls"
                    xmlns:h="clr-namespace:Soundie.Resources.Helpers">
    <Style x:Key="BaseBeatGridViewStyle" TargetType="c:BeatGridView">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="c:BeatGridView" BasedOn="{StaticResource BaseBeatGridViewStyle}" />
</ResourceDictionary>
