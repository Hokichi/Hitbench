        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonControlStyle"
        TargetType="{x:Type c:BalloonControl}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
    </Style>
    <ItemsPanelTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonStateItemsPanelTemplate">
        <StackPanel />
    </ItemsPanelTemplate>
    <DataTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonStateItemTemplate">
        <c:BalloonButton
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            ButtonIcon="{Binding ButtonIcon, Mode=OneWay}"
            ButtonSize="40"
            ButtonText="{Binding ButtonText, Mode=OneWay}"
            CommandParameter="{Binding Mode=OneWay}"
            CornerRadius="{Binding Tag.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Mode=OneWay}"
            IconSize="{Binding Tag.IconSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Mode=OneWay}"
            ShouldShowText="True"
            Style="{DynamicResource OHsBalloonStateItemStyle}" />
    </DataTemplate>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonControlTemplate"
        TargetType="{x:Type c:BalloonControl}">
        <Grid Background="Transparent">
            <Canvas IsHitTestVisible="False">
                <!--  Shared action shape.  -->
                <Path
                    x:Name="PART_Shape"
                    Fill="{TemplateBinding DefaultBackground}"
                    Stroke="{TemplateBinding StrokeBrush}"
                    StrokeThickness="{TemplateBinding StrokeThickness}" />
                <!--  Compatibility shape part; the control owns pressed fill.  -->
                <Path
                    x:Name="PART_Overlay"
                    Fill="{DynamicResource Brush.Overlay}"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Canvas>
            <!--  Content area follows the public padding contract.  -->
            <Grid
                x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="PART_IconSlot"
                        Width="{TemplateBinding IconSize}"
                        VerticalAlignment="Center">
                        <Path
                            x:Name="PART_Icon"
                            Width="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Stretch="Uniform">
                            <Path.Fill>
                                <TemplateBinding Property="Foreground" />
                            </Path.Fill>
                        </Path>
                    </Grid>
                    <Border
                        x:Name="PART_TextContent"
                        Grid.Column="1"
                        ClipToBounds="True">
                        <TextBlock
                            x:Name="PART_ButtonText"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Bold}"
                            FontSize="{TemplateBinding FontSize}"
                            Text="{TemplateBinding ButtonText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">
                            <TextBlock.Foreground>
                                <TemplateBinding Property="Foreground" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
            <Popup
                x:Name="PART_StatePopup"
                HorizontalAlignment="Right"
                AllowsTransparency="True"
                HorizontalOffset="4"
                Placement="Bottom"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                PopupAnimation="None"
                StaysOpen="False">
                <Border
                    Padding="4"
                    Background="{DynamicResource Brush.Background.Popup}"
                    CornerRadius="{StaticResource Radius.Popup}"
                    Style="{StaticResource BaseBorderStyle}">
                    <ItemsControl x:Name="PART_StateItems" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <StaticResource ResourceKey="BalloonStateItemsPanelTemplate" />
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="BalloonStateItemTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonControlStyle}"
        TargetType="{x:Type c:BalloonControl}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Neutral}" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Background" Value="{Binding DefaultBackground, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=ButtonSize, Mode=OneWay}" />
        <Setter Property="Template" Value="{StaticResource BalloonControlTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{Binding HoveredBackground, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonButtonStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonButtonStyle}"
        TargetType="{x:Type c:BalloonButton}" />
    <Style
        x:Key="OHsBalloonActionStyle"
        BasedOn="{StaticResource BaseBalloonButtonStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="ButtonSize" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="CurveHeight" Value="0" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="DefaultBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="HoveredBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="StrokeThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsBalloonNeutralActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}" />
    <Style
        x:Key="OHsBalloonDefaultActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Default}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Default.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Default.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Default}" />
    </Style>
    <Style
        x:Key="OHsBalloonConfirmActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.ConfirmSave}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.ConfirmSave.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.ConfirmSave.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.ConfirmSave}" />
    </Style>
    <Style
        x:Key="OHsBalloonDestructiveActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Destructive}" />
    </Style>
    <Style
        x:Key="OHsBalloonNavInfoActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.NavInfo}" />
        <Setter Property="StrokeBrush" Value="{DynamicResource Brush.BalloonButton.Border.NavInfo}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style
        x:Key="OHsBalloonSurfaceActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Surface}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Surface.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.Surface.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.Surface}" />
    </Style>
    <Style
        x:Key="OHsBalloonDestructiveSolidActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.DestructiveSolid}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.DestructiveSolid.Hovered}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.DestructiveSolid.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.DestructiveSolid}" />
    </Style>
    <Style
        x:Key="OHsBalloonStateItemStyle"
        BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="DefaultBackground" Value="{Binding DefaultBackground, Mode=OneWay}" />
        <Setter Property="HoveredBackground" Value="{Binding HoverBackground, Mode=OneWay}" />
        <Setter Property="PressedBackground" Value="{Binding PressedBackground, Mode=OneWay}" />
        <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay}" />
        <Setter Property="ToolTip" Value="{Binding ButtonText, Mode=OneWay}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ButtonText, Mode=OneWay}" />
        <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DefaultBackground, Mode=OneWay, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HoverBackground, Mode=OneWay, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Hovered}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PressedBackground, Mode=OneWay, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="PressedBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Pressed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Foreground, Mode=OneWay, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.BalloonButton.Foreground.NavInfo}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonToggleStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonToggle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonToggleStyle}"
        TargetType="{x:Type c:BalloonToggle}" />
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonCheckBoxStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonCheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonCheckBoxStyle}"
        TargetType="{x:Type c:BalloonCheckBox}">
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.Navy}" />
        <Setter Property="StrokeBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{Binding CheckedBackground, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeBrush" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{Binding HoveredBackground, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonRadioButtonStyle"
        BasedOn="{StaticResource {x:Type c:BalloonCheckBox}}"
        TargetType="{x:Type c:BalloonRadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonRadioButtonStyle}"
        TargetType="{x:Type c:BalloonRadioButton}" />

    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseSwipeRevealContainerStyle"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRevealContentPresenterStyle"
        BasedOn="{StaticResource BaseContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeLeftRevealContentPresenterStyle"
        BasedOn="{StaticResource SwipeRevealContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLeftContentRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRightRevealContentPresenterStyle"
        BasedOn="{StaticResource SwipeRevealContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRightContentRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRevealContainerTemplate"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Grid ClipToBounds="True">
            <!--  Left action (revealed on swipe right)  -->
            <ContentPresenter
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{TemplateBinding LeftContent}">
                <ContentPresenter.Style>
                    <StaticResource ResourceKey="SwipeLeftRevealContentPresenterStyle" />
                </ContentPresenter.Style>
            </ContentPresenter>
            <!--  Right action (revealed on swipe left)  -->
            <ContentPresenter
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{TemplateBinding RightContent}">
                <ContentPresenter.Style>
                    <StaticResource ResourceKey="SwipeRightRevealContentPresenterStyle" />
                </ContentPresenter.Style>
            </ContentPresenter>
            <!--  Main slideable content  -->
            <Border x:Name="PART_ContentBorder" Background="Transparent">
                <ContentPresenter Content="{TemplateBinding Content}" />
            </Border>
        </Grid>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseSwipeRevealContainerStyle}"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Setter Property="Template" Value="{StaticResource SwipeRevealContainerTemplate}" />
    </Style>






    <Style
        x:Key="OHsPopupCloseActionStyle"
        BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="ShouldShowText" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="ToolTip" Value="Close (Esc)" />
        <Setter Property="AutomationProperties.Name" Value="Close" />
    </Style>
    <ControlTemplate x:Key="OHsTimelineEditingModeButtonTemplate" TargetType="RadioButton">
        <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="8" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border
                x:Name="ModeCue"
                Height="3"
                Margin="8,0,8,4"
                VerticalAlignment="Bottom"
                Background="{TemplateBinding Foreground}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ModeCue" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        x:Key="OHsTimelineEditingModeButtonStyle"
        BasedOn="{StaticResource BaseRadioButtonStyle}"
        TargetType="RadioButton">
        <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        <Setter Property="Template" Value="{StaticResource OHsTimelineEditingModeButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="OHsWorkstationTrackToggleTemplate" TargetType="ToggleButton">
        <Grid Style="{StaticResource BaseGridStyle}">
            <Border
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Style="{StaticResource BaseBorderStyle}">
                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
            </Border>
        </Grid>
    </ControlTemplate>
    <Style
        x:Key="OHsWorkstationTrackToggleStyle"
        BasedOn="{StaticResource BaseToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="{StaticResource Size.Control.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackToggleTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}" />
                <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

