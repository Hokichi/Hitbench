    <!-- ===================== ELEVATION (NEW) ===================== -->
    <!-- Shadows lift modal chrome, menus and tooltips. Cards and inputs rely on surface contrast and borders. -->
    <DropShadowEffect x:Key="Effect.Shadow.Popup" Color="{StaticResource Color.Shadow}" Direction="270" ShadowDepth="16" BlurRadius="40" Opacity="0.22" />
    <DropShadowEffect x:Key="Effect.Shadow.Menu" Color="{StaticResource Color.Shadow}" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18" />
    <DropShadowEffect x:Key="Effect.Shadow.Tooltip" Color="{StaticResource Color.Shadow}" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.16" />
