<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Soundie · Light theme · "Ink" palette (v2)

        Rules for this file
        - Dark.xaml MUST expose exactly the same keys (verified by comparing both key sets).
        - Every Brush.X references Color.X from this file. Brush.BalloonButton.Background.Neutral is the one direct exception.
        - Existing v1 key names are kept; their values changed. New keys are marked NEW.
        - Text pairs were checked at 4.5:1 or better, control edges and graphics at 3:1 or better.
          Text.Muted is only for Surface, Elevated, Popup and Main. Never place it on Hover or Pressed.
          Light surfaces are NOT an inversion of Dark: Surface is white, Elevated is slightly grey, Deepened is the recessed tone.
        - Eight-digit values use WPF #AARRGGBB order.
    -->

    <!-- ===================== COLORS ===================== -->

    <!-- Surfaces (three structural layers at most: Main or Popup > Surface > Elevated or Deepened) -->
    <Color x:Key="Color.Background.Main">#F3F4F8</Color>
    <Color x:Key="Color.Background.Deepened">#E9ECF2</Color>
    <Color x:Key="Color.Background.Popup">#FFFFFF</Color>
    <Color x:Key="Color.Background.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Background.Elevated">#F7F8FB</Color>
    <Color x:Key="Color.Background.Hover">#E3E7EF</Color>
    <Color x:Key="Color.Background.Pressed">#D8DDE8</Color> <!-- NEW -->

    <!-- Accent. Navy keeps its v1 name; the hue is now a clearer indigo-blue -->
    <Color x:Key="Color.Navy">#3552DD</Color>
    <Color x:Key="Color.Navy.Hover">#2D47C4</Color> <!-- NEW -->
    <Color x:Key="Color.Navy.Pressed">#263CA8</Color> <!-- NEW -->
    <Color x:Key="Color.Navy.Muted">#657CE6</Color>
    <Color x:Key="Color.Navy.Tint">#E7EBFF</Color>
    <Color x:Key="Color.Navy.Text">#3552DD</Color> <!-- NEW: accent text, icons, selected labels -->

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#151922</Color>
    <Color x:Key="Color.Text.Secondary">#475066</Color>
    <Color x:Key="Color.Text.Muted">#5B6479</Color>
    <Color x:Key="Color.Text.Disabled">#9AA2B4</Color> <!-- NEW: exempt from contrast; pair with 0.4 opacity rule -->
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color> <!-- NEW: label on Navy and DestructiveSolid fills -->
    <Color x:Key="Color.Text.Primary.Inverted">#0A0C10</Color>
    <Color x:Key="Color.Text.Secondary.Inverted">#171B23</Color>
    <Color x:Key="Color.Text.Muted.Inverted">#1F2430</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border.Subtle">#E6E9F0</Color>
    <Color x:Key="Color.Border.Default">#D3D8E2</Color>
    <Color x:Key="Color.Border.Strong">#B4BBCB</Color>
    <Color x:Key="Color.Border.Control">#7E879B</Color> <!-- NEW: field, checkbox and radio edges, 3:1 -->
    <Color x:Key="Color.Border.Focus">#3552DD</Color> <!-- keyboard focus ring, drawn with a 2 px gap -->
    <Color x:Key="Color.Border.Danger">#C22F2F</Color>
    <Color x:Key="Color.Border.Warning">#B26A00</Color>
    <Color x:Key="Color.Border.Info">#1A64B8</Color>
    <Color x:Key="Color.Border.Accent.Muted">#5D2C4BC7</Color>

    <!-- Status: foreground and companion tint. ".Dark" companions keep their v1 names in both themes (pale tints here) -->
    <Color x:Key="Color.Success">#0B7A55</Color>
    <Color x:Key="Color.Warning">#8A5300</Color>
    <Color x:Key="Color.Danger">#C22F2F</Color>
    <Color x:Key="Color.Info">#1A64B8</Color>
    <Color x:Key="Color.Success.Dark">#E3F6EE</Color>
    <Color x:Key="Color.Warning.Dark">#FFF1D6</Color>
    <Color x:Key="Color.Danger.Dark">#FCE9E9</Color>
    <Color x:Key="Color.Info.Dark">#E4F0FF</Color>

    <!-- Audio domain (NEW) -->
    <Color x:Key="Color.Track.1">#2474CF</Color>
    <Color x:Key="Color.Track.2">#7D5CC7</Color>
    <Color x:Key="Color.Track.3">#B2468A</Color>
    <Color x:Key="Color.Track.4">#C04442</Color>
    <Color x:Key="Color.Track.5">#AE5E00</Color>
    <Color x:Key="Color.Track.6">#5F8300</Color>
    <Color x:Key="Color.Track.7">#00905C</Color>
    <Color x:Key="Color.Track.8">#008CA1</Color>
    <Color x:Key="Color.Beat.Whole">#151922</Color>
    <Color x:Key="Color.Beat.Half">#BA2840</Color>
    <Color x:Key="Color.Beat.Fourth">#006AC5</Color>
    <Color x:Key="Color.Beat.Triplet">#8244BA</Color>
    <Color x:Key="Color.Beat.FifthEighth">#9F8400</Color>
    <Color x:Key="Color.Beat.Sixteenth">#7B849A</Color>
    <Color x:Key="Color.Waveform.Played">#3552DD</Color>
    <Color x:Key="Color.Waveform.Unplayed">#657CE6</Color>
    <Color x:Key="Color.Playhead">#151922</Color>
    <Color x:Key="Color.Node.SelectedOutline">#151922</Color>

    <Color x:Key="Color.OHs.ControlPoint.Normal">#315AC6</Color>
    <Color x:Key="Color.OHs.ControlPoint.Soft">#14786F</Color>
    <Color x:Key="Color.OHs.ControlPoint.Drum">#7843B5</Color>
    <SolidColorBrush x:Key="Brush.OHs.ControlPoint.Normal" Color="{StaticResource Color.OHs.ControlPoint.Normal}" />
    <SolidColorBrush x:Key="Brush.OHs.ControlPoint.Soft" Color="{StaticResource Color.OHs.ControlPoint.Soft}" />
    <SolidColorBrush x:Key="Brush.OHs.ControlPoint.Drum" Color="{StaticResource Color.OHs.ControlPoint.Drum}" />

    <!-- Overlay and shadow -->
    <Color x:Key="Color.Overlay">#59000000</Color>
    <Color x:Key="Color.Shadow">#000000</Color> <!-- NEW -->

    <!-- Action roles. Background rest, .Hovered, .Pressed and a fixed Foreground replace the runtime-computed label colour -->
    <Color x:Key="Color.BalloonButton.Background.Default">#3552DD</Color>
    <Color x:Key="Color.BalloonButton.Background.Default.Hovered">#2D47C4</Color>
    <Color x:Key="Color.BalloonButton.Background.Default.Pressed">#263CA8</Color>
    <Color x:Key="Color.BalloonButton.Foreground.Default">#FFFFFF</Color>
    <Color x:Key="Color.BalloonButton.Background.ConfirmSave">#3552DD</Color> <!-- Same as Default: one primary role -->
    <Color x:Key="Color.BalloonButton.Background.ConfirmSave.Hovered">#2D47C4</Color>
    <Color x:Key="Color.BalloonButton.Background.ConfirmSave.Pressed">#263CA8</Color>
    <Color x:Key="Color.BalloonButton.Foreground.ConfirmSave">#FFFFFF</Color>
    <Color x:Key="Color.BalloonButton.Background.Destructive">#FCE9E9</Color> <!-- Tonal danger -->
    <Color x:Key="Color.BalloonButton.Background.Destructive.Hovered">#F8D9D9</Color>
    <Color x:Key="Color.BalloonButton.Background.Destructive.Pressed">#F2C6C6</Color>
    <Color x:Key="Color.BalloonButton.Foreground.Destructive">#A82525</Color>
    <Color x:Key="Color.BalloonButton.Background.DestructiveSolid">#C22F2F</Color> <!-- NEW: final destructive confirm only -->
    <Color x:Key="Color.BalloonButton.Background.DestructiveSolid.Hovered">#AD2828</Color>
    <Color x:Key="Color.BalloonButton.Background.DestructiveSolid.Pressed">#961F1F</Color>
    <Color x:Key="Color.BalloonButton.Foreground.DestructiveSolid">#FFFFFF</Color>
    <Color x:Key="Color.BalloonButton.Background.Caution">#FFF1D6</Color>
    <Color x:Key="Color.BalloonButton.Background.Caution.Hovered">#FBE3B0</Color>
    <Color x:Key="Color.BalloonButton.Background.Caution.Pressed">#F6D68C</Color>
    <Color x:Key="Color.BalloonButton.Foreground.Caution">#7F4B00</Color>
    <Color x:Key="Color.BalloonButton.Background.NavInfo">#EEF0F5</Color> <!-- Secondary role -->
    <Color x:Key="Color.BalloonButton.Background.NavInfo.Hovered">#E3E7EF</Color>
    <Color x:Key="Color.BalloonButton.Background.NavInfo.Pressed">#D8DDE8</Color>
    <Color x:Key="Color.BalloonButton.Foreground.NavInfo">#151922</Color>
    <Color x:Key="Color.BalloonButton.Border.NavInfo">#C9CFDB</Color>
    <Color x:Key="Color.BalloonButton.Background.Surface">#F7F8FB</Color>
    <Color x:Key="Color.BalloonButton.Background.Surface.Hovered">#E3E7EF</Color>
    <Color x:Key="Color.BalloonButton.Background.Surface.Pressed">#D8DDE8</Color>
    <Color x:Key="Color.BalloonButton.Foreground.Surface">#151922</Color>
    <Color x:Key="Color.BalloonButton.Background.Neutral.Hovered">#E3E7EF</Color> <!-- Ghost role; rest is Transparent -->
    <Color x:Key="Color.BalloonButton.Background.Neutral.Pressed">#D8DDE8</Color>
    <Color x:Key="Color.BalloonButton.Foreground.Neutral">#151922</Color>

    <!-- LEGACY (deprecated). Finance-era keys with no hitsound meaning. Values are the v1 values.
         Delete after a repository search shows no consumers; Light.xaml must drop the same keys. -->
    <Color x:Key="Color.Text.Recurring">#7A4A00</Color>
    <Color x:Key="Color.Background.Recurring">#FFEBD2</Color>
    <Color x:Key="Color.Category.Needs">#2E3440</Color>
    <Color x:Key="Color.Category.Wants">#2E86AB</Color>
    <Color x:Key="Color.Category.Investments">#2C4BC7</Color>
    <Color x:Key="Color.Category.Needs.Dark">#EDEFF2</Color>
    <Color x:Key="Color.Category.Wants.Dark">#E4F1FA</Color>
    <Color x:Key="Color.Category.Investments.Dark">#DCE3F7</Color>
    <Color x:Key="Color.Account.Checking">#2C7FE0</Color>
    <Color x:Key="Color.Account.Cash">#64707E</Color>
    <Color x:Key="Color.Account.Credit">#7259C9</Color>
    <Color x:Key="Color.Account.Saving">#C1841F</Color>
    <Color x:Key="Color.Account.Checking.Inverted">#E1EFFD</Color>
    <Color x:Key="Color.Account.Cash.Inverted">#EDEFF1</Color>
    <Color x:Key="Color.Account.Credit.Inverted">#F0EAFB</Color>
    <Color x:Key="Color.Account.Saving.Inverted">#FBF0DC</Color>
    <Color x:Key="Color.Reserved">#5A6172</Color>

