<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\OHsExportTemplate.osu" LogicalName="Soundie.Resources.OHsExportTemplate.osu" />
    <Compile Remove="CustomControls\**" />
    <EmbeddedResource Remove="CustomControls\**" />
    <None Remove="CustomControls\**" />
    <Page Remove="CustomControls\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <Resource Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Behaviors\" />
    <Folder Include="Extensions\" />
    <Folder Include="Mappings\" />
    <Folder Include="Resources\Converters\" />
    <Folder Include="Resources\CustomControls\" />
    <Folder Include="Resources\DataModels\" />
    <Folder Include="Resources\Fonts\" />
    <Folder Include="Resources\Helpers\" />
    <Folder Include="Resources\Messages\" />
    <Folder Include="Resources\Styles\" />
    <Folder Include="Resources\Themes\" />
    <Folder Include="Services\" />
    <Folder Include="Services\Dialogs\" />
    <Folder Include="Services\FileSystem\" />
    <Folder Include="Services\ProjectFiles\" />
    <Folder Include="Services\Serialization\" />
    <Folder Include="Services\Ui\" />
    <Folder Include="ViewModels\" />
    <Folder Include="ViewModels\Controls\" />
    <Folder Include="ViewModels\CustomControls\" />
    <Folder Include="ViewModels\Entities\" />
    <Folder Include="ViewModels\Popups\" />
    <Folder Include="ViewModels\Shell\" />
    <Folder Include="Views\Popups\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundie.Core\Soundie.Core.csproj" />
  </ItemGroup>

  <Target Name="SeedAppSettingsForBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/appsettings.json" DestinationFiles="$(TargetDir)appsettings.json" Condition="!Exists('$(TargetDir)appsettings.json')" />
  </Target>
  <Target Name="SeedAppSettingsForPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/appsettings.json" DestinationFiles="$(PublishDir)appsettings.json" Condition="!Exists('$(PublishDir)appsettings.json')" />
  </Target>
</Project>
