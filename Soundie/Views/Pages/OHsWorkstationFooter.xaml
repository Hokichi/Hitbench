<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Soundie.Resources.Converters" xmlns:customControls="clr-namespace:Soundie.Resources.CustomControls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:entities="clr-namespace:Soundie.Core.Entities;assembly=Soundie.Core" xmlns:helpers="clr-namespace:Soundie.Resources.Helpers" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:Soundie.Views.Pages" x:Class="Soundie.Views.Pages.OHsWorkstationFooter" d:DesignHeight="600" d:DesignWidth="1100" mc:Ignorable="d">
    <Grid x:Name="ZoomFooter" Style="{StaticResource BaseGridStyle}">
        <WrapPanel VerticalAlignment="Center">
            <StackPanel x:Name="SubdivisionPanel" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                <customControls:ValueSlider x:Name="SubdivisionSelector" AutomationProperties.Name="Beat subdivision" DisplayText="{Binding Subdivision, Mode=OneWay, StringFormat=1/{0}}" IsSnapToTickEnabled="True" LargeChange="1" Maximum="8" Minimum="0" SmallChange="1" Style="{StaticResource BaseValueSliderStyle}" TickFrequency="1" Value="{Binding SelectedSubdivisionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
            </StackPanel>
            <Border Style="{StaticResource OHsWorkstationToolbarSeparatorStyle}"/>
            <StackPanel x:Name="ZoomControls" VerticalAlignment="Center" FlowDirection="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FlowDirection, Mode=OneWay}" Orientation="Horizontal">
                <customControls:BalloonButton AutomationProperties.Name="Zoom waveform out" ButtonIcon="{StaticResource Minus}" Command="{Binding ZoomOutCommand, Mode=OneWay}" Style="{StaticResource OHsBalloonNeutralActionStyle}" ToolTip="Zoom waveform out" Margin="4,0,0,0" ShouldShowText="False"/>
                <customControls:BalloonButton AutomationProperties.Name="Zoom waveform in" ButtonIcon="{StaticResource PlusSolid}" Command="{Binding ZoomInCommand, Mode=OneWay}" Style="{StaticResource OHsBalloonNeutralActionStyle}" ToolTip="Zoom waveform in" Margin="4,0,0,0" ShouldShowText="False"/>
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
