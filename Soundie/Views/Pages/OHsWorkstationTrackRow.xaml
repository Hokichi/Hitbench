<UserControl
    x:Class="Soundie.Views.Pages.OHsWorkstationTrackRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Soundie.Resources.Converters"
    xmlns:customControls="clr-namespace:Soundie.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:Soundie.Core.Entities;assembly=Soundie.Core"
    xmlns:helpers="clr-namespace:Soundie.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Soundie.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OHsWorkstationTrackVolumeTagBorderStyle" TargetType="Border" BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationTrackVolumeTagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsWorkstationTrackVolumeTagTemplate">
            <Border Style="{StaticResource OHsWorkstationTrackVolumeTagBorderStyle}">
                <TextBlock Text="{Binding DisplayText, Mode=OneWay}" Style="{StaticResource OHsWorkstationTrackVolumeTagTextStyle}" />
            </Border>
        </DataTemplate>

        <ObjectDataProvider x:Key="OHsWorkstationTrackRowSource" />
        <Style
            x:Key="OHsWorkstationInstrumentActionStyle"
            BasedOn="{StaticResource OHsBalloonSurfaceActionStyle}"
            TargetType="customControls:BalloonButton" />
        <Style
            x:Key="OHsWorkstationTrackNameStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="IsReadOnly" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="IsReadOnly" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationSampleTrackNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="OHsWorkstationSampleTrackNameTemplate">
            <TextBlock x:Name="SampleTrackName" Style="{StaticResource OHsWorkstationSampleTrackNameStyle}" Text="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" ToolTip="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="OHsWorkstationInstrumentTrackNameTemplate">                    <TextBox
                        AutomationProperties.Name="Track name"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        Loaded="OnTrackNameLoaded"
                        LostKeyboardFocus="OnTrackNameLostFocus"
                        PreviewKeyDown="OnTrackNameKeyDown"
                        Style="{StaticResource OHsWorkstationTrackNameStyle}"
                        Text="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding TrackNameDraft, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
        </DataTemplate>
        <Style x:Key="OHsWorkstationNameHostStyle" TargetType="ContentPresenter" BasedOn="{StaticResource BaseContentPresenterStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource OHsWorkstationSampleTrackNameTemplate}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsInstrumentalTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource OHsWorkstationInstrumentTrackNameTemplate}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMetadataComboBoxStyle"
            BasedOn="{StaticResource OHsComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="IsTabStop" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationInstrumentMutedActionStyle"
            BasedOn="{StaticResource OHsWorkstationInstrumentActionStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackMuted, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackActionsStyle"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}"
            TargetType="customControls:BalloonComboBox">
            <Setter Property="ButtonIcon" Value="{StaticResource BarsSolid}" />
        </Style>
        <DataTemplate x:Key="OHsWorkstationTrackActionHeaderTemplate">
            <StackPanel Orientation="Horizontal" Style="{StaticResource BaseStackPanelStyle}">
                <customControls:Icon
                    Width="16"
                    Height="16"
                    Margin="4"
                    Path="{Binding Icon, RelativeSource={RelativeSource AncestorType=MenuItem}, Mode=OneWay}"
                    Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}, Mode=OneWay}" />
                <TextBlock
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}, Mode=OneWay}"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <Style
            x:Key="OHsWorkstationTrackMenuItemStyle"
            BasedOn="{StaticResource OHsActionMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="HeaderTemplate" Value="{StaticResource OHsWorkstationTrackActionHeaderTemplate}" />
        </Style>
        <Style
            x:Key="OHsWorkstationTrackDeleteMenuItemStyle"
            BasedOn="{StaticResource OHsDestructiveActionMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="HeaderTemplate" Value="{StaticResource OHsWorkstationTrackActionHeaderTemplate}" />
        </Style>
        <Style
            x:Key="OHsWorkstationTrackCollapseMenuStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMenuItemStyle}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="Collapse track" />
            <Setter Property="Icon" Value="{StaticResource CompressAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Header" Value="Expand track" />
                    <Setter Property="Icon" Value="{StaticResource ExpandAlt}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu
            x:Key="OHsWorkstationTrackActionMenu"
            x:Shared="False"
            Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem
                Command="{Binding ViewModel.MoveTrackUpCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Move Up"
                Icon="{StaticResource AngleUp}"
                Style="{StaticResource OHsWorkstationTrackMenuItemStyle}" />
            <MenuItem
                Command="{Binding ViewModel.MoveTrackDownCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Move Down"
                Icon="{StaticResource AngleDown}"
                Style="{StaticResource OHsWorkstationTrackMenuItemStyle}" />
            <MenuItem
                Command="{Binding ViewModel.BeginTrackRenameCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Rename"
                Icon="{StaticResource Pen}"
                Style="{StaticResource OHsWorkstationTrackMenuItemStyle}" />
            <MenuItem
                Command="{Binding ViewModel.ToggleTrackCollapsedCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource OHsWorkstationTrackCollapseMenuStyle}" />
            <MenuItem
                Command="{Binding ViewModel.RemoveTrackCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Header="Delete Track"
                Icon="{StaticResource Delete}"
                IsEnabled="{Binding ViewModel.CanRemoveTrack, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                Style="{StaticResource OHsWorkstationTrackDeleteMenuItemStyle}" />
        </ContextMenu>
        <BlurEffect x:Key="OHsWorkstationMissingBlur" Radius="4" />
        <Style
            x:Key="OHsWorkstationGridContentStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Effect" Value="{StaticResource OHsWorkstationMissingBlur}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMutedContentStyle"
            BasedOn="{StaticResource OHsWorkstationGridContentStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackMuted, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationSampleFileSelectorStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationExpandedTrackControlsStyle"
            BasedOn="{StaticResource BaseStackPanelStyle}"
            TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackCollapsed, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationCompactVolumeStyle"
            BasedOn="{StaticResource BaseValueSliderStyle}"
            TargetType="customControls:ValueSlider">
            <Setter Property="Height" Value="{StaticResource Size.Control.Primary}" />
        </Style>
        <Style
            x:Key="OHsWorkstationActionRegionStyle"
            BasedOn="{StaticResource BaseColumnDefinitionStyle}"
            TargetType="ColumnDefinition">
            <Setter Property="Width" Value="48" />
        </Style>
        <Style
            x:Key="OHsWorkstationActionColumnStyle"
            BasedOn="{StaticResource BaseColumnDefinitionStyle}"
            TargetType="ColumnDefinition">
            <Setter Property="Width" Value="40" />
        </Style>
        <DataTemplate x:Key="OHsWorkstationTrackLeftTemplate">
            <StackPanel
                x:Name="TrackLeftControls"
                Margin="0,8"
                VerticalAlignment="Center"
                Loaded="OnTrackControlStackLoaded"
                SizeChanged="OnTrackControlStackSizeChanged"
                Style="{StaticResource BaseStackPanelStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=" *" />
                        <ColumnDefinition Style="{StaticResource OHsWorkstationActionRegionStyle}" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Mode=OneWay}" Style="{StaticResource OHsWorkstationNameHostStyle}"/>
                    <customControls:BalloonComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Track actions"
                        Loaded="OnActionMenuLoaded"
                        Style="{StaticResource OHsWorkstationTrackActionsStyle}"
                        ToolTip="Track actions" />
                </Grid>
                <StackPanel
                    x:Name="TrackLeftExpandedControls"
                    Margin="0,4,0,0"
                    Style="{StaticResource OHsWorkstationExpandedTrackControlsStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Style="{StaticResource OHsWorkstationActionColumnStyle}" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Style="{StaticResource OHsWorkstationActionColumnStyle}" />
                        </Grid.ColumnDefinitions>
                        <customControls:ValueSlider
                            x:Name="VolumeSlider"
                            ShowValueTag="True" ValueTagTemplate="{StaticResource OHsWorkstationTrackVolumeTagTemplate}"
                            helpers:KeyboardNavigationPolicy.AllowTabNavigation="True"
                            AutomationProperties.Name="Track volume percent"
                            DataContextChanged="OnTrackControlDataContextChanged"
                            DisplayText="{Binding ElementName=VolumeSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}%}"
                            FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                            IsEnabled="{Binding ViewModel.CanImportSample, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                            IsMoveToPointEnabled="True"
                            IsSnapToTickEnabled="True"
                            IsTabStop="True"
                            LargeChange="5"
                            Loaded="OnVolumeSliderLoaded"
                            Maximum="200"
                            Minimum="5"
                            SmallChange="1"
                            Style="{StaticResource OHsWorkstationCompactVolumeStyle}"
                            TickFrequency="1"
                            ToolTip="Track volume percent"
                            ValueChanged="OnVolumeValueChanged" />
                        <ToggleButton
                            x:Name="TrackMuteToggle"
                            Grid.Column="2"
                            AutomationProperties.Name="Mute track"
                            Checked="OnTrackAuditionChanged"
                            Content="M"
                            DataContextChanged="OnTrackControlDataContextChanged"
                            IsEnabled="{Binding ViewModel.CanPlaceSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                            Loaded="OnTrackAuditionLoaded"
                            Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                            ToolTip="Mute track"
                            Unchecked="OnTrackAuditionChanged" />
                        <ToggleButton
                            x:Name="TrackSoloToggle"
                            Grid.Column="4"
                            AutomationProperties.Name="Solo track"
                            Checked="OnTrackAuditionChanged"
                            Content="S"
                            DataContextChanged="OnTrackControlDataContextChanged"
                            IsEnabled="{Binding ViewModel.CanPlaceSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                            Loaded="OnTrackAuditionLoaded"
                            Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                            ToolTip="Solo track"
                            Unchecked="OnTrackAuditionChanged" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OHsWorkstationSampleTrackTemplate">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationRightColumnWidth}" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Content="{Binding Mode=OneWay}"
                    ContentTemplate="{StaticResource OHsWorkstationTrackLeftTemplate}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <Border
                    Grid.Column="2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1,0"
                    Style="{StaticResource BaseBorderStyle}">
                    <Grid
                        x:Name="TrackGridHost"
                        DataContextChanged="OnTrackGridHostDataContextChanged"
                        Loaded="OnTrackGridHostLoaded"
                        Style="{StaticResource BaseGridStyle}">
                        <Grid x:Name="TrackGridContent" Style="{StaticResource OHsWorkstationTrackMutedContentStyle}">
                            <customControls:BeatGridView
                                Height="{Binding CurrentTrackExtent, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                AllowNodeCreation="{Binding ViewModel.IsAdditionMode, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                AutomationProperties.HelpText="Use Left and Right to move playback. Enter places or selects a node. In Selection Mode, drag empty timeline space to select nodes across tracks. Control+click or Control+Enter toggles selection; Control+drag does nothing. Escape cancels an active drag and keeps selection; press Escape again to clear selection. Selecting nodes disables Scroll with marker. Delete removes selected nodes; Control+C copies and Control+V pastes on original tracks at the marker, preserving spacing and discarding nodes beyond the audio end. Alt+Left or Right moves selected nodes; Alt+Up or Down changes tracks. Drag nodes to move them."
                                AutomationProperties.Name="Track sample placement timeline"
                                Bpms="{Binding ViewModel.Project.BPMs, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                CanPlaceSamples="{Binding ViewModel.CanPlaceSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ContentWidth="{Binding TimelineContentWidth, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                FocusBrush="{DynamicResource Brush.Text.Primary}"
                                HorizontalOffset="{Binding TimelineHorizontalOffset, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                HoverBrush="{DynamicResource Brush.Background.Hover}"
                                IsNodeDragActive="{Binding ViewModel.IsNodeDragActive, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                KeyboardNavigation.IsTabStop="True"
                                MarkerBrush="{Binding TrackBrush, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                Offsets="{Binding ViewModel.Project.Offsets, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                PlaybackMarkerBrush="{DynamicResource Brush.Playhead}"
                                PlaybackMarkerOutlineBrush="{DynamicResource Brush.Background.Deepened}"
                                Position="{Binding ViewModel.Position, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                PressedBrush="{DynamicResource Brush.Navy}"
                                SamplePlacementRequested="OnSamplePlacementRequested"
                                SampleRemovalRequested="OnSampleRemovalRequested"
                                SampleSelectionRequested="OnSampleSelectionRequested"
                                Samples="{Binding Samples, Mode=OneWay}"
                                SamplesRevision="{Binding ViewModel.SamplesRevision, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                SelectedSamples="{Binding ViewModel.SelectedSamples, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                SelectionBrush="{DynamicResource Brush.Navy}"
                                SelectionCueBrush="{DynamicResource Brush.Node.SelectedOutline}"
                                Subdivision="{Binding ViewModel.Subdivision, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ViewportWidth="{Binding TimelineViewportWidth, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ZoomFactor="{Binding ViewModel.ZoomFactor, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                Duration="{Binding ViewModel.Waveform.Duration, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel
                    x:Name="TrackRightControls"
                    Grid.Column="4"
                    Margin="0,8"
                    VerticalAlignment="Center"
                    Loaded="OnTrackControlStackLoaded"
                    SizeChanged="OnTrackControlStackSizeChanged"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <ComboBox
                        x:Name="TrackSampleFileSelector"
                        AutomationProperties.Name="Track sample"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding ViewModel.CanImportSample, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        ItemsSource="{Binding ViewModel.SampleFiles, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                        Loaded="OnSampleSelectorLoaded"
                        SelectionChanged="OnSampleSelectionChanged"
                        Style="{StaticResource OHsWorkstationSampleFileSelectorStyle}"
                        ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                    <StackPanel x:Name="TrackRightExpandedControls" Style="{StaticResource OHsWorkstationExpandedTrackControlsStyle}">
                        <Grid Style="{StaticResource BaseGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="TrackAdditionSelector"
                                AutomationProperties.Name="Sampleset"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ItemsSource="{x:Static entities:Track.AdditionOptions}"
                                Loaded="OnTrackMetadataSelectorLoaded"
                                SelectionChanged="OnTrackMetadataSelectionChanged"
                                Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                                ToolTip="Sampleset" />
                            <ComboBox
                                x:Name="TrackSampleTypeSelector"
                                Grid.Column="2"
                                AutomationProperties.Name="Track sample type"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding ViewModel.CanEditTracks, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                                ItemsSource="{x:Static entities:Track.SampleTypeOptions}"
                                Loaded="OnTrackMetadataSelectorLoaded"
                                SelectionChanged="OnTrackMetadataSelectionChanged"
                                Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                                ToolTip="Track sample type" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OHsWorkstationInstrumentalTrackTemplate">
            <Grid Height="{Binding CurrentTrackExtent, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationRightColumnWidth}" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Content="{Binding Mode=OneWay}"
                    ContentTemplate="{StaticResource OHsWorkstationTrackLeftTemplate}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <customControls:BalloonButton
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    helpers:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.HelpText="Map at least one key before opening the arrangement."
                    AutomationProperties.Name="View Arrangement"
                    ButtonIcon="{StaticResource Eye}"
                    ButtonText="View Arrangement"
                    Command="{Binding ViewModel.ViewArrangementCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    HasIcon="False"
                    IsTabStop="True"
                    ShouldShowText="True"
                    Style="{StaticResource OHsWorkstationInstrumentMutedActionStyle}"
                    ToolTip="Edit instrumental notes (map at least one key first)"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                <customControls:BalloonButton
                    Grid.Column="4"
                    Height="Auto"
                    VerticalAlignment="Stretch"
                    helpers:KeyboardNavigationPolicy.AllowTabNavigation="True"
                    AutomationProperties.Name="Keys Mapping"
                    ButtonIcon="{StaticResource KeyboardBoxFill}"
                    ButtonText="Mapping"
                    Command="{Binding ViewModel.KeysMappingCommand, Source={StaticResource OHsWorkstationTrackRowSource}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                    IsTabStop="True"
                    ShouldShowText="True"
                    Style="{StaticResource OHsWorkstationInstrumentActionStyle}"
                    ToolTip="Map samples to instrument keys"
                    ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
            </Grid>
        </DataTemplate>
        <helpers:WorkstationTrackTemplateSelector
            x:Key="OHsWorkstationTrackTemplateSelector"
            InstrumentalTrackTemplate="{StaticResource OHsWorkstationInstrumentalTrackTemplate}"
            SampleTrackTemplate="{StaticResource OHsWorkstationSampleTrackTemplate}" />
    </UserControl.Resources>
    <ContentPresenter
        x:Name="RowContent"
        Content="{Binding Track, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackRow}, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource OHsWorkstationTrackTemplateSelector}" />
</UserControl>
