<UserControl x:Class="Soundie.Views.Popups.OHsControlPointEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Soundie.Resources.CustomControls"
 xmlns:p="clr-namespace:Soundie.Views.Popups"
 xmlns:h="clr-namespace:Soundie.Resources.Helpers"
 xmlns:e="clr-namespace:Soundie.Core.Entities;assembly=Soundie.Core">
 <UserControl.Resources>
  <Style x:Key="OHsControlPointEditorSurfaceStyle" TargetType="Border" BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}">
   <Setter Property="Padding" Value="16" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" /><Setter Property="BorderThickness" Value="1" />
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsControlPointEditorVolumeStyle" TargetType="c:NumericUpDown" BasedOn="{StaticResource {x:Type c:NumericUpDown}}">
   <Setter Property="IsIntegerOnly" Value="True" /><Setter Property="LowerLimit" Value="5" /><Setter Property="UpperLimit" Value="100" />
   <Setter Property="Step" Value="1" /><Setter Property="ClampIntegerToRange" Value="False" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
   <Setter Property="AutomationProperties.HelpText" Value="Enter a whole-number volume from 5 to 100 percent. Accepted legacy volume is preserved until you edit." />
  </Style>
  <Style x:Key="OHsControlPointEditorSamplesetStyle" TargetType="ComboBox" BasedOn="{StaticResource OHsComboBoxStyle}">
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="IsTabStop" Value="True" />
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource OHsControlPointEditorSurfaceStyle}">
  <StackPanel Style="{StaticResource BaseStackPanelStyle}" KeyboardNavigation.TabNavigation="Continue">
   <c:NumericUpDown x:Name="VolumeInput" Style="{StaticResource OHsControlPointEditorVolumeStyle}" AutomationProperties.Name="Control point volume in percent" />
   <ComboBox x:Name="SamplesetInput" Margin="0,12,0,0" Style="{StaticResource OHsControlPointEditorSamplesetStyle}" ItemsSource="{x:Static e:ControlPoint.SamplesetOptions}" SelectionChanged="OnSamplesetChanged" AutomationProperties.Name="Control point sampleset" />
  </StackPanel>
 </Border>
</UserControl>
