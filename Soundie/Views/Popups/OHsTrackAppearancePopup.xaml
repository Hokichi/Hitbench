<c:BasePopup x:Class="Soundie.Views.Popups.OHsTrackAppearancePopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Soundie.Resources.CustomControls" xmlns:h="clr-namespace:Soundie.Resources.Helpers"
 PopupTitle="Change Name and Color" ShowCloseButton="False" Width="420" MinWidth="320">
 <c:BasePopup.Resources>
  <Style x:Key="OHsTrackAppearanceColorPickerStyle" TargetType="c:OHsColorPicker" BasedOn="{StaticResource BaseControlStyle}">
   <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
    <Trigger Property="IsMouseCaptured" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy.Pressed}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.4"/></Trigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OHsTrackAppearanceHueStyle" TargetType="c:ValueSlider" BasedOn="{StaticResource BaseValueSliderStyle}">
   <Setter Property="IsTabStop" Value="True"/><Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
  </Style>
  <LinearGradientBrush x:Key="OHsTrackAppearanceHueRamp" StartPoint="0,0.5" EndPoint="1,0.5">
   <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.1666667"/><GradientStop Color="#00FF00" Offset="0.3333333"/>
   <GradientStop Color="#00FFFF" Offset="0.5"/><GradientStop Color="#0000FF" Offset="0.6666667"/><GradientStop Color="#FF00FF" Offset="0.8333333"/><GradientStop Color="#FF0000" Offset="1"/>
  </LinearGradientBrush>
 </c:BasePopup.Resources>
 <Grid Margin="24" Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="180"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBox x:Name="NameInput" Style="{StaticResource RoundedTextInputStyle}" AutomationProperties.Name="Track name"
   h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  <c:OHsColorPicker x:Name="ColorInput" Grid.Row="2" Style="{StaticResource OHsTrackAppearanceColorPickerStyle}" AutomationProperties.Name="Track color"
   SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  <StackPanel Grid.Row="4" Style="{StaticResource BaseStackPanelStyle}">
   <Border Height="8" Background="{StaticResource OHsTrackAppearanceHueRamp}" IsHitTestVisible="False" Style="{StaticResource BaseBorderStyle}"/>
   <c:ValueSlider AutomationProperties.Name="Hue" Style="{StaticResource OHsTrackAppearanceHueStyle}" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
    Value="{Binding Hue, ElementName=ColorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
   <Border Height="24" Background="{Binding Color, Mode=OneWay}" BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="1" Style="{StaticResource BaseBorderStyle}" IsHitTestVisible="False"/>
  </StackPanel>
  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource BaseStackPanelStyle}">
   <c:BalloonButton ButtonText="Cancel" ButtonIcon="{StaticResource Ban}" AutomationProperties.Name="Cancel" ShouldShowText="True" Style="{StaticResource OHsBalloonDestructiveActionStyle}" Click="OnCancel" Margin="0,0,8,0"/>
   <c:BalloonButton ButtonText="Save" ButtonIcon="{StaticResource Check}" AutomationProperties.Name="Save" ShouldShowText="True" Style="{StaticResource OHsBalloonConfirmActionStyle}" Click="OnSave" IsEnabled="{Binding CanSave, Mode=OneWay}"/>
  </StackPanel>
 </Grid>
</c:BasePopup>
