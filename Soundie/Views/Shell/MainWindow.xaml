<Window
    x:Class="Soundie.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Soundie.Views.Shell"
    xmlns:customControls="clr-namespace:Soundie.Resources.CustomControls"
    Title="Soundie"
    Width="1280"
    Height="720"
    MinWidth="640"
    MinHeight="360"
    Deactivated="OnWindowDeactivated"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <Style
            x:Key="OHsMainWindowSampleManagerHostStyle"
            BasedOn="{StaticResource BaseContentControlStyle}"
            TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Width" Value="720" />
            <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=SampleManagerLayer, Mode=OneWay}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsMainWindowShellDrawerHostStyle" TargetType="ContentControl" BasedOn="{StaticResource OHsMainWindowSampleManagerHostStyle}">
            <Setter Property="Grid.RowSpan" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomDrawer, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Width" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsMainWindowKeysMappingDrawerHostStyle" TargetType="ContentControl" BasedOn="{StaticResource OHsMainWindowSampleManagerHostStyle}">
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MaxHeight" Value="{Binding ActualHeight, ElementName=SampleManagerMotionHost, Mode=OneWay}"/>
        </Style>
        <SolidColorBrush x:Key="OHsMainWindowAcrylicBackground" Color="Transparent" />

        <Style
            x:Key="MainWindowStyle"
            BasedOn="{StaticResource BaseWindowStyle}"
            TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Main}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcrylicEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OHsMainWindowAcrylicBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowRootStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Main}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcrylicEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OHsMainWindowAcrylicBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <BlurEffect x:Key="MainWindowScanBlur" Radius="8" />
        <Style x:Key="OHsMainWindowHeaderScanBlurStyle" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowScanContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInteractionBlocked, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMainWindowHeaderStatusOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <BlurEffect x:Key="MainWindowModalBlur" Radius="8" />
        <Style
            x:Key="OHsMainWindowSampleManagerContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBlockingDrawerVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowModalBlur}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMainWindowSampleManagerLayerStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSampleManagerVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMainWindowSampleManagerBackdropStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="Dismiss active drawer" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomDrawer, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowModalContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPopupOverlayVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowModalBlur}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            <DataTrigger Binding="{Binding PopupOverlayUsesBlur, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="False"><Setter Property="Effect" Value="{x:Null}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowModalOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPopupOverlayVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            <DataTrigger Binding="{Binding PopupOverlayUsesBlur, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="False"><Setter Property="Background" Value="Black"/><Setter Property="Opacity" Value="{Binding PopupOverlayOpacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsMainWindowAudioBusyToastStyle" TargetType="Border" BasedOn="{StaticResource OHsPopupSurfaceBorderStyle}">
            <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsMainWindowAudioBusyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="MainWindowStyle" />
    </Window.Style>
    <Border
        x:Name="ShellRoot"
        MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"
        Style="{StaticResource MainWindowRootStyle}">
        <Grid>
            <Border x:Name="ModalShellContent" Style="{StaticResource MainWindowModalContentStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Border x:Name="SampleManagerAppContent" Style="{StaticResource OHsMainWindowSampleManagerContentStyle}">
                        <Grid x:Name="ShellLayout">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource BaseGridStyle}">
                                <Border x:Name="HeaderScanBlurHost" Style="{StaticResource OHsMainWindowHeaderScanBlurStyle}">
                                    <Border x:Name="HeaderVolumeBlurHost" Style="{StaticResource BaseBorderStyle}">
                                        <shell:OHsShellHeader x:Name="ShellHeader"
                                            GoBackRequested="OnGoBackClick" MinimizeRequested="OnMinimizeClick"
                                            MaximizeRestoreRequested="OnMaximizeRestoreClick" CloseRequested="OnCloseClick" />
                                    </Border>
                                </Border>
                                <Border x:Name="HeaderProcessingOverlay" IsHitTestVisible="False"
                                    Style="{StaticResource MainWindowProcessingOverlayStyle}" />
                                <Border x:Name="HeaderWorkstationOverlay" Style="{StaticResource OHsMainWindowHeaderStatusOverlayStyle}" />
                            </Grid>
                            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                                <Border FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Style="{StaticResource MainWindowScanContentStyle}">
                                    <ContentControl x:Name="PageHost" />
                                </Border>
                                <Border FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Style="{StaticResource MainWindowProcessingOverlayStyle}">
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="SampleManagerLayer" Style="{StaticResource OHsMainWindowSampleManagerLayerStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding ActualHeight, ElementName=ShellHeader, Mode=OneWay}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="SampleManagerBackdrop"
                            Grid.RowSpan="2"
                            MouseLeftButtonDown="OnSampleManagerBackdropClick"
                            Style="{StaticResource OHsMainWindowSampleManagerBackdropStyle}" />
                        <Grid
                            x:Name="SampleManagerMotionHost"
                            Grid.Row="1"
                            Style="{StaticResource BaseGridStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <ContentControl
                                x:Name="SampleManagerHost"
                                FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                Style="{StaticResource OHsMainWindowShellDrawerHostStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="ModalShellOverlay" Style="{StaticResource MainWindowModalOverlayStyle}" />
            <Border x:Name="AudioBusyToast" Style="{StaticResource OHsMainWindowAudioBusyToastStyle}" AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{Binding AudioBusyText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Style="{StaticResource OHsMainWindowAudioBusyTextStyle}" Text="{Binding AudioBusyText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </Border>
        </Grid>
    </Border>
</Window>
