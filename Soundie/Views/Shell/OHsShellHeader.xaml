<UserControl
    x:Class="Soundie.Views.Shell.OHsShellHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:Soundie.Resources.CustomControls"
    xmlns:helpers="clr-namespace:Soundie.Resources.Helpers"
    xmlns:shell="clr-namespace:Soundie.Views.Shell">
    <UserControl.Resources>
        <Style x:Key="OHsShellHeaderAudioActionsStyle" TargetType="StackPanel" BasedOn="{StaticResource BaseStackPanelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudioBusy, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OHsMainWindowGoBackStyle"
            BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style
            x:Key="OHsShellHeaderHomeSeparatorStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowTitleStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsShellThemeToggleTemplate" TargetType="ToggleButton">
            <Grid Style="{StaticResource BaseGridStyle}" Background="Transparent">
                <Border Style="{StaticResource BaseBorderStyle}" Width="40" Height="20" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <Ellipse x:Name="Thumb" Width="8" Height="8" Margin="4" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="22"/></Setter.Value></Setter></Trigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True"/>
                    <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation), Mode=OneWay}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="ThemeTrue"><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="22" Duration="0:0:0.14" FillBehavior="Stop"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ThemeTrue"/></MultiDataTrigger.ExitActions></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="False"/>
                    <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation), Mode=OneWay}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="ThemeFalse"><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="22" To="0" Duration="0:0:0.14" FillBehavior="Stop"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ThemeFalse"/></MultiDataTrigger.ExitActions></MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="OHsShellThemeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseToggleButtonStyle}">
            <Setter Property="Template" Value="{StaticResource OHsShellThemeToggleTemplate}"/>
            <Setter Property="Width" Value="40"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/><Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Navy}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Pressed}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/></Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Brush.Navy.Pressed}"/></MultiTrigger>
                <DataTrigger Binding="{Binding ThemeService.IsChangingTheme, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8" LastChildFill="True">

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <TextBlock Margin="12,0" Style="{StaticResource MainWindowTitleStyle}" Text="Soundie"/>
            <Border Style="{StaticResource OHsShellHeaderHomeSeparatorStyle}"/>
            <ToggleButton x:Name="ThemeSwitch" AutomationProperties.Name="Light theme" ToolTip="Toggle Dark / Light theme" IsChecked="{Binding IsLightTheme, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}" Click="OnThemeToggleClick" Style="{StaticResource OHsShellThemeToggleStyle}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <StackPanel x:Name="WorkstationActions" Orientation="Horizontal" Style="{StaticResource OHsShellHeaderAudioActionsStyle}">
                <customControls:BalloonButton
                    x:Name="GoBackButton"
                    AutomationProperties.Name="Return home"
                    ButtonIcon="{StaticResource Home}"
                    ButtonText="Return home"
                    Click="OnGoBackClick"
                    IsEnabled="{Binding CanGoBack, RelativeSource={RelativeSource AncestorType=shell:OHsShellHeader}, Mode=OneWay}"
                    Style="{StaticResource OHsMainWindowGoBackStyle}"
                    ToolTip="Save project and return to home" />
                <Border Style="{StaticResource OHsShellHeaderHomeSeparatorStyle}" />
            </StackPanel>
            <customControls:BalloonButton
                x:Name="MinimizeButton"
                AutomationProperties.Name="Minimize"
                ButtonIcon="{StaticResource Minus}"
                ButtonText="Minimize"
                Click="OnMinimizeClick"
                Style="{StaticResource OHsBalloonNeutralActionStyle}"
                ToolTip="Minimize" />
            <customControls:BalloonButton
                x:Name="MaximizeRestoreButton"
                AutomationProperties.Name="Maximize"
                ButtonIcon="{StaticResource ExpandAlt}"
                ButtonText="Maximize"
                Click="OnMaximizeRestoreClick"
                Style="{StaticResource OHsBalloonNeutralActionStyle}"
                ToolTip="Maximize" />
            <customControls:BalloonButton
                x:Name="CloseButton"
                AutomationProperties.Name="Close"
                ButtonIcon="{StaticResource Close}"
                ButtonText="Close"
                Click="OnCloseClick"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                ToolTip="Close" />
        </StackPanel>

    </DockPanel>
</UserControl>
