<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="BaseBorderStyle" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="SnapsToDevicePixels" Value="True" /></Style>

<Style x:Key="CardBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Padding" Value="16" /><Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
<Style x:Key="VerticalSeparatorBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="1" /><Setter Property="Margin" Value="12,0" /><Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" /></Style>
<Style x:Key="HeaderVerticalSeparatorBorderStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="1" /><Setter Property="Margin" Value="16,0,8,0" /><Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" /><Setter Property="SnapsToDevicePixels" Value="True" /></Style>

</ResourceDictionary>
