<ResourceDictionary xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Control.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseButtonStyle"
        TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="FolderActionButtonTemplate"
        TargetType="Button">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8"
            Style="{StaticResource BaseBorderStyle}">
            <ContentPresenter
                x:Name="SongContent"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                Style="{StaticResource BaseContentPresenterStyle}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SongContent" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="FolderActionButtonStyle"
        BasedOn="{StaticResource BaseButtonStyle}"
        TargetType="Button">
        <Setter Property="Template" Value="{StaticResource FolderActionButtonTemplate}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
            </Trigger>

            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseRepeatButtonStyle"
        TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseToggleButtonStyle"
        TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseCheckBoxStyle"
        TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseRadioButtonStyle"
        TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonControlStyle"
        TargetType="{x:Type c:BalloonControl}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
    </Style>
    <ItemsPanelTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonStateItemsPanelTemplate">
        <StackPanel />
    </ItemsPanelTemplate>
    <DataTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonStateItemTemplate">
        <c:BalloonButton
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            ButtonIcon="{Binding ButtonIcon}"
            ButtonSize="40"
            ButtonText="{Binding ButtonText}"
            CommandParameter="{Binding}"
            CornerRadius="{Binding Tag.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
            DefaultBackground="{Binding DefaultBackground}"
            HoveredBackground="{Binding HoverBackground}"
            IconSize="{Binding Tag.IconSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
            ShouldExpand="True"
            ShouldShowText="False" />
    </DataTemplate>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BalloonControlTemplate"
        TargetType="{x:Type c:BalloonControl}">
        <Grid>
            <!--  Balloon shape  -->
            <Path
                x:Name="PART_Shape"
                Fill="{TemplateBinding DefaultBackground}"
                Stroke="{TemplateBinding StrokeBrush}"
                StrokeThickness="{TemplateBinding StrokeThickness}" />
            <!--  Pressed overlay shares geometry with PART_Shape via code-behind  -->
            <Path
                x:Name="PART_Overlay"
                Fill="{DynamicResource Brush.Overlay}"
                IsHitTestVisible="False"
                Opacity="0" />
            <!--  Content area, inset by Padding to clear the bulging edges  -->
            <Grid
                x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Grid
                        x:Name="PART_IconSlot"
                        Width="{TemplateBinding IconSize}"
                        VerticalAlignment="Center">
                        <Path
                            x:Name="PART_Icon"
                            Width="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Stretch="Uniform">
                            <Path.Fill>
                                <Binding
                                    Converter="{StaticResource BackgroundToForegroundConverter}"
                                    ElementName="PART_Shape"
                                    Path="Fill" />
                            </Path.Fill>
                        </Path>
                    </Grid>
                    <Border
                        x:Name="PART_TextReveal"
                        Width="0"
                        ClipToBounds="True"
                        Opacity="0">
                        <StackPanel
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="PART_ButtonText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Bold}"
                                FontSize="{TemplateBinding FontSize}"
                                Opacity="0"
                                Text="{TemplateBinding ButtonText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap">
                                <TextBlock.Foreground>
                                    <Binding
                                        Converter="{StaticResource BackgroundToForegroundConverter}"
                                        ElementName="PART_Shape"
                                        Path="Fill" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock
                                x:Name="PART_SubText"
                                Margin="8,2,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource Light}"
                                FontSize="10"
                                Opacity="0"
                                Text="{TemplateBinding SubText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Visibility="Collapsed">
                                <TextBlock.Foreground>
                                    <Binding
                                        Converter="{StaticResource BackgroundToForegroundConverter}"
                                        ElementName="PART_Shape"
                                        Path="Fill" />
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Popup
                x:Name="PART_StatePopup"
                HorizontalAlignment="Right"
                AllowsTransparency="True"
                HorizontalOffset="4"
                Placement="Bottom"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                PopupAnimation="None"
                StaysOpen="False">
                <Border Padding="4" Background="#01000000">
                    <ItemsControl x:Name="PART_StateItems" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <ItemsControl.ItemsPanel>
                            <StaticResource ResourceKey="BalloonStateItemsPanelTemplate" />
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="BalloonStateItemTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PART_Overlay" Property="Opacity" Value="0.3" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonControlStyle}"
        TargetType="{x:Type c:BalloonControl}">
        <Setter Property="Background" Value="{Binding DefaultBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=ButtonSize}" />
        <Setter Property="Template" Value="{StaticResource BalloonControlTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{Binding HoveredBackground, RelativeSource={RelativeSource Self}}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonButtonStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonButtonStyle}"
        TargetType="{x:Type c:BalloonButton}" />
    <Style
        x:Key="OHsBalloonActionStyle"
        BasedOn="{StaticResource BaseBalloonButtonStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="ButtonSize" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="CurveHeight" Value="8" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="DefaultBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="HoveredBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="StrokeThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="OHsBalloonNeutralActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
    </Style>
    <Style
        x:Key="OHsBalloonDefaultActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Default}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Default.Hovered}" />
    </Style>
    <Style
        x:Key="OHsBalloonConfirmActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.ConfirmSave}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.ConfirmSave.Hovered}" />
    </Style>
    <Style
        x:Key="OHsBalloonDestructiveActionStyle"
        BasedOn="{StaticResource OHsBalloonActionStyle}"
        TargetType="{x:Type c:BalloonButton}">
        <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive}" />
        <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Destructive.Hovered}" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonToggleStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonToggle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonToggleStyle}"
        TargetType="{x:Type c:BalloonToggle}" />
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonCheckBoxStyle"
        BasedOn="{StaticResource {x:Type c:BalloonControl}}"
        TargetType="{x:Type c:BalloonCheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonCheckBoxStyle}"
        TargetType="{x:Type c:BalloonCheckBox}">
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.Navy}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{Binding CheckedBackground, RelativeSource={RelativeSource Self}}" />
                <Setter Property="StrokeThickness" Value="2" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{Binding HoveredBackground, RelativeSource={RelativeSource Self}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseBalloonRadioButtonStyle"
        BasedOn="{StaticResource {x:Type c:BalloonCheckBox}}"
        TargetType="{x:Type c:BalloonRadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseBalloonRadioButtonStyle}"
        TargetType="{x:Type c:BalloonRadioButton}" />

    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseSwipeRevealContainerStyle"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRevealContentPresenterStyle"
        BasedOn="{StaticResource BaseContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeLeftRevealContentPresenterStyle"
        BasedOn="{StaticResource SwipeRevealContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLeftContentRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRightRevealContentPresenterStyle"
        BasedOn="{StaticResource SwipeRevealContentPresenterStyle}"
        TargetType="ContentPresenter">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRightContentRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SwipeRevealContainerTemplate"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Grid ClipToBounds="True">
            <!--  Left action (revealed on swipe right)  -->
            <ContentPresenter
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{TemplateBinding LeftContent}">
                <ContentPresenter.Style>
                    <StaticResource ResourceKey="SwipeLeftRevealContentPresenterStyle" />
                </ContentPresenter.Style>
            </ContentPresenter>
            <!--  Right action (revealed on swipe left)  -->
            <ContentPresenter
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{TemplateBinding RightContent}">
                <ContentPresenter.Style>
                    <StaticResource ResourceKey="SwipeRightRevealContentPresenterStyle" />
                </ContentPresenter.Style>
            </ContentPresenter>
            <!--  Main slideable content  -->
            <Border x:Name="PART_ContentBorder" Background="Transparent">
                <ContentPresenter Content="{TemplateBinding Content}" />
            </Border>
        </Grid>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseSwipeRevealContainerStyle}"
        TargetType="{x:Type c:SwipeRevealContainer}">
        <Setter Property="Template" Value="{StaticResource SwipeRevealContainerTemplate}" />
    </Style>






    <Style
        x:Key="OHsPopupCloseActionStyle"
        BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}"
        TargetType="c:BalloonButton">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="ShouldShowText" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="ToolTip" Value="Close (Esc)" />
        <Setter Property="AutomationProperties.Name" Value="Close" />
    </Style>
        <ControlTemplate x:Key="OHsTimelineEditingModeButtonTemplate" TargetType="RadioButton">
            <Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border
                    x:Name="ModeCue"
                    Height="3"
                    Margin="8,0,8,4"
                    VerticalAlignment="Bottom"
                    Background="{TemplateBinding Foreground}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ModeCue" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsTimelineEditingModeButtonStyle"
            BasedOn="{StaticResource BaseRadioButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="Template" Value="{StaticResource OHsTimelineEditingModeButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
</ResourceDictionary>
