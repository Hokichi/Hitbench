            <Grid Background="Transparent">
                <Border
                    x:Name="SelectedStrip"
                    Width="4"
                    Margin="0,8"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Navy}"
                    CornerRadius="0 4 4 0"
                    Visibility="Collapsed" />
                <StackPanel
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
