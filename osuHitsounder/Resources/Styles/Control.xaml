<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="BaseControlStyle" TargetType="Control" />
    <Style
        x:Key="DefaultFocusVisualStyle"
        BasedOn="{StaticResource BaseControlStyle}"
        TargetType="Control">
        <Setter Property="Template" Value="{x:Null}" />
    </Style>

    <ControlTemplate x:Key="OHsSampleManagerKeyboardFocusTemplate" TargetType="Control">
        <Border x:Name="FocusMarker" Height="2" Margin="4,0,4,0" VerticalAlignment="Bottom"
                IsHitTestVisible="False" Background="{DynamicResource Brush.Text.Primary}"
                Style="{StaticResource BaseBorderStyle}" />
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="FocusMarker" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="OHsSampleManagerKeyboardFocusStyle" TargetType="Control" BasedOn="{StaticResource DefaultFocusVisualStyle}">
        <Setter Property="Template" Value="{StaticResource OHsSampleManagerKeyboardFocusTemplate}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>
</ResourceDictionary>
