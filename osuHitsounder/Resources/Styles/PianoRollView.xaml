<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers">
 <Style x:Key="BasePianoRollViewStyle" TargetType="c:PianoRollView" BasedOn="{StaticResource BaseControlStyle}">
  <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
  <Setter Property="Focusable" Value="True"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FontFamily" Value="{DynamicResource Regular}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="c:PianoRollView" BasedOn="{StaticResource BasePianoRollViewStyle}"/>
</ResourceDictionary>
