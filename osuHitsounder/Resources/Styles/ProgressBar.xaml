<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls" >
<Style x:Key="BaseProgressBarStyle" TargetType="ProgressBar" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="OverridesDefaultStyle" Value="True" /></Style>
<ControlTemplate x:Key="RoundedProgressBarTemplate" TargetType="ProgressBar" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"><Border.CornerRadius><MultiBinding Converter="{StaticResource CornerRadiusConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></Border.CornerRadius><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="{Binding ElementName=BackgroundBorder, Path=CornerRadius}" /></Grid></Border></ControlTemplate>
<Style x:Key="RoundedProgressBarStyle" BasedOn="{StaticResource BaseProgressBarStyle}" TargetType="ProgressBar" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" /><Setter Property="Template" Value="{StaticResource RoundedProgressBarTemplate}" /></Style>

</ResourceDictionary>
