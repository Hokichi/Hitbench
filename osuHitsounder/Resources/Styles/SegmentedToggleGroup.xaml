<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseSegmentedToggleGroupStyle"
        TargetType="{x:Type c:SegmentedToggleGroup}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="OptionSpacing" Value="4" />
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SegmentedToggleGroupTemplate"
        TargetType="{x:Type c:SegmentedToggleGroup}">
        <Border
            Height="{TemplateBinding Height}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="14">
            <ItemsPresenter />
        </Border>
    </ControlTemplate>
    <ItemsPanelTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="SegmentedToggleItemsPanelTemplate">
        <c:SegmentedTogglePanel />
    </ItemsPanelTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseSegmentedToggleGroupStyle}"
        TargetType="{x:Type c:SegmentedToggleGroup}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Template" Value="{StaticResource SegmentedToggleGroupTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource SegmentedToggleItemsPanelTemplate}" />
    </Style>
</ResourceDictionary>
