<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="BaseTextBlockStyle" TargetType="TextBlock" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="FontFamily" Value="{DynamicResource Regular}" /><Setter Property="FontSize" Value="13" /></Style>

<Style x:Key="CenteredEmptyStateTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontFamily" Value="{DynamicResource Bold}" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" /></Style>
<Style x:Key="CardLabelTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="FontFamily" Value="{DynamicResource Bold}" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" /></Style>
<Style x:Key="FieldLabelTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="FontFamily" Value="{DynamicResource Bold}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Style>

<Style x:Key="OHsPopupTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="FontFamily" Value="{DynamicResource Bold}" /><Setter Property="FontSize" Value="18" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger></Style.Triggers></Style>
</ResourceDictionary>
