<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:helpers="clr-namespace:osuHitsounder.Resources.Helpers">
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseTextBoxStyle"
        TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="FadingTextBoxContentHostTemplate"
        TargetType="TextBox">
        <customControls:FadingScrollViewer
            x:Name="PART_ContentHost"
            Margin="0"
            VerticalAlignment="Stretch" />
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BasePasswordBoxStyle"
        TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <ControlTemplate x:Key="RoundedTextInputTemplate" TargetType="TextBox">
        <Border
            x:Name="InputRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8">
            <customControls:FadingScrollViewer
                x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="Stretch" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="InputRoot" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputRoot" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="RoundedTextInputStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource RoundedTextInputTemplate}" />
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="RoundedPasswordInputTemplate"
        TargetType="PasswordBox">
        <Border
            x:Name="InputRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8">
            <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}"
                VerticalAlignment="Stretch" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputRoot" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="RoundedPasswordInputStyle"
        BasedOn="{StaticResource BasePasswordBoxStyle}"
        TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template" Value="{StaticResource RoundedPasswordInputTemplate}" />
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="NumericUpDownArrowButtonTemplate"
        TargetType="RepeatButton">
        <Border Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="NumericUpDownArrowButtonStyle"
        BasedOn="{StaticResource BaseRepeatButtonStyle}"
        TargetType="RepeatButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource NumericUpDownArrowButtonTemplate}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="BaseNumericUpDownStyle"
        TargetType="{x:Type customControls:NumericUpDown}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style
        x:Key="NumericUpDownEditorStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="{Binding Path=(helpers:KeyboardNavigationPolicy.AllowTabNavigation), RelativeSource={RelativeSource AncestorType=customControls:NumericUpDown}, Mode=OneWay}" />
        <Setter Property="IsTabStop" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsVerticalDragActive, RelativeSource={RelativeSource AncestorType=customControls:NumericUpDown}, Mode=OneWay}" Value="True">
                <Setter Property="Cursor" Value="SizeNS" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Key="NumericUpDownTemplate"
        TargetType="{x:Type customControls:NumericUpDown}">
        <Border
            x:Name="InputRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PART_TextBox"
                    AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                    Margin="4,0,0,0"
                    Padding="4,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource Brush.Text.Primary}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Style="{StaticResource NumericUpDownEditorStyle}" />
                <Grid
                    Grid.Column="1"
                    Height="24"
                    Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <RepeatButton
                        x:Name="PART_UpButton"
                        AutomationProperties.Name="Increase value"
                        Grid.Row="0"
                        Delay="200"
                        Interval="70"
                        Style="{StaticResource NumericUpDownArrowButtonStyle}">
                        <customControls:Icon
                            x:Name="UpIcon"
                            Width="8"
                            Height="8"
                            Path="{StaticResource AngleUp}"
                            Color="{DynamicResource Brush.Text.Secondary}" />
                    </RepeatButton>
                    <RepeatButton
                        x:Name="PART_DownButton"
                        AutomationProperties.Name="Decrease value"
                        Grid.Row="1"
                        Delay="200"
                        Interval="70"
                        Style="{StaticResource NumericUpDownArrowButtonStyle}">
                        <customControls:Icon
                            x:Name="DownIcon"
                            Width="8"
                            Height="8"
                            Path="{StaticResource AngleDown}"
                            Color="{DynamicResource Brush.Text.Secondary}" />
                    </RepeatButton>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="InputRoot" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="HasInputError" Value="True">
                <Setter TargetName="InputRoot" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
            </Trigger>
            <Trigger SourceName="PART_UpButton" Property="IsMouseOver" Value="True">
                <Setter TargetName="UpIcon" Property="Color" Value="{DynamicResource Brush.Navy}" />
            </Trigger>
            <Trigger SourceName="PART_DownButton" Property="IsMouseOver" Value="True">
                <Setter TargetName="DownIcon" Property="Color" Value="{DynamicResource Brush.Navy}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputRoot" Property="Opacity" Value="0.4" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter TargetName="UpIcon" Property="Color" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="DownIcon" Property="Color" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="PART_TextBox" Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, ElementName=PART_UpButton, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_UpButton" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="UpIcon" Property="Color" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, ElementName=PART_DownButton, Mode=OneWay}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_DownButton" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="DownIcon" Property="Color" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        BasedOn="{StaticResource BaseNumericUpDownStyle}"
        TargetType="{x:Type customControls:NumericUpDown}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
        <Setter Property="Template" Value="{StaticResource NumericUpDownTemplate}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsVerticalDragEnabled" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Cursor" Value="Hand" />
            </MultiTrigger>
            <Trigger Property="IsVerticalDragActive" Value="True"><Setter Property="Cursor" Value="SizeNS" /></Trigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>



