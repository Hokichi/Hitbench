<UserControl
    x:Class="osuHitsounder.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadSongsCommand, Mode=OneWay}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="HomePageSearchButtonStyle" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}" TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSongSearchExpanded, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomePageSearchAreaStyle" BasedOn="{StaticResource BaseGridStyle}" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSongSearchExpanded, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomePageSearchInputStyle" BasedOn="{StaticResource RoundedTextInputStyle}" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageBodyStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageHeadingStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="HomePageSongsHeadingStyle" BasedOn="{StaticResource HomePageHeadingStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="HomePageStatusStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePagePanelStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageProjectCardStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style
            x:Key="HomePageProjectNameStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="HomePageProjectPathStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageFolderTemplate">
            <Button
                AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource HomePageProjectCardStyle}">
                <TextBlock Style="{StaticResource HomePageProjectNameStyle}" Text="{Binding Name, Mode=OneWay}" />
            </Button>
        </DataTemplate>
        <DropShadowEffect
            x:Key="HomePageSongTextGlow"
            BlurRadius="8"
            Opacity="0.95"
            ShadowDepth="0"
            Color="{DynamicResource Color.Text.Primary.Inverted}" />
        <SolidColorBrush x:Key="HomePageSongArtworkFallbackBrush" Color="Black" />
        <SolidColorBrush x:Key="HomePageSongArtworkForegroundBrush" Color="White" />
        <Style
            x:Key="HomePageSongArtworkStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource HomePageSongArtworkFallbackBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{x:Null}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source, ElementName=SongArtwork, Mode=OneWay}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongBackgroundStyle"
            BasedOn="{StaticResource BaseImageStyle}"
            TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongArtistStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Artist, Mode=OneWay}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
            <Setter Property="Effect" Value="{StaticResource HomePageSongTextGlow}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                    <Setter Property="Effect" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongTitleStyle"
            BasedOn="{StaticResource HomePageSongArtistStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Title, Mode=OneWay}" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style
            x:Key="HomePageSongCardButtonStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource HomePageSongArtworkForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageSongTemplate">
            <Button
                AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
                Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource HomePageSongCardButtonStyle}">
                <Grid SizeChanged="OnSongCardSizeChanged" Style="{StaticResource HomePageSongArtworkStyle}">
                    <Image
                        x:Name="SongArtwork"
                        DataContextChanged="OnSongImageDataContextChanged"
                        Loaded="OnSongImageLoaded"
                        Style="{StaticResource HomePageSongBackgroundStyle}"
                        Unloaded="OnSongImageUnloaded" />
                    <StackPanel
                        Margin="16,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource HomePageSongArtistStyle}" />
                        <TextBlock Style="{StaticResource HomePageSongTitleStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HomePageVirtualizingPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="HomePageItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ControlTemplate x:Key="HomePageSongsItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <customControls:SpacedUniformGrid
                    Columns="4"
                    HorizontalGap="12"
                    IsItemsHost="True"
                    ItemHeight="108"
                    ItemWidth="336"
                    VerticalGap="12" />
            </ScrollViewer>
        </ControlTemplate>
        <Style
            x:Key="HomePageFoldersStyle"
            BasedOn="{StaticResource BaseItemsControlStyle}"
            TargetType="ItemsControl">
            <Setter Property="Template" Value="{StaticResource HomePageItemsTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource HomePageVirtualizingPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource HomePageFolderTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource BaseContentPresenterStyle}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style
            x:Key="HomePageSongsStyle"
            BasedOn="{StaticResource HomePageFoldersStyle}"
            TargetType="ItemsControl">
            <Setter Property="Template" Value="{StaticResource HomePageSongsItemsTemplate}" />
            <Setter Property="ItemTemplate" Value="{StaticResource HomePageSongTemplate}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        </Style>
        <Style
            x:Key="HomePageRetryButtonStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="HomePageProjectsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetryProjects, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetrySongs, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageLayout" Margin="12,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePagePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HomePageHeadingStyle}" Text="Projects" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource HomePageStatusStyle}"
                    Text="{Binding ProjectsStatus, Mode=OneWay}" />
                <customControls:BalloonButton
                    x:Name="ProjectsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Retry Projects"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Retry Projects"
                    Command="{Binding RetryProjectsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageProjectsRetryStyle}" />
                <ItemsControl
                    x:Name="ProjectsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Projects"
                    ItemsSource="{Binding Projects, Mode=OneWay}"
                    Style="{StaticResource HomePageFoldersStyle}" />
            </Grid>
        </Border>
        <Border
            x:Name="SongsPanel"
            Grid.Column="1"
            Style="{StaticResource HomePagePanelStyle}">
            <Grid x:Name="SongsContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HomePageSongsHeadingStyle}" Text="Songs" />
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <customControls:BalloonButton
                            x:Name="SongSearchButton"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Search songs"
                            ButtonIcon="{StaticResource MagnifyingGlass}"
                            Command="{Binding OpenSongSearchCommand, Mode=OneWay}"
                            ToolTip="Search songs"
                            ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                            Style="{StaticResource HomePageSearchButtonStyle}" />
                        <Grid MaxWidth="320" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource HomePageSearchAreaStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,4" Style="{StaticResource HomePageBodyStyle}" Text="Search songs" TextWrapping="Wrap" />
                            <TextBox
                                x:Name="SongSearchTextBox"
                                Grid.Row="1"
                                AutomationProperties.Name="Search songs"
                                IsEnabled="{Binding CanInteract, Mode=OneWay}"
                                PreviewKeyDown="OnSongSearchKeyDown"
                                Text="{Binding SongSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource HomePageSearchInputStyle}" />
                            <customControls:BalloonButton
                                x:Name="SongSearchCloseButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Close song search"
                                ButtonIcon="{StaticResource Close}"
                                Command="{Binding CloseSongSearchCommand, Mode=OneWay}"
                                ToolTip="Clear and close song search (Escape)"
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                Style="{StaticResource OHsBalloonDestructiveActionStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource HomePageStatusStyle}"
                    Text="{Binding SongsStatus, Mode=OneWay}" />
                <customControls:BalloonButton
                    x:Name="SongsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Refresh Songs"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Refresh Songs"
                    Command="{Binding RetrySongsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageSongsRetryStyle}" />
                <ItemsControl
                    x:Name="SongsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Songs"
                    ItemsSource="{Binding Songs, Mode=OneWay}"
                    Opacity="0"
                    Style="{StaticResource HomePageSongsStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
