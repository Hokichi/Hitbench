<UserControl
    x:Class="osuHitsounder.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:converters="clr-namespace:osuHitsounder.Resources.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    PreviewKeyDown="OnHomePageKeyDown"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="R"
            Command="{Binding ReloadSongsCommand, Mode=OneWay}"
            Modifiers="Control" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <converters:OHsSameFolderConverter x:Key="OHsHomePageSameFolderConverter" />
        <ObjectDataProvider x:Key="OHsHomePageSource" />
        <Style
            x:Key="HomePageSearchInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="Padding" Value="32,0,24,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomePageSongCaptionStyle" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomePageSearchPlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource CardLabelTextStyle}">
            <Setter Property="Margin" Value="32,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsHomePageMapsetPlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsHomePageSearchPlaceholderStyle}">
            <Setter Property="Text" Value="Search mapsets" /><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding SongSearchText, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageBodyStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="HomePagePanelStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="HomePageProjectNameStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="HomePageSongArtworkStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{x:Null}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source, ElementName=SongArtwork, Mode=OneWay}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongBackgroundStyle"
            BasedOn="{StaticResource BaseImageStyle}"
            TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongArtistStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Artist, Mode=OneWay}" />

            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="HomePageSongCardButtonStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding><MultiBinding Converter="{StaticResource OHsHomePageSameFolderConverter}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Path="DataContext.SelectedMapset" RelativeSource="{RelativeSource AncestorType=UserControl}" Mode="OneWay" /></MultiBinding></DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageSongTemplate">
            <Button
                AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
                Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource HomePageSongCardButtonStyle}">
                <Grid SizeChanged="OnSongCardSizeChanged" Style="{StaticResource HomePageSongArtworkStyle}">
                    <Image
                        x:Name="SongArtwork"
                        DataContextChanged="OnSongImageDataContextChanged"
                        Loaded="OnSongImageLoaded"
                        Style="{StaticResource HomePageSongBackgroundStyle}"
                        Unloaded="OnSongImageUnloaded" />
                    <Border Style="{StaticResource OHsHomePageSongCaptionStyle}">
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource HomePageSongArtistStyle}" Text="{Binding Title, Mode=OneWay}" FontFamily="{DynamicResource Bold}" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource HomePageSongArtistStyle}" />
                    </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="OHsHomePageMetadataStyle" TargetType="TextBlock" BasedOn="{StaticResource HomePageBodyStyle}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OHsHomePageChangedTimeStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsHomePageMetadataStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding LastChangedLocalDateTime, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsHomePageSelectedMapsetStyle" TargetType="StackPanel" BasedOn="{StaticResource BaseStackPanelStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers><DataTrigger Binding="{Binding SelectedMapset, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsHomePageOpenActionStyle" TargetType="customControls:BalloonButton" BasedOn="{StaticResource OHsBalloonActionStyle}">
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Hovered}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        </Style>
        <Style x:Key="OHsHomePageMenuTriggerStyle" TargetType="customControls:BalloonComboBox" BasedOn="{StaticResource BaseBalloonComboBoxStyle}">
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
        </Style>
        <Style x:Key="OHsHomePageProjectContentButtonStyle" TargetType="Button" BasedOn="{StaticResource FolderActionButtonStyle}">
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        </Style>
        <Style x:Key="OHsHomePagePinMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource OHsActionMenuItemStyle}">
            <Setter Property="Header" Value="Pin" />
            <Style.Triggers><DataTrigger Binding="{Binding IsPinned, Mode=OneWay}" Value="True"><Setter Property="Header" Value="Unpin" /></DataTrigger></Style.Triggers>
        </Style>
        <ContextMenu x:Key="OHsHomePageProjectMenu" x:Shared="False" Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem Style="{StaticResource OHsHomePagePinMenuItemStyle}" Command="{Binding DataContext.ToggleProjectPinCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
            <MenuItem Header="Delete" Style="{StaticResource OHsDestructiveActionMenuItemStyle}" Command="{Binding DataContext.DeleteProjectCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
        </ContextMenu>
        <DataTemplate x:Key="OHsHomePageProjectHeadingTemplate">
            <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource OHsHomePageMetadataStyle}" FontFamily="{DynamicResource Bold}" Margin="0,12,0,8" />
        </DataTemplate>
        <DataTemplate x:Key="OHsHomePageProjectRowTemplate">
            <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Grid.ColumnSpan="2" Style="{StaticResource OHsHomePageProjectContentButtonStyle}" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Name, Mode=OneWay}" AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                        Command="{Binding DataContext.OpenProjectCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Width="40" Height="40" Margin="0,0,8,0" Loaded="OnProjectImageLoaded" Unloaded="OnProjectImageUnloaded" DataContextChanged="OnProjectImageDataContextChanged" Style="{StaticResource HomePageSongBackgroundStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BaseStackPanelStyle}">
                        <TextBlock Style="{StaticResource HomePageProjectNameStyle}" Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource OHsHomePageMetadataStyle}" Text="{Binding MapsetName, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource OHsHomePageChangedTimeStyle}" Text="{Binding LastChangedLocalDateTime, Converter={StaticResource DateTimeToRelativeDateConverter}, Mode=OneWay}" />
                    </StackPanel>
                    </Grid>
                    </Button>
                    <customControls:BalloonButton Grid.Column="2" ButtonIcon="{StaticResource AngleRight}" ButtonText="Open" ShouldShowText="True" Style="{StaticResource OHsHomePageOpenActionStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Name, Mode=OneWay}" AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}" ToolTip="Open project" ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                        Command="{Binding DataContext.OpenProjectCommand, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                    <customControls:BalloonComboBox Grid.Column="3" ButtonIcon="{StaticResource BarsSolid}" Style="{StaticResource OHsHomePageMenuTriggerStyle}" VerticalAlignment="Center" Margin="4,0,0,0"
                        IsEnabled="{Binding DataContext.CanInteract, Source={StaticResource OHsHomePageSource}, Mode=OneWay}" AutomationProperties.Name="Project actions" ToolTip="Project actions" ContextMenu="{StaticResource OHsHomePageProjectMenu}" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="OHsHomePageProjectContentStyle" TargetType="ContentControl" BasedOn="{StaticResource BaseContentControlStyle}">
            <Setter Property="Content" Value="{Binding Project, Mode=OneWay}" />
            <Setter Property="ContentTemplate" Value="{StaticResource OHsHomePageProjectRowTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers><DataTrigger Binding="{Binding IsHeading, Mode=OneWay}" Value="True"><Setter Property="Content" Value="{Binding Heading, Mode=OneWay}" /><Setter Property="ContentTemplate" Value="{StaticResource OHsHomePageProjectHeadingTemplate}" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsHomePageProjectItemTemplate"><ContentControl Style="{StaticResource OHsHomePageProjectContentStyle}" /></DataTemplate>
        <Style x:Key="OHsHomePageProjectPlaceholderStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsHomePageSearchPlaceholderStyle}">
            <Setter Property="Text" Value="Search all projects" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding ProjectSearchText, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <ControlTemplate x:Key="HomePageItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="HomePageSongsItemsPanel"><customControls:SpacedUniformGrid Columns="4" HorizontalGap="12" ItemHeight="108" ItemWidth="336" VerticalGap="12" /></ItemsPanelTemplate>

        <Style
            x:Key="HomePageRetryButtonStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="HomePageProjectsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetryProjects, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetrySongs, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageLayout" Margin="12,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="SongsPanel"
            Grid.Column="0"
            Style="{StaticResource HomePagePanelStyle}">
            <Grid x:Name="SongsContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HomePageBodyStyle}" Text="Mapsets" FontFamily="{DynamicResource Bold}" FontSize="14" />
                    <TextBlock Grid.Column="1" Style="{StaticResource OHsHomePageMetadataStyle}" Text="{Binding MapsetInventoryText, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="SongSearchTextBox" AutomationProperties.Name="Search mapsets" IsEnabled="{Binding CanInteract, Mode=OneWay}" PreviewKeyDown="OnSongSearchKeyDown" Style="{StaticResource HomePageSearchInputStyle}" Text="{Binding SongSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <customControls:Icon Path="{StaticResource MagnifyingGlass}" Color="{DynamicResource Brush.Text.Muted}" Width="16" Height="16" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource OHsHomePageMapsetPlaceholderStyle}" />
                    <TextBlock Text="/" Style="{StaticResource OHsHomePageMetadataStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                </Grid>
                <customControls:BalloonButton
                    x:Name="SongsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Refresh Songs"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Refresh Songs"
                    Command="{Binding RetrySongsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageSongsRetryStyle}" />
                <ItemsControl
                    x:Name="SongsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Songs"
                    ItemsSource="{Binding Songs, Mode=OneWay}"
                    Opacity="0"
                    Style="{StaticResource BaseItemsControlStyle}"  ItemsPanel="{StaticResource HomePageSongsItemsPanel}" ItemTemplate="{StaticResource HomePageSongTemplate}" ScrollViewer.VerticalScrollBarVisibility="Visible" Template="{StaticResource HomePageItemsTemplate}" ItemContainerStyle="{StaticResource BaseContentPresenterStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource HomePagePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Style="{StaticResource OHsHomePageSelectedMapsetStyle}">
                    <TextBlock Style="{StaticResource OHsHomePageMetadataStyle}" Text="Selected mapset" />
                    <TextBlock Style="{StaticResource HomePageBodyStyle}" Text="{Binding SelectedMapset.Title, Mode=OneWay}" FontFamily="{DynamicResource Bold}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="ProjectSearchTextBox" Style="{StaticResource HomePageSearchInputStyle}" AutomationProperties.Name="Search all projects" IsEnabled="{Binding CanInteract, Mode=OneWay}" Text="{Binding ProjectSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <customControls:Icon Path="{StaticResource MagnifyingGlass}" Color="{DynamicResource Brush.Text.Muted}" Width="16" Height="16" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource OHsHomePageProjectPlaceholderStyle}" />
                </Grid>
                <customControls:BalloonButton
                    x:Name="ProjectsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Retry Projects"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Retry Projects"
                    Command="{Binding RetryProjectsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageProjectsRetryStyle}" />
                <ItemsControl
                    x:Name="ProjectsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Projects"
                    ItemsSource="{Binding ProjectItems, Mode=OneWay}"
                    Style="{StaticResource OHsVirtualizedDrawerItemsStyle}" ItemTemplate="{StaticResource OHsHomePageProjectItemTemplate}" ItemContainerStyle="{StaticResource BaseContentPresenterStyle}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
