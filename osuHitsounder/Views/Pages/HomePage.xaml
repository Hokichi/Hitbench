<UserControl
    x:Class="osuHitsounder.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="HomePageBodyStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageHeadingStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style
            x:Key="HomePageStatusStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePagePanelStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageFolderBorderStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageFolderTextStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding FullName, Mode=OneWay}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Focusable" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Text" Value="{Binding FullName, Mode=OneWay}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageFolderTemplate">
            <Border Style="{StaticResource HomePageFolderBorderStyle}">
                <TextBlock Style="{StaticResource HomePageFolderTextStyle}">
                    <TextBlock.ToolTip>
                        <ToolTip Content="{Binding FullName, Mode=OneWay}" Style="{StaticResource BaseToolTipStyle}" />
                    </TextBlock.ToolTip>
                </TextBlock>
            </Border>
        </DataTemplate>
        <DropShadowEffect
            x:Key="HomePageSongTextGlow"
            BlurRadius="8"
            Opacity="0.95"
            ShadowDepth="0"
            Color="{DynamicResource Color.Text.Primary.Inverted}" />
        <Style
            x:Key="HomePageSongBackgroundStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="customControls:OHsSongBackground">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{Binding ImageBrush, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
            <Setter Property="IsBlurred" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Value="True">
                    <Setter Property="IsBlurred" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Value="True">
                    <Setter Property="IsBlurred" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="IsBlurred" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongArtistStyle"
            BasedOn="{StaticResource HomePageBodyStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Artist, Mode=OneWay}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
            <Setter Property="Effect" Value="{StaticResource HomePageSongTextGlow}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" />
                    <Setter Property="Effect" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongTitleStyle"
            BasedOn="{StaticResource HomePageSongArtistStyle}"
            TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Title, Mode=OneWay}" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style
            x:Key="HomePageSongCardButtonStyle"
            BasedOn="{StaticResource FolderActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="336" />
            <Setter Property="Height" Value="108" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="HomePageSongTemplate">
            <Button
                AutomationProperties.HelpText="{Binding FullName, Mode=OneWay}"
                AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
                Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                CommandParameter="{Binding Mode=OneWay}"
                Style="{StaticResource HomePageSongCardButtonStyle}">
                <Grid>
                    <customControls:OHsSongBackground
                        Loader="{Binding ImageLoader, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                        Path="{Binding BackgroundPath, Mode=OneWay}"
                        Style="{StaticResource HomePageSongBackgroundStyle}" />
                    <StackPanel
                        Width="304"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource HomePageSongArtistStyle}" />
                        <TextBlock Style="{StaticResource HomePageSongTitleStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HomePageVirtualizingPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="HomePageItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ControlTemplate x:Key="HomePageSongsItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Padding="{TemplateBinding Padding}"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                CanContentScroll="True"
                Focusable="True"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <customControls:SpacedUniformGrid
                    Columns="4"
                    HorizontalGap="12"
                    IsItemsHost="True"
                    ItemHeight="108"
                    ItemWidth="336"
                    VerticalGap="12" />
            </ScrollViewer>
        </ControlTemplate>
        <Style
            x:Key="HomePageFoldersStyle"
            BasedOn="{StaticResource BaseItemsControlStyle}"
            TargetType="ItemsControl">
            <Setter Property="Template" Value="{StaticResource HomePageItemsTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource HomePageVirtualizingPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource HomePageFolderTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource BaseContentPresenterStyle}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style
            x:Key="HomePageSongsStyle"
            BasedOn="{StaticResource HomePageFoldersStyle}"
            TargetType="ItemsControl">
            <Setter Property="Template" Value="{StaticResource HomePageSongsItemsTemplate}" />
            <Setter Property="ItemTemplate" Value="{StaticResource HomePageSongTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style
            x:Key="HomePageRetryButtonStyle"
            BasedOn="{StaticResource OHsBalloonDefaultActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="HomePageProjectsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetryProjects, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HomePageSongsRetryStyle"
            BasedOn="{StaticResource HomePageRetryButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRetrySongs, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePagePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HomePageHeadingStyle}" Text="Projects" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource HomePageStatusStyle}"
                    Text="{Binding ProjectsStatus, Mode=OneWay}" />
                <customControls:BalloonButton
                    x:Name="ProjectsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Retry Projects"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Retry Projects"
                    Command="{Binding RetryProjectsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageProjectsRetryStyle}" />
                <ItemsControl
                    x:Name="ProjectsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Projects"
                    ItemsSource="{Binding Projects, Mode=OneWay}"
                    Style="{StaticResource HomePageFoldersStyle}" />
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource HomePagePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HomePageHeadingStyle}" Text="Songs" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource HomePageStatusStyle}"
                    Text="{Binding SongsStatus, Mode=OneWay}" />
                <customControls:BalloonButton
                    x:Name="SongsRetryButton"
                    Grid.Row="2"
                    AutomationProperties.Name="Refresh Songs"
                    ButtonIcon="{StaticResource UpdateOutline}"
                    ButtonText="Refresh Songs"
                    Command="{Binding RetrySongsCommand, Mode=OneWay}"
                    ShouldShowText="True"
                    Style="{StaticResource HomePageSongsRetryStyle}" />
                <ItemsControl
                    x:Name="SongsList"
                    Grid.Row="3"
                    AutomationProperties.Name="Songs"
                    ItemsSource="{Binding Songs, Mode=OneWay}"
                    Opacity="0"
                    Style="{StaticResource HomePageSongsStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
