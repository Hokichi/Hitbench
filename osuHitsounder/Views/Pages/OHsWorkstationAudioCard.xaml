<UserControl
    x:Class="osuHitsounder.Views.Pages.OHsWorkstationAudioCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:osuHitsounder.Resources.Converters"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:osuHitsounder.Core.Entities;assembly=osuHitsounder.Core"
    xmlns:helpers="clr-namespace:osuHitsounder.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:osuHitsounder.Views.Pages"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
<UserControl.Resources><Style
            x:Key="OHsWorkstationPanelStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<Style
            x:Key="OHsWorkstationTransportButtonStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ShouldExpand" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
<Style
            x:Key="OHsWorkstationScrollWithMarkerStyle"
            BasedOn="{StaticResource {x:Type customControls:BalloonCheckBox}}"
            TargetType="customControls:BalloonCheckBox">
            <Setter Property="ButtonSize" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="StrokeBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="DefaultBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="CheckedBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="HoveredBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="StrokeThickness" Value="1" />
                </DataTrigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="StrokeThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationElapsedStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationAggregateToggleStyle" BasedOn="{StaticResource OHsWorkstationTrackToggleStyle}" TargetType="ToggleButton">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ContentStringFormat" Value="{}{0} On" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="On" />
                </Trigger>
            </Style.Triggers>
        </Style>
<Style
            x:Key="OHsWorkstationPlayPauseStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="AutomationProperties.Name" Value="Play audio" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Setter Property="ButtonText" Value="Play" />
            <Setter Property="ToolTip" Value="Play audio (Space)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Pause audio" />
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}" />
                    <Setter Property="ButtonText" Value="Pause" />
                    <Setter Property="ToolTip" Value="Pause audio (Space)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<Style
            x:Key="OHsWorkstationPlaybackWarningStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<Style
            x:Key="OHsWorkstationPlaybackWarningScrollStyle"
            BasedOn="{StaticResource {x:Type ScrollViewer}}"
            TargetType="ScrollViewer">
            <Setter Property="MaxHeight" Value="120" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<Style
            x:Key="OHsWorkstationToolbarButtonStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="OHsWorkstationSamplesActionStyle" BasedOn="{StaticResource OHsBalloonDefaultActionStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="ShouldExpand" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <ContextMenu x:Key="OHsWorkstationAddMenu" x:Shared="False" Style="{StaticResource OHsActionContextMenuStyle}">
            <MenuItem Header="Sample Track" Command="{Binding AddSampleTrackCommand, Mode=OneWay}"
                InputGestureText="Ctrl+N" ToolTip="Add sample track (Ctrl+N)" Style="{StaticResource OHsActionMenuItemStyle}" />
            <MenuItem Header="Instrumental Track" Command="{Binding AddPianoTrackCommand, Mode=OneWay}"
                InputGestureText="Ctrl+Shift+N" ToolTip="Add instrumental track (Ctrl+Shift+N)" Style="{StaticResource OHsActionMenuItemStyle}" />
            <MenuItem Header="Control Point" Command="{Binding AddControlPointCommand, Mode=OneWay}"
                InputGestureText="F6" ToolTip="Add control point at playback marker (F6)" Style="{StaticResource OHsActionMenuItemStyle}" />
        </ContextMenu>
<Style
            x:Key="OHsWorkstationCollapseTracksStyle"
            BasedOn="{StaticResource OHsWorkstationToolbarButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ButtonIcon" Value="{StaticResource ArrowDropUpRound}" />
            <Setter Property="ButtonText" Value="Collapse all tracks" />
            <Setter Property="ToolTip" Value="Collapse all tracks (F4)" />
            <Setter Property="AutomationProperties.Name" Value="Collapse all tracks" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreTracksCollapsed, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource ArrowDropDownRound}" />
                    <Setter Property="ButtonText" Value="Expand all tracks" />
                    <Setter Property="ToolTip" Value="Expand all tracks (F4)" />
                    <Setter Property="AutomationProperties.Name" Value="Expand all tracks" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
</UserControl.Resources>
<Border
                    x:Name="SongAudioCard"
                    Margin="0,0,0,8"
                    Style="{StaticResource OHsWorkstationPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="128" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            Grid.Row="0"
                            AutomationProperties.Name="Playback diagnostics"
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource OHsWorkstationPlaybackWarningScrollStyle}"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="PlaybackWarningText"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{Binding PlaybackWarning, Mode=OneWay}"
                                Style="{StaticResource OHsWorkstationPlaybackWarningStyle}"
                                Text="{Binding PlaybackWarning, Mode=OneWay}" />
                        </ScrollViewer>
                        <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                                <ColumnDefinition Width="{Binding TrackScrollBarGutter, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationAudioCard}, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <customControls:BalloonButton x:Name="PlayPauseButton" Margin="0"
                                        Command="{Binding PlayPauseCommand, Mode=OneWay}" IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationPlayPauseStyle}" />
                                    <customControls:BalloonButton Margin="4,0,0,0" AutomationProperties.Name="Stop audio"
                                        ButtonIcon="{StaticResource MediaStop}" ButtonText="Stop"
                                        Command="{Binding StopCommand, Mode=OneWay}" IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationTransportButtonStyle}"
                                        ToolTip="Stop audio and return to the beginning" />
                                    <customControls:BalloonCheckBox x:Name="ScrollWithMarkerCheckBox" Margin="4,0,0,0"
                                        AutomationProperties.HelpText="Follow the current playback marker. Selecting a node turns this off."
                                        AutomationProperties.Name="Scroll with marker"
                                        ButtonIcon="{StaticResource AlignArrowRightFill}" ButtonText="Scroll with marker"
                                        CheckedIcon="{StaticResource AlignArrowRightFill}"
                                        IsChecked="{Binding ScrollWithMarker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationScrollWithMarkerStyle}"
                                        ToolTip="Follow the current playback marker (F3). Selecting a node turns this off." />
                                </StackPanel>
                                <TextBlock x:Name="ElapsedTimeText" AutomationProperties.Name="Elapsed audio time"
                                    Style="{StaticResource OHsWorkstationElapsedStyle}" Text="{Binding ElapsedText, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ClearTrackMutesToggle"
                                        AutomationProperties.Name="{Binding TrackMutesActionText, Mode=OneWay}"
                                        Content="M" IsChecked="{Binding AreTracksMuted, Mode=OneWay}"
                                        IsEnabled="{Binding CanToggleTrackMutes, Mode=OneWay}"
                                        Tag="{Binding ToggleTrackMutesCommand, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationAggregateToggleStyle}"
                                        ToolTip="{Binding TrackMutesActionText, Mode=OneWay}"
                                        Checked="OnAggregateToggleChanged" Unchecked="OnAggregateToggleChanged" />
                                    <ToggleButton x:Name="ClearTrackSolosToggle" Margin="4,0,0,0"
                                        AutomationProperties.Name="Clear all track solos" Content="S"
                                        IsChecked="{Binding HasSoloedTracks, Mode=OneWay}"
                                        IsEnabled="{Binding CanClearTrackSolos, Mode=OneWay}"
                                        Tag="{Binding ClearTrackSolosCommand, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationAggregateToggleStyle}"
                                        ToolTip="Clear all track solos"
                                        Checked="OnAggregateToggleChanged" Unchecked="OnAggregateToggleChanged" />
                                </StackPanel>
                            </StackPanel>
                            <pages:OHsWorkstationTimeline x:Name="TimelineControl" Grid.Column="2" />
                            <StackPanel x:Name="TrackActionsHost" Grid.Column="4" VerticalAlignment="Center">
                                <customControls:SegmentedToggleGroup x:Name="EditingModeGroup" Margin="0,0,0,8"
                                    AutomationProperties.Name="Workstation editing mode" IsEnabled="{Binding CanPlaceSamples, Mode=OneWay}"
                                    SelectedValue="{Binding IsAdditionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <customControls:SegmentedToggleOption x:Name="SelectionModeButton" Content="Select"
                                        AutomationProperties.Name="Selection Mode" ToolTip="Select and move nodes (1)">
                                        <customControls:SegmentedToggleOption.Value><sys:Boolean>False</sys:Boolean></customControls:SegmentedToggleOption.Value>
                                    </customControls:SegmentedToggleOption>
                                    <customControls:SegmentedToggleOption x:Name="AdditionModeButton" Content="Draw"
                                        AutomationProperties.Name="Addition Mode" ToolTip="Create nodes (2)">
                                        <customControls:SegmentedToggleOption.Value><sys:Boolean>True</sys:Boolean></customControls:SegmentedToggleOption.Value>
                                    </customControls:SegmentedToggleOption>
                                </customControls:SegmentedToggleGroup>
                                <customControls:BalloonComboBox x:Name="AddMenuButton" Margin="0,0,0,8"
                                    AutomationProperties.Name="Add" ButtonIcon="{StaticResource PlusSolid}" ButtonText="Add"
                                    ContextMenu="{StaticResource OHsWorkstationAddMenu}" ShouldShowText="True" ShouldExpand="False"
                                    Style="{StaticResource BaseBalloonComboBoxStyle}" ToolTip="Add a track or control point" />
                                <customControls:BalloonButton x:Name="ManageSamplesButton" Margin="0,0,0,8"
                                    AutomationProperties.Name="Samples" ButtonIcon="{StaticResource BarsSolid}" ButtonText="Samples"
                                    Command="{Binding ManageSamplesCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationSamplesActionStyle}" ToolTip="Manage project samples (F2)" />
                                <StackPanel Orientation="Horizontal">
                                    <customControls:BalloonButton x:Name="ResnapAllSamplesButton"
                                        AutomationProperties.Name="Resnap all nodes"
                                        AutomationProperties.HelpText="Snap sample nodes and instrumental notes across all tracks to the current beat subdivision"
                                        ButtonIcon="{StaticResource RegularRepeat}" ButtonText="Resnap all nodes"
                                        Command="{Binding ResnapAllSamplesCommand, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationToolbarButtonStyle}"
                                        ToolTip="Snap sample nodes and instrumental notes across all tracks to the current beat subdivision" />
                                    <customControls:BalloonButton x:Name="ReloadSamplesButton" Margin="4,0,0,0"
                                        AutomationProperties.Name="Refresh samples" ButtonIcon="{StaticResource RegularRepeat}" ButtonText="Refresh samples"
                                        Command="{Binding ReloadSamplesCommand, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationToolbarButtonStyle}" ToolTip="Refresh project samples (F5)" />
                                    <customControls:BalloonButton x:Name="ToggleTracksCollapsedButton" Margin="4,0,0,0"
                                        Command="{Binding ToggleTracksCollapsedCommand, Mode=OneWay}"
                                        Style="{StaticResource OHsWorkstationCollapseTracksStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
</UserControl>
