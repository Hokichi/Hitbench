<UserControl
    x:Class="osuHitsounder.Views.Pages.OHsWorkstationTrackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:osuHitsounder.Resources.Converters"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:osuHitsounder.Core.Entities;assembly=osuHitsounder.Core"
    xmlns:helpers="clr-namespace:osuHitsounder.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:osuHitsounder.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
<UserControl.Resources><ObjectDataProvider x:Key="OHsWorkstationTrackListSource" />
<ControlTemplate x:Key="OHsWorkstationTrackScrollTemplate" TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    CanHorizontallyScroll="False"
                    CanVerticallyScroll="True"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                <ScrollBar
                    x:Name="PART_VerticalScrollBar"
                    Grid.Column="1"
                    AutomationProperties.Name="Sample tracks vertical position"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    Orientation="Vertical"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                    Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Grid>
        </ControlTemplate>
<Style
            x:Key="OHsWorkstationTrackScrollStyle"
            BasedOn="{StaticResource {x:Type ScrollViewer}}"
            TargetType="ScrollViewer">
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackScrollTemplate}" />
        </Style>
<Style
            x:Key="OHsWorkstationTrackSeparatorStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Beat.Whole}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<ControlTemplate x:Key="OHsWorkstationTrackItemTemplate" TargetType="ListBoxItem">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="2"
                    Background="{TemplateBinding Background}"
                    Style="{StaticResource BaseBorderStyle}" />
                <ContentPresenter
                    Grid.ColumnSpan="5"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <Border
                    Grid.ColumnSpan="5"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource OHsWorkstationTrackSeparatorStyle}" />
            </Grid>
        </ControlTemplate>
<Style
            x:Key="OHsWorkstationTrackItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackItemTemplate}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="AutomationProperties.Name" Value="Track" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSelectionMode, Source={StaticResource OHsWorkstationTrackListSource}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSelectionMode, Source={StaticResource OHsWorkstationTrackListSource}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
<ControlTemplate x:Key="OHsWorkstationTrackListTemplate" TargetType="ListBox">
            <Grid Style="{StaticResource BaseGridStyle}">
                <ScrollViewer
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    ScrollChanged="OnTrackListViewportChanged"
                    Style="{StaticResource OHsWorkstationTrackScrollStyle}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                </ScrollViewer>
            </Grid>
        </ControlTemplate>
<DataTemplate x:Key="OHsWorkstationTrackRowTemplate">
    <pages:OHsWorkstationTrackRow Track="{Binding Mode=OneWay}"
        ViewModel="{Binding DataContext, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackList}, Mode=OneWay}"
        TimelineContentWidth="{Binding TimelineContentWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackList}, Mode=OneWay}"
        TimelineViewportWidth="{Binding TimelineViewportWidth, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackList}, Mode=OneWay}"
        TimelineHorizontalOffset="{Binding TimelineHorizontalOffset, RelativeSource={RelativeSource AncestorType=pages:OHsWorkstationTrackList}, Mode=OneWay}" />
</DataTemplate>
</UserControl.Resources>
<AdornerDecorator Grid.Row="0">
                            <Grid>
                                <ListBox
                                    x:Name="TrackList"
                                    AutomationProperties.Name="Tracks"
                                    ItemTemplate="{StaticResource OHsWorkstationTrackRowTemplate}"
                                    ItemsSource="{Binding Tracks, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectionMode="Single"
                                    Style="{StaticResource BaseListBoxStyle}"  Background="Transparent" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemContainerStyle="{StaticResource OHsWorkstationTrackItemStyle}" FocusVisualStyle="{StaticResource DefaultFocusVisualStyle}" IsTabStop="True" ItemsPanel="{StaticResource OHsVirtualizedDrawerItemsPanel}" Template="{StaticResource OHsWorkstationTrackListTemplate}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                            </Grid>
                        </AdornerDecorator>
</UserControl>
