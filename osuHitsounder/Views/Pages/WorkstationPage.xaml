<UserControl
    x:Class="osuHitsounder.Views.Pages.WorkstationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:osuHitsounder.Resources.Converters"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:osuHitsounder.Core.Entities;assembly=osuHitsounder.Core"
    xmlns:helpers="clr-namespace:osuHitsounder.Resources.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:osuHitsounder.Views.Pages"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <GridLength x:Key="OHsWorkstationSideColumnWidth">128</GridLength>
        <GridLength x:Key="OHsWorkstationColumnGap">12</GridLength>
        <Style
            x:Key="OHsWorkstationTrackCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackNameStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.AreTracksCollapsed, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationRemoveTrackStyle"
            BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ButtonIcon" Value="{StaticResource Delete}" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ShouldExpand" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationTrackToggleTemplate" TargetType="ToggleButton">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Style="{StaticResource BaseBorderStyle}">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Style="{StaticResource BaseContentPresenterStyle}" />
                </Border>
            </Grid>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationTrackToggleStyle"
            BasedOn="{StaticResource BaseToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackToggleTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationTrackScrollTemplate" TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    CanHorizontallyScroll="False"
                    CanVerticallyScroll="True"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                <ScrollBar
                    x:Name="PART_VerticalScrollBar"
                    Grid.Column="1"
                    AutomationProperties.Name="Sample tracks vertical position"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    Orientation="Vertical"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                    Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Grid>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationTrackScrollStyle"
            BasedOn="{StaticResource {x:Type ScrollViewer}}"
            TargetType="ScrollViewer">
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackScrollTemplate}" />
        </Style>
        <BlurEffect x:Key="OHsWorkstationVolumeBlurEffect" Radius="0" />
        <Style
            x:Key="OHsWorkstationContentStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=VolumeOverlay, Mode=OneWay}" Value="Visible">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="OHsWorkstationPlaybackMarkerBrush" Color="White" />
        <Style
            x:Key="OHsWorkstationPanelStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTransportButtonStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="ShouldExpand" Value="False" />
        </Style>
        <Style
            x:Key="OHsWorkstationResnapButtonStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style
            x:Key="OHsWorkstationScrollWithMarkerStyle"
            BasedOn="{StaticResource {x:Type customControls:BalloonCheckBox}}"
            TargetType="customControls:BalloonCheckBox">
            <Setter Property="ButtonSize" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="False" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.Neutral.Hovered}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="DefaultBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="CheckedBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="HoveredBackground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="StrokeThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationPlayPauseStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="AutomationProperties.Name" Value="Play audio" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Setter Property="ButtonText" Value="Play" />
            <Setter Property="ToolTip" Value="Play audio (Space)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Pause audio" />
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}" />
                    <Setter Property="ButtonText" Value="Pause" />
                    <Setter Property="ToolTip" Value="Pause audio (Space)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationIconButtonStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ShouldShowText" Value="False" />
        </Style>
        <Style
            x:Key="OHsWorkstationElapsedStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationSubdivisionLabelStyle"
            BasedOn="{StaticResource FieldLabelTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="OHsWorkstationSubdivisionStyle"
            BasedOn="{StaticResource OHsValueSliderStyle}"
            TargetType="customControls:ValueSlider">
            <Setter Property="Width" Value="160" />
        </Style>
        <Style
            x:Key="OHsWorkstationErrorStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationScrollTrackButtonStyle"
            BasedOn="{StaticResource BaseRepeatButtonStyle}"
            TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style
            x:Key="OHsWorkstationWaveformScrollThumbStyle"
            BasedOn="{StaticResource RoundedHorizontalScrollThumbStyle}"
            TargetType="Thumb">
            <Setter Property="Height" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationWaveformScrollBarTemplate" TargetType="ScrollBar">
            <Grid x:Name="Root" Background="Transparent">
                <Border
                    x:Name="TrackBackground"
                    Height="16"
                    Margin="0,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Opacity="1" />
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageLeftCommand"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource OHsWorkstationScrollTrackButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource OHsWorkstationWaveformScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageRightCommand"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource OHsWorkstationScrollTrackButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationWaveformScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="ScrollBar">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationWaveformScrollBarTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanPlay, Mode=OneWay}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationWaveformScrollTemplate" TargetType="ScrollViewer">
            <Border
                x:Name="WaveformBoundary"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="WaveformBoundary" Property="BorderBrush" Value="{DynamicResource Brush.Navy.Muted}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationWaveformScrollStyle"
            BasedOn="{StaticResource BaseScrollViewerStyle}"
            TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationWaveformScrollTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationVolumeStyle"
            BasedOn="{StaticResource OHsValueSliderStyle}"
            TargetType="customControls:ValueSlider">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="5" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
        </Style>
        <Style
            x:Key="OHsWorkstationPlaybackWarningStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PlaybackWarning, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationVolumeOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="RightToLeft">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackSeparatorStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Beat.Whole}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationTrackItemTemplate" TargetType="ListBoxItem">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="2"
                    Background="{TemplateBinding Background}"
                    Style="{StaticResource BaseBorderStyle}" />
                <ContentPresenter
                    Grid.ColumnSpan="5"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    Style="{StaticResource BaseContentPresenterStyle}" />
                <Border
                    Grid.ColumnSpan="5"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource OHsWorkstationTrackSeparatorStyle}" />
            </Grid>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationTrackItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackItemTemplate}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="Sample track" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="OHsWorkstationTrackItemsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <Style
            x:Key="OHsWorkstationEmptyTracksStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tracks.Count, Mode=OneWay}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationTrackListTemplate" TargetType="ListBox">
            <Grid Style="{StaticResource BaseGridStyle}">
                <ScrollViewer
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    ScrollChanged="OnTrackListViewportChanged"
                    Style="{StaticResource OHsWorkstationTrackScrollStyle}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                </ScrollViewer>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource OHsWorkstationEmptyTracksStyle}"
                    Text="No tracks. Load a sample, then use Add New Sample Track beside the waveform to create one." />
            </Grid>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationTrackListStyle"
            BasedOn="{StaticResource BaseListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource OHsWorkstationTrackItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ItemsPanel" Value="{StaticResource OHsWorkstationTrackItemsPanel}" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationTrackListTemplate}" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style
            x:Key="OHsWorkstationTimelineStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        </Style>
        <Style
            x:Key="OHsWorkstationSaveErrorStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationRetrySaveStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationTrackMetadataComboBoxStyle"
            BasedOn="{StaticResource OHsComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <BlurEffect x:Key="OHsWorkstationMissingBlur" Radius="4" />
        <Style
            x:Key="OHsWorkstationGridContentStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Effect" Value="{StaticResource OHsWorkstationMissingBlur}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationMissingStatusStyle"
            BasedOn="{StaticResource CenteredEmptyStateTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <Trigger Property="Text" Value="Sample not found.">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Text" Value="No sample selected. Choose a sample or use Manage Sample.">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationToolbarButtonStyle"
            BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        </Style>
        <Style
            x:Key="OHsWorkstationManageSamplesButtonStyle"
            BasedOn="{StaticResource OHsWorkstationToolbarButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="helpers:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        </Style>
        <Style
            x:Key="OHsWorkstationCollapseTracksStyle"
            BasedOn="{StaticResource OHsWorkstationToolbarButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="ButtonIcon" Value="{StaticResource ArrowDropUpRound}" />
            <Setter Property="ButtonText" Value="Collapse all tracks" />
            <Setter Property="ToolTip" Value="Collapse all tracks" />
            <Setter Property="AutomationProperties.Name" Value="Collapse all tracks" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreTracksCollapsed, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource ArrowDropDownRound}" />
                    <Setter Property="ButtonText" Value="Expand all tracks" />
                    <Setter Property="ToolTip" Value="Expand all tracks" />
                    <Setter Property="AutomationProperties.Name" Value="Expand all tracks" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationToolbarResnapStyle"
            BasedOn="{StaticResource OHsWorkstationResnapButtonStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style
            x:Key="OHsWorkstationToolbarFollowStyle"
            BasedOn="{StaticResource OHsWorkstationScrollWithMarkerStyle}"
            TargetType="customControls:BalloonCheckBox">
            <Setter Property="Margin" Value="0" />
        </Style>
        <ControlTemplate x:Key="OHsWorkstationModeButtonTemplate" TargetType="RadioButton">
            <Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border
                    x:Name="ModeCue"
                    Height="3"
                    Margin="8,0,8,4"
                    VerticalAlignment="Bottom"
                    Background="{TemplateBinding Foreground}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ModeCue" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsWorkstationModeButtonStyle"
            BasedOn="{StaticResource BaseRadioButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationModeButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <converters:SamplesetDisplayConverter x:Key="OHsWorkstationSamplesetDisplayConverter" />
        <DataTemplate x:Key="OHsWorkstationCompactOptionTemplate">
            <TextBlock Style="{StaticResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource OHsWorkstationSamplesetDisplayConverter}" Mode="OneWay">
                        <Binding Mode="OneWay" />
                        <Binding
                            Mode="OneWay"
                            Path="IsDropDownOpen"
                            RelativeSource="{RelativeSource AncestorType=ComboBox}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <Style
            x:Key="OHsWorkstationCompactMetadataStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="ItemTemplate" Value="{StaticResource OHsWorkstationCompactOptionTemplate}" />
        </Style>
        <Style
            x:Key="OHsWorkstationSampleFileSelectorStyle"
            BasedOn="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.AreTracksCollapsed, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationExpandedTrackControlsStyle"
            BasedOn="{StaticResource BaseStackPanelStyle}"
            TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.AreTracksCollapsed, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsWorkstationSampleTrackTemplate">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                    <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="TrackLeftControls"
                    Margin="0,8"
                    VerticalAlignment="Center"
                    Loaded="OnTrackControlStackLoaded"
                    SizeChanged="OnTrackControlStackSizeChanged"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <TextBox
                        AutomationProperties.Name="Track name"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding DataContext.CanEditTracks, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                        Loaded="OnTrackNameLoaded"
                        Style="{StaticResource OHsWorkstationTrackNameStyle}"
                        Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=Explicit}"
                        TextChanged="OnTrackNameTextChanged"
                        ToolTip="Track name" />
                    <StackPanel x:Name="TrackLeftExpandedControls" Style="{StaticResource OHsWorkstationExpandedTrackControlsStyle}">
                        <customControls:SpacedUniformGrid
                            Margin="0,0,0,8"
                            Columns="3"
                            HorizontalGap="4"
                            ItemHeight="40"
                            ItemWidth="40"
                            VerticalGap="4">
                            <customControls:BalloonButton
                                AutomationProperties.Name="Remove track"
                                Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                CommandParameter="{Binding Mode=OneWay}"
                                IsEnabled="{Binding DataContext.CanRemoveTrack, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                Style="{StaticResource OHsWorkstationRemoveTrackStyle}"
                                ToolTip="Remove track" />
                            <ToggleButton
                                x:Name="TrackMuteToggle"
                                AutomationProperties.Name="Mute track"
                                Checked="OnTrackAuditionChanged"
                                Content="M"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding DataContext.CanPlaceSamples, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                Loaded="OnTrackAuditionLoaded"
                                Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                                ToolTip="Mute track"
                                Unchecked="OnTrackAuditionChanged" />
                            <ToggleButton
                                x:Name="TrackSoloToggle"
                                AutomationProperties.Name="Solo track"
                                Checked="OnTrackAuditionChanged"
                                Content="S"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding DataContext.CanPlaceSamples, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                Loaded="OnTrackAuditionLoaded"
                                Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                                ToolTip="Solo track"
                                Unchecked="OnTrackAuditionChanged" />
                        </customControls:SpacedUniformGrid>
                        <customControls:ValueSlider
                            x:Name="VolumeSlider"
                            AutomationProperties.Name="Track volume percent"
                            DataContextChanged="OnTrackControlDataContextChanged"
                            DisplayText="{Binding ElementName=VolumeSlider, Path=Value, Mode=OneWay, StringFormat={}{0:0}}"
                            IsEnabled="{Binding DataContext.CanImportSample, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                            Loaded="OnVolumeSliderLoaded"
                            Style="{StaticResource OHsWorkstationVolumeStyle}"
                            ToolTip="Track volume percent"
                            ValueChanged="OnVolumeValueChanged" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource OHsWorkstationTimelineStyle}">
                    <Grid
                        x:Name="TrackGridHost"
                        DataContextChanged="OnTrackGridHostDataContextChanged"
                        Loaded="OnTrackGridHostLoaded"
                        Style="{StaticResource BaseGridStyle}">
                        <Grid x:Name="TrackGridContent" Style="{StaticResource OHsWorkstationGridContentStyle}">
                            <customControls:BeatGridView
                                Height="{Binding DataContext.TrackHeight, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                AllowNodeCreation="{Binding DataContext.IsAdditionMode, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                AutomationProperties.HelpText="Use Left and Right to move playback. Enter places or selects a node. Control+click or Control+Enter toggles node selection. Click outside nodes or press Escape to clear selection. Selecting nodes disables Scroll with marker. Delete removes selected nodes; Control+C copies and Control+V pastes. Alt+Left or Right moves selected nodes; Alt+Up or Down changes tracks. Drag nodes to move them; Escape cancels dragging."
                                AutomationProperties.Name="Track sample placement timeline"
                                Bpms="{Binding DataContext.Project.BPMs, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                CanPlaceSamples="{Binding DataContext.CanPlaceSamples, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                ContentWidth="{Binding TimelineContentWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                FocusBrush="{DynamicResource Brush.Text.Primary}"
                                HorizontalOffset="{Binding TimelineHorizontalOffset, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                HoverBrush="{DynamicResource Brush.Background.Hover}"
                                IsNodeDragActive="{Binding DataContext.IsNodeDragActive, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                KeyboardNavigation.IsTabStop="True"
                                MarkerBrush="{DynamicResource Brush.Navy.Muted}"
                                Offsets="{Binding DataContext.Project.Offsets, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                PlaybackMarkerBrush="{StaticResource OHsWorkstationPlaybackMarkerBrush}"
                                PlaybackMarkerOutlineBrush="{DynamicResource Brush.Navy.Muted}"
                                Position="{Binding DataContext.Position, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                PressedBrush="{DynamicResource Brush.Navy}"
                                SamplePlacementRequested="OnSamplePlacementRequested"
                                SampleRemovalRequested="OnSampleRemovalRequested"
                                SampleSelectionRequested="OnSampleSelectionRequested"
                                Samples="{Binding Samples, Mode=OneWay}"
                                SamplesRevision="{Binding DataContext.SamplesRevision, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                SelectedSamples="{Binding DataContext.SelectedSamples, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                SelectionBrush="{DynamicResource Brush.Navy}"
                                SelectionCueBrush="{DynamicResource Brush.Text.Primary}"
                                Subdivision="{Binding DataContext.Subdivision, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                ViewportWidth="{Binding TimelineViewportWidth, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                ZoomFactor="{Binding DataContext.ZoomFactor, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                Duration="{Binding DataContext.Waveform.Duration, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="MissingGridStatus"
                            IsHitTestVisible="False"
                            Style="{StaticResource OHsWorkstationMissingStatusStyle}" />
                    </Grid>
                </Border>
                <StackPanel
                    x:Name="TrackRightControls"
                    Grid.Column="4"
                    Margin="0,8"
                    VerticalAlignment="Center"
                    Loaded="OnTrackControlStackLoaded"
                    SizeChanged="OnTrackControlStackSizeChanged"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <ComboBox
                        x:Name="TrackSampleFileSelector"
                        AutomationProperties.Name="Track sample"
                        DataContextChanged="OnTrackControlDataContextChanged"
                        IsEnabled="{Binding DataContext.CanImportSample, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                        ItemsSource="{Binding DataContext.SampleFiles, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                        Loaded="OnSampleSelectorLoaded"
                        SelectionChanged="OnSampleSelectionChanged"
                        Style="{StaticResource OHsWorkstationSampleFileSelectorStyle}"
                        ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                    <StackPanel x:Name="TrackRightExpandedControls" Style="{StaticResource OHsWorkstationExpandedTrackControlsStyle}">
                        <customControls:SpacedUniformGrid
                            Margin="0,0,0,8"
                            Columns="2"
                            HorizontalGap="4"
                            VerticalGap="4">
                            <ComboBox
                                x:Name="TrackSamplesetSelector"
                                AutomationProperties.Name="Sampleset"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding DataContext.CanEditTracks, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                ItemsSource="{x:Static entities:Track.SamplesetOptions}"
                                Loaded="OnTrackMetadataSelectorLoaded"
                                SelectionChanged="OnTrackMetadataSelectionChanged"
                                Style="{StaticResource OHsWorkstationCompactMetadataStyle}"
                                ToolTip="Sampleset" />
                            <ComboBox
                                x:Name="TrackAdditionSelector"
                                AutomationProperties.Name="Addition"
                                DataContextChanged="OnTrackControlDataContextChanged"
                                IsEnabled="{Binding DataContext.CanEditTracks, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                                ItemsSource="{x:Static entities:Track.AdditionOptions}"
                                Loaded="OnTrackMetadataSelectorLoaded"
                                SelectionChanged="OnTrackMetadataSelectionChanged"
                                Style="{StaticResource OHsWorkstationCompactMetadataStyle}"
                                ToolTip="Addition" />
                        </customControls:SpacedUniformGrid>
                        <ComboBox
                            x:Name="TrackSampleTypeSelector"
                            AutomationProperties.Name="Track sample type"
                            DataContextChanged="OnTrackControlDataContextChanged"
                            IsEnabled="{Binding DataContext.CanEditTracks, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}"
                            ItemsSource="{x:Static entities:Track.SampleTypeOptions}"
                            Loaded="OnTrackMetadataSelectorLoaded"
                            SelectionChanged="OnTrackMetadataSelectionChanged"
                            Style="{StaticResource OHsWorkstationTrackMetadataComboBoxStyle}"
                            ToolTip="Track sample type" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style
            x:Key="OHsWorkstationLoadingOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowStatusOverlay, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationLoadingToastStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowStatusOverlay, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsWorkstationLoadingTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent" Style="{StaticResource BaseGridStyle}">
        <Grid
            x:Name="WorkstationRoot"
            Margin="16,16,16,0"
            IsEnabled="{Binding IsInteractionReady, Mode=OneWay}"
            SizeChanged="OnVolumeOverlayHostSizeChanged">
            <Grid x:Name="WorkstationContent" Style="{StaticResource OHsWorkstationContentStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <Border
                    x:Name="SongAudioCard"
                    Margin="0,0,0,8"
                    Style="{StaticResource OHsWorkstationPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="128" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                                <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                                <ColumnDefinition Width="{Binding TrackScrollBarGutter, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <customControls:SpacedUniformGrid
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Columns="3"
                                HorizontalGap="4"
                                ItemHeight="40"
                                ItemWidth="40"
                                VerticalGap="4">
                                <customControls:BalloonButton
                                    x:Name="PlayPauseButton"
                                    Margin="0"
                                    Command="{Binding PlayPauseCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationPlayPauseStyle}" />
                                <customControls:BalloonButton
                                    Margin="0"
                                    AutomationProperties.Name="Stop audio"
                                    ButtonIcon="{StaticResource MediaStop}"
                                    ButtonText="Stop"
                                    Command="{Binding StopCommand, Mode=OneWay}"
                                    ShouldShowText="False"
                                    Style="{StaticResource OHsWorkstationToolbarButtonStyle}"
                                    ToolTip="Stop audio and return to the beginning" />
                                <customControls:BalloonCheckBox
                                    x:Name="ScrollWithMarkerCheckBox"
                                    AutomationProperties.HelpText="Follow the current playback marker. Selecting a node turns this off."
                                    AutomationProperties.Name="Scroll with marker"
                                    ButtonIcon="{StaticResource AlignArrowRightFill}"
                                    ButtonText="Scroll with marker"
                                    CheckedIcon="{StaticResource AlignArrowRightFill}"
                                    IsChecked="{Binding ScrollWithMarker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationToolbarFollowStyle}"
                                    ToolTip="Follow the current playback marker. Selecting a node turns this off." />
                                <customControls:BalloonButton
                                    x:Name="ResnapAllSamplesButton"
                                    Margin="0"
                                    AutomationProperties.HelpText="Snap every sample to the nearest beat in the current subdivision"
                                    AutomationProperties.Name="Resnap all samples"
                                    ButtonIcon="{StaticResource RegularRepeat}"
                                    ButtonText="Resnap all samples"
                                    Command="{Binding ResnapAllSamplesCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationToolbarResnapStyle}"
                                    ToolTip="Snap every sample to the nearest beat in the current subdivision" />
                                <ToggleButton
                                    x:Name="ClearTrackMutesToggle"
                                    AutomationProperties.Name="Clear all track mutes"
                                    Command="{Binding ClearTrackMutesCommand, Mode=OneWay}"
                                    Content="M"
                                    IsChecked="{Binding HasMutedTracks, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                                    ToolTip="Clear all track mutes"
                                    Unchecked="OnClearTrackMutesUnchecked" />
                                <ToggleButton
                                    x:Name="ClearTrackSolosToggle"
                                    AutomationProperties.Name="Clear all track solos"
                                    Command="{Binding ClearTrackSolosCommand, Mode=OneWay}"
                                    Content="S"
                                    IsChecked="{Binding HasSoloedTracks, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationTrackToggleStyle}"
                                    ToolTip="Clear all track solos"
                                    Unchecked="OnClearTrackSolosUnchecked" />
                            </customControls:SpacedUniformGrid>
                            <ScrollViewer
                                x:Name="WaveformScrollViewer"
                                Grid.Column="2"
                                AutomationProperties.HelpText="Click to seek. Left and Right move between subdivision lines. Control plus Left or Right moves between whole beats. Use Shift plus wheel to scroll, Control plus wheel to zoom, or Alt plus wheel over this song card to change subdivision."
                                AutomationProperties.Name="Audio waveform"
                                FlowDirection="LeftToRight"
                                Focusable="True"
                                IsEnabled="{Binding CanPlay, Mode=OneWay}"
                                ScrollChanged="OnWaveformScrollChanged"
                                SizeChanged="OnWaveformViewportSizeChanged"
                                Style="{StaticResource OHsWorkstationWaveformScrollStyle}">
                                <customControls:WaveformView
                                    x:Name="WaveformDisplay"
                                    Bpms="{Binding Project.BPMs, Mode=OneWay}"
                                    Data="{Binding Waveform, Mode=OneWay}"
                                    FontFamily="{DynamicResource Regular}"
                                    HorizontalOffset="{Binding ElementName=WaveformScrollViewer, Path=HorizontalOffset, Mode=OneWay}"
                                    MarkerBrush="{StaticResource OHsWorkstationPlaybackMarkerBrush}"
                                    MouseLeftButtonDown="OnWaveformMouseLeftButtonDown"
                                    Offsets="{Binding Project.Offsets, Mode=OneWay}"
                                    Position="{Binding Position, Mode=OneWay}"
                                    SeekCommand="{Binding SeekCommand, Mode=OneWay}"
                                    SizeChanged="OnWaveformDisplaySizeChanged"
                                    Subdivision="{Binding Subdivision, Mode=OneWay}"
                                    TextBrush="{DynamicResource Brush.Text.Secondary}"
                                    ViewportWidth="{Binding ElementName=WaveformScrollViewer, Path=ViewportWidth, Mode=OneWay}"
                                    WaveformBrush="{DynamicResource Brush.Navy.Muted}"
                                    ZoomFactor="{Binding ZoomFactor, Mode=OneWay}" />
                            </ScrollViewer>
                            <customControls:SpacedUniformGrid
                                x:Name="TrackActionsHost"
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Columns="3"
                                HorizontalGap="4"
                                ItemHeight="40"
                                ItemWidth="40"
                                VerticalGap="4">
                                <RadioButton
                                    x:Name="SelectionModeButton"
                                    AutomationProperties.Name="Selection Mode"
                                    Checked="OnEditingModeChecked"
                                    GroupName="EditingMode"
                                    IsChecked="{Binding IsSelectionMode, Mode=OneWay}"
                                    IsEnabled="{Binding CanPlaceSamples, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationModeButtonStyle}"
                                    ToolTip="Selection Mode: select and drag nodes">
                                    <customControls:Icon
                                        Width="18"
                                        Height="18"
                                        Path="{StaticResource ArrowCursor}"
                                        Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}, Mode=OneWay}" />
                                </RadioButton>
                                <RadioButton
                                    x:Name="AdditionModeButton"
                                    AutomationProperties.Name="Addition Mode"
                                    Checked="OnEditingModeChecked"
                                    GroupName="EditingMode"
                                    IsChecked="{Binding IsAdditionMode, Mode=OneWay}"
                                    IsEnabled="{Binding CanPlaceSamples, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationModeButtonStyle}"
                                    ToolTip="Addition Mode: create nodes">
                                    <customControls:Icon
                                        Width="18"
                                        Height="18"
                                        Path="{StaticResource RectangleVertical}"
                                        Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}, Mode=OneWay}" />
                                </RadioButton>
                                <customControls:BalloonButton
                                    x:Name="ToggleTracksCollapsedButton"
                                    Command="{Binding ToggleTracksCollapsedCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationCollapseTracksStyle}" />
                                <customControls:BalloonButton
                                    x:Name="ManageSamplesButton"
                                    AutomationProperties.Name="Manage Samples"
                                    ButtonIcon="{StaticResource BarsSolid}"
                                    ButtonText="Manage Samples"
                                    Command="{Binding ManageSamplesCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationManageSamplesButtonStyle}"
                                    ToolTip="Manage project samples" />
                                <customControls:BalloonButton
                                    x:Name="AddSampleTrackButton"
                                    AutomationProperties.Name="Add New Sample Track"
                                    ButtonIcon="{StaticResource MoviePlus}"
                                    ButtonText="Add New Sample Track"
                                    Command="{Binding AddSampleTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationToolbarButtonStyle}"
                                    ToolTip="Add New Sample Track" />
                                <customControls:BalloonButton
                                    x:Name="AddInstrumentButton"
                                    AutomationProperties.HelpText="Instrumental track creation is not implemented yet."
                                    AutomationProperties.Name="Add New Instrument"
                                    ButtonIcon="{StaticResource MusicNotesPlusFill}"
                                    ButtonText="Add New Instrument"
                                    Command="{Binding AddPianoTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource OHsWorkstationToolbarButtonStyle}"
                                    ToolTip="Instrumental track creation is coming later" />
                            </customControls:SpacedUniformGrid>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource OHsWorkstationSaveErrorStyle}"
                        Text="{Binding SaveError, Mode=OneWay}" />
                    <customControls:BalloonButton
                        AutomationProperties.Name="Retry project save"
                        ButtonIcon="{StaticResource RegularRepeat}"
                        ButtonText="Retry save"
                        Command="{Binding RetrySaveCommand, Mode=OneWay}"
                        ShouldShowText="True"
                        Style="{StaticResource OHsWorkstationRetrySaveStyle}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    Margin="17,0,17,8"
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource OHsWorkstationColumnGap}" />
                        <ColumnDefinition Width="{StaticResource OHsWorkstationSideColumnWidth}" />
                        <ColumnDefinition Width="{Binding TrackScrollBarGutter, RelativeSource={RelativeSource AncestorType=pages:WorkstationPage}, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <ScrollBar
                        x:Name="WaveformScrollBar"
                        Grid.Column="2"
                        Margin="0"
                        AutomationProperties.HelpText="Use arrow keys, Page Up, Page Down, Home, or End to move through the waveform."
                        AutomationProperties.Name="Waveform horizontal position"
                        FlowDirection="LeftToRight"
                        LargeChange="{Binding ViewportWidth, ElementName=WaveformScrollViewer, Mode=OneWay}"
                        Maximum="{Binding ScrollableWidth, ElementName=WaveformScrollViewer, Mode=OneWay}"
                        Orientation="Horizontal"
                        Scroll="OnWaveformScrollBarScroll"
                        SmallChange="16"
                        Style="{StaticResource OHsWorkstationWaveformScrollBarStyle}"
                        ViewportSize="{Binding ViewportWidth, ElementName=WaveformScrollViewer, Mode=OneWay}" />
                </Grid>
                <Border
                    x:Name="TracksCard"
                    Grid.Row="3"
                    Margin="0,0,0,12"
                    Style="{StaticResource OHsWorkstationTrackCardStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AdornerDecorator Grid.Row="0">
                            <Grid>
                                <ListBox
                                    x:Name="TrackList"
                                    AutomationProperties.Name="Sample tracks"
                                    ItemTemplate="{StaticResource OHsWorkstationSampleTrackTemplate}"
                                    ItemsSource="{Binding Tracks, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectionMode="Single"
                                    Style="{StaticResource OHsWorkstationTrackListStyle}" />
                            </Grid>
                        </AdornerDecorator>
                        <Border
                            Grid.Row="1"
                            Padding="0"
                            BorderThickness="{Binding BorderThickness, ElementName=SongAudioCard, Mode=OneWay}"
                            Style="{StaticResource BaseBorderStyle}">
                            <Grid
                                x:Name="ZoomFooter"
                                Margin="0,0,0,-16"
                                Style="{StaticResource BaseGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Elapsed audio time"
                                    Style="{StaticResource OHsWorkstationElapsedStyle}"
                                    Text="{Binding ElapsedText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid
                                    x:Name="FooterControlsHost"
                                    Grid.Column="1"
                                    Style="{StaticResource BaseGridStyle}">
                                    <WrapPanel
                                        MaxWidth="{Binding ActualWidth, ElementName=FooterControlsHost, Mode=OneWay}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FlowDirection="{Binding FlowDirection, ElementName=WorkstationRoot, Mode=OneWay}">
                                        <StackPanel
                                            x:Name="SubdivisionPanel"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource OHsWorkstationSubdivisionLabelStyle}" Text="Beat Divisor" />
                                            <customControls:ValueSlider
                                                x:Name="SubdivisionSelector"
                                                AutomationProperties.Name="Beat subdivision"
                                                DisplayText="{Binding Subdivision, Mode=OneWay, StringFormat=1/{0}}"
                                                IsSnapToTickEnabled="True"
                                                LargeChange="1"
                                                Maximum="8"
                                                Minimum="0"
                                                SmallChange="1"
                                                Style="{StaticResource OHsWorkstationSubdivisionStyle}"
                                                TickFrequency="1"
                                                Value="{Binding SelectedSubdivisionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="ZoomControls"
                                            VerticalAlignment="Center"
                                            FlowDirection="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FlowDirection, Mode=OneWay}"
                                            Orientation="Horizontal">
                                            <customControls:BalloonButton
                                                AutomationProperties.Name="Zoom waveform out"
                                                ButtonIcon="{StaticResource Minus}"
                                                Command="{Binding ZoomOutCommand, Mode=OneWay}"
                                                Style="{StaticResource OHsWorkstationIconButtonStyle}"
                                                ToolTip="Zoom waveform out" />
                                            <customControls:BalloonButton
                                                AutomationProperties.Name="Zoom waveform in"
                                                ButtonIcon="{StaticResource PlusSolid}"
                                                Command="{Binding ZoomInCommand, Mode=OneWay}"
                                                Style="{StaticResource OHsWorkstationIconButtonStyle}"
                                                ToolTip="Zoom waveform in" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
            <Border
                x:Name="VolumeOverlay"
                Width="320"
                VerticalAlignment="Center"
                Panel.ZIndex="10"
                FlowDirection="LeftToRight"
                PreviewMouseMove="OnVolumeOverlayMouseMove"
                Style="{StaticResource OHsWorkstationVolumeOverlayStyle}"
                Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="VolumeWheelPanel"
                        HorizontalAlignment="Stretch"
                        FlowDirection="{Binding FlowDirection, ElementName=WorkstationRoot, Mode=OneWay}"
                        Style="{StaticResource BaseStackPanelStyle}">
                        <customControls:VolumeWheel
                            x:Name="SongVolumeWheel"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            Label="Song"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource OHsVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding SongVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <customControls:VolumeWheel
                            x:Name="ApplicationVolumeWheel"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            Label="Application"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource OHsVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding ApplicationVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <customControls:VolumeWheel
                            x:Name="SamplesVolumeWheel"
                            IsEnabled="{Binding CanPlay, Mode=OneWay}"
                            Label="Samples"
                            MouseMove="OnVolumeWheelMouseMove"
                            PreviewMouseLeftButtonDown="OnVolumeWheelMouseDown"
                            Style="{StaticResource OHsVolumeWheelStyle}"
                            ValueChanged="OnVolumeWheelValueChanged"
                            Value="{Binding SamplesVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border x:Name="LoadingOverlay" Style="{StaticResource OHsWorkstationLoadingOverlayStyle}" />
        <Border x:Name="LoadingToast" Style="{StaticResource OHsWorkstationLoadingToastStyle}">
            <TextBlock
                x:Name="LoadingProjectText"
                AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                Style="{StaticResource OHsWorkstationLoadingTextStyle}"
                Text="{Binding StatusText, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
