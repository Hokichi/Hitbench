<UserControl
    x:Class="osuHitsounder.Views.Pages.WorkstationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OHsWorkstationPanelStyle" BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OHsWorkstationTransportButtonStyle" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ShouldShowText" Value="True" />
        </Style>
        <Style x:Key="OHsWorkstationPlayPauseStyle" BasedOn="{StaticResource OHsWorkstationTransportButtonStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="AutomationProperties.Name" Value="Play audio" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Setter Property="ButtonText" Value="Play" />
            <Setter Property="ToolTip" Value="Play audio" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Pause audio" />
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaPause}" />
                    <Setter Property="ButtonText" Value="Pause" />
                    <Setter Property="ToolTip" Value="Pause audio" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationDummyTrackStyle" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ShouldShowText" Value="True" />
        </Style>
        <Style x:Key="OHsWorkstationIconButtonStyle" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ShouldShowText" Value="False" />
        </Style>
        <Style x:Key="OHsWorkstationFitButtonStyle" BasedOn="{StaticResource OHsWorkstationIconButtonStyle}" TargetType="customControls:BalloonButton">
            <Setter Property="ShouldShowText" Value="True" />
        </Style>
        <Style x:Key="OHsWorkstationZoomEditorStyle" BasedOn="{StaticResource RoundedTextInputStyle}" TargetType="TextBox">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationZoomValidationBoundaryStyle" BasedOn="{StaticResource BaseBorderStyle}" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasZoomValidationError, Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationZoomLabelStyle" BasedOn="{StaticResource FieldLabelTextStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OHsWorkstationZoomSuffixStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="OHsWorkstationZoomValidationTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ZoomValidationMessage, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationElapsedStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationSubdivisionLabelStyle" BasedOn="{StaticResource FieldLabelTextStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OHsWorkstationSubdivisionStyle" BasedOn="{StaticResource OHsComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" /></Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationStatusStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationErrorStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsWorkstationWaveformScrollBarStyle" BasedOn="{StaticResource {x:Type ScrollBar}}" TargetType="ScrollBar">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsWorkstationWaveformScrollTemplate" TargetType="ScrollViewer">
            <Border x:Name="WaveformBoundary" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <Grid>
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    Margin="{TemplateBinding Padding}"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                <ScrollBar
                    x:Name="PART_HorizontalScrollBar"
                    Height="12"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Waveform horizontal position"
                    Maximum="{TemplateBinding ScrollableWidth}"
                    Orientation="Horizontal"
                    Style="{StaticResource OHsWorkstationWaveformScrollBarStyle}"
                    ViewportSize="{TemplateBinding ViewportWidth}"
                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                    Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WaveformBoundary" Property="BorderBrush" Value="{DynamicResource Brush.Navy.Muted}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="WaveformBoundary" Property="BorderBrush" Value="{DynamicResource Brush.Navy}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="OHsWorkstationWaveformScrollStyle" BasedOn="{StaticResource BaseScrollViewerStyle}" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisualStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template" Value="{StaticResource OHsWorkstationWaveformScrollTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /><Setter Property="Opacity" Value="0.4" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource OHsWorkstationPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <WrapPanel x:Name="TransportPanel" VerticalAlignment="Center">
                    <customControls:BalloonButton x:Name="PlayPauseButton" Command="{Binding PlayPauseCommand, Mode=OneWay}" Style="{StaticResource OHsWorkstationPlayPauseStyle}" />
                    <customControls:BalloonButton
                        AutomationProperties.Name="Stop audio"
                        ButtonIcon="{StaticResource MediaStop}"
                        ButtonText="Stop"
                        Command="{Binding StopCommand, Mode=OneWay}"
                        ShouldShowText="True"
                        Style="{StaticResource OHsWorkstationTransportButtonStyle}"
                        ToolTip="Stop audio and return to the beginning" />
                    <TextBlock AutomationProperties.Name="Elapsed audio time" Style="{StaticResource OHsWorkstationElapsedStyle}" Text="{Binding ElapsedText, Mode=OneWay}" />
                </WrapPanel>
                    <StackPanel x:Name="SubdivisionPanel" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OHsWorkstationSubdivisionLabelStyle}" Text="Subdivision" />
                        <ComboBox
                            x:Name="SubdivisionSelector"
                            AutomationProperties.Name="Beat subdivision"
                            SelectedIndex="{Binding SelectedSubdivisionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource OHsWorkstationSubdivisionStyle}">
                            <ComboBoxItem Content="1/1" />
                            <ComboBoxItem Content="1/2" />
                            <ComboBoxItem Content="1/3" />
                            <ComboBoxItem Content="1/4" />
                            <ComboBoxItem Content="1/5" />
                            <ComboBoxItem Content="1/6" />
                            <ComboBoxItem Content="1/8" />
                            <ComboBoxItem Content="1/12" />
                            <ComboBoxItem Content="1/16" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource OHsWorkstationStatusStyle}" Text="Loading waveform…" />
                <TextBlock Grid.Row="2" Style="{StaticResource OHsWorkstationErrorStyle}" Text="{Binding ErrorMessage, Mode=OneWay}" />
                <ScrollViewer
                    x:Name="WaveformScrollViewer"
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    AutomationProperties.HelpText="Click to seek. Use arrow keys to scroll, Control plus arrow keys to seek, Control plus wheel to zoom, or Alt plus wheel to change subdivision."
                    AutomationProperties.Name="Audio waveform"
                    Focusable="True"
                    IsEnabled="{Binding CanPlay, Mode=OneWay}"
                    PreviewKeyDown="OnWaveformKeyDown"
                    ScrollChanged="OnWaveformScrollChanged"
                    SizeChanged="OnWaveformViewportSizeChanged"
                    Style="{StaticResource OHsWorkstationWaveformScrollStyle}">
                    <customControls:WaveformView
                        x:Name="WaveformDisplay"
                        Data="{Binding Waveform, Mode=OneWay}"
                        FontFamily="{DynamicResource Regular}"
                        HorizontalOffset="{Binding ElementName=WaveformScrollViewer, Path=HorizontalOffset, Mode=OneWay}"
                        MarkerBrush="{DynamicResource Brush.Navy}"
                        MouseLeftButtonDown="OnWaveformMouseLeftButtonDown"
                        Position="{Binding Position, Mode=OneWay}"
                        SeekCommand="{Binding SeekCommand, Mode=OneWay}"
                        TextBrush="{DynamicResource Brush.Text.Secondary}"
                        ViewportWidth="{Binding ElementName=WaveformScrollViewer, Path=ViewportWidth, Mode=OneWay}"
                        WaveformBrush="{DynamicResource Brush.Navy.Muted}"
                        ZoomFactor="{Binding ZoomFactor, Mode=OneWay}" />
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <customControls:BalloonButton
                x:Name="SampleTrackButton"
                AutomationProperties.HelpText="Track creation is not implemented yet."
                AutomationProperties.Name="Add sample track"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="Sample Track"
                Command="{Binding AddSampleTrackCommand, Mode=OneWay}"
                Style="{StaticResource OHsWorkstationDummyTrackStyle}"
                ToolTip="Sample track creation is coming later" />
            <customControls:BalloonButton
                x:Name="PianoTrackButton"
                Grid.Column="2"
                AutomationProperties.HelpText="Track creation is not implemented yet."
                AutomationProperties.Name="Add piano track"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="Piano Track"
                Command="{Binding AddPianoTrackCommand, Mode=OneWay}"
                Style="{StaticResource OHsWorkstationDummyTrackStyle}"
                ToolTip="Piano track creation is coming later" />
        </Grid>
        <Grid x:Name="ZoomFooter" Grid.Row="3" HorizontalAlignment="Right" FlowDirection="LeftToRight">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel
                FlowDirection="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FlowDirection, Mode=OneWay}"
                Orientation="Horizontal">
                <TextBlock x:Name="ZoomLabel" Style="{StaticResource OHsWorkstationZoomLabelStyle}" Text="Zoom" />
                <customControls:BalloonButton AutomationProperties.Name="Zoom waveform out" ButtonIcon="{StaticResource Minus}" Command="{Binding ZoomOutCommand, Mode=OneWay}" Style="{StaticResource OHsWorkstationIconButtonStyle}" ToolTip="Zoom waveform out" />
                <Border Style="{StaticResource OHsWorkstationZoomValidationBoundaryStyle}">
                    <TextBox
                        x:Name="ZoomEditor"
                        AutomationProperties.HelpText="{Binding ZoomValidationMessage, Mode=OneWay}"
                        AutomationProperties.Name="Waveform zoom level"
                        GotKeyboardFocus="OnZoomEditorGotKeyboardFocus"
                        IsEnabled="{Binding CanZoom, Mode=OneWay}"
                        LostKeyboardFocus="OnZoomEditorLostKeyboardFocus"
                        PreviewKeyDown="OnZoomEditorKeyDown"
                        PreviewMouseLeftButtonDown="OnZoomEditorMouseLeftButtonDown"
                        Style="{StaticResource OHsWorkstationZoomEditorStyle}"
                        Text="{Binding ZoomDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <TextBlock Style="{StaticResource OHsWorkstationZoomSuffixStyle}" Text="x" />
                <customControls:BalloonButton AutomationProperties.Name="Zoom waveform in" ButtonIcon="{StaticResource PlusSolid}" Command="{Binding ZoomInCommand, Mode=OneWay}" Style="{StaticResource OHsWorkstationIconButtonStyle}" ToolTip="Zoom waveform in" />
                <customControls:BalloonButton
                    x:Name="FitButton"
                    AutomationProperties.Name="Fit waveform"
                    ButtonIcon="{StaticResource ExpandAlt}"
                    ButtonText="Fit"
                    Click="OnFitClicked"
                    Command="{Binding FitCommand, Mode=OneWay}"
                    Style="{StaticResource OHsWorkstationFitButtonStyle}"
                    ToolTip="Fit the full waveform" />
            </StackPanel>
            <TextBlock
                x:Name="ZoomValidationText"
                Grid.Row="1"
                AutomationProperties.LiveSetting="Assertive"
                Style="{StaticResource OHsWorkstationZoomValidationTextStyle}"
                Text="{Binding ZoomValidationMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
