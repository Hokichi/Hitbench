<c:BasePopup x:Class="osuHitsounder.Views.Popups.ManageSamplesPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" Width="720" Height="480" SizeToContent="Manual" Mode="None" PopupTitle="Manage Sample" KeyboardNavigation.TabNavigation="Cycle">
 <c:BasePopup.Resources>
  <Style x:Key="OHsManageSamplesTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsManageSamplesErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsManageSamplesTextStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
   <Style.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsManageSamplesNameStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsManageSamplesTextStyle}">
   <Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsEditing,Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsManageSamplesEditorHostStyle" TargetType="Grid" BasedOn="{StaticResource BaseGridStyle}">
   <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing,Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsManageSamplesEditorStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextInputStyle}">
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/>
   <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/></Trigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OHsManageSamplesActionStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"><Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/><Setter Property="IsTabStop" Value="True"/></Style>
  <Style x:Key="OHsManageSamplesDeleteStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}"><Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/><Setter Property="IsTabStop" Value="True"/></Style>
  <Style x:Key="OHsManageSamplesRowStyle" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,4"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/></Trigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource Self},Mode=OneWay}" Value="True"/><Condition Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></MultiDataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource Self},Mode=OneWay}" Value="True"/><Condition Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></MultiDataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="OHsManageSamplesRowTemplate">
   <Border Style="{StaticResource OHsManageSamplesRowStyle}">
   <Grid MinHeight="48" Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding FileName,Mode=OneWay}" ToolTip="{Binding FileName,Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource OHsManageSamplesNameStyle}"/>
    <Grid Style="{StaticResource OHsManageSamplesEditorHostStyle}" Margin="0,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="Filename" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource OHsManageSamplesTextStyle}"/>
     <TextBox Grid.Column="1" AutomationProperties.Name="Sample filename stem" Text="{Binding DataContext.DraftStem,RelativeSource={RelativeSource AncestorType=ItemsControl},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Style="{StaticResource OHsManageSamplesEditorStyle}" IsVisibleChanged="OnEditorVisibilityChanged" PreviewKeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus"/>
     <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Extension,Mode=OneWay}" Style="{StaticResource OHsManageSamplesTextStyle}"/>
    </Grid>
<c:BalloonButton Grid.Column="1" ButtonText="Play" ButtonIcon="{StaticResource MediaPlay}" ToolTip="{Binding FileName,Mode=OneWay,StringFormat=Play {0}}" AutomationProperties.Name="{Binding FileName,Mode=OneWay,StringFormat=Play {0}}" Command="{Binding DataContext.PlayCommand,RelativeSource={RelativeSource AncestorType=ItemsControl},Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Style="{StaticResource OHsManageSamplesActionStyle}"/>
    <c:BalloonButton Grid.Column="2" Margin="8,0,0,0" ButtonText="Edit" ButtonIcon="{StaticResource Pen}" ToolTip="{Binding FileName,Mode=OneWay,StringFormat=Edit {0}}" AutomationProperties.Name="{Binding FileName,Mode=OneWay,StringFormat=Edit {0}}" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=ItemsControl},Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Style="{StaticResource OHsManageSamplesActionStyle}"/>
    <c:BalloonButton Grid.Column="3" Margin="8,0,0,0" ButtonText="Delete" ButtonIcon="{StaticResource Delete}" ToolTip="{Binding FileName,Mode=OneWay,StringFormat=Delete {0}}" AutomationProperties.Name="{Binding FileName,Mode=OneWay,StringFormat=Delete {0}}" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=ItemsControl},Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Style="{StaticResource OHsManageSamplesDeleteStyle}"/>
   </Grid>
   </Border>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="OHsManageSamplesPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
  <ControlTemplate x:Key="OHsManageSamplesListTemplate" TargetType="ItemsControl"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
  <Style x:Key="OHsManageSamplesListStyle" TargetType="ItemsControl" BasedOn="{StaticResource BaseItemsControlStyle}">
   <Setter Property="ItemsPanel" Value="{StaticResource OHsManageSamplesPanel}"/><Setter Property="ItemTemplate" Value="{StaticResource OHsManageSamplesRowTemplate}"/><Setter Property="Template" Value="{StaticResource OHsManageSamplesListTemplate}"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style x:Key="OHsManageSamplesEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredEmptyStateTextStyle}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty,Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers></Style>
 </c:BasePopup.Resources>
 <Grid Margin="24" Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Style="{StaticResource BaseGridStyle}"><ItemsControl x:Name="SampleRows" ItemsSource="{Binding Entries,Mode=OneWay}" Style="{StaticResource OHsManageSamplesListStyle}"/><TextBlock Text="No samples in this project. Add a new sample to get started." Style="{StaticResource OHsManageSamplesEmptyStyle}"/></Grid>
  <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding ErrorMessage,Mode=OneWay}" Style="{StaticResource OHsManageSamplesErrorStyle}"/>
  <Grid Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource BaseGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <c:BalloonButton x:Name="AddNewSampleButton" Grid.Column="1" ButtonText="Add New Sample" ButtonIcon="{StaticResource PlusSolid}" ShouldShowText="True" AutomationProperties.Name="Add new sample" Command="{Binding AddNewSampleCommand,Mode=OneWay}" Style="{StaticResource OHsManageSamplesActionStyle}"/>
  </Grid>
 </Grid>
</c:BasePopup>

