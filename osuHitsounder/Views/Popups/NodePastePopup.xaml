<c:BasePopup x:Class="osuHitsounder.Views.Popups.NodePastePopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" PopupTitle="Paste sample nodes">
 <c:BasePopup.Resources>
  <ControlTemplate x:Key="OHsNodePasteTimingChoiceTemplate" TargetType="RadioButton">
   <Border Style="{StaticResource BaseBorderStyle}" Background="{TemplateBinding Background}" Padding="8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Ellipse Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
     <Ellipse x:Name="CheckedCue" Width="8" Height="8" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
     <ContentPresenter Style="{StaticResource BaseContentPresenterStyle}" Grid.Column="1" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckedCue" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="OHsNodePasteTimingChoiceStyle" TargetType="RadioButton" BasedOn="{StaticResource BaseRadioButtonStyle}">
   <Setter Property="Template" Value="{StaticResource OHsNodePasteTimingChoiceTemplate}"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="IsTabStop" Value="True"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="FontFamily" Value="{DynamicResource Regular}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/></Trigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></MultiDataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OHsNodePasteConfirmButtonStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonConfirmActionStyle}"><Setter Property="IsTabStop" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/></Style>
  <Style x:Key="OHsNodePasteCancelButtonStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"><Setter Property="IsTabStop" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}"/></Style>
 </c:BasePopup.Resources>
 <StackPanel Margin="24" MaxWidth="420">
  <RadioButton GroupName="NodePasteTiming" IsChecked="{Binding UseSourceTimestamps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OHsNodePasteTimingChoiceStyle}" AutomationProperties.Name="Same timestamps as source"><TextBlock Style="{StaticResource BaseTextBlockStyle}" TextWrapping="Wrap" Text="Same timestamps as source"/></RadioButton>
  <RadioButton x:Name="MarkerChoice" GroupName="NodePasteTiming" IsChecked="{Binding UsePlaybackMarker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OHsNodePasteTimingChoiceStyle}" AutomationProperties.Name="At playback marker"><TextBlock Style="{StaticResource BaseTextBlockStyle}" TextWrapping="Wrap" Text="At playback marker"/></RadioButton>
  <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
   <c:BalloonButton x:Name="CancelButton" ButtonText="Cancel" ButtonIcon="{StaticResource Ban}" ShouldShowText="True" Style="{StaticResource OHsNodePasteCancelButtonStyle}" AutomationProperties.Name="Cancel" Click="OnCancel"/>
   <c:BalloonButton x:Name="PasteButton" ButtonText="Paste" ButtonIcon="{StaticResource Check}" ShouldShowText="True" Style="{StaticResource OHsNodePasteConfirmButtonStyle}" AutomationProperties.Name="Paste" Click="OnPaste"/>
  </WrapPanel>
 </StackPanel>
</c:BasePopup>
