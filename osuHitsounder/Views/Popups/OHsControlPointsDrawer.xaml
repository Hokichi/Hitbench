<UserControl x:Class="osuHitsounder.Views.Popups.OHsControlPointsDrawer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
 xmlns:e="clr-namespace:osuHitsounder.Core.Entities;assembly=osuHitsounder.Core">
 <UserControl.Resources>
  <Style x:Key="OHsControlPointsActionStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
   <Setter Property="IsTabStop" Value="True" /><Setter Property="ShouldShowText" Value="True" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
   <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
  </Style>
  <Style x:Key="OHsControlPointsCloseStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
   <Setter Property="IsTabStop" Value="True" /><Setter Property="ShouldShowText" Value="True" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
   <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
  </Style>
  <Style x:Key="OHsControlPointsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /><Setter Property="TextWrapping" Value="Wrap" />
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsControlPointsErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsControlPointsTextStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /><Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
   <Style.Triggers>
    <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OHsControlPointsLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CardLabelTextStyle}">
   <Setter Property="TextWrapping" Value="Wrap" />
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsControlPointsStatusStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
   <Setter Property="MaxHeight" Value="120" /><Setter Property="Focusable" Value="True" />
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="IsTabStop" Value="True" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
  </Style>
  <Style x:Key="OHsControlPointsVolumeStyle" TargetType="c:NumericUpDown" BasedOn="{StaticResource {x:Type c:NumericUpDown}}">
   <Setter Property="IsIntegerOnly" Value="True" /><Setter Property="LowerLimit" Value="5" /><Setter Property="UpperLimit" Value="100" /><Setter Property="Step" Value="1" />
   <Setter Property="ClampIntegerToRange" Value="True" /><Setter Property="IsVerticalDragEnabled" Value="True" />
   <Setter Property="AutomationProperties.HelpText" Value="Drag up/down to adjust volume (5–100%)." />
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
  </Style>
  <Style x:Key="OHsControlPointsSnapStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsControlPointsActionStyle}">
   <Setter Property="ShouldShowText" Value="False" />
  </Style>
  <Style x:Key="OHsControlPointsDeleteStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsControlPointsCloseStyle}">
   <Setter Property="ShouldShowText" Value="False" />
  </Style>
  <Style x:Key="OHsControlPointsItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource OHsVirtualizedDrawerItemsStyle}">
   <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
  </Style>
  <Style x:Key="OHsControlPointsSamplesetStyle" TargetType="ComboBox" BasedOn="{StaticResource OHsComboBoxStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="IsTabStop" Value="True" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
  </Style>
  <Style x:Key="OHsControlPointsEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsControlPointsTextStyle}">
   <Setter Property="Visibility" Value="Collapsed" />
   <Style.Triggers><DataTrigger Binding="{Binding IsEmpty, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsControlPointsRetryStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsControlPointsActionStyle}">
   <Setter Property="Visibility" Value="Visible" />
   <Style.Triggers>
    <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
    <DataTrigger Binding="{Binding SaveError, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="OHsControlPointsRowTemplate">
   <Grid Margin="0,8,8,0" Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid Style="{StaticResource BaseGridStyle}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Timestamp, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource OHsControlPointsTextStyle}" />
     <c:BalloonButton Grid.Column="1" Margin="4,0" ButtonText="Snap" ButtonIcon="{StaticResource BullseyeSolid}"
      Command="{Binding DataContext.SnapPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
      CommandParameter="{Binding Id, Mode=OneWay}" Style="{StaticResource OHsControlPointsSnapStyle}"
      ToolTip="Snap to current marker location"
      AutomationProperties.Name="{Binding Timestamp, Mode=OneWay, StringFormat=Snap control point at {0} milliseconds to current marker location}" />
     <c:BalloonButton Grid.Column="2" ButtonText="Delete" ButtonIcon="{StaticResource Delete}"
      Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
      CommandParameter="{Binding Id, Mode=OneWay}" Style="{StaticResource OHsControlPointsDeleteStyle}"
      ToolTip="Delete control point"
      AutomationProperties.Name="{Binding Timestamp, Mode=OneWay, StringFormat=Delete control point at {0} milliseconds}" />
    </Grid>
    <StackPanel Grid.Column="1" Margin="8,0" Style="{StaticResource BaseStackPanelStyle}">
     <c:NumericUpDown x:Name="VolumeInput" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      Style="{StaticResource OHsControlPointsVolumeStyle}" AutomationProperties.Name="{Binding Timestamp, Mode=OneWay, StringFormat=Sample volume at {0} milliseconds}" />
     <TextBlock Text="{Binding InputError, ElementName=VolumeInput, Mode=OneWay}" Style="{StaticResource OHsControlPointsErrorStyle}" />
     <TextBlock Text="{Binding Error, Mode=OneWay}" Style="{StaticResource OHsControlPointsErrorStyle}" />
    </StackPanel>
    <ComboBox Grid.Column="2" ItemsSource="{x:Static e:Track.SamplesetOptions}" SelectedItem="{Binding Sampleset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
     Style="{StaticResource OHsControlPointsSamplesetStyle}" AutomationProperties.Name="{Binding Timestamp, Mode=OneWay, StringFormat=Sampleset at {0} milliseconds}" />
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Border Style="{StaticResource OHsPopupSurfaceBorderStyle}" Padding="8">
  <Grid Style="{StaticResource BaseGridStyle}">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Grid Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <c:BalloonButton x:Name="AddPointButton" HorizontalAlignment="Left" ButtonText="Add" ButtonIcon="{StaticResource PlusSolid}" Command="{Binding AddCommand, Mode=OneWay}"
     Style="{StaticResource OHsControlPointsActionStyle}" AutomationProperties.Name="Add control point at marker" ToolTip="Add control point at nearest grid beat" />
    <TextBlock Grid.Column="1" Text="Control Points" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource OHsPopupTitleTextStyle}" />
    <c:BalloonButton Grid.Column="2" ButtonText="Close" ButtonIcon="{StaticResource Close}" Click="OnCloseClick" Style="{StaticResource OHsControlPointsCloseStyle}"
     IsEnabled="{Binding CanClose, Mode=OneWay}" AutomationProperties.Name="Close Control Points" ToolTip="Close (Esc)" />
   </Grid>
   <Grid Grid.Row="1" Margin="0,8,8,0" Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="Timestamp (ms)" Style="{StaticResource OHsControlPointsLabelStyle}" />
    <TextBlock Grid.Column="1" Margin="8,0" Text="Volume (%)" Style="{StaticResource OHsControlPointsLabelStyle}" />
    <TextBlock Grid.Column="2" Text="Sampleset" Style="{StaticResource OHsControlPointsLabelStyle}" />
   </Grid>
   <Grid Grid.Row="2" Style="{StaticResource BaseGridStyle}">
    <Grid.RowDefinitions><RowDefinition Height="4*" /><RowDefinition Height="*" MinHeight="40" /></Grid.RowDefinitions>
    <ItemsControl x:Name="PointRows" ItemsSource="{Binding Rows, Mode=OneWay}" ItemTemplate="{StaticResource OHsControlPointsRowTemplate}" Style="{StaticResource OHsControlPointsItemsStyle}" />
    <TextBlock Text="No control points yet. Use + Add to create one." Style="{StaticResource OHsControlPointsEmptyStyle}" Margin="0,8" />
   <ScrollViewer x:Name="SaveStatusHost" Grid.Row="1" Style="{StaticResource OHsControlPointsStatusStyle}"
    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Control point save status">
   <StackPanel Style="{StaticResource BaseStackPanelStyle}">
    <TextBlock Text="{Binding UnavailableReason, Mode=OneWay}" Style="{StaticResource OHsControlPointsTextStyle}" />
    <TextBlock Text="{Binding SaveStatus, Mode=OneWay}" Style="{StaticResource OHsControlPointsTextStyle}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding SaveError, Mode=OneWay}" Style="{StaticResource OHsControlPointsErrorStyle}" />
    <c:BalloonButton ButtonText="Retry save" ButtonIcon="{StaticResource RegularRepeat}" Command="{Binding RetrySaveCommand, Mode=OneWay}"
     Style="{StaticResource OHsControlPointsRetryStyle}" HorizontalAlignment="Left" AutomationProperties.Name="Retry control points save" ToolTip="Retry saving project" />
   </StackPanel>
   </ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</UserControl>
