<c:BasePopup x:Class="osuHitsounder.Views.Popups.OHsExportPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:d="clr-namespace:osuHitsounder.Resources.DataModels"
    xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
    PopupTitle="Export" ShowInTaskbar="False">
    <c:BasePopup.Resources>
        <Style x:Key="OHsExportDestinationGroupStyle" TargetType="c:SegmentedToggleGroup" BasedOn="{StaticResource {x:Type c:SegmentedToggleGroup}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        </Style>
        <Style x:Key="OHsExportDestinationOptionStyle" TargetType="c:SegmentedToggleOption" BasedOn="{StaticResource {x:Type c:SegmentedToggleOption}}">
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy.Text}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsExportNameInputStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextInputStyle}">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNameError, Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" /><Condition Binding="{Binding HasNameError, Mode=OneWay}" Value="True" /></MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OHsExportIndexInputStyle" TargetType="c:NumericUpDown" BasedOn="{StaticResource {x:Type c:NumericUpDown}}">
            <Setter Property="IsIntegerOnly" Value="True" /><Setter Property="LowerLimit" Value="1" />
            <Setter Property="UpperLimit" Value="999" /><Setter Property="Step" Value="1" />
        </Style>
        <Style x:Key="OHsExportFormatInputStyle" TargetType="ComboBox" BasedOn="{StaticResource OHsComboBoxStyle}">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style x:Key="OHsExportLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OHsExportCheckTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsExportCheckContentTemplate">
            <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource OHsExportCheckTextStyle}" />
        </DataTemplate>
        <ControlTemplate x:Key="OHsExportShowFilesTemplate" TargetType="CheckBox">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="Square" Background="{DynamicResource Brush.Background.Elevated}" Width="20" Height="20" VerticalAlignment="Center" Style="{StaticResource BaseBorderStyle}">
                        <Grid Style="{StaticResource BaseGridStyle}">
                            <c:Icon x:Name="Outline" Path="{StaticResource CheckboxBlankOutline}" Color="{DynamicResource Brush.Border.Control}" Width="20" Height="20" />
                            <c:Icon x:Name="Mark" Path="{StaticResource Check}" Color="{DynamicResource Brush.Navy.Text}" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True" Style="{StaticResource BaseContentPresenterStyle}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter TargetName="Square" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter TargetName="Outline" Property="Color" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter TargetName="Mark" Property="Color" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="OHsExportShowFilesStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
            <Setter Property="Template" Value="{StaticResource OHsExportShowFilesTemplate}" />
            <Setter Property="ContentTemplate" Value="{StaticResource OHsExportCheckContentTemplate}" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" /><Setter Property="IsTabStop" Value="True" />
            <Setter Property="MinHeight" Value="{StaticResource Size.Control.Primary}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsPressed" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" /></MultiTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /></Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="OHsExportProgressTemplate" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Style="{StaticResource BaseBorderStyle}">
                <Grid x:Name="PART_Track" Style="{StaticResource BaseGridStyle}">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Style="{StaticResource BaseBorderStyle}" />
                </Grid>
            </Border>
        </ControlTemplate>
        <Style x:Key="OHsExportProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource BaseProgressBarStyle}">
            <Setter Property="Template" Value="{StaticResource OHsExportProgressTemplate}" />
            <Setter Property="Height" Value="{StaticResource Space.2}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </c:BasePopup.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                <TextBlock Text="Diff Name" Style="{StaticResource OHsExportLabelStyle}" />
                <TextBox x:Name="DiffNameInput" AutomationProperties.Name="Diff Name" Style="{StaticResource OHsExportNameInputStyle}"
                    Text="{Binding DiffName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,16,0,0" IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                <TextBlock Text="Starting sample count" Style="{StaticResource OHsExportLabelStyle}" />
                <c:NumericUpDown x:Name="StartingIndexInput" AutomationProperties.Name="Starting custom sample index" Style="{StaticResource OHsExportIndexInputStyle}"
                    Value="{Binding StartingIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,16,0,0" IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                <TextBlock Text="Single sample format" Style="{StaticResource OHsExportLabelStyle}" />
                <ComboBox x:Name="SingleFormatInput" AutomationProperties.Name="Single sample format" Style="{StaticResource OHsExportFormatInputStyle}"
                    ItemsSource="{Binding Formats, Mode=OneWay}" SelectedItem="{Binding SingleFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,16,0,0" IsEnabled="{Binding CanEditOptions, Mode=OneWay}">
                <TextBlock Text="Mixed sample format" Style="{StaticResource OHsExportLabelStyle}" />
                <ComboBox x:Name="MixedFormatInput" AutomationProperties.Name="Mixed sample format" Style="{StaticResource OHsExportFormatInputStyle}"
                    ItemsSource="{Binding Formats, Mode=OneWay}" SelectedItem="{Binding MixedFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <c:SegmentedToggleGroup x:Name="DestinationInput" Grid.Row="4" Margin="0,16,0,0" AutomationProperties.Name="Export destination"
                Style="{StaticResource OHsExportDestinationGroupStyle}" IsEnabled="{Binding CanEditOptions, Mode=OneWay}"
                SelectedValue="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <c:SegmentedToggleOption x:Name="ProjectDestinationInput" Content="Project" AutomationProperties.Name="Project"
                    Style="{StaticResource OHsExportDestinationOptionStyle}" Value="{x:Static d:OHsExportDestination.Project}" />
                <c:SegmentedToggleOption x:Name="BeatmapDestinationInput" Content="Beatmap" AutomationProperties.Name="Beatmap"
                    Style="{StaticResource OHsExportDestinationOptionStyle}" Value="{x:Static d:OHsExportDestination.Beatmap}" />
            </c:SegmentedToggleGroup>
            <CheckBox x:Name="OverwriteEverythingInput" Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Left"
                AutomationProperties.Name="Overwrite everything" Content="Overwrite everything"
                Style="{StaticResource OHsExportShowFilesStyle}" IsEnabled="{Binding CanOverwriteEverything, Mode=OneWay}"
                IsChecked="{Binding OverwriteEverything, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox x:Name="ShowFilesAfterExportInput" Grid.Row="6" Margin="0,16,0,0" HorizontalAlignment="Left"
                AutomationProperties.Name="Show files after export" Content="Show files after export"
                Style="{StaticResource OHsExportShowFilesStyle}" IsEnabled="{Binding CanEditOptions, Mode=OneWay}"
                IsChecked="{Binding ShowFilesAfterExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ProgressBar x:Name="ExportProgressBar" Grid.Row="7" Margin="0,16,0,0" Minimum="0" Maximum="100"
                AutomationProperties.Name="Export progress" AutomationProperties.HelpText="{Binding ProgressPhase, Mode=OneWay}"
                Style="{StaticResource OHsExportProgressStyle}" Value="{Binding ExportProgress, Mode=OneWay}" ToolTip="{Binding ProgressPhase, Mode=OneWay}" />
            <StackPanel Grid.Row="8" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <c:BalloonButton x:Name="CancelButton" Margin="0,0,8,0" AutomationProperties.Name="Cancel" ButtonText="Cancel" ButtonIcon="{StaticResource Ban}"
                    ShouldShowText="True" Style="{StaticResource OHsBalloonDestructiveActionStyle}" Command="{Binding CancelCommand, Mode=OneWay}"
                    h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" />
                <c:BalloonButton x:Name="ExportButton" AutomationProperties.Name="Export" ButtonText="Export" ButtonIcon="{StaticResource Export}"
                    ToolTip="{Binding ExportToolTip, Mode=OneWay}" AutomationProperties.HelpText="{Binding ExportToolTip, Mode=OneWay}" ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                    ShouldShowText="True" Style="{StaticResource OHsBalloonConfirmActionStyle}" Command="{Binding ExportCommand, Mode=OneWay}"
                    h:KeyboardNavigationPolicy.AllowTabNavigation="True" IsTabStop="True" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</c:BasePopup>
