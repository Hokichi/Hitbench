<UserControl x:Class="osuHitsounder.Views.Popups.OHsInstrumentalArrangementDrawer" x:Name="Drawer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers">
 <Border Style="{StaticResource OHsPopupSurfaceBorderStyle}" Padding="16">
 <Grid Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Style="{StaticResource BaseGridStyle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding PopupTitle,Mode=OneWay}" Style="{StaticResource OHsPopupTitleTextStyle}" VerticalAlignment="Center"/>
   <c:BalloonButton Grid.Column="1" ButtonText="Close" ButtonIcon="{StaticResource Close}" Style="{StaticResource OHsBalloonDestructiveActionStyle}"
    Click="OnCloseClick" AutomationProperties.Name="Close arrangement" ToolTip="Close (Esc)" ShouldShowText="True" IsTabStop="True"
    h:KeyboardNavigationPolicy.AllowTabNavigation="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" ToolTipService.ShowsToolTipOnKeyboardFocus="True"/>
  </Grid>
  <c:SegmentedToggleGroup Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit,Mode=OneWay}"
   SelectedValue="{Binding IsAdditionMode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Piano editing mode">
   <c:SegmentedToggleOption Content="Select" AutomationProperties.Name="Select notes" ToolTip="Select and move notes (1)"><c:SegmentedToggleOption.Value><sys:Boolean>False</sys:Boolean></c:SegmentedToggleOption.Value></c:SegmentedToggleOption>
   <c:SegmentedToggleOption Content="Draw" AutomationProperties.Name="Draw notes" ToolTip="Place notes (2)"><c:SegmentedToggleOption.Value><sys:Boolean>True</sys:Boolean></c:SegmentedToggleOption.Value></c:SegmentedToggleOption>
  </c:SegmentedToggleGroup>
  <Grid Grid.Row="2" Style="{StaticResource BaseGridStyle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <c:PianoRollView x:Name="PianoRoll" Style="{StaticResource BasePianoRollViewStyle}" Notes="{Binding Notes,Mode=OneWay}"
    SelectedNoteId="{Binding SelectedNoteId,Mode=OneWay}" SelectedNoteIds="{Binding SelectedNoteIds,Mode=OneWay}" IsAdditionMode="{Binding IsAdditionMode,Mode=OneWay}" LaneHeight="{Binding LaneHeight,Mode=OneWay}" NoteSelectionRequested="OnNoteSelection" Offsets="{Binding Offsets,Mode=OneWay}" Bpms="{Binding Bpms,Mode=OneWay}"
    Subdivision="{Binding Subdivision,Mode=OneWay}" Duration="{Binding Duration,Mode=OneWay}" Position="{Binding Position,Mode=OneWay}" ZoomFactor="{Binding ZoomFactor,Mode=OneWay}"
    ContentWidth="{Binding TimelineContentWidth,ElementName=Drawer,Mode=OneWay}" ViewportWidth="{Binding TimelineViewportWidth,ElementName=Drawer,Mode=OneWay}"
    HorizontalOffset="{Binding TimelineHorizontalOffset,ElementName=Drawer,Mode=OneWay}"
    CanEdit="{Binding CanEdit,Mode=OneWay}" IsEnabled="{Binding CanEdit,Mode=OneWay}" NoteEditRequested="OnNoteEdit"
    AutomationProperties.Name="Instrumental piano roll" AutomationProperties.HelpText="Arrows navigate keys and beats. Enter places or selects a note. Delete removes the selected note. Alt+arrows move notes. Right click removes a note. Escape cancels drag, clears selection, then closes. Space plays or pauses; Shift+Space stops." Background="{DynamicResource Brush.Background.Deepened}" Foreground="{DynamicResource Brush.Text.Primary}" MarkerBrush="{DynamicResource Brush.Navy.Muted}" SelectionBrush="{DynamicResource Brush.Navy}" SelectionCueBrush="{DynamicResource Brush.Text.Primary}" PressedBrush="{DynamicResource Brush.Navy}" HoverBrush="{DynamicResource Brush.Background.Hover}" NodeBorderBrush="{DynamicResource Brush.Border.Default}" PlaybackMarkerBrush="{DynamicResource Brush.Text.Primary}"/>
   <ScrollBar x:Name="PitchScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{Binding MaximumVerticalOffset,ElementName=PianoRoll,Mode=OneWay}" ViewportSize="{Binding ActualHeight,ElementName=PianoRoll,Mode=OneWay}"
    Value="{Binding VerticalOffset,ElementName=PianoRoll,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SmallChange="36" LargeChange="180" AutomationProperties.Name="Piano pitch position"/>
  </Grid>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OHsStatusScrollStyle}" AutomationProperties.Name="Arrangement status messages">
  <StackPanel Style="{StaticResource BaseStackPanelStyle}">
   <TextBlock Text="{Binding EditingHint,Mode=OneWay}" Style="{StaticResource BodyTextStyle}"/>
   <TextBlock Text="C1–B9 · Addition places; Selection selects and drags. Ctrl+A selects all; Ctrl+C/V copies/pastes; Ctrl+Z/Y undoes/redoes. Alt+arrows move selected notes; Delete removes. Shift+wheel scrolls time; Ctrl+wheel zooms; Alt+wheel changes snap; Ctrl+Shift+wheel changes pitch height." Style="{StaticResource BodyTextStyle}"/>
   <TextBlock Text="{Binding MappingStatus,Mode=OneWay}" Style="{StaticResource WarningTextStyle}"/>
   <TextBlock Text="{Binding PlaybackWarning,Mode=OneWay}" Style="{StaticResource WarningTextStyle}"/>

   <TextBlock Text="{Binding SaveError,Mode=OneWay}" Style="{StaticResource ErrorTextStyle}"/>
   <TextBlock Text="{Binding ErrorMessage,Mode=OneWay}" Style="{StaticResource ErrorTextStyle}"/>
  </StackPanel>
  </ScrollViewer>
 </Grid>
 </Border>
</UserControl>
