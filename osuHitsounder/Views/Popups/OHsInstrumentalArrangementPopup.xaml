<c:BasePopup x:Class="osuHitsounder.Views.Popups.OHsInstrumentalArrangementPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers" Mode="None" Width="1120" Height="760"
 PopupTitle="{Binding PopupTitle,Mode=OneWay}" ResizeMode="CanResize" SizeToContent="Manual">
 <c:BasePopup.Resources>
  <Style x:Key="OHsArrangementAction" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Setter Property="ShouldShowText" Value="True"/><Setter Property="IsTabStop" Value="True"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
   <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
  </Style>
  <Style x:Key="OHsArrangementFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}">
   <Setter Property="FontFamily" Value="{DynamicResource Regular}"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsArrangementPlay" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsArrangementAction}">
   <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsPlaying,Mode=OneWay}" Value="True"><Setter Property="ButtonIcon" Value="{StaticResource MediaPause}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsArrangementText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsArrangementError" TargetType="TextBlock" BasedOn="{StaticResource OHsArrangementText}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
   <Style.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsArrangementWarning" TargetType="TextBlock" BasedOn="{StaticResource OHsArrangementText}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsArrangementSlider" TargetType="c:ValueSlider" BasedOn="{StaticResource OHsValueSliderStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Setter Property="Width" Value="140"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="8,0,16,8"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
  </Style>
  <Style x:Key="OHsArrangementRoll" TargetType="c:PianoRollView" BasedOn="{StaticResource BasePianoRollViewStyle}">
   <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="MarkerBrush" Value="{DynamicResource Brush.Navy.Muted}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Navy}"/>
   <Setter Property="SelectionCueBrush" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="PressedBrush" Value="{DynamicResource Brush.Navy}"/>
   <Setter Property="HoverBrush" Value="{DynamicResource Brush.Background.Hover}"/>
   <Setter Property="NodeBorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
   <Setter Property="PlaybackMarkerBrush" Value="{DynamicResource Brush.Text.Primary}"/>
  </Style>
  <Style x:Key="OHsArrangementStatusScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Setter Property="MaxHeight" Value="120"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
  </Style>
 </c:BasePopup.Resources>
 <Grid Margin="16" Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0">
   <c:BalloonButton ButtonText="{Binding PlayText,Mode=OneWay}" Command="{Binding PlayPauseCommand,Mode=OneWay}" Style="{StaticResource OHsArrangementPlay}" AutomationProperties.Name="Arrangement play or pause" ToolTip="Play/Pause (Space)"/>
   <c:BalloonButton ButtonText="Stop" ButtonIcon="{StaticResource MediaStop}" Command="{Binding StopCommand,Mode=OneWay}" Style="{StaticResource OHsArrangementAction}" AutomationProperties.Name="Stop arrangement" ToolTip="Stop (Shift+Space)"/>
   <TextBlock Text="{Binding ElapsedText,Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,16,8" Style="{StaticResource OHsArrangementText}"/>
   <TextBlock Text="Snap" VerticalAlignment="Center" Style="{StaticResource OHsArrangementFieldLabel}"/>
   <c:ValueSlider Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
    Value="{Binding SelectedSubdivisionIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayText="{Binding Subdivision,Mode=OneWay,StringFormat=1/{0}}" Style="{StaticResource OHsArrangementSlider}" AutomationProperties.Name="Arrangement beat subdivision"/>
   <TextBlock Text="Zoom" VerticalAlignment="Center" Style="{StaticResource OHsArrangementFieldLabel}"/>
   <c:ValueSlider Minimum="8" Maximum="128" Value="{Binding ZoomFactor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayText="{Binding ZoomFactor,Mode=OneWay,StringFormat={}{0:0}}" Style="{StaticResource OHsArrangementSlider}" AutomationProperties.Name="Arrangement zoom"/>
   <c:BalloonButton ButtonText="Zoom out" ButtonIcon="{StaticResource Minus}" Command="{Binding ZoomOutCommand,Mode=OneWay}" Style="{StaticResource OHsArrangementAction}" AutomationProperties.Name="Zoom out arrangement" ToolTip="Zoom out"/>
   <c:BalloonButton ButtonText="Zoom in" ButtonIcon="{StaticResource PlusSolid}" Command="{Binding ZoomInCommand,Mode=OneWay}" Style="{StaticResource OHsArrangementAction}" AutomationProperties.Name="Zoom in arrangement" ToolTip="Zoom in"/>
  </WrapPanel>
  <Grid Grid.Row="1" FlowDirection="LeftToRight" Margin="0,0,0,8" Style="{StaticResource BaseGridStyle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding KeyColumnWidth,ElementName=PianoRoll,Mode=OneWay}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{Binding ActualWidth,ElementName=PitchScroll,Mode=OneWay}"/></Grid.ColumnDefinitions>
   <TextBlock Text="Song" Style="{StaticResource OHsArrangementText}" VerticalAlignment="Center"/>
   <ScrollViewer x:Name="WaveformScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Style="{StaticResource {x:Type ScrollViewer}}"
    ScrollChanged="OnWaveformScrolled" SizeChanged="OnWaveformSizeChanged">
    <c:WaveformView x:Name="SongWaveform" Data="{Binding Waveform,Mode=OneWay}" Position="{Binding Position,Mode=OneWay}" ZoomFactor="{Binding ZoomFactor,Mode=OneWay}"
     ViewportWidth="{Binding ViewportWidth,ElementName=WaveformScroll,Mode=OneWay}" HorizontalOffset="{Binding HorizontalOffset,ElementName=WaveformScroll,Mode=OneWay}"
     Offsets="{Binding Offsets,Mode=OneWay}" Bpms="{Binding Bpms,Mode=OneWay}" Subdivision="{Binding Subdivision,Mode=OneWay}"
     ShowBeatRuler="True" FontFamily="{DynamicResource Regular}" WaveformBrush="{DynamicResource Brush.Navy.Muted}" MarkerBrush="{DynamicResource Brush.Text.Primary}" TextBrush="{DynamicResource Brush.Text.Secondary}"
     SeekCommand="{Binding SeekCommand,Mode=OneWay}" MouseLeftButtonDown="OnWaveformClick" />
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" FlowDirection="LeftToRight" Style="{StaticResource BaseGridStyle}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <c:PianoRollView x:Name="PianoRoll" Style="{StaticResource OHsArrangementRoll}" Notes="{Binding Notes,Mode=OneWay}"
    SelectedNoteId="{Binding SelectedNoteId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Offsets="{Binding Offsets,Mode=OneWay}" Bpms="{Binding Bpms,Mode=OneWay}"
    Subdivision="{Binding Subdivision,Mode=OneWay}" Duration="{Binding Waveform.Duration,Mode=OneWay}" Position="{Binding Position,Mode=OneWay}" ZoomFactor="{Binding ZoomFactor,Mode=OneWay}"
    ContentWidth="{Binding ActualWidth,ElementName=SongWaveform,Mode=OneWay}" ViewportWidth="{Binding ViewportWidth,ElementName=WaveformScroll,Mode=OneWay}"
    HorizontalOffset="{Binding Value,ElementName=TimelineScroll,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
    CanEdit="{Binding CanEdit,Mode=OneWay}" IsEnabled="{Binding CanEdit,Mode=OneWay}" NoteEditRequested="OnNoteEdit"
    AutomationProperties.Name="Instrumental piano roll" AutomationProperties.HelpText="Arrows navigate keys and beats. Enter places or selects a note. Delete removes the selected note. Alt+arrows move notes. Right click removes a note. Escape cancels drag, clears selection, then closes. Space plays or pauses; Shift+Space stops."/>
   <ScrollBar x:Name="PitchScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{Binding MaximumVerticalOffset,ElementName=PianoRoll,Mode=OneWay}" ViewportSize="{Binding ActualHeight,ElementName=PianoRoll,Mode=OneWay}"
    Value="{Binding VerticalOffset,ElementName=PianoRoll,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SmallChange="36" LargeChange="180" AutomationProperties.Name="Piano pitch position"/>
  </Grid>
  <ScrollBar x:Name="TimelineScroll" Grid.Row="3" Margin="0,8,0,8" Orientation="Horizontal" Minimum="0" Maximum="{Binding ScrollableWidth,ElementName=WaveformScroll,Mode=OneWay}"
   ViewportSize="{Binding ViewportWidth,ElementName=WaveformScroll,Mode=OneWay}" ValueChanged="OnHorizontalChanged" AutomationProperties.Name="Arrangement timeline position"/>
  <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OHsArrangementStatusScroll}" AutomationProperties.Name="Arrangement status messages">
  <StackPanel Style="{StaticResource BaseStackPanelStyle}">
   <TextBlock Text="{Binding EditingHint,Mode=OneWay}" Style="{StaticResource OHsArrangementText}"/>
   <TextBlock Text="C1–B9 · Enter places; Alt+arrows move; Delete removes. Ctrl+Left/Right seeks; Ctrl+Home/End goes to song start/end." Style="{StaticResource OHsArrangementText}"/>
   <TextBlock Text="{Binding MappingStatus,Mode=OneWay}" Style="{StaticResource OHsArrangementWarning}"/>
   <TextBlock Text="{Binding PlaybackWarning,Mode=OneWay}" Style="{StaticResource OHsArrangementWarning}"/>
   <TextBlock Text="{Binding SaveStatus,Mode=OneWay}" Style="{StaticResource OHsArrangementText}"/>
   <TextBlock Text="{Binding SaveError,Mode=OneWay}" Style="{StaticResource OHsArrangementError}"/>
   <TextBlock Text="{Binding ErrorMessage,Mode=OneWay}" Style="{StaticResource OHsArrangementError}"/>
  </StackPanel>
  </ScrollViewer>
 </Grid>
</c:BasePopup>
