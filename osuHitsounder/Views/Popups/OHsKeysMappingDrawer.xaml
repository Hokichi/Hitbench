<UserControl
    x:Class="osuHitsounder.Views.Popups.OHsKeysMappingDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
    xmlns:popups="clr-namespace:osuHitsounder.Views.Popups">
    <UserControl.Resources>

        <Style
            x:Key="OHsKeysInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <ItemsPanelTemplate x:Key="OHsKeysKeyboardItemsPanel">
            <popups:OHsKeysMappingPianoPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="OHsKeysKeyboardTemplate" TargetType="ListBox">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Style="{StaticResource BaseBorderStyle}">
                <ScrollViewer
                    x:Name="PianoScrollViewer"
                    ScrollChanged="OnPianoScrollChanged"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    Style="{StaticResource {x:Type ScrollViewer}}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                </ScrollViewer>
            </Border>
        </ControlTemplate>
        <Style
            x:Key="OHsKeysKeyboardStyle"
            BasedOn="{StaticResource BaseListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template" Value="{StaticResource OHsKeysKeyboardTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource OHsKeysKeyboardItemsPanel}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
        </Style>
        <ControlTemplate x:Key="OHsKeysKeyboardItemTemplate" TargetType="ListBoxItem">
            <Border
                x:Name="KeySurface"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="0,0,4,4"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <Border
                        x:Name="MappedMarker"
                        Width="4"
                        Height="4"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="2"
                        IsHitTestVisible="False"
                        Style="{StaticResource BaseBorderStyle}"
                        Visibility="Collapsed" />
                    <c:Icon
                        x:Name="SelectedMarker"
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Path="{StaticResource Check}"
                        Visibility="Collapsed"
                        Color="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMapped, Mode=OneWay}" Value="True">
                    <Setter TargetName="MappedMarker" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsKeysKeyboardItemStyle"
            BasedOn="{StaticResource BaseListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Template" Value="{StaticResource OHsKeysKeyboardItemTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,20,4,8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Key, Mode=OneWay}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding MappingStatus, Mode=OneWay}" />
            <Setter Property="ToolTip" Value="{Binding MappingStatus, Mode=OneWay}" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSharp, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Deepened}" />
                    <Setter Property="Padding" Value="0,20,0,8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMapped, Mode=OneWay}" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseCaptureWithin" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OHsKeysKeyboardContentTemplate">
            <TextBlock
                Style="{StaticResource BodyTextStyle}"
                Text="{Binding Key, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Padding="16" Style="{StaticResource OHsPopupSurfaceBorderStyle}">
        <Grid Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer
            AutomationProperties.Name="Key mapping controls"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource {x:Type ScrollViewer}}"
            VerticalScrollBarVisibility="Auto">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <c:BalloonButton
                        x:Name="LoadAction"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.HelpText="Choose a folder of note-named audio files. Conflicts can be reviewed before importing."
                        AutomationProperties.Name="Import key mappings from folder"
                        ButtonIcon="{StaticResource PlusSolid}"
                        ButtonText="Load Samples Folder"
                        Command="{Binding OpenFolderCommand, Mode=OneWay}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsTabStop="True"
                        ShouldShowText="True"
                        Style="{StaticResource OHsBalloonNeutralActionStyle}"
                        ToolTip="Import key mappings from folder"
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                    <c:BalloonButton
                        x:Name="ClearAllMappingsAction"
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="Clear all key mappings"
                        ButtonIcon="{StaticResource Delete}"
                        ButtonText="Clear All Mappings"
                        Command="{Binding ClearAllMappingsCommand, Mode=OneWay}"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsTabStop="True"
                        ShouldShowText="True"
                        Style="{StaticResource OHsBalloonDestructiveActionStyle}" />
                    <c:BalloonButton
                        h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                        AutomationProperties.Name="Close Keys Mapping"
                        ButtonIcon="{StaticResource Close}"
                        ButtonText="Close"
                        Click="OnCloseClick"
                        FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                        IsEnabled="{Binding CanClose, Mode=OneWay}"
                        IsTabStop="True"
                        ShouldShowText="True"
                        Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                        ToolTip="Close (Esc)"
                        ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
                </WrapPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,12"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <TextBlock Style="{StaticResource OHsPopupTitleTextStyle}" Text="Keys Mapping" />
                    <TextBlock
                        Style="{StaticResource BodyTextStyle}"
                        Text="{Binding TrackName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="2" Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox
                        x:Name="KeySelector"
                        AutomationProperties.Name="Piano key mapping selector"
                        IsEnabled="{Binding CanEditMapping, Mode=OneWay}"
                        IsSynchronizedWithCurrentItem="False"
                        ItemContainerStyle="{StaticResource OHsKeysKeyboardItemStyle}"
                        ItemTemplate="{StaticResource OHsKeysKeyboardContentTemplate}"
                        ItemsSource="{Binding Rows, Mode=OneWay}"
                        SelectedValue="{Binding SelectedEntry.Key, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Key"
                        SelectionChanged="OnKeySelectionChanged"
                        Style="{StaticResource OHsKeysKeyboardStyle}" />
                    <Grid
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Bold}"
                            FontSize="24"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding SelectedEntry.Key, Mode=OneWay}" />
                        <StackPanel
                            Grid.Column="1"
                            DataContext="{Binding SelectedEntry, Mode=OneWay}"
                            Style="{StaticResource BaseStackPanelStyle}">
                            <TextBox
                                AutomationProperties.Name="Selected key sample path"
                                IsEnabled="{Binding DataContext.CanEditSelectedMapping, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                LostKeyboardFocus="OnMappingLostFocus"
                                PreviewKeyDown="OnMappingKeyDown"
                                Style="{StaticResource OHsKeysInputStyle}"
                                Text="{Binding DraftFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" MaxWidth="160">
                            <c:BalloonButton
                                Margin="8,0,0,0"
                                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                                AutomationProperties.Name="Audition selected key sample"
                                ButtonIcon="{StaticResource MediaPlay}"
                                ButtonText="Play"
                                Command="{Binding PlaySelectedCommand, Mode=OneWay}"
                                FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                                IsTabStop="True"
                                ShouldShowText="false"
                                Style="{StaticResource OHsBalloonNeutralActionStyle}" />
                            <c:BalloonButton
                                x:Name="DeleteSelectedMappingAction"
                                Margin="8,0,0,0"
                                h:KeyboardNavigationPolicy.AllowTabNavigation="True"
                                AutomationProperties.Name="Unmap selected key"
                                ButtonIcon="{StaticResource Delete}"
                                ButtonText="Delete"
                                Command="{Binding DeleteSelectedCommand, Mode=OneWay}"
                                FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"
                                IsTabStop="True"
                                ShouldShowText="false"
                                Style="{StaticResource OHsBalloonDestructiveActionStyle}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
        <ScrollBar x:Name="PianoScrollBar" Grid.Row="1" Orientation="Horizontal"
            IsEnabled="{Binding CanEditMapping, Mode=OneWay}" AutomationProperties.Name="Piano key position" Scroll="OnPianoScroll"/>
        </Grid>
    </Border>
</UserControl>
