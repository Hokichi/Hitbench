<UserControl x:Class="osuHitsounder.Views.Popups.OHsKeysMappingDrawer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers">
 <UserControl.Resources>

  <Style x:Key="OHsKeysInputStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextInputStyle}">
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
   <Style.Triggers><DataTrigger Binding="{Binding HasError,Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="OHsKeysWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/><Setter Property="FontSize" Value="11"/>
  </Style>

  <DataTemplate x:Key="OHsKeysRowTemplate">
   <Grid Margin="0,8,8,0" Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Key,Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
    <StackPanel Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource BaseStackPanelStyle}">
     <TextBox Text="{Binding DraftFileName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OHsKeysInputStyle}"
      AutomationProperties.Name="{Binding Key,Mode=OneWay,StringFormat=Sample file for {0}}" LostKeyboardFocus="OnMappingLostFocus" PreviewKeyDown="OnMappingKeyDown"/>
     <TextBlock Text="{Binding Error,Mode=OneWay}" Style="{StaticResource ErrorTextStyle}"/>
     <TextBlock Text="{Binding AvailabilityText,Mode=OneWay}" Style="{StaticResource OHsKeysWarningStyle}"/>
    </StackPanel>
    <c:BalloonButton Grid.Column="2" VerticalAlignment="Top" ButtonText="Open" ButtonIcon="{StaticResource PlusSolid}" Style="{StaticResource OHsBalloonNeutralActionStyle}"
     AutomationProperties.Name="{Binding Key,Mode=OneWay,StringFormat=Open sample for {0}}" ToolTip="Choose a sample for this key"
     Command="{Binding DataContext.OpenKeyCommand,RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}" CommandParameter="{Binding Key,Mode=OneWay}" h:KeyboardNavigationPolicy.AllowTabNavigation="True" ShouldShowText="True" IsTabStop="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" ToolTipService.ShowsToolTipOnKeyboardFocus="True"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Border Style="{StaticResource OHsPopupSurfaceBorderStyle}" Padding="16">
  <Grid Style="{StaticResource BaseGridStyle}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Style="{StaticResource BaseGridStyle}">
    <c:BalloonButton HorizontalAlignment="Left" ButtonText="Open" ButtonIcon="{StaticResource PlusSolid}" Style="{StaticResource OHsBalloonNeutralActionStyle}" Command="{Binding OpenFolderCommand,Mode=OneWay}"
     AutomationProperties.Name="Import key mappings from folder" AutomationProperties.HelpText="Choose a folder of note-named audio files. Conflicts can be reviewed before importing." ToolTip="Import key mappings from folder" h:KeyboardNavigationPolicy.AllowTabNavigation="True" ShouldShowText="True" IsTabStop="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" ToolTipService.ShowsToolTipOnKeyboardFocus="True"/>
    <c:BalloonButton HorizontalAlignment="Right" ButtonText="Close" ButtonIcon="{StaticResource Close}" Style="{StaticResource OHsBalloonDestructiveActionStyle}"
     AutomationProperties.Name="Close Keys Mapping" ToolTip="Close (Esc)" Click="OnCloseClick" IsEnabled="{Binding CanClose,Mode=OneWay}" h:KeyboardNavigationPolicy.AllowTabNavigation="True" ShouldShowText="True" IsTabStop="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" ToolTipService.ShowsToolTipOnKeyboardFocus="True"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,16,0,12" Style="{StaticResource BaseStackPanelStyle}">
    <TextBlock Text="Keys Mapping" Style="{StaticResource OHsPopupTitleTextStyle}"/>
    <TextBlock Text="{Binding TrackName,Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="C1–B9 · Paths relative to Samples · PageUp/PageDown scroll keys; Alt+Home/End go to first/last key." Style="{StaticResource BodyTextStyle}"/>
   </StackPanel>
   <ItemsControl x:Name="KeyRows" Grid.Row="2" IsEnabled="{Binding CanEditMapping,Mode=OneWay}" ItemsSource="{Binding Rows,Mode=OneWay}" ItemTemplate="{StaticResource OHsKeysRowTemplate}" Style="{StaticResource OHsVirtualizedDrawerItemsStyle}"/>
   <ScrollViewer Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource OHsStatusScrollStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Mapping import and save status">
   <StackPanel Style="{StaticResource BaseStackPanelStyle}">
    <TextBlock Text="{Binding SaveStatus,Mode=OneWay}" Style="{StaticResource BodyTextStyle}"/>
    <TextBlock Text="{Binding ImportStatus,Mode=OneWay}" Style="{StaticResource BodyTextStyle}" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding SaveError,Mode=OneWay}" Style="{StaticResource ErrorTextStyle}"/>
    <TextBlock Text="{Binding ErrorMessage,Mode=OneWay}" Style="{StaticResource ErrorTextStyle}"/>
   </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
