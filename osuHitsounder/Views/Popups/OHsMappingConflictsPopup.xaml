<c:BasePopup x:Class="osuHitsounder.Views.Popups.OHsMappingConflictsPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
 Mode="None" PopupTitle="Mapping conflicts found" SizeToContent="Manual" ShowInTaskbar="False" ShowCloseButton="False">
 <c:BasePopup.Resources>
  <Style x:Key="OHsMappingConflictTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="OHsMappingConflictLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsMappingConflictTextStyle}">
   <Setter Property="FontFamily" Value="{DynamicResource Bold}"/>
  </Style>
  <Style x:Key="OHsMappingConflictPathStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsMappingConflictTextStyle}">
   <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
  </Style>
  <Style x:Key="OHsMappingConflictStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource OHsMappingConflictTextStyle}">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="OHsMappingConflictChoiceTemplate" TargetType="CheckBox">
   <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Style="{StaticResource BaseBorderStyle}">
    <Grid Style="{StaticResource BaseGridStyle}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <c:Icon Path="{StaticResource CheckboxBlankOutline}" Color="{TemplateBinding Foreground}" Width="16" Height="16" VerticalAlignment="Center"/>
     <c:Icon x:Name="ChoiceMark" Path="{StaticResource Check}" Color="{TemplateBinding Foreground}" Width="12" Height="12" VerticalAlignment="Center" Visibility="Collapsed"/>
     <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceMark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <DataTemplate x:Key="OHsMappingConflictChoiceContent">
   <StackPanel Style="{StaticResource BaseStackPanelStyle}">
    <TextBlock Text="{Binding FileName,Mode=OneWay}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=CheckBox},Mode=OneWay}" Style="{StaticResource OHsMappingConflictLabelStyle}"/>
    <TextBlock Text="{Binding FilePath,Mode=OneWay}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=CheckBox},Mode=OneWay}" Style="{StaticResource OHsMappingConflictPathStyle}"/>
    <TextBlock Text="{Binding AvailabilityText,Mode=OneWay}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=CheckBox},Mode=OneWay}" Style="{StaticResource OHsMappingConflictStatusStyle}"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="OHsMappingConflictChoiceStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
   <Setter Property="Template" Value="{StaticResource OHsMappingConflictChoiceTemplate}"/>
   <Setter Property="ContentTemplate" Value="{StaticResource OHsMappingConflictChoiceContent}"/>
   <Setter Property="Content" Value="{Binding Mode=OneWay}"/>
   <Setter Property="IsChecked" Value="{Binding IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName,Mode=OneWay}"/>
   <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="8"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/><Setter Property="IsTabStop" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/></Trigger>
    <DataTrigger Binding="{Binding IsMissing,Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </DataTrigger>
    <MultiDataTrigger>
     <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource Self},Mode=OneWay}" Value="True"/><Condition Binding="{Binding Path=(SystemParameters.HighContrast),Mode=OneWay}" Value="True"/></MultiDataTrigger.Conditions>
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
    </MultiDataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="OHsMappingConflictChoiceItem"><CheckBox Style="{StaticResource OHsMappingConflictChoiceStyle}"/></DataTemplate>
  <DataTemplate x:Key="OHsMappingConflictRowTemplate">
   <Grid Margin="0,0,0,16" Style="{StaticResource BaseGridStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Key,Mode=OneWay}" Style="{StaticResource OHsMappingConflictLabelStyle}" VerticalAlignment="Top" Margin="0,8,8,0"/>
    <StackPanel Grid.Column="1" Style="{StaticResource BaseStackPanelStyle}">
     <TextBlock Text="Existing" Style="{StaticResource OHsMappingConflictLabelStyle}"/>
     <TextBlock Text="{Binding ExistingStatus,Mode=OneWay}" Style="{StaticResource OHsMappingConflictStatusStyle}"/>
     <ItemsControl ItemsSource="{Binding ExistingChoices,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictChoiceItem}" Style="{StaticResource BaseItemsControlStyle}"/>
    </StackPanel>
    <StackPanel Grid.Column="3" Style="{StaticResource BaseStackPanelStyle}">
     <TextBlock Text="Incoming" Style="{StaticResource OHsMappingConflictLabelStyle}"/>
     <ItemsControl ItemsSource="{Binding IncomingChoices,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictChoiceItem}" Style="{StaticResource BaseItemsControlStyle}"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="OHsMappingConflictPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
  <ControlTemplate x:Key="OHsMappingConflictItemsTemplate" TargetType="ItemsControl">
   <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource {x:Type ScrollViewer}}"><ItemsPresenter/></ScrollViewer>
  </ControlTemplate>
  <Style x:Key="OHsMappingConflictItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource BaseItemsControlStyle}">
   <Setter Property="Template" Value="{StaticResource OHsMappingConflictItemsTemplate}"/><Setter Property="ItemsPanel" Value="{StaticResource OHsMappingConflictPanel}"/>
   <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style x:Key="OHsMappingConflictConfirmStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonConfirmActionStyle}">
   <Setter Property="ButtonIcon" Value="{StaticResource Check}"/><Setter Property="ShouldShowText" Value="True"/>
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/><Setter Property="IsTabStop" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
  </Style>
  <Style x:Key="OHsMappingConflictCancelStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonDestructiveActionStyle}">
   <Setter Property="ButtonIcon" Value="{StaticResource Close}"/><Setter Property="ShouldShowText" Value="True"/>
   <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True"/><Setter Property="IsTabStop" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
  </Style>
 </c:BasePopup.Resources>
 <Grid Margin="24,0,24,8" Style="{StaticResource BaseGridStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Choose one file for each key." Style="{StaticResource OHsMappingConflictTextStyle}" Margin="0,0,0,16"/>
  <ItemsControl x:Name="ConflictRows" Grid.Row="1" ItemsSource="{Binding Rows,Mode=OneWay}" ItemTemplate="{StaticResource OHsMappingConflictRowTemplate}" Style="{StaticResource OHsMappingConflictItemsStyle}"/>
  <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Style="{StaticResource BaseStackPanelStyle}">
   <c:BalloonButton ButtonText="Cancel" AutomationProperties.Name="Cancel folder import" ToolTip="Cancel folder import (Esc)" Click="OnCancel" Style="{StaticResource OHsMappingConflictCancelStyle}" Margin="0,0,8,0"/>
   <c:BalloonButton x:Name="ConfirmButton" ButtonText="OK" AutomationProperties.Name="Accept mapping choices" ToolTip="Accept mapping choices (Enter)" Click="OnConfirm" IsEnabled="{Binding CanConfirm,Mode=OneWay}" Style="{StaticResource OHsMappingConflictConfirmStyle}"/>
  </StackPanel>
 </Grid>
</c:BasePopup>
