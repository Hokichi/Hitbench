<customControls:BasePopup
    x:Class="osuHitsounder.Views.Popups.ProjectNamePopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    Width="420"
    MinWidth="420"
    MaxWidth="420"
    PopupTitle="Create project"
    ShowCloseButton="False"
    ShowInTaskbar="False">
    <customControls:BasePopup.Resources>

        <Style
            x:Key="ProjectNamePopupInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValidationError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding CanCreate, Mode=OneWay}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ProjectNamePopupWatermarkStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectName}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ProjectNamePopupValidationStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValidationError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </customControls:BasePopup.Resources>

    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Project name" />
        <Grid Grid.Row="1">
            <TextBox
                x:Name="ProjectNameTextBox"
                AutomationProperties.Name="Project name"
                PreviewTextInput="OnPreviewTextInput"
                Style="{StaticResource ProjectNamePopupInputStyle}"
                Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                x:Name="ProjectNameWatermark"
                IsHitTestVisible="False"
                Style="{StaticResource ProjectNamePopupWatermarkStyle}"
                Text="{Binding SuggestedName, Mode=OneWay}" />
        </Grid>
        <TextBlock
            x:Name="ProjectNameValidation"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource ProjectNamePopupValidationStyle}"
            Text="{Binding ValidationError, Mode=OneWay}" />
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <customControls:BalloonButton
                x:Name="CancelButton"
                AutomationProperties.Name="Cancel"
                ButtonIcon="{StaticResource Ban}"
                ButtonText="Cancel"
                Click="OnCancelClick"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonDestructiveActionStyle}"  Margin="0,0,8,0"/>
            <customControls:BalloonButton
                x:Name="CreateButton"
                AutomationProperties.Name="Create"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="Create"
                Click="OnCreateClick"
                IsEnabled="{Binding CanCreate, Mode=OneWay}"
                ShouldShowText="True"
                Style="{StaticResource OHsBalloonConfirmActionStyle}" />
        </StackPanel>
    </Grid>
</customControls:BasePopup>
