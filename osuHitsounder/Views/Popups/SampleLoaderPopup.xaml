<c:BasePopup
    x:Class="osuHitsounder.Views.Popups.SampleLoaderPopup"
    x:Name="PopupRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
    Width="960"
    Height="640"
    PopupTitle="{Binding PopupTitle, Mode=OneWay}"
    SizeToContent="Manual">
    <c:BasePopup.Resources>
        <Style
            x:Key="SampleLoaderSelectedFileDetailsStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding SelectedFile, Mode=OneWay}"
                    Value="{x:Null}">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate
            x:Key="SampleLoaderCheckTemplate"
            TargetType="CheckBox">
            <Grid
                Background="{TemplateBinding Background}"
                Style="{StaticResource BaseGridStyle}">
                <c:Icon
                    Width="16"
                    Height="16"
                    Path="{StaticResource CheckboxBlankOutline}"
                    Color="{TemplateBinding Foreground}" />
                <c:Icon
                    x:Name="CheckedIcon"
                    Width="12"
                    Height="12"
                    Path="{StaticResource Check}"
                    Visibility="Collapsed"
                    Color="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger
                    Property="IsChecked"
                    Value="True">
                    <Setter
                        TargetName="CheckedIcon"
                        Property="Visibility"
                        Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderCheckStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="Template"
                Value="{StaticResource SampleLoaderCheckTemplate}" />
            <Setter
                Property="Width"
                Value="40" />
            <Setter
                Property="Height"
                Value="40" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
            <Setter
                Property="FocusVisualStyle"
                Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Value="True" />
                        <Condition
                            Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <DataTrigger
                    Binding="{Binding IsDirectory, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderBreadcrumbButtonStyle"
            BasedOn="{StaticResource OHsBalloonNavInfoActionStyle}"
            TargetType="c:BalloonButton">
            <Setter
                Property="ShouldShowText"
                Value="True" />
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="ButtonIcon"
                Value="{StaticResource AngleRight}" />
            <Setter
                Property="FocusVisualStyle"
                Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter
                Property="FontFamily"
                Value="{DynamicResource Regular}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsCurrent, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="FontFamily"
                        Value="{DynamicResource Bold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate
            x:Key="SampleLoaderBreadcrumbTemplate">
            <c:BalloonButton
                AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                ButtonText="{Binding Name, Mode=OneWay}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                CommandParameter="{Binding FullPath, Mode=OneWay}"
                Style="{StaticResource SampleLoaderBreadcrumbButtonStyle}"
                ToolTip="{Binding FullPath, Mode=OneWay}" />
        </DataTemplate>
        <ControlTemplate
            x:Key="SampleLoaderContentItemTemplate"
            TargetType="ListBoxItem">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Style="{StaticResource BaseBorderStyle}">
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="16" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Icon
                        x:Name="ActiveFileCheck"
                        Width="10"
                        Height="10"
                        Path="{StaticResource Check}"
                        Color="{TemplateBinding Foreground}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        TargetName="ActiveFileCheck"
                        Property="Visibility"
                        Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderContentItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter
                Property="ToolTip"
                Value="{Binding FullPath, Mode=OneWay}" />
            <Setter
                Property="ToolTipService.ShowsToolTipOnKeyboardFocus"
                Value="True" />
            <Setter
                Property="Template"
                Value="{StaticResource SampleLoaderContentItemTemplate}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Primary}" />
            <Setter
                Property="FontFamily"
                Value="{DynamicResource Regular}" />
            <Setter
                Property="FocusVisualStyle"
                Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter
                Property="AutomationProperties.Name"
                Value="{Binding Name, Mode=OneWay}" />
            <Setter
                Property="IsSelected"
                Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <EventSetter
                Event="PreviewMouseLeftButtonDown"
                Handler="OnEntryRowMouseDown" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter
                        Property="BorderBrush"
                        Value="{DynamicResource Brush.Navy.Text}" />
                </Trigger>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        Property="FontFamily"
                        Value="{DynamicResource Bold}" />
                </Trigger>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                            Value="True" />
                        <Condition
                            Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter
                        Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderRowMetadataStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BodyTextStyle}">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource FontSize.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="NoWrap" />
            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />
            <Setter
                Property="TextAlignment"
                Value="Right" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="Margin"
                Value="4,0,8,0" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderFileColumnsStyle"
            TargetType="Grid"
            BasedOn="{StaticResource BaseGridStyle}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding DataContext.IsFolderSelection, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBadgeStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BodyTextStyle}">
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Setter
                Property="FontSize"
                Value="{StaticResource FontSize.Caption}" />
            <Setter
                Property="Margin"
                Value="0,2,8,0" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderPreviewBadgeStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource OHsSampleLoaderBadgeStyle}">
            <Setter
                Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsPreviewing, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderImportedBadgeStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource OHsSampleLoaderBadgeStyle}">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Warning}" />
            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Warning.Dark}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsAlreadyInProject, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate
            x:Key="SampleLoaderEntryTemplate">
            <Grid
                MinHeight="40"
                Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                    Click="OnFileCheckClick"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SampleLoaderCheckStyle}" />
                <Grid
                    Grid.Column="1"
                    Margin="0,4"
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="{Binding Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding FullPath, Mode=OneWay}" />
                    <WrapPanel
                        Grid.Row="1">
                        <c:Icon
                            Width="10"
                            Height="10"
                            Margin="0,0,4,0"
                            Path="{StaticResource MediaPlay}"
                            Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                            Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            Text="Previewing"
                            Style="{StaticResource OHsSampleLoaderPreviewBadgeStyle}" />
                        <TextBlock
                            Text="Already in project"
                            Style="{StaticResource OHsSampleLoaderImportedBadgeStyle}" />
                    </WrapPanel>
                </Grid>
                <Grid
                    Grid.Column="2"
                    Style="{StaticResource OHsSampleLoaderFileColumnsStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="80" />
                        <ColumnDefinition
                            Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource OHsSampleLoaderRowMetadataStyle}"
                        Text="{Binding DurationText, Mode=OneWay}"
                        ToolTip="{Binding DurationText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource OHsSampleLoaderRowMetadataStyle}"
                        Text="{Binding SizeText, Mode=OneWay}"
                        ToolTip="{Binding SizeText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <Style
            x:Key="OHsSampleLoaderSecondaryActionStyle"
            TargetType="c:BalloonButton"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="ToolTipService.ShowsToolTipOnKeyboardFocus"
                Value="True" />
        </Style>
        <Style
            x:Key="SampleLoaderPreviewStyle"
            BasedOn="{StaticResource OHsSampleLoaderSecondaryActionStyle}"
            TargetType="c:BalloonButton">
            <Setter
                Property="ButtonIcon"
                Value="{StaticResource MediaPlay}" />
        </Style>
        <ControlTemplate
            x:Key="SampleLoaderAutoPlayTemplate"
            TargetType="CheckBox">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Style="{StaticResource BaseBorderStyle}">
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Style="{StaticResource BaseGridStyle}">
                        <c:Icon
                            Path="{StaticResource CheckboxBlankOutline}"
                            Color="{TemplateBinding Foreground}" />
                        <c:Icon
                            x:Name="CheckMark"
                            Width="12"
                            Height="12"
                            Path="{StaticResource Check}"
                            Visibility="Collapsed"
                            Color="{TemplateBinding Foreground}" />
                    </Grid>
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger
                    Property="IsChecked"
                    Value="True">
                    <Setter
                        TargetName="CheckMark"
                        Property="Visibility"
                        Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderAutoPlayStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter
                Property="Template"
                Value="{StaticResource SampleLoaderAutoPlayTemplate}" />
            <Setter
                Property="MinHeight"
                Value="40" />
            <Setter
                Property="Padding"
                Value="8,0" />
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Primary}" />
            <Setter
                Property="FontFamily"
                Value="{DynamicResource Regular}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource FontSize.Body}" />
            <Setter
                Property="FocusVisualStyle"
                Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsFolderSelection, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Value="True" />
                        <Condition
                            Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <CollectionViewSource
            x:Key="OHsSampleLoaderLocationsView"
            Source="{Binding Locations, Mode=OneWay}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription
                    PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <DataTemplate
            x:Key="OHsSampleLoaderLocationGroupHeaderTemplate">
            <TextBlock
                Margin="8,12,8,4"
                Style="{StaticResource CardLabelTextStyle}"
                Text="{Binding Name, Mode=OneWay}" />
        </DataTemplate>
        <GroupStyle
            x:Key="OHsSampleLoaderLocationGroupStyle"
            HeaderTemplate="{StaticResource OHsSampleLoaderLocationGroupHeaderTemplate}" />
        <ControlTemplate
            x:Key="OHsSampleLoaderLocationContainerTemplate"
            TargetType="ListBoxItem">
            <Border
                Style="{StaticResource BaseBorderStyle}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{StaticResource Radius.Control}">
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="24" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Icon
                        x:Name="ActiveLocationCheck"
                        Width="12"
                        Height="12"
                        Path="{StaticResource Check}"
                        Color="{TemplateBinding Foreground}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        Grid.Column="1"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        TargetName="ActiveLocationCheck"
                        Property="Visibility"
                        Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsSampleLoaderLocationItemStyle"
            TargetType="ListBoxItem"
            BasedOn="{StaticResource PlainListBoxItemStyle}">
            <Setter
                Property="ToolTip"
                Value="{Binding FullPath, Mode=OneWay}" />
            <Setter
                Property="ToolTipService.ShowsToolTipOnKeyboardFocus"
                Value="True" />
            <Setter
                Property="Template"
                Value="{StaticResource OHsSampleLoaderLocationContainerTemplate}" />
            <Setter
                Property="IsEnabled"
                Value="{Binding IsAvailable, Mode=OneWay}" />
            <Setter
                Property="MinHeight"
                Value="{StaticResource Size.Control.Primary}" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
            <Setter
                Property="AutomationProperties.Name"
                Value="{Binding Name, Mode=OneWay}" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Primary}" />
            <Setter
                Property="FontFamily"
                Value="{DynamicResource Regular}" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="FocusVisualStyle"
                Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        Property="FontFamily"
                        Value="{DynamicResource Bold}" />
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Navy.Tint}" />
                </Trigger>
                <Trigger
                    Property="IsEnabled"
                    Value="False">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource Brush.Text.Disabled}" />
                </Trigger>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                            Value="True" />
                        <Condition
                            Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate
            x:Key="OHsSampleLoaderLocationTemplate">
            <TextBlock
                Margin="8,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextStyle}"
                FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                Text="{Binding Name, Mode=OneWay}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding FullPath, Mode=OneWay}" />
        </DataTemplate>
        <Style
            x:Key="OHsSampleLoaderSearchStyle"
            TargetType="TextBox"
            BasedOn="{StaticResource RoundedTextInputStyle}" />
        <Style
            x:Key="OHsSampleLoaderSidebarStyle"
            TargetType="Grid"
            BasedOn="{StaticResource BaseGridStyle}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsCompactLayout, ElementName=PopupRoot, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderCompactSelectorStyle"
            TargetType="c:BalloonComboBox"
            BasedOn="{StaticResource BaseBalloonComboBoxStyle}">
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Setter
                Property="ButtonIcon"
                Value="{StaticResource AngleDown}" />
            <Setter
                Property="ShouldShowText"
                Value="False" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsCompactLayout, ElementName=PopupRoot, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate
            x:Key="OHsSampleLoaderCompactLocationItemTemplate"
            TargetType="MenuItem">
            <Border
                Style="{StaticResource BaseBorderStyle}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{StaticResource Radius.Control}">
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="24" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Icon
                        x:Name="CheckedLocation"
                        Width="12"
                        Height="12"
                        Path="{StaticResource Check}"
                        Color="{TemplateBinding Foreground}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        Grid.Column="1"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger
                    Property="IsChecked"
                    Value="True">
                    <Setter
                        TargetName="CheckedLocation"
                        Property="Visibility"
                        Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="OHsSampleLoaderCompactLocationItemStyle"
            TargetType="MenuItem"
            BasedOn="{StaticResource OHsActionMenuItemStyle}">
            <Setter
                Property="Template"
                Value="{StaticResource OHsSampleLoaderCompactLocationItemTemplate}" />
            <Setter
                Property="IsTabStop"
                Value="False" />
            <Setter
                Property="h:KeyboardNavigationPolicy.AllowTabNavigation"
                Value="False" />
            <Setter
                Property="Header"
                Value="{Binding Name, Mode=OneWay}" />
            <Setter
                Property="IsEnabled"
                Value="{Binding IsAvailable, Mode=OneWay}" />
            <Setter
                Property="IsCheckable"
                Value="True" />
            <Setter
                Property="Command"
                Value="{Binding DataContext.NavigateLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" />
            <Setter
                Property="CommandParameter"
                Value="{Binding Mode=OneWay}" />
            <Setter
                Property="AutomationProperties.Name"
                Value="{Binding Name, Mode=OneWay}" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderSearchPlaceholderStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BodyTextStyle}">
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Setter
                Property="IsHitTestVisible"
                Value="False" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding SearchText, Mode=OneWay}"
                    Value="">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBasketItemStyle"
            TargetType="ListBoxItem"
            BasedOn="{StaticResource PlainListBoxItemStyle}">
            <Setter
                Property="ToolTip"
                Value="{Binding FullPath, Mode=OneWay}" />
            <Setter
                Property="ToolTipService.ShowsToolTipOnKeyboardFocus"
                Value="True" />
            <Setter
                Property="Template"
                Value="{StaticResource SampleLoaderContentItemTemplate}" />
            <Setter
                Property="MinHeight"
                Value="40" />
            <Setter
                Property="Margin"
                Value="0,0,0,4" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Primary}" />
            <Setter
                Property="AutomationProperties.Name"
                Value="{Binding Name, Mode=OneWay}" />
            <Setter
                Property="IsSelected"
                Value="{Binding IsSelected, Mode=OneWay}" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger
                    Property="IsSelected"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource Brush.Navy.Tint}" />
                </Trigger>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                            Value="True" />
                        <Condition
                            Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                            Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter
                        Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBasketMetadataStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BodyTextStyle}">
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter
                Property="FontSize"
                Value="{StaticResource FontSize.Caption}" />
            <Setter
                Property="TextWrapping"
                Value="NoWrap" />
            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate
            x:Key="OHsSampleLoaderBasketTemplate">
            <Grid
                Margin="4"
                Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <TextBlock
                        Style="{StaticResource BodyTextStyle}"
                        FontFamily="{DynamicResource Bold}"
                        Text="{Binding Name, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource OHsSampleLoaderBasketMetadataStyle}"
                        Text="{Binding SourceFolderName, Mode=OneWay}"
                        ToolTip="{Binding FullPath, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource OHsSampleLoaderBasketMetadataStyle}"
                        Text="{Binding DurationText, Mode=OneWay}" />
                </StackPanel>
                <c:BalloonButton
                    Grid.Column="1"
                    Style="{StaticResource OHsSampleLoaderSecondaryActionStyle}"
                    ButtonIcon="{StaticResource Close}"
                    AutomationProperties.Name="Remove sample from selection"
                    ToolTip="Remove sample from selection"
                    Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    Click="OnRemoveSelectedClick" />
            </Grid>
        </DataTemplate>
        <Style
            x:Key="OHsSampleLoaderBasketPanelStyle"
            TargetType="Border"
            BasedOn="{StaticResource CardBorderStyle}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsFolderSelection, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBrowserLayoutStyle"
            TargetType="Grid"
            BasedOn="{StaticResource BaseGridStyle}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsFolderSelection, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Grid.ColumnSpan"
                        Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderImportLayoutStyle"
            TargetType="Grid"
            BasedOn="{StaticResource BaseGridStyle}">
            <Setter
                Property="Grid.Column"
                Value="2" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsFolderSelection, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Grid.Column"
                        Value="1" />
                    <Setter
                        Property="Grid.ColumnSpan"
                        Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderAudioRegionStyle"
            TargetType="Grid"
            BasedOn="{StaticResource BaseGridStyle}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsFolderSelection, Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderPreviewMetadataStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BodyTextStyle}">
            <Setter
                Property="FontSize"
                Value="{StaticResource FontSize.Caption}" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter
                Property="TextWrapping"
                Value="NoWrap" />
            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />
            <Setter
                Property="ToolTipService.ShowsToolTipOnKeyboardFocus"
                Value="True" />
        </Style>
        <Style
            x:Key="OHsSampleLoaderWaveformTrackStyle"
            TargetType="Border"
            BasedOn="{StaticResource BaseBorderStyle}">
            <Setter
                Property="Background"
                Value="{DynamicResource Brush.Background.Deepened}" />
            <Setter
                Property="CornerRadius"
                Value="{StaticResource Radius.Control}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsSampleLoaderBrowserCardStyle"
            TargetType="Border"
            BasedOn="{StaticResource CardBorderStyle}">
            <Setter
                Property="Padding"
                Value="8" />
        </Style>
    </c:BasePopup.Resources>
    <Grid
        Margin="16,0,16,8"
        Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="Auto" />
            <ColumnDefinition
                Width="3*" />
            <ColumnDefinition
                Width="1.2*" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Row="1"
            Margin="0,0,12,0"
            MaxWidth="180"
            Style="{StaticResource OHsSampleLoaderSidebarStyle}">
            <ListBox
                x:Name="LocationList"
                IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                Style="{StaticResource BaseListBoxStyle}"
                ItemsSource="{Binding Source={StaticResource OHsSampleLoaderLocationsView}, Mode=OneWay}"
                ItemContainerStyle="{StaticResource OHsSampleLoaderLocationItemStyle}"
                ItemTemplate="{StaticResource OHsSampleLoaderLocationTemplate}"
                SelectedItem="{Binding ActiveLocation, Mode=OneWay}"
                SelectionChanged="OnLocationSelectionChanged"
                AutomationProperties.Name="Sample locations"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"
                Background="Transparent"
                BorderThickness="0">
                <ListBox.GroupStyle>
                    <StaticResource
                        ResourceKey="OHsSampleLoaderLocationGroupStyle" />
                </ListBox.GroupStyle>
            </ListBox>
        </Grid>
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="0"
            Style="{StaticResource OHsSampleLoaderBrowserLayoutStyle}">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Style="{StaticResource OHsSampleLoaderBrowserCardStyle}">
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="0.6*" />
                        </Grid.ColumnDefinitions>
                        <c:BalloonComboBox
                            x:Name="CompactLocationSelector"
                            IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Margin="0,0,8,0"
                            Style="{StaticResource OHsSampleLoaderCompactSelectorStyle}"
                            ButtonText="{Binding ActiveLocation.Name, Mode=OneWay, TargetNullValue=Drives}"
                            AutomationProperties.Name="Sample locations">
                            <c:BalloonComboBox.ContextMenu>
                                <ContextMenu
                                    Style="{StaticResource OHsActionContextMenuStyle}"
                                    ItemsSource="{Binding Locations, Mode=OneWay}"
                                    ItemContainerStyle="{StaticResource OHsSampleLoaderCompactLocationItemStyle}"
                                    Opened="OnLocationMenuOpened" />
                            </c:BalloonComboBox.ContextMenu>
                        </c:BalloonComboBox>
                        <Grid
                            Grid.Column="2"
                            Margin="8,0,0,0">
                            <TextBox
                                x:Name="FolderSearch"
                                IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                                Style="{StaticResource OHsSampleLoaderSearchStyle}"
                                AutomationProperties.Name="Search this folder"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OHsSampleLoaderSearchPlaceholderStyle}"
                                Text="Search this folder" />
                        </Grid>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl
                                x:Name="DirectoryBreadcrumbs"
                                ItemTemplate="{StaticResource SampleLoaderBreadcrumbTemplate}"
                                ItemsPanel="{StaticResource HorizontalStackItemsPanelTemplate}"
                                ItemsSource="{Binding Breadcrumbs, Mode=OneWay}"
                                Style="{StaticResource BaseItemsControlStyle}" />
                        </ScrollViewer>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="56,8,0,0"
                        Style="{StaticResource OHsSampleLoaderAudioRegionStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="80" />
                            <ColumnDefinition
                                Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CardLabelTextStyle}"
                            Text="Name" />
                        <TextBlock
                            Grid.Column="1"
                            TextAlignment="Right"
                            Margin="0,0,8,0"
                            Style="{StaticResource CardLabelTextStyle}"
                            Text="Duration" />
                        <TextBlock
                            Grid.Column="2"
                            TextAlignment="Right"
                            Margin="0,0,8,0"
                            Style="{StaticResource CardLabelTextStyle}"
                            Text="Size" />
                    </Grid>
                    <ListBox
                        x:Name="DirectoryContents"
                        IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="{Binding ContentsAutomationName, Mode=OneWay}"
                        ItemsSource="{Binding VisibleEntries, Mode=OneWay}"
                        PreviewKeyDown="OnContentsKeyDown"
                        SelectionChanged="OnContentsSelectionChanged"
                        Style="{StaticResource BaseListBoxStyle}"
                        ItemContainerStyle="{StaticResource SampleLoaderContentItemStyle}"
                        ItemTemplate="{StaticResource SampleLoaderEntryTemplate}"
                        Background="Transparent"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" />
                </Grid>
            </Border>
            <Grid
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{StaticResource OHsSampleLoaderAudioRegionStyle}">
                <Grid
                    x:Name="SelectedFileDetails"
                    Style="{StaticResource SampleLoaderSelectedFileDetailsStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="2*" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding SelectedFile.Name, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding SelectedFile.FullPath, Mode=OneWay}"
                            AutomationProperties.Name="{Binding SelectedFile.Name, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            Style="{StaticResource OHsSampleLoaderPreviewMetadataStyle}"
                            Text="{Binding PreviewMetadataText, Mode=OneWay}"
                            ToolTip="{Binding PreviewMetadataText, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource OHsSampleLoaderPreviewMetadataStyle}"
                            Text="{Binding SelectedFile.FullPath, Mode=OneWay}"
                            ToolTip="{Binding SelectedFile.FullPath, Mode=OneWay}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:BalloonButton
                            x:Name="PreviewButton"
                            ButtonText="Play"
                            AutomationProperties.Name="Play sample"
                            ToolTip="Play sample"
                            Command="{Binding PlayPreviewCommand, Mode=OneWay}"
                            Style="{StaticResource SampleLoaderPreviewStyle}" />
                        <c:BalloonButton
                            x:Name="StopPreviewButton"
                            Grid.Column="1"
                            ButtonIcon="{StaticResource MediaStop}"
                            AutomationProperties.Name="Stop sample"
                            ToolTip="Stop sample"
                            Command="{Binding StopPreviewCommand, Mode=OneWay}"
                            Style="{StaticResource OHsSampleLoaderSecondaryActionStyle}" />
                        <Border
                            Grid.Column="2"
                            Margin="8,0"
                            Style="{StaticResource OHsSampleLoaderWaveformTrackStyle}">
                            <Grid
                                Height="40"
                                Style="{StaticResource BaseGridStyle}"
                                PreviewMouseLeftButtonDown="OnWaveformSeekMouseDown">
                                <c:WaveformView
                                    x:Name="PreviewWaveform"
                                    Data="{Binding Waveform, Mode=OneWay}"
                                    Position="{Binding PlaybackPosition, Mode=OneWay}"
                                    WaveformBrush="{DynamicResource Brush.Waveform.Unplayed}"
                                    PlayedWaveformBrush="{DynamicResource Brush.Waveform.Played}"
                                    MarkerBrush="{DynamicResource Brush.Playhead}"
                                    SeekCommand="{Binding SeekPreviewCommand, Mode=OneWay}"
                                    IsEnabled="{Binding CanSeek, Mode=OneWay}"
                                    AutomationProperties.Name="Sample waveform" />
                                <c:ValueSlider
                                    x:Name="PlaybackTimeline"
                                    AutomationProperties.Name="Sample playback position"
                                    IsEnabled="{Binding CanSeek, Mode=OneWay}"
                                    Maximum="{Binding PlaybackDurationSeconds, Mode=OneWay}"
                                    Minimum="0"
                                    Style="{StaticResource BaseValueSliderStyle}"
                                    Value="{Binding PlaybackPositionSeconds, Mode=OneWay}"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    MinHeight="40" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="PlaybackTimeTextBlock"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource OHsSampleLoaderPreviewMetadataStyle}"
                            Text="{Binding PlaybackTimeText, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,8,0,0"
            Style="{StaticResource OHsSampleLoaderAudioRegionStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox
                x:Name="AutoPlayCheckBox"
                Content="Auto-play on select"
                AutomationProperties.Name="Auto-play on select"
                IsChecked="{Binding AutoPlaySamples, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                Style="{StaticResource SampleLoaderAutoPlayStyle}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource OHsSampleLoaderPreviewMetadataStyle}"
                Text="Shift+click selects a range"
                TextWrapping="Wrap" />
        </Grid>
        <Border
            Grid.Row="1"
            Grid.Column="2"
            Margin="12,0,0,0"
            Style="{StaticResource OHsSampleLoaderBasketPanelStyle}">
            <Grid
                Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Style="{StaticResource BaseStackPanelStyle}">
                        <TextBlock
                            Text="Selected samples"
                            Style="{StaticResource BodyTextStyle}"
                            FontFamily="{DynamicResource Bold}" />
                        <TextBlock
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding CheckedCount, Mode=OneWay}" />
                    </StackPanel>
                    <c:BalloonButton
                        x:Name="ClearSelectedButton"
                        Grid.Column="1"
                        Style="{StaticResource OHsSampleLoaderSecondaryActionStyle}"
                        ButtonIcon="{StaticResource Minus}"
                        ButtonText="Clear all"
                        ShouldShowText="True"
                        Command="{Binding ClearSelectedCommand, Mode=OneWay}"
                        AutomationProperties.Name="Clear all selected samples" />
                </Grid>
                <ListBox
                    x:Name="SelectedSamplesList"
                    IsEnabled="{Binding CanNavigate, Mode=OneWay}"
                    Grid.Row="1"
                    Margin="0,8,0,8"
                    Style="{StaticResource BaseListBoxStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding SelectedSamples, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource OHsSampleLoaderBasketItemStyle}"
                    ItemTemplate="{StaticResource OHsSampleLoaderBasketTemplate}"
                    AutomationProperties.Name="Selected samples"
                    SelectionChanged="OnBasketSelectionChanged"
                    PreviewKeyDown="OnBasketKeyDown"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True" />
                <StackPanel
                    Grid.Row="2"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <TextBlock
                        Text="{Binding CheckedCountText, Mode=OneWay}"
                        Style="{StaticResource BodyTextStyle}" />
                    <TextBlock
                        Text="{Binding SelectedDurationText, Mode=OneWay}"
                        Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid
            Grid.Row="2"
            Margin="12,8,0,0"
            Style="{StaticResource OHsSampleLoaderImportLayoutStyle}">
            <c:BalloonButton
                x:Name="ImportButton"
                AutomationProperties.Name="{Binding ConfirmAutomationName, Mode=OneWay}"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="{Binding ConfirmActionText, Mode=OneWay}"
                Click="OnImportClick"
                IsEnabled="{Binding CanConfirm, Mode=OneWay}"
                Style="{StaticResource OHsBalloonConfirmActionStyle}"
                IsTabStop="False"
                h:KeyboardNavigationPolicy.AllowTabNavigation="False"
                ShouldShowText="True"
                FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
        </Grid>
    </Grid>
</c:BasePopup>