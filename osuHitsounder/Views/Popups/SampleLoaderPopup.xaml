<c:BasePopup x:Class="osuHitsounder.Views.Popups.SampleLoaderPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls" Mode="None" PopupTitle="Load samples" Width="960" Height="640" SizeToContent="Manual">
    <c:BasePopup.Resources>
        <Style x:Key="SampleLoaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SampleLoaderCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SampleLoaderTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="SampleLoaderStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource SampleLoaderCaptionStyle}">
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SampleLoaderErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource SampleLoaderStatusStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
        <Style x:Key="SampleLoaderWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource SampleLoaderStatusStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </Style>
        <Style x:Key="SampleLoaderCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SampleLoaderDirectoryInputStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextInputStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DirectoryError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="SampleLoaderCheckTemplate" TargetType="CheckBox">
            <Grid Style="{StaticResource BaseGridStyle}" Background="{TemplateBinding Background}">
                <c:Icon Width="16" Height="16" Path="{StaticResource CheckboxBlankOutline}" Color="{TemplateBinding Foreground}" />
                <c:Icon x:Name="CheckedIcon" Width="12" Height="12" Path="{StaticResource Check}" Color="{TemplateBinding Foreground}" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckedIcon" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SampleLoaderCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderCheckTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="SampleLoaderExpanderTemplate" TargetType="ToggleButton">
            <Grid Style="{StaticResource BaseGridStyle}" Background="{TemplateBinding Background}">
                <c:Icon x:Name="Arrow" Width="12" Height="12" Path="{StaticResource AngleRight}" Color="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Path" Value="{StaticResource AngleDown}" />
                </Trigger>
                <Trigger Property="FlowDirection" Value="RightToLeft">
                    <Setter TargetName="Arrow" Property="FlowDirection" Value="RightToLeft" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SampleLoaderExpanderStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseToggleButtonStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderExpanderTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="Expand or collapse folder" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="SampleLoaderTreePanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="SampleLoaderTreeItemTemplate" TargetType="TreeViewItem">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="Row" Background="{TemplateBinding Background}" Style="{StaticResource BaseBorderStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Style="{StaticResource SampleLoaderExpanderStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ItemsPresenter x:Name="Children" Grid.Row="1" Margin="24,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsExpanded" Value="False">
                    <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SampleLoaderTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource BaseTreeViewItemStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderTreeItemTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource SampleLoaderTreePanel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <EventSetter Event="Expanded" Handler="OnFolderExpanded" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPlaceholder, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SampleLoaderTreeErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource SampleLoaderErrorStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate x:Key="SampleLoaderEntryTemplate" ItemsSource="{Binding Children, Mode=OneWay}">
            <Grid Style="{StaticResource BaseGridStyle}" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource SampleLoaderCheckStyle}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name, Mode=OneWay}" Click="OnFileCheckClick" />
                <StackPanel Style="{StaticResource BaseStackPanelStyle}" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath, Mode=OneWay}" />
                    <TextBlock Text="{Binding Error, Mode=OneWay}" Style="{StaticResource SampleLoaderTreeErrorStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="8,0,4,0" VerticalAlignment="Center" Text="{Binding KindText, Mode=OneWay}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" Style="{StaticResource SampleLoaderCaptionStyle}" />
            </Grid>
        </HierarchicalDataTemplate>
        <Style x:Key="SampleLoaderTreeStyle" TargetType="TreeView" BasedOn="{StaticResource BaseTreeViewStyle}">
            <Setter Property="ItemsPanel" Value="{StaticResource SampleLoaderTreePanel}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SampleLoaderTreeItemStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource SampleLoaderEntryTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
        </Style>
        <Style x:Key="SampleLoaderPreviewStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonNeutralActionStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaStop}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SampleLoaderImportStyle" TargetType="c:BalloonButton" BasedOn="{StaticResource OHsBalloonConfirmActionStyle}">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
        </Style>
    </c:BasePopup.Resources>
    <Grid Style="{StaticResource BaseGridStyle}" Margin="24,0,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource BaseGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SampleLoaderCardStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Current directory" Style="{StaticResource SampleLoaderCaptionStyle}" />
                    <TextBox x:Name="DirectoryTextBox" Grid.Row="1" AutomationProperties.Name="Current directory" Style="{StaticResource SampleLoaderDirectoryInputStyle}" Text="{Binding DirectoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnDirectoryKeyDown" />
                    <TextBlock Grid.Row="2" Text="{Binding DirectoryError, Mode=OneWay}" Style="{StaticResource SampleLoaderErrorStyle}" />
                    <TreeView x:Name="DirectoryTree" Grid.Row="3" Margin="0,8,0,0" AutomationProperties.Name="Folders and audio files" ItemsSource="{Binding Roots, Mode=OneWay}" Style="{StaticResource SampleLoaderTreeStyle}" SelectedItemChanged="OnTreeSelectionChanged" />
                    <TextBlock Grid.Row="4" Text="{Binding BrowserStatusText, Mode=OneWay}" Style="{StaticResource SampleLoaderStatusStyle}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SampleLoaderCardStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource {x:Type ScrollViewer}}">
                        <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                            <TextBlock Text="Selected file" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding Metadata.Name, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="{Binding SelectedFile.FullPath, Mode=OneWay}" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding MetadataStatusText, Mode=OneWay}" Style="{StaticResource SampleLoaderStatusStyle}" />
                            <TextBlock Text="Format" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding Metadata.Format, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="Size" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="Duration" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding DurationText, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="Sample rate" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding SampleRateText, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="Channels" Style="{StaticResource SampleLoaderCaptionStyle}" />
                            <TextBlock Text="{Binding ChannelsText, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
                            <TextBlock Text="{Binding MetadataError, Mode=OneWay}" Style="{StaticResource SampleLoaderErrorStyle}" />
                            <TextBlock Text="{Binding PreviewError, Mode=OneWay}" Style="{StaticResource SampleLoaderErrorStyle}" />
                            <TextBlock Text="{Binding PreviewWarning, Mode=OneWay}" Style="{StaticResource SampleLoaderWarningStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                    <c:BalloonButton x:Name="PreviewButton" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left" ButtonText="{Binding PreviewActionText, Mode=OneWay}" Command="{Binding TogglePreviewCommand, Mode=OneWay}" IsEnabled="{Binding CanPreview, Mode=OneWay}" AutomationProperties.Name="{Binding PreviewActionText, Mode=OneWay}" Style="{StaticResource SampleLoaderPreviewStyle}" />
                </Grid>
            </Border>
        </Grid>
        <Grid Style="{StaticResource BaseGridStyle}" Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CheckedCountTextBlock" VerticalAlignment="Center" Text="{Binding CheckedCountText, Mode=OneWay}" Style="{StaticResource SampleLoaderTextStyle}" />
            <c:BalloonButton x:Name="ImportButton" Grid.Column="1" ButtonIcon="{StaticResource PlusSolid}" ButtonText="Import" IsEnabled="{Binding CanImport, Mode=OneWay}" AutomationProperties.Name="Import checked files" Click="OnImportClick" Style="{StaticResource SampleLoaderImportStyle}" />
        </Grid>
    </Grid>
</c:BasePopup>
