<c:BasePopup
    x:Class="osuHitsounder.Views.Popups.SampleLoaderPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls"
    Width="960"
    Height="640"
    Mode="None"
    PopupTitle="Load samples"
    SizeToContent="Manual">
    <c:BasePopup.Resources>
        <Style
            x:Key="SampleLoaderTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderSelectedFileDetailsStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedFile, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderEmptySelectionStyle"
            BasedOn="{StaticResource CenteredEmptyStateTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedFile, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderCaptionStyle"
            BasedOn="{StaticResource SampleLoaderTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style
            x:Key="SampleLoaderStatusStyle"
            BasedOn="{StaticResource SampleLoaderCaptionStyle}"
            TargetType="TextBlock">
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderErrorStyle"
            BasedOn="{StaticResource SampleLoaderStatusStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
        <Style
            x:Key="SampleLoaderWarningStyle"
            BasedOn="{StaticResource SampleLoaderStatusStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </Style>
        <Style
            x:Key="SampleLoaderCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderDirectoryInputStyle"
            BasedOn="{StaticResource RoundedTextInputStyle}"
            TargetType="TextBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DirectoryError, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="SampleLoaderCheckTemplate" TargetType="CheckBox">
            <Grid Background="{TemplateBinding Background}" Style="{StaticResource BaseGridStyle}">
                <c:Icon
                    Width="16"
                    Height="16"
                    Path="{StaticResource CheckboxBlankOutline}"
                    Color="{TemplateBinding Foreground}" />
                <c:Icon
                    x:Name="CheckedIcon"
                    Width="12"
                    Height="12"
                    Path="{StaticResource Check}"
                    Visibility="Collapsed"
                    Color="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckedIcon" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderCheckStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderCheckTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="SampleLoaderExpanderTemplate" TargetType="ToggleButton">
            <Grid Background="{TemplateBinding Background}" Style="{StaticResource BaseGridStyle}">
                <c:Icon
                    x:Name="Arrow"
                    Width="12"
                    Height="12"
                    Path="{StaticResource AngleRight}"
                    Color="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Path" Value="{StaticResource AngleDown}" />
                </Trigger>
                <Trigger Property="FlowDirection" Value="RightToLeft">
                    <Setter TargetName="Arrow" Property="FlowDirection" Value="RightToLeft" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderExpanderStyle"
            BasedOn="{StaticResource BaseToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderExpanderTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="Expand or collapse folder" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="SampleLoaderTreePanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ControlTemplate x:Key="SampleLoaderTreeItemTemplate" TargetType="TreeViewItem">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="Row"
                    Background="{TemplateBinding Background}"
                    Style="{StaticResource BaseBorderStyle}">
                    <Grid Style="{StaticResource BaseGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="Expander"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource SampleLoaderExpanderStyle}" />
                        <ContentPresenter
                            x:Name="PART_Header"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>
                </Border>
                <ItemsPresenter
                    x:Name="Children"
                    Grid.Row="1"
                    Margin="24,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsExpanded" Value="False">
                    <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderTreeItemStyle"
            BasedOn="{StaticResource BaseTreeViewItemStyle}"
            TargetType="TreeViewItem">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderTreeItemTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource SampleLoaderTreePanel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <EventSetter Event="Expanded" Handler="OnFolderExpanded" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFileRowMouseDown" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPlaceholder, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderTreeErrorStyle"
            BasedOn="{StaticResource SampleLoaderErrorStyle}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate x:Key="SampleLoaderEntryTemplate" ItemsSource="{Binding Children, Mode=OneWay}">
            <Grid MinHeight="40" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                    Click="OnFileCheckClick"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SampleLoaderCheckStyle}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BaseStackPanelStyle}">
                    <TextBlock
                        FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=OneWay}"
                        Style="{StaticResource SampleLoaderTextStyle}"
                        Text="{Binding Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding FullPath, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SampleLoaderTreeErrorStyle}" Text="{Binding Error, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        <Style
            x:Key="SampleLoaderTreeStyle"
            BasedOn="{StaticResource BaseTreeViewStyle}"
            TargetType="TreeView">
            <Setter Property="ItemsPanel" Value="{StaticResource SampleLoaderTreePanel}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SampleLoaderTreeItemStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource SampleLoaderEntryTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
        </Style>
        <Style
            x:Key="SampleLoaderPreviewStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaStop}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderImportStyle"
            BasedOn="{StaticResource OHsBalloonConfirmActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
        </Style>
        <Style
            x:Key="SampleLoaderCompactTextStyle"
            BasedOn="{StaticResource SampleLoaderTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
        </Style>
        <Style
            x:Key="SampleLoaderMetadataLabelStyle"
            BasedOn="{StaticResource SampleLoaderTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style
            x:Key="SampleLoaderTimelineStyle"
            BasedOn="{StaticResource OHsValueSliderStyle}"
            TargetType="c:ValueSlider">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.1" />
        </Style>
        <ControlTemplate x:Key="SampleLoaderAutoPlayTemplate" TargetType="CheckBox">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Style="{StaticResource BaseGridStyle}">
                        <c:Icon Path="{StaticResource CheckboxBlankOutline}" Color="{TemplateBinding Foreground}" />
                        <c:Icon
                            x:Name="CheckMark"
                            Width="12"
                            Height="12"
                            Path="{StaticResource Check}"
                            Visibility="Collapsed"
                            Color="{TemplateBinding Foreground}" />
                    </Grid>
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderAutoPlayStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="Template" Value="{StaticResource SampleLoaderAutoPlayTemplate}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsKeyboardFocusVisualStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </c:BasePopup.Resources>
    <Grid Margin="24,0,24,8" Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SampleLoaderCardStyle}">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SampleLoaderMetadataLabelStyle}"
                        Text="Current directory" />
                    <TextBox
                        x:Name="DirectoryTextBox"
                        Grid.Column="1"
                        AutomationProperties.Name="Current directory"
                        PreviewKeyDown="OnDirectoryKeyDown"
                        Style="{StaticResource SampleLoaderDirectoryInputStyle}"
                        Text="{Binding DirectoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SampleLoaderErrorStyle}"
                    Text="{Binding DirectoryError, Mode=OneWay}" />
                <TreeView
                    x:Name="DirectoryTree"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Folders and audio files"
                    ItemsSource="{Binding Roots, Mode=OneWay}"
                    SelectedItemChanged="OnTreeSelectionChanged"
                    Style="{StaticResource SampleLoaderTreeStyle}" />
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource SampleLoaderStatusStyle}"
                    Text="{Binding BrowserStatusText, Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid
            Grid.Row="1"
            Margin="0,8,0,0"
            Style="{StaticResource BaseGridStyle}">
            <Grid x:Name="SelectedFileDetails" Style="{StaticResource SampleLoaderSelectedFileDetailsStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    MaxHeight="80"
                    HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource {x:Type ScrollViewer}}"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            Style="{StaticResource SampleLoaderCompactTextStyle}"
                            Text="{Binding SelectedFile.Name, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Style="{StaticResource SampleLoaderCompactTextStyle}"
                            Text="{Binding SelectedFile.FullPath, Mode=OneWay}" />
                        <WrapPanel>
                            <StackPanel
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                Style="{StaticResource BaseStackPanelStyle}">
                                <TextBlock Style="{StaticResource SampleLoaderMetadataLabelStyle}" Text="Size" />
                                <TextBlock Style="{StaticResource SampleLoaderTextStyle}" Text="{Binding SizeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                Style="{StaticResource BaseStackPanelStyle}">
                                <TextBlock Style="{StaticResource SampleLoaderMetadataLabelStyle}" Text="Duration" />
                                <TextBlock Style="{StaticResource SampleLoaderTextStyle}" Text="{Binding DurationText, Mode=OneWay}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource SampleLoaderStatusStyle}" Text="{Binding MetadataStatusText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SampleLoaderErrorStyle}" Text="{Binding MetadataError, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SampleLoaderErrorStyle}" Text="{Binding PreviewError, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SampleLoaderWarningStyle}" Text="{Binding PreviewWarning, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:BalloonButton
                        x:Name="PreviewButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{Binding PreviewActionText, Mode=OneWay}"
                        ButtonText="{Binding PreviewActionText, Mode=OneWay}"
                        Command="{Binding TogglePreviewCommand, Mode=OneWay}"
                        IsEnabled="{Binding CanPreview, Mode=OneWay}"
                        Style="{StaticResource SampleLoaderPreviewStyle}" />
                    <c:ValueSlider
                        x:Name="PlaybackTimeline"
                        Grid.Column="1"
                        Margin="8,0"
                        AutomationProperties.Name="Sample playback position"
                        IsEnabled="{Binding CanSeek, Mode=OneWay}"
                        Maximum="{Binding PlaybackDurationSeconds, Mode=OneWay}"
                        Minimum="0"
                        Style="{StaticResource SampleLoaderTimelineStyle}"
                        Value="{Binding PlaybackPositionSeconds, Mode=OneWay}" />
                    <TextBlock
                        x:Name="PlaybackTimeTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource SampleLoaderTextStyle}"
                        Text="{Binding PlaybackTimeText, Mode=OneWay}" />
                </Grid>
            </Grid>
            <TextBlock
                x:Name="EmptySelectionPrompt"
                MinHeight="40"
                Style="{StaticResource SampleLoaderEmptySelectionStyle}"
                Text="Select a .wav, .ogg or .mp3" />
        </Grid>
        <Grid
            Grid.Row="2"
            Margin="0,8,0,0"
            Style="{StaticResource BaseGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox
                x:Name="AutoPlayCheckBox"
                AutomationProperties.Name="Auto-play samples"
                Content="Auto-play samples"
                IsChecked="{Binding AutoPlaySamples, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource SampleLoaderAutoPlayStyle}" />
            <TextBlock
                x:Name="CheckedCountTextBlock"
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Style="{StaticResource SampleLoaderCompactTextStyle}"
                Text="{Binding CheckedCountText, Mode=OneWay}" />
            <c:BalloonButton
                x:Name="ImportButton"
                Grid.Column="2"
                AutomationProperties.Name="Import checked files"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="Import"
                Click="OnImportClick"
                IsEnabled="{Binding CanImport, Mode=OneWay}"
                Style="{StaticResource SampleLoaderImportStyle}" />
        </Grid>
    </Grid>
</c:BasePopup>
