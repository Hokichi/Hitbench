<c:BasePopup
    x:Class="osuHitsounder.Views.Popups.SampleLoaderPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:osuHitsounder.Resources.CustomControls"
    xmlns:h="clr-namespace:osuHitsounder.Resources.Helpers"
    Width="960"
    Height="640"
    PopupTitle="{Binding PopupTitle, Mode=OneWay}"
    SizeToContent="Manual">
    <c:BasePopup.Resources>

        <Style
            x:Key="SampleLoaderSelectedFileDetailsStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedFile, Mode=OneWay}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="SampleLoaderCheckTemplate" TargetType="CheckBox">
            <Grid Background="{TemplateBinding Background}" Style="{StaticResource BaseGridStyle}">
                <c:Icon
                    Width="16"
                    Height="16"
                    Path="{StaticResource CheckboxBlankOutline}"
                    Color="{TemplateBinding Foreground}" />
                <c:Icon
                    x:Name="CheckedIcon"
                    Width="12"
                    Height="12"
                    Path="{StaticResource Check}"
                    Visibility="Collapsed"
                    Color="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckedIcon" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderCheckStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="Template" Value="{StaticResource SampleLoaderCheckTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

            </Style.Triggers>
        </Style>
        <Style
            x:Key="SampleLoaderBreadcrumbButtonStyle"
            BasedOn="{StaticResource OHsBalloonActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ButtonIcon" Value="{StaticResource AngleRight}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Hovered}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SampleLoaderBreadcrumbTemplate">
            <c:BalloonButton
                AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                ButtonText="{Binding Name, Mode=OneWay}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                CommandParameter="{Binding FullPath, Mode=OneWay}"
                Style="{StaticResource SampleLoaderBreadcrumbButtonStyle}"
                ToolTip="{Binding FullPath, Mode=OneWay}" />
        </DataTemplate>
        <ControlTemplate x:Key="SampleLoaderContentItemTemplate" TargetType="ListBoxItem">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Style="{StaticResource BaseBorderStyle}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderContentItemStyle"
            BasedOn="{StaticResource PlainListBoxItemStyle}"
            TargetType="ListBoxItem">
            <Setter Property="Template" Value="{StaticResource SampleLoaderContentItemTemplate}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnEntryRowMouseDown" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Navy.Tint}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Navy}" />
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SampleLoaderEntryTemplate">
            <Grid MinHeight="40" Style="{StaticResource BaseGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                    Click="OnFileCheckClick"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SampleLoaderCheckStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding FullPath, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <Style
            x:Key="SampleLoaderPreviewStyle"
            BasedOn="{StaticResource OHsBalloonNeutralActionStyle}"
            TargetType="c:BalloonButton">
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="ShouldShowText" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Setter Property="ButtonIcon" Value="{StaticResource MediaPlay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewPlaying, Mode=OneWay}" Value="True">
                    <Setter Property="ButtonIcon" Value="{StaticResource MediaStop}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <ControlTemplate x:Key="SampleLoaderAutoPlayTemplate" TargetType="CheckBox">
            <Border
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Style="{StaticResource BaseBorderStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Style="{StaticResource BaseGridStyle}">
                        <c:Icon Path="{StaticResource CheckboxBlankOutline}" Color="{TemplateBinding Foreground}" />
                        <c:Icon
                            x:Name="CheckMark"
                            Width="12"
                            Height="12"
                            Path="{StaticResource Check}"
                            Visibility="Collapsed"
                            Color="{TemplateBinding Foreground}" />
                    </Grid>
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style
            x:Key="SampleLoaderAutoPlayStyle"
            BasedOn="{StaticResource BaseCheckBoxStyle}"
            TargetType="CheckBox">
            <Setter Property="Template" Value="{StaticResource SampleLoaderAutoPlayTemplate}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="h:KeyboardNavigationPolicy.AllowTabNavigation" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource OHsSampleManagerKeyboardFocusStyle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderSelection, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </c:BasePopup.Resources>
    <Grid Margin="24,0,24,8" Style="{StaticResource BaseGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid Style="{StaticResource BaseGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl
                            x:Name="DirectoryBreadcrumbs"
                            ItemTemplate="{StaticResource SampleLoaderBreadcrumbTemplate}"
                            ItemsPanel="{StaticResource HorizontalStackItemsPanelTemplate}"
                            ItemsSource="{Binding Breadcrumbs, Mode=OneWay}"
                            Style="{StaticResource BaseItemsControlStyle}" />
                    </ScrollViewer>
                </Grid>
                <ListBox
                    x:Name="DirectoryContents"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="{Binding ContentsAutomationName, Mode=OneWay}"
                    ItemsSource="{Binding Entries, Mode=OneWay}"
                    PreviewKeyDown="OnContentsKeyDown"
                    SelectionChanged="OnContentsSelectionChanged"
                    Style="{StaticResource BaseListBoxStyle}"  ItemContainerStyle="{StaticResource SampleLoaderContentItemStyle}" ItemTemplate="{StaticResource SampleLoaderEntryTemplate}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
            </Grid>
        </Border>
        <Grid
            Grid.Row="1"
            Style="{StaticResource BaseGridStyle}">
            <Grid x:Name="SelectedFileDetails" Margin="0,8,0,0" Style="{StaticResource SampleLoaderSelectedFileDetailsStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    MaxHeight="80"
                    HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource {x:Type ScrollViewer}}"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource BaseStackPanelStyle}">
                        <TextBlock
                            FontFamily="{DynamicResource Bold}"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{Binding SelectedFile.Name, Mode=OneWay}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, Mode=OneWay}"/>
                        <WrapPanel>
                            <StackPanel
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                Style="{StaticResource BaseStackPanelStyle}">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding SizeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                Style="{StaticResource BaseStackPanelStyle}">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding DurationText, Mode=OneWay}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Style="{StaticResource BaseGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:BalloonButton
                        x:Name="PreviewButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{Binding PreviewActionText, Mode=OneWay}"
                        ButtonText="{Binding PreviewActionText, Mode=OneWay}"
                        Command="{Binding TogglePreviewCommand, Mode=OneWay}"
                        IsEnabled="{Binding CanPreview, Mode=OneWay}"
                        Style="{StaticResource SampleLoaderPreviewStyle}" />
                    <c:ValueSlider
                        x:Name="PlaybackTimeline"
                        Grid.Column="1"
                        Margin="8,0"
                        AutomationProperties.Name="Sample playback position"
                        IsEnabled="{Binding CanSeek, Mode=OneWay}"
                        Maximum="{Binding PlaybackDurationSeconds, Mode=OneWay}"
                        Minimum="0"
                        Style="{StaticResource BaseValueSliderStyle}"
                        Value="{Binding PlaybackPositionSeconds, Mode=OneWay}"  IsTabStop="True" h:KeyboardNavigationPolicy.AllowTabNavigation="True" MinHeight="40" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}" SmallChange="0.01" LargeChange="0.1"/>
                    <TextBlock
                        x:Name="PlaybackTimeTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextStyle}"
                        Text="{Binding PlaybackTimeText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>
        <Grid
            Grid.Row="2"
            Margin="0,8,0,0"
            Style="{StaticResource BaseGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox
                x:Name="AutoPlayCheckBox"
                AutomationProperties.Name="Auto-play samples"
                Content="Auto-play samples"
                IsChecked="{Binding AutoPlaySamples, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource SampleLoaderAutoPlayStyle}" />
            <c:BalloonButton
                x:Name="ImportButton"
                Grid.Column="2"
                AutomationProperties.Name="{Binding ConfirmAutomationName, Mode=OneWay}"
                ButtonIcon="{StaticResource PlusSolid}"
                ButtonText="{Binding ConfirmActionText, Mode=OneWay}"
                Click="OnImportClick"
                IsEnabled="{Binding CanConfirm, Mode=OneWay}"
                Style="{StaticResource OHsBalloonConfirmActionStyle}"  IsTabStop="True" h:KeyboardNavigationPolicy.AllowTabNavigation="True" ShouldShowText="True" FocusVisualStyle="{StaticResource OHsSampleManagerKeyboardFocusStyle}"/>
        </Grid>
    </Grid>
</c:BasePopup>

