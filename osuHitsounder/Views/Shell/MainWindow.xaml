<Window
    x:Class="osuHitsounder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:osuHitsounder.Resources.CustomControls"
    Title="osuHitsounder"
    Width="1280"
    Height="720"
    MinWidth="640"
    MinHeight="360"
    Deactivated="OnWindowDeactivated"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <Style
            x:Key="OHsMainWindowSampleManagerHostStyle"
            BasedOn="{StaticResource BaseContentControlStyle}"
            TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Width" Value="720" />
            <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=SampleManagerLayer, Mode=OneWay}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="OHsMainWindowAcrylicBackground" Color="Transparent" />
        <Style
            x:Key="OHsMainWindowGoBackStyle"
            BasedOn="{StaticResource OHsBalloonActionStyle}"
            TargetType="customControls:BalloonButton">
            <Setter Property="DefaultBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo}" />
            <Setter Property="HoveredBackground" Value="{DynamicResource Brush.BalloonButton.Background.NavInfo.Hovered}" />
            <Setter Property="ShouldShowText" Value="True" />
        </Style>
        <Style
            x:Key="MainWindowStyle"
            BasedOn="{StaticResource BaseWindowStyle}"
            TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Main}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcrylicEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OHsMainWindowAcrylicBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowRootStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Main}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAcrylicEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OHsMainWindowAcrylicBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowTitleStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BlurEffect x:Key="MainWindowScanBlur" Radius="8" />
        <Style
            x:Key="MainWindowScanContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInteractionBlocked, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingSurfaceStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BlurEffect x:Key="MainWindowModalBlur" Radius="8" />
        <Style
            x:Key="OHsMainWindowSampleManagerContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSampleManagerVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowModalBlur}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMainWindowSampleManagerLayerStyle"
            BasedOn="{StaticResource BaseGridStyle}"
            TargetType="Grid">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSampleManagerVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="OHsMainWindowSampleManagerBackdropStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="Dismiss active drawer" />
        </Style>
        <Style
            x:Key="MainWindowModalContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPopupOverlayVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowModalBlur}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowModalOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPopupOverlayVisible, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="MainWindowStyle" />
    </Window.Style>
    <Border
        x:Name="ShellRoot"
        MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"
        Style="{StaticResource MainWindowRootStyle}">
        <Grid>
            <Border x:Name="ModalShellContent" Style="{StaticResource MainWindowModalContentStyle}">
                <Grid Style="{StaticResource BaseGridStyle}">
                    <Border x:Name="SampleManagerAppContent" Style="{StaticResource OHsMainWindowSampleManagerContentStyle}">
                        <Grid x:Name="ShellLayout">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="ShellHeader">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="12,0"
                                    Style="{StaticResource MainWindowTitleStyle}"
                                    Text="osuHitsounder" />
                                <WrapPanel
                                    x:Name="WorkstationActions"
                                    Grid.Column="1"
                                    Visibility="Collapsed">
                                    <customControls:BalloonButton
                                        x:Name="GoBackButton"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Go Back"
                                        ButtonIcon="{StaticResource Home}"
                                        ButtonText="Go Back"
                                        Click="OnGoBackClick"
                                        IsEnabled="{Binding ElementName=PageHost, Path=Content.DataContext.CanGoBack, Mode=OneWay}"
                                        Style="{StaticResource OHsMainWindowGoBackStyle}"
                                        ToolTip="Save project and return to home" />
                                </WrapPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <customControls:BalloonButton
                                        x:Name="MinimizeButton"
                                        AutomationProperties.Name="Minimize"
                                        ButtonIcon="{StaticResource Minus}"
                                        ButtonText="Minimize"
                                        Click="OnMinimizeClick"
                                        Style="{StaticResource OHsBalloonNeutralActionStyle}"
                                        ToolTip="Minimize" />
                                    <customControls:BalloonButton
                                        x:Name="MaximizeRestoreButton"
                                        AutomationProperties.Name="Maximize"
                                        ButtonIcon="{StaticResource ExpandAlt}"
                                        ButtonText="Maximize"
                                        Click="OnMaximizeRestoreClick"
                                        Style="{StaticResource OHsBalloonNeutralActionStyle}"
                                        ToolTip="Maximize" />
                                    <customControls:BalloonButton
                                        x:Name="CloseButton"
                                        AutomationProperties.Name="Close"
                                        ButtonIcon="{StaticResource Close}"
                                        ButtonText="Close"
                                        Click="OnCloseClick"
                                        Style="{StaticResource OHsBalloonDestructiveActionStyle}"
                                        ToolTip="Close" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                                <Border FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Style="{StaticResource MainWindowScanContentStyle}">
                                    <ContentControl x:Name="PageHost" />
                                </Border>
                                <Border FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Style="{StaticResource MainWindowProcessingOverlayStyle}">
                                    <Border Style="{StaticResource MainWindowProcessingSurfaceStyle}">
                                        <TextBlock
                                            x:Name="ProcessingText"
                                            Style="{StaticResource MainWindowProcessingTextStyle}"
                                            Text="Processing..." />
                                    </Border>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="SampleManagerLayer" Style="{StaticResource OHsMainWindowSampleManagerLayerStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding ActualHeight, ElementName=ShellHeader, Mode=OneWay}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="SampleManagerBackdrop"
                            Grid.RowSpan="2"
                            MouseLeftButtonDown="OnSampleManagerBackdropClick"
                            Style="{StaticResource OHsMainWindowSampleManagerBackdropStyle}" />
                        <Grid
                            x:Name="SampleManagerMotionHost"
                            Grid.Row="1"
                            Style="{StaticResource BaseGridStyle}">
                            <ContentControl
                                x:Name="SampleManagerHost"
                                FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                Style="{StaticResource OHsMainWindowSampleManagerHostStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="ModalShellOverlay" Style="{StaticResource MainWindowModalOverlayStyle}" />
        </Grid>
    </Border>
</Window>
