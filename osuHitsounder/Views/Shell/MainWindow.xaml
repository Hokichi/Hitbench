<Window
    x:Class="osuHitsounder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="osuHitsounder"
    Width="1280"
    Height="720"
    MinWidth="640"
    MinHeight="360"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None">
    <Window.Resources>
        <Style
            x:Key="MainWindowStyle"
            BasedOn="{StaticResource BaseWindowStyle}"
            TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Main}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BlurEffect x:Key="MainWindowScanBlur" Radius="8" />
        <Style
            x:Key="MainWindowScanContentStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Effect" Value="{StaticResource MainWindowScanBlur}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInteractionBlocked, Mode=OneWay}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingOverlayStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingSurfaceStyle"
            BasedOn="{StaticResource BaseBorderStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="MainWindowProcessingTextStyle"
            BasedOn="{StaticResource BaseTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast), Mode=OneWay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="MainWindowStyle" />
    </Window.Style>
    <Grid>
        <Border Style="{StaticResource MainWindowScanContentStyle}">
            <ContentControl x:Name="PageHost" />
        </Border>
        <Border Style="{StaticResource MainWindowProcessingOverlayStyle}">
            <Border Style="{StaticResource MainWindowProcessingSurfaceStyle}">
                <TextBlock
                    x:Name="ProcessingText"
                    Style="{StaticResource MainWindowProcessingTextStyle}"
                    Text="Processing..." />
            </Border>
        </Border>
    </Grid>
</Window>
